# Align with .editorconfig: all text files use LF (both in repo and working tree)
* text=auto eol=lf

# Shell scripts must always be LF (Linux requirement)
*.sh text eol=lf

# Python scripts
*.py text eol=lf

# Ansible YAML files (run on Linux)
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - never touch
*.png 
*.jpg 
*.jpeg 
*.gif 
*.ico 
*.svg 
*.woff 
*.woff2 
*.ttf 
*.eot 
*.zip 
*.tar.gz 
*.gz  -text
scripts/lib/seat-planes.yml -text

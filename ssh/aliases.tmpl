# --- oldsrv: direct at home, the seat itself at home, `-vps` when away ----------
#% seat: laptop-win11 laptop-wsl
Host oldsrv
  HostName @OLDSRV_HN@
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
Host oldsrv-vps
  HostName @OLDSRV_HN@
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  AddressFamily inet
  ProxyJump vps
#% end
#% seat: cockpit
# ON-SELF: this seat IS oldsrv. Measured 2026-10-09: `ssh oldsrv` from the cockpit seat died
# `domen@oldsrv: Permission denied` because no block named it, so ssh used the login user, picked
# the box's own key and offered a key `domen` is not authorized for. The self-alias is the fix:
# the human identity, direct, no jump (a jump here would hairpin through the VPS to reach the box
# the shell is already on).
Host @OLDSRV_PAT@
  HostName @OLDSRV_HN@
  User domen
  IdentityFile @IDENT@
  IdentitiesOnly yes
  AddressFamily inet
#% end

# --- oldsrv-domen: the coding seat (HD-492) --------------------------------------
# This is the name the VS Code Remote-SSH session uses, and it is now DIRECT: on the LAN the jump
# buys nothing but a hairpin and one more key to load, and a jumped leg is exactly where the
# LibreSSL-cannot-parse-PKCS#8 failure lands — it dies on the FIRST hop and then reads like a VPS
# auth problem when it is a seat transport problem.
#% seat: laptop-win11 laptop-wsl
Host oldsrv-domen
  HostName @OLDSRV_HN@
  User domen
  IdentityFile @IDENT@
  IdentitiesOnly yes
Host oldsrv-domen-vps
  HostName @OLDSRV_HN@
  User domen
  IdentityFile @IDENT@
  IdentitiesOnly yes
  AddressFamily inet
  ProxyJump vps
#% end

# --- the typed-address blocks (laptop seats only) --------------------------------
# The pair of `ansible_ssh_common_args`: OpenSSH only matches what is typed, so `scp`/`rsync`/`git`
# and a human typing an address need these. Load-bearing for scp, NOT for Ansible (HD-397). On the
# cockpit seat they are unnecessary: the alias lines above already carry the address spellings.
#
# They carry NO jump, and that is rule 1 rather than an omission: an address is a same-site spelling,
# so `scp file 10.10.1.10:` means "this subnet, now". Away from the house the NAME form carries the
# hop (`scp file nas-vps:` — scp/rsync/git all take a host NAME, so refusing to jump an unreachable
# address costs nothing).
#% seat: laptop-win11 laptop-wsl
Host 10.10.1.10
  HostName 10.10.1.10
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
Host 10.10.1.20
  HostName 10.10.1.20
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
Host 10.10.1.30
  HostName 10.10.1.30
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
Host 10.10.1.40
  HostName 10.10.1.40
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
#% end

# --- the Mgmt plane (VLAN 99): ON-SITE ADMIN PATHS ONLY --------------------------
# Jump-less by decision, not by omission (HD-398 A): the VPS site-to-site tunnel is sealed from
# VLAN 99 on purpose and the router scopes its own SSH to the VLAN-99 subnet. Away from the house
# these are dead ADDRESSES, not dead hosts. On the laptop the route is the Mgmt99 vNIC —
# `wsl-nat-resolv.ps1 -EnableMgmt99`, and verify with `ip -br addr` in WSL that a VLAN-99 route
# exists, not just eth0. The cockpit seat declares none of these: a host reaching the Mgmt plane
# is a routing question no seat has measured (HD-487 is still open on exactly that point), so it is
# absent as a MEASURED fact, not as a decision.
#% seat: laptop-win11 laptop-wsl
Host pi99
  HostName 10.10.99.20
  User domen
  IdentityFile @IDENT@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host oldsrv99
  HostName 10.10.99.30
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host nas99
  HostName 10.10.99.10
  User ansible-admin
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host router
  HostName 10.10.99.1
  User ansible
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host switch
  HostName 10.10.99.2
  User ansible
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host ap-spalnica
  HostName 10.10.99.4
  User ansible
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host ap-dnevna
  HostName 10.10.99.5
  User ansible
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
Host ap-spare
  HostName 10.10.99.6
  User ansible
  IdentityFile @ADMIN@
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
#% end

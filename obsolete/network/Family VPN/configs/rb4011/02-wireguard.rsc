#==============================================================================
# RB4011 — 02-wireguard
# WireGuard "server" side. Generates keys, creates interface + peer for hAP ac².
#
# VARIABLES (fill in before running):
#   <WG_LISTEN_PORT>      – public UDP port for WireGuard (e.g. 29008)
#   <HAP_AC2_PUBLIC_KEY>  – public key from hAP ac² (generated by 02-wireguard.rsc there)
#==============================================================================

# --- Generate RB4011 WireGuard key pair ---
/interface wireguard add \
    comment="Family VPN – server side" \
    listen-port=<WG_LISTEN_PORT> \
    mtu=1420 \
    name=wg-family

# --- Assign tunnel IP (server side = .1) ---
/ip address add \
    address=10.99.99.1/31 \
    interface=wg-family \
    network=10.99.99.0

# --- Add the hAP ac² peer ---
/interface wireguard peers add \
    allowed-address=192.168.123.0/24 \
    comment="hAP ac² travel AP" \
    interface=wg-family \
    public-key="<HAP_AC2_PUBLIC_KEY>"

# --- Show the RB4011 public key (copy this to hAP ac² config) ---
:put "=== RB4011 WireGuard public key ==="
/interface wireguard print value-list where name=wg-family
:put "=== Paste the public-key value into hap-ac2/02-wireguard.rsc ==="

# Next: run 03-firewall-nat.rsc

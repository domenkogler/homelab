# Shelly device credentials
# Replace with your 1Password references or plaintext values.
# Safe to commit — op:// references are not real secrets.

# Shared credentials for all Shelly devices on the LAN
SHELLY_USER=admin
SHELLY_PASSWORD=op://Private/Shelly Devices/password

# Network scan range (optional — auto-detected from routing table if not set)
SHELLY_SCAN_CIDR=192.168.1.0/24
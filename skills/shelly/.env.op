# Shelly device credentials
# Safe to commit — op:// references are not real secrets; never put real values here.

# Shared credentials for all Shelly devices on the LAN.
# Current fleet (4x Shelly RGBW2, VLAN 20: 10.10.20.13-16) is OPEN-ACCESS
# (auth:false — verified live 2026-09-03), so no password is needed.
SHELLY_USER=admin
SHELLY_PASSWORD=

# Network scan range (optional — auto-detected from routing table if not set)
SHELLY_SCAN_CIDR=192.168.1.0/24
# MikroTik 1Password environment template
#
# Replace the op:// paths with your own 1Password vault/item/field references.
# This file is safe to commit to Git — it contains only URI references, not secrets.
#
# Usage:
#   op run --env-file=skills/mikrotik/.env.op -- python skills/mikrotik/scripts/mikrotik-read.py /ip/firewall/filter

MIKROTIK_HOST=op://Homelab/RB4011/url
MIKROTIK_USER=op://Homelab/RB4011/username
MIKROTIK_PASSWORD=op://Homelab/RB4011/password
MIKROTIK_PORT=8728
MIKROTIK_TIMEOUT=10

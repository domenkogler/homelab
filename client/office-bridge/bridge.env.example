# bridge config example — copy to bridge.env on the client, do NOT commit secrets.
# Wire the wrapper (bridge.py) to a Headscale overlay IP + one token.
#
# Headscale-only bind (HD-109): the bridge must be reachable from the server-side
# Open WebUI over the overlay, and NOT on the public/home-LAN that anyone can touch.
# Set OFFICE_BRIDGE_HOST to the Tailscale/Headscale IP of this client (e.g. 100.x.y.z),
# NOT 0.0.0.0 — bridge.py refuses 0.0.0.0 by design.

# Token Open WebUI sends as `Authorization: Bearer <TOKEN>` (HD-109). Generate + keep
# in 1Password `Homelab`; inject here on the client. Fail-closed: if unset, bridge 503s.
OFFICE_BRIDGE_TOKEN=replace-me-from-1password

# Bind host/port. Host = Headscale overlay IP of this client.
OFFICE_BRIDGE_HOST=100.64.0.5
OFFICE_BRIDGE_PORT=8766

# Optional TLS for the wrapper (recommended: terminate TLS so the token is not plaintext
# even on the overlay). Leave empty for plaintext-over-Headscale-only.
#OFFICE_BRIDGE_TLS_CERT=C:\\path\\to\\wildcard.kogler.si.crt
#OFFICE_BRIDGE_TLS_KEY=C:\\path\\to\\wildcard.kogler.si.key

# Excel via sbroenne standalone CLI (exclusive mode). Pin the binary checksum in the
# update script (HD-106). Excel 2016+ required; close open workbooks before use.
EXCEL_CLI=C:\\Program Files\\ExcelMcp\\excelcli.exe

# Optional DIY GetActiveObject attach-mode Excel fallback.
#EXCEL_FALLBACK=C:\\Program Files\\ExcelMcp\\excel_fallback.py
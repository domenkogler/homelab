{# roles/cockpit seat.yml — the pi-web cockpit unit (HD-445).
   A systemd USER unit: installed under the seat account's ~/.config/systemd/user,
   enabled, and started by the handler (never `enable --now`, which will not restart
   a running unit — the Phase 4c lesson). ExecStart points at the launcher the pi-web
   package installs; the assert in seat.yml refuses to render this unit if that
   binary is missing, and the loopback/on-path drop-ins carry the two properties the
   unit alone cannot express. #}
[Unit]
Description=pi-web — browser-based pi session viewer and chat
Documentation=https://github.com/ygncode/pi-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ seat_home }}/{{ seat_pi_web_bin }}
Restart=on-failure
RestartSec=5

# Pass PI_WEB_TOKEN from the environment if set
EnvironmentFile=-%h/.config/pi-web/env

[Install]
WantedBy=default.target

# managed by Ansible — nut role (master)
# Local upsmon on the master watches the USB-HID device via upsd.
MONITOR powerwalker@localhost 1 upsmon {{ nut_upsmon_password }} master
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
POWERDOWNWAIT 0
RUN_AS_USER nut

# Wire the guaranteed notify (upssched-cmd: email + Signal on ONBATT/LOWBATT,
# independent of Grafana/n8n). upssched runs via upsmon's NOTIFYCMD.
NOTIFYCMD /usr/sbin/upssched
NOTIFYFLAG ONLINE SYSLOG+WALL+EXEC
NOTIFYFLAG ONBATT SYSLOG+WALL+EXEC
NOTIFYFLAG LOWBATT SYSLOG+WALL+EXEC

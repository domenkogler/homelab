# managed by Ansible — nut role (both)
# Charge-threshold shutdown helper. On mains loss we poll the UPS charge
# (checkcharge) and halt this host once it drops to its threshold. `nut_shutdown_charge_threshold`:
#   oldsrv = 75 — biggest load, halts early to preserve battery for nas/pi
#   nas/pi  = 0  — rely on the upsmon LOWBATT SHUTDOWNCMD (critical-only policy;
#                  the repeat timer below does nothing at threshold 0).
# ONBATT/ONLINE transitions send a direct notification (independent of Grafana/n8n).
CMDSCRIPT /etc/nut/upssched-cmd
PIPEFN /var/run/nut/upssched.pipe
LOCKFN /var/run/nut/upssched.lock

# Notify immediately on mains loss.
AT ONBATT  * EXECUTE onbatt
AT ONLINE * EXECUTE online

# Poll charge while on battery (every 30 s). At threshold 0 (nas/pi) the check
# never halts — LOWBATT (upsmon SHUTDOWNCMD) remains their only powerdown path.
AT ONBATT * START-TIMER charge-check 30
AT ONLINE * CANCEL-TIMER charge-check
AT charge-check * EXECUTE checkcharge
AT charge-check * START-TIMER charge-check 30

# LOWBATT direct notify (upsmon's own SHUTDOWNCMD handles the actual halt).
AT LOWBATT * EXECUTE lowbatt
# managed by Ansible — nut role (client slave)
# Connects to the nas master (intra-Home VLAN) and shuts down locally on low
# battery. The graceful delay (shutdown_delay_seconds: oldsrv=60, pi=0) is
# owned by the upssched ONBATT timer (see upssched.conf.j2 → powerdown);
# SHUTDOWNCMD here is the immediate LOWBATT path only.
MONITOR powerwalker@{{ nut_host }} 1 upsmon {{ nut_upsmon_password }} slave
SHUTDOWNCMD "/sbin/shutdown -h now"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
POWERDOWNWAIT 0
RUN_AS_USER nut

# Wire the guaranteed notify (upssched-cmd: email + Signal on ONBATT/LOWBATT,
# independent of Grafana/n8n). upssched runs via upsmon's NOTIFYCMD.
NOTIFYCMD /usr/sbin/upssched
NOTIFYFLAG ONLINE SYSLOG+WALL+EXEC
NOTIFYFLAG ONBATT SYSLOG+WALL+EXEC
NOTIFYFLAG LOWBATT SYSLOG+WALL+EXEC

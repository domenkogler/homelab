#!/bin/bash
# managed by Ansible — nut role — upssched-cmd
# master (nas): direct ONBATT/LOWBATT/ONLINE email + optional Signal notify,
#               INDEPENDENT of Grafana/n8n — a pre-shutdown notice goes out even
#               if the observability stack is degraded. SMTP creds render from
#               1Password `nut-smtp_login` on the master only — clients keep
#               no secrets (mode 0750).
# both:         `powerdown` — the deferred shutdown fired by the upssched
#               ONBATT timer (shutdown_delay_seconds: nas/pi=0 immediate,
#               oldsrv=60). upsmon's own SHUTDOWNCMD covers LOWBATT.
set -u

{% if nut_mode == 'master' %}
# --- Notification path (master) ---
case "$1" in
  onbatt)
    SUBJ="[Homelab UPS] ON BATTERY — mains lost"
    BODY="The PowerWalker UPS is on battery. ${nut_host}@${nut_listen_ip} — expect shutdown per NUT policy."
    ;;
  lowbatt)
    SUBJ="[Homelab UPS] LOW BATTERY — imminent shutdown"
    BODY="UPS battery critically low — hosts will shut down now (${nut_host})."
    ;;
  online)
    SUBJ="[Homelab UPS] Back on mains"
    BODY="Utility power restored; UPS charging. ${nut_host}"
    ;;
  powerdown)
    logger -t nut-upssched "UPS still on battery after ${shutdown_delay_seconds}s — powering down"
    /sbin/shutdown -h now
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

# --- Email (SMTP via python3, or local sendmail/mail fallback) ---
send_mail() {
  if [ -n "${nut_smtp_server}" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "${nut_smtp_server}" "${nut_smtp_user}" "${nut_smtp_pass}" \
      "${nut_notify_email}" "${SUBJ}" "${BODY}" <<'PYEOF'
import smtplib, sys
from email.mime.text import MIMEText
server_arg, user, pwd, to, subj, body = sys.argv[1:7]
# nut_smtp_server is "host:port" (SMTP2Go SSOT); split, default 587 for safety.
if ':' in server_arg:
    server, port = server_arg.rsplit(':', 1)
    port = int(port)
else:
    server, port = server_arg, 587
msg = MIMEText(body, 'plain', 'utf-8')
msg['Subject'] = subj
msg['From'] = user
msg['To'] = to
try:
    smtp = smtplib.SMTP(server, port, timeout=15)
    smtp.ehlo()
    smtp.starttls()
    smtp.login(user, pwd)
    smtp.sendmail(user, [to], msg.as_string())
    smtp.quit()
except Exception as e:
    sys.stderr.write("NUT SMTP failed: %s\n" % e)
    sys.exit(1)
PYEOF
    return $?
  fi
  # Fallback: local MTA if SMTP not configured.
  { echo "To: ${nut_notify_email}"; echo "Subject: ${SUBJ}"; echo ""; echo "${BODY}"; } \
    | /usr/sbin/sendmail -t 2>/dev/null \
    || /usr/bin/mail -s "${SUBJ}" "${nut_notify_email}" <<<"${BODY}" 2>/dev/null || true
  return 0
}

send_mail || true

# --- Optional Signal helper ---
if [ -n "${nut_signal_helper}" ] && [ -x "${nut_signal_helper}" ]; then
  "${nut_signal_helper}" "${SUBJ} — ${BODY}" 2>/dev/null || true
fi
{% else %}
# --- Shutdown/log path (client) — no SMTP creds on clients ---
case "$1" in
  onbatt)
    logger -t nut-upssched "UPS on battery (${nut_host}) — shutdown in ${shutdown_delay_seconds}s unless mains returns"
    ;;
  lowbatt)
    logger -t nut-upssched "UPS battery critically low — shutting down now"
    ;;
  online)
    logger -t nut-upssched "UPS back on mains — shutdown cancelled"
    ;;
  powerdown)
    logger -t nut-upssched "UPS still on battery after ${shutdown_delay_seconds}s — powering down"
    /sbin/shutdown -h now
    ;;
  *)
    ;;
esac
{% endif %}
exit 0

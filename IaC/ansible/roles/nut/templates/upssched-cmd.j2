#!/bin/bash
# managed by Ansible — nut role — upssched-cmd
# master (nas): direct ONBATT/LOWBATT/ONLINE email + optional Signal notify,
#               INDEPENDENT of Grafana/n8n — a pre-shutdown notice goes out even
#               if the observability stack is degraded. SMTP creds render from
#               1Password `smtp_login` on the master only — clients keep
#               no secrets (mode 0750).
# both:         `checkcharge` — polls the UPS charge while on battery and fires
#               `powerdown` once it crosses this host's threshold
#               (nut_shutdown_charge_threshold: oldsrv=75 — the power hog halts
#               early to preserve battery for nas/pi; nas/pi=0 → rely on the
#               upsmon LOWBATT SHUTDOWNCMD instead, per the critical-only policy).
#               `powerdown` — the actual halt, executed via sudo (nut has no
#               polkit rights to /sbin/shutdown).
set -u

{% if nut_mode == 'master' %}
# --- Notification path (master) ---
case "$1" in
  onbatt)
    SUBJ="[Homelab UPS] ON BATTERY — mains lost"
    BODY="The PowerWalker UPS is on battery. {{ nut_host }}@{{ nut_listen_ip }} — expect shutdown per NUT policy."
    ;;
  lowbatt)
    SUBJ="[Homelab UPS] LOW BATTERY — imminent shutdown"
    BODY="UPS battery critically low — hosts will shut down now ({{ nut_host }})."
    ;;
  online)
    SUBJ="[Homelab UPS] Back on mains"
    BODY="Utility power restored; UPS charging. {{ nut_host }}"
    ;;
  wake-check)
    # Master-only: when mains is back and battery recharges to >= nut_wake_charge,
    # wake clients that halted themselves (WoL magic packet to each configured MAC).
    _charge=$(upsc {{ nut_host }}@{{ nut_listen_ip }} battery.charge 2>/dev/null | tr -dc '0-9')
    if [ -n "${_charge}" ] && [ "${_charge}" -ge "{{ nut_wake_charge | default(90) }}" ]; then
      logger -t nut-upssched "battery ${_charge}% >= {{ nut_wake_charge | default(90) }}% — sending WoL to halted clients"
{% for _host, _mac in nut_wake_macs | default({}) | dictsort %}
      /usr/bin/wakeonlan {{ _mac }} || true
      logger -t nut-upssched "wakeonlan sent to {{ _host }} ({{ _mac }})"
{% endfor %}
    fi
    exit 0
    ;;
  checkcharge)
    # Poll charge (via the master's USB link) and halt at this host's threshold.
    # Uses" the master upsd so no client-side NUT auth is needed.
    _charge=$(upsc {{ nut_host }}@{{ nut_listen_ip }} battery.charge 2>/dev/null | tr -dc '0-9')
    if [ -n "${_charge}" ] && [ "${_charge}" -le "{{ nut_shutdown_charge_threshold | default(0) }}" ]; then
      logger -t nut-upssched "charge ${_charge}% <= threshold {{ nut_shutdown_charge_threshold | default(0) }}% — powering down"
      exec sudo /sbin/poweroff
    fi
    exit 0
    ;;
  powerdown)
    logger -t nut-upssched "UPS still on battery after {{ shutdown_delay_seconds | default(0) }}s — powering down"
    exec sudo /sbin/poweroff
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

# --- Email (SMTP via python3, or local sendmail/mail fallback) ---
send_mail() {
  if [ -n "{{ nut_smtp_server }}" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "{{ nut_smtp_server }}" "{{ nut_smtp_user }}" "{{ nut_smtp_pass }}" \
      "{{ nut_notify_email }}" "${SUBJ}" "${BODY}" <<'PYEOF'
import smtplib, sys
from email.mime.text import MIMEText
server_arg, user, pwd, to, subj, body = sys.argv[1:7]
# nut_smtp_server is "host:port" (SMTP2Go SSOT); split, default 2525 for safety.
if ':' in server_arg:
    server, port = server_arg.rsplit(':', 1)
    port = int(port)
else:
    server, port = server_arg, 2525
msg = MIMEText(body, 'plain', 'utf-8')
msg['Subject'] = subj
msg['From'] = user
msg['To'] = to
try:
    smtp = smtplib.SMTP(server, port, timeout=15)
    smtp.ehlo()
    smtp.starttls()
    smtp.login(user, pwd)
    smtp.sendmail(user, [to], msg.as_string())
    smtp.quit()
except Exception as e:
    sys.stderr.write("NUT SMTP failed: %s\n" % e)
    sys.exit(1)
PYEOF
    return $?
  fi
  # Fallback: local MTA if SMTP not configured.
  { echo "To: {{ nut_notify_email }}"; echo "Subject: ${SUBJ}"; echo ""; echo "${BODY}"; } \
    | /usr/sbin/sendmail -t 2>/dev/null \
    || /usr/bin/mail -s "${SUBJ}" "{{ nut_notify_email }}" <<<"${BODY}" 2>/dev/null || true
  return 0
}

send_mail || true

# --- Optional Signal helper ---
# NOTE: `:-` guard — under `set -u` an unset ${nut_signal_helper} aborted the whole
# script at this line (HD-06 drill: `vrstica 103: nut_signal_helper: nedoločena
# spremenljivka`, exec_cmd returned 1). The helper stays optional/shell-defaulted.
if [ -n "${nut_signal_helper:-}" ] && [ -x "${nut_signal_helper:-}" ]; then
  "${nut_signal_helper:-}" "${SUBJ} — ${BODY}" 2>/dev/null || true
fi
{% else %}
# --- Shutdown/log path (client) — no SMTP creds on clients ---
case "$1" in
  onbatt)
    logger -t nut-upssched "UPS on battery ({{ nut_host }}) — shutdown below {{ nut_shutdown_charge_threshold | default(0) }}% charge"
    ;;
  lowbatt)
    logger -t nut-upssched "UPS battery critically low — shutting down now"
    ;;
  online)
    logger -t nut-upssched "UPS back on mains — shutdown cancelled"
    ;;
  checkcharge)
    # Poll charge from the master and halt at this host's threshold.
    _charge=$(upsc {{ nut_host }} battery.charge 2>/dev/null | tr -dc '0-9')
    if [ -n "${_charge}" ] && [ "${_charge}" -le "{{ nut_shutdown_charge_threshold | default(0) }}" ]; then
      logger -t nut-upssched "charge ${_charge}% <= threshold {{ nut_shutdown_charge_threshold | default(0) }}% — powering down"
      exec sudo /sbin/poweroff
    fi
    exit 0
    ;;
  powerdown)
    logger -t nut-upssched "UPS still on battery after {{ shutdown_delay_seconds | default(0) }}s — powering down"
    exec sudo /sbin/poweroff
    ;;
  *)
    ;;
esac
{% endif %}
exit 0
# smb.conf — Samba shares on the NAS (D4 / HD-131)
# Managed by Ansible (storage role). Family mapped drives:
#   \\nas\media  — shared media (any family user; files owned by neutral `media`)
#   \\nas\music  — the arr music library = Lidarr's rootFolder (a top-level share like
#                 media, NOT a user store — so the “three kinds” count above still holds; HD-362)
#   \\nas\<user> — per-user private drive (valid users = that account; files owned by that
#                  user's OWN uid, NOT the global media account — so per-user isolation holds)
# Authentication is LOCAL: `passdb backend = tdbsam` — one unix+Samba account per entry in
# `storage_samba_users`, its password written from the 1Password item `smb-<name>_login` at
# converge (roles/storage/tasks/samba.yml). Members mount with a username + password typed
# once by the client. The Authentik-as-LDAP passdb planned here (D7/HD-132) was RETIRED
# 2026-10-07 — see docs/storage-rejected.md. Nothing in this file reads a directory or a bind
# secret, which is why the rendered file is 0644 again. Data lives on ZFS datasets.

[global]
   workgroup = WORKGROUP
   server string = Kogler NAS
   security = user
   map to guest = never
   min protocol = SMB2
   max protocol = SMB3
   # ZFS ACLs via Samba's always-available POSIX-ACL backend (acl_xattr).
   # `zfs_core` is NOT in Debian's samba packages (TrueNAS-only fork module) —
   # using it breaks EVERY tree connect with vfs_init failed (2026-09-14 live hit).
   vfs objects = acl_xattr
   create mask = 0664
   directory mask = 0775
   netbios name = NAS

   # ---- PassDB: local tdbsam, and the only supported shape ----
   # The Authentik-as-LDAP alternative (D7/HD-132) is retired 2026-10-07: it hung a LAN-local
   # mount off the VPS + WG tunnel and could never answer an NTLM challenge (Authentik serves
   # no `sambaNTPassword`). Credentials arrive from 1Password `smb-<name>_login` via
   # roles/storage/tasks/samba.yml; NOTHING here reads an LDAP directory or a bind secret.
   passdb backend = tdbsam

# ---- Shared media (any family account; force-owner = neutral media account) ----
[{{ storage_samba_media.share }}]
   comment = Family shared media
   path = {{ storage_samba_media.path }}
   browseable = yes
   read only = no
   valid users = @{{ storage_group }}
   force user = {{ storage_user }}
   force group = {{ storage_group }}

# ---- Arr music library = Lidarr's rootFolder (HD-362) ----
# The one drop point that needs no follow-up move: this IS the folder Lidarr scans
# (container /media/music). Drop albums as <Artist>/<Album (Year)>/<files>, then
# Lidarr → Artists → Add New / Import mode "Existing Files" (or Rescan on a known artist).
# `valid users` is the SHARED service account rather than the storage group: this is the
# share a laptop or a relative's machine mounts, so it is deliberately reachable with ONE
# non-personal credential (host_vars pins storage_samba_music_valid_users).
[{{ storage_samba_music.share }}]
   comment = Music library (Lidarr root — <Artist>/<Album (Year)>/files)
   path = {{ storage_samba_music.path }}
   browseable = yes
   read only = no
   valid users = {{ storage_samba_music_valid_users | default('@' ~ storage_group) }}
   force user = {{ storage_user }}
   force group = {{ storage_group }}

# ---- Per-user private drives (only the named account can mount; OWN uid owns their files) ----
{% for u in storage_samba_users if u.drive | default(true) %}
[{{ u.name }}]
   comment = {{ u.name }}'s private drive
   path = {{ storage_samba_users_root }}/{{ u.name }}
   browseable = no
   read only = no
   valid users = {{ u.name }}
   # NO force user — each user's files keep their own POSIX uid (per-user isolation)

{% endfor %}
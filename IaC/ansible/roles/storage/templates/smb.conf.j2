# smb.conf — Samba shares on the NAS (D4 / HD-131)
# Managed by Ansible (storage role). Family mapped drives:
#   \\nas\media  — shared media (any family user; files owned by neutral `media`)
#   \\nas\<user> — per-user private drive (valid users = that account; files owned by that
#                  user's OWN uid, NOT the global media account — so per-user isolation holds)
# Family members log in with their Samba username+password at mount time (manual, no
# 1Password SSO — 1Password only stores the passwords). Data lives on ZFS datasets.

[global]
   workgroup = WORKGROUP
   server string = Kogler NAS
   security = user
   map to guest = never
   guest account = nobody
   min protocol = SMB2
   max protocol = SMB3
   vfs objects = zfs_core
   create mask = 0664
   directory mask = 0775
   netbios name = NAS

# ---- Shared media (any family user; force-owner = neutral media account) ----
[{{ storage_samba_media.share }}]
   comment = Family shared media
   path = {{ storage_samba_media.path }}
   browseable = yes
   read only = no
   valid users = @{{ storage_gid }}
   force user = {{ storage_uid }}
   force group = {{ storage_gid }}

# ---- Per-user private drives (only the named user can mount; OWN uid owns their files) ----
{% for u in storage_samba_users %}
[{{ u.name }}]
   comment = {{ u.name }}'s private drive
   path = {{ storage_samba_users_root }}/{{ u.name }}
   browseable = no
   read only = no
   valid users = {{ u.name }}
   # NO force user — each user's files keep their own POSIX uid (per-user isolation)

{% endfor %}
[Unit]
Description=Produce oldsrv DB dumps and push them (local scratch → tank/data/db-dumps)
Documentation=file:///usr/local/sbin/storage-push-db-dumps.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Non-root on purpose (KOPS-056/HD-127): the dump needs the docker socket, and a nightly
# timer has no business owning it as root. svc-backup is in the docker group and owns the
# staging dir — see roles/storage/tasks/oldsrv.yml.
User=svc-backup
Group=svc-backup
ExecStart=/usr/local/sbin/storage-push-db-dumps.sh
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true

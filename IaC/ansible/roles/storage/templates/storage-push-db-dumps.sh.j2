#!/bin/bash
# Managed by Ansible — storage role. DB-dump leg on oldsrv, HALF ONE of two units: this one
# PRODUCES the dumps this host owns. It runs unprivileged as `svc-backup` (in the docker group),
# because that is the half that touches the docker socket. The copy to the NAS is
# storage-push-db-dumps-push.sh, which must run as root — see the why in that file.
#
# Why this half exists at all (HD-468, measured 2026-09-28): `/srv/dumps` was a permanently EMPTY
# directory. The old unit rsynced it to `tank/data/db-dumps` and, once the rsync flags were the only
# thing fixed, would have gone green while shipping nothing. A leg that produces nothing must fail,
# so every step here is asserted and an empty output is a failure rather than a success.
set -euo pipefail
umask 022

SRC="{{ storage_push_db_dumps.src | quote }}"
KEEP={{ storage_push_db_dumps.keep | default(14) | int }}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)

fail() { echo "FATAL: $*" >&2; exit 1; }

command -v docker >/dev/null || fail "docker not present"
[ -d "$SRC" ] || fail "staging dir $SRC does not exist (is the nvme/dumps dataset mounted?)"

produced=0
{% for pg in storage_push_db_dumps_pg %}
# {{ pg.container }}: pg_dumpall INSIDE the container (its socket is local to it; --clean
# --if-exists makes the dump restorable onto a non-empty cluster), streamed to a temp file and only
# then gzipped — so a dump that dies halfway can never leave a truncated .sql.gz behind.
# mktemp needs the X's at the END of the template, so a `.err` suffix is not an option here.
err=$(mktemp "$SRC/.{{ pg.container }}.err.XXXXXX")
raw=$(mktemp "$SRC/.{{ pg.container }}.raw.XXXXXX")
out="$SRC/{{ pg.container }}-$STAMP.sql.gz"
if ! docker exec {{ pg.container | quote }} pg_dumpall -U {{ pg.db_user | quote }} --clean --if-exists \
      > "$raw" 2>"$err"; then
  reason=$(tail -c 300 "$err" 2>/dev/null | tr '\n' ' ')
  rm -f "$raw" "$err"
  fail "{{ pg.container }}: pg_dumpall failed — ${reason:-(no stderr)}"
fi
gzip -n -c "$raw" > "$out" || { rm -f "$raw" "$err"; fail "{{ pg.container }}: gzip failed"; }
rm -f "$raw"
[ -s "$out" ] || { rm -f "$out" "$err"; fail "{{ pg.container }}: dump is empty (that is not a backup)"; }
gzip -t "$out" 2>/dev/null || { rm -f "$out" "$err"; fail "{{ pg.container }}: dump failed its own gzip integrity test"; }
rm -f "$err"
echo "produced {{ pg.container }} → $(basename "$out") ($(stat -c %s "$out") bytes)"
# Local retention only. The NAS side keeps whatever it has ever received; retention there belongs to
# sanoid snapshots, not to a copy job (which is also why the push half never passes --delete).
ls -1t "$SRC"/{{ pg.container }}-*.sql.gz 2>/dev/null | tail -n +$(( KEEP + 1 )) | xargs -r rm -f
produced=$(( produced + 1 ))
{% endfor %}

[ "$produced" -gt 0 ] || fail "no dump sources configured (storage_push_db_dumps_pg is empty) — this leg is a no-op, and a no-op is not a backup"
echo "OK: $produced dump(s) produced into $SRC"

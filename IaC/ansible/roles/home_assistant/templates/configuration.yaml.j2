# Home Assistant configuration.yaml — templated by Ansible
# Source of truth: IaC/ansible/roles/home_assistant/templates/configuration.yaml.j2
# Both Pi (primary) and oldsrv (standby) render the same config.

# ---- Reverse proxy (Traefik) ----
# Both edges must be trusted so HA sees real client IPs.
http:
  use_x_forwarded_for: true
  # Trust only the specific Traefik edge container IPs, not the whole traefik-public /16
  # (KOPS-039 / HD-81) — prevents a compromised sibling container from spoofing client IPs.
  trusted_proxies:
{% for ip in ha_trusted_proxies %}
    - {{ ip }}
{% endfor %}

# ---- Recorder (trimmed for Pi microSD wear) ----
# Grafana replaces HA for long-term analytics, so local history is kept short.
# Keep recorder ENABLED — it still powers Logbook, Energy-Dashboard LTS, and
# history_stats sensors. Do NOT disable, do NOT switch to Postgres.
recorder:
  purge_keep_days: 2
  commit_interval: 5
  exclude:
    domains:
      - update
      - updater
      - persistent_notification
      - scene
      - automation
    entity_globs:
      - sensor.*_last_boot
      - binary_sensor.*_status

# ---- Integrations ----
# Configure additional integrations via the HA UI (stored in .storage/).
# See docs/smart-home.md for architecture.

# ---- Weather (HD-22) ----
# Single authoritative weather source = HA core `meteoblue` (models Slovenia well,
# hourly + daily forecast). Replaces the third-party HACS "Weather 2000" and drop core
# `met` (weather.forecast_dom). api key from 1Password Homelab.
weather:
  - platform: meteoblue
    api_key: "{{ lookup('community.general.onepassword', 'meteoblue_api', field='credential', vault=op_vault) }}"
    name: Meteoblue kogler.si (Maribor)
    latitude: {{ home_latitude }}
    longitude: {{ home_longitude }}
    forecast_days: 7
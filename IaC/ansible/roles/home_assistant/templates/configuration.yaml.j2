# Home Assistant configuration.yaml — templated by Ansible
# Source of truth: IaC/ansible/roles/home_assistant/templates/configuration.yaml.j2
# Both Pi (primary) and oldsrv (standby) render the same config.

# ---- Reverse proxy (Traefik) ----
# Both edges must be trusted so HA sees real client IPs.
http:
  use_x_forwarded_for: true
  # Trust only the specific Traefik edge container IPs, not the whole traefik-public /16 —
  # a compromised sibling container could otherwise spoof client IPs.
  trusted_proxies:
{% for ip in ha_trusted_proxies %}
    - {{ ip }}
{% endfor %}

# ---- Recorder (trimmed for Pi microSD wear) ----
# Grafana replaces HA for long-term analytics, so local history is kept short.
# Keep recorder ENABLED — it still powers Logbook, Energy-Dashboard LTS, and
# history_stats sensors. Do NOT disable, do NOT switch to Postgres.
recorder:
  purge_keep_days: 2
  commit_interval: 5
  exclude:
    domains:
      - update
      - updater
      - persistent_notification
      - scene
      - automation
    entity_globs:
      - sensor.*_last_boot
      - binary_sensor.*_status

# ---- Integrations ----
# Mobile App/Companion integration (Android/iOS). Required for the HA Companion
# app registration — without it POST /api/mobile_app/registrations 404s and the
# app aborts at the "name the device" step with "enable the mobile app
# integration". Declare it explicitly (NOT `default_config:` — that pulls in
# cloud/energy/dlna/etc. deliberately omitted here; the config stays hand-picked).
mobile_app:

# KNX (docs/smart-home.md): ETS project file is the SSOT; entity maps are generated
# from it (scripts/knx-hass-gen.py → knx-entities.yaml). The knxproj itself is
# deployed to /config/knx/ for the KNX panel import (Group Monitor names + triggers).
# The KNX/IP connection (tunneling to the GIRA IP router {{ knx_router_ip }}) is
# configured in the UI config flow (Settings → Connectivity → KNX) — current HA has
# no YAML key for the connection.
knx: !include knx-entities.yaml

# ---- Lovelace (dashboard_stanovanje, YAML mode) ----
# Modernized from the old dashboard_stanovanje.yaml; views includes live under
# /config/lovelace/. The dashboard renders the KNX entities generated from the
# ETS project (same namespace as configuration.yaml's knx: block).
lovelace:
  mode: storage
  dashboards:
    lovelace-stanovanje:
      mode: yaml
      title: Stanovanje
      show_in_sidebar: true
      icon: mdi:home
      filename: /config/lovelace/dashboard_stanovanje.yaml

# ---- Radiator timers (ported from old-ha scripts.yaml; target the KNX radiator
#      switches by their generated entity IDs — stable). ----
script:
  kopalnica_radiator_za_1h:
    alias: "Kopalnica radiator za 1h"
    sequence:
      - action: switch.turn_on
        target: { entity_id: switch.kopalnica_radiator }
      - delay: "01:00:00"
      - action: switch.turn_off
        target: { entity_id: switch.kopalnica_radiator }
  wc_radiator_za_1h:
    alias: "WC radiator za 1h"
    sequence:
      - action: switch.turn_on
        target: { entity_id: switch.wc_radiator }
      - delay: "01:00:00"
      - action: switch.turn_off
        target: { entity_id: switch.wc_radiator }


# Home Assistant secrets.yaml — templated by Ansible (home_assistant role)
# Source of truth: IaC/ansible/roles/home_assistant/templates/secrets.yaml.j2
# Both Pi (primary) and oldsrv (standby) render the same secret file — each host
# keeps its OWN 1Password-rendered copy (`./secrets.yaml` is excluded from the
# Pi→standby config rsync, per docs/smart-home-failover.md and the compose mounts).
#
# Values are resolved via `community.general.onepassword` lookup at render time
# (the same mechanism configuration.yaml.j2 uses — the home_assistant role runs
# BEFORE docker_services on the Pi (render-first, HD-204), so the docker_services
# `vault` dict is NOT yet populated at this point and must not be relied on).
#
# Rendered secret values keep the HD-233 YAML rule: block scalar `>-` for anything
# a 1Password value could contain (`:`, `"`, `#`, `$`, …) so HA's YAML parse never
# breaks on a rotated/odd secret.
#
# Salting: use `| replace('$','$$')` where HA passes the value into a shell
# (HD-233 §2.3), and plain `>-` where HA reads it as a YAML value only.
#
# Each field is FAIL-CLOSED per HD-91: if the 1Password item is missing the whole
# render aborts loudly (no default('')).
# Note: ha_api (HA long-lived API token / Prometheus bearer) is NOT a HA YAML-
# config secret — the monitoring role writes it to /etc/prometheus/ha_token under
# the prometheus_ha_exporter gate (docs/observability.md). It does not belong here.
meteoblue_api: >-
  {{ lookup('community.general.onepassword', 'meteoblue_api', field='credential', vault=op_vault) }}
smtp_login: >-
  {{ lookup('community.general.onepassword', 'smtp_login', field='username', vault=op_vault) }}
smtp_password: >-
  {{ lookup('community.general.onepassword', 'smtp_login', field='password', vault=op_vault) }}
ha-vrrp_password: >-
  {{ lookup('community.general.onepassword', 'ha-vrrp_password', field='password', vault=op_vault) }}

# HA failover trigger API env (HD-17) — rendered by the home_assistant role.
# Vault-escape note: this .env is consumed directly (NOT via `docker compose`
# interpolation) — vault values pass through unchanged, no `| replace('$','$$')` (HD-270).
# Read by /usr/local/sbin/ha-failover-api.py (fail-closed on empty token).
HA_FAILOVER_PORT={{ failover_api_port }}
HA_FAILOVER_TOKEN={{ lookup('community.general.onepassword', 'ha-failover_api', field='credential', vault=op_vault) }}
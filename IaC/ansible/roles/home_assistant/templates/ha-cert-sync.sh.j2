#!/bin/bash
# Managed by Ansible — home_assistant role (Pi). Pull the wildcard *.kogler.si
# cert pair from the VPS traefik (the SINGLE ACME issuer, HD-178/HD-181 — decided
# HD-204: every consumer pulls from the VPS directly, no relay) into traefik-ha's
# certs, keeping the Pi edge TLS-valid offline. The last synced copy stays valid when
# the WAN/VPS is down (ACME cannot renew, but does not need to). Runs as root via
# ha-cert-sync.service (key at /root/.ssh/ha-sync).
set -euo pipefail

SRC="ansible-admin@{{ hostvars['vps.kogler.si'].ansible_host }}:/opt/traefik/certs/"
DST="/opt/traefik-ha/certs/"
SSH="ssh -i /root/.ssh/ha-sync -o StrictHostKeyChecking=accept-new -o BatchMode=yes"

mkdir -p "$DST"
rsync -az --delete -e "$SSH" "$SRC" "$DST"
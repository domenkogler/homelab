#!/usr/sbin/nft -f
# nftables ruleset — VPS default-deny inbound (security.md §8)
# Allow: loopback, established/related, :443 (Traefik edge), :51820 (WireGuard S2S),
# and the stateless IPv6 NDP/MLD/PMTUD traffic without which none of the above is
# reachable over v6.
# Deny everything else inbound. Docker containers on isolated overlay networks
# (traefik-public/services-internal/db-internal) reach the internet via the host
# NAT (docker's own iptables/nftables chains), which this ruleset leaves intact —
# we only gate the HOST-facing input path.

# Scoped table replacement: this file must NEVER
# begin with 'flush ruleset' — that wipes ALL tables including docker's
# iptables-nft-programmed nat/filter chains until docker re-programs them, and the container
# fleet is isolated for that window. Instead: declare an empty
# table (no-op if absent), delete it, then recreate it below — touching ONLY our
# own table, so docker-managed tables survive every apply and service restart.
table inet filter {}
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # Loopback
        iif lo accept

        # Established/related (outbound-initiated replies)
        ct state established,related accept

        # Public edge
        tcp dport 22 accept         # SSH (ansible-admin) — management path; omitting it locks the converge out
        tcp dport 443 accept        # Traefik HTTPS (wildcard *.kogler.si)
        udp dport 51820 accept      # WireGuard S2S (wg-s2s, home router peer)
        # The traefik-tailnet
        # internal edge publishes :4443 on the wg-s2s VPS address (docker compose
        # ports: wg_s2s_vps.ip -> container). Docker's PREROUTING DNAT preempts this
        # input chain, but the vps-hardening pattern mandates an explicit
        # input allow scoped to the tunnel peer (defense-in-depth; kopia :51515's
        # allow rides the same docker-DNAT path). Keep in lockstep with
        # wg_internal_edge_port (group_vars/vps.yml).
        iifname "wg-s2s" ip saddr {{ wg_s2s_vps.router_ip }} tcp dport {{ wg_internal_edge_port }} accept
        # ICMP ping (ops sanity) — limited
        ip protocol icmp icmp type echo-request accept

        # IPv6 stateless control traffic. `ip protocol icmp` just above is the
        # IPv4 upper-proto field, so it matches NOTHING for v6; under `policy drop` the
        # chain discards the provider router's neighbour-advertisement and
        # router-advertisement replies. Result: `ip -6 -s neigh show` pins at
        # `fe80::1 … FAILED`, so the v6 default route (statically configured by the netcup
        # image — `accept_ra=0`/`autoconf=0`, so NOT SLAAC) can never resolve a nexthop
        # and IPv6 is dead in BOTH directions, including the published AAAA.
        # The drop is OURS, not netcup's, and it is measurable rather than inferred: a
        # counter-only probe rule (`ip6 nexthdr icmpv6 counter`) counts the inbound NA/RA,
        # while `nstat Icmp6InNeighborAdvertisements` stays 0 — the netfilter verdict
        # precedes the ICMPv6 handler. Same instrument as the home punch discriminator
        # (network-ops.md §IPv6), opposite verdict.
        # This opens no service surface: it is what lets the box see packets at all.
        # NDP is scoped to link-local sources because RFC 4861 requires ND to be
        # link-local-sourced; the ICMPv6 error types are deliberately NOT scoped — a
        # `packet-too-big` arrives from an upstream router with a GLOBAL address, and
        # black-holing it is the classic silent-v6 breakage (PMTUD). MLD rides nexthdr 0,
        # not 58, so it cannot share the icmpv6 rule.
        # ⚠ Second-order effect, and it is decided: KEEP the parity. The
        # `tcp dport 22/443`, `udp dport 51820` and RustDesk accepts are family-agnostic in
        # this `inet` table, so they are IPv4-only *in practice* only while NDP does not
        # resolve; when it does they are reachable over v6 as well, and they are NOT scoped
        # `meta nfproto ipv4` — scoping them down is not an available safety improvement.
        # The duty therefore sits on the proof: a real IPv6 client address must reach a ban
        # log. Where a listener binds dual-stack it does (`:22` — sshd on `[::]:22`, real
        # home-prefix client addresses in the log the sshd jail reads); where the publish is
        # v4-only it cannot yet be shown (`:443` — nothing binds `[::]:443`).
        # The `ip saddr …` rules (DNS
        # source-allow, wg-s2s scoping) stay IPv4-only by the shape of the match itself.
        # Proof and state: network-ops.md §IPv6.
        meta l4proto icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } ip6 saddr fe80::/10 accept
        meta l4proto icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
        meta l4proto icmpv6 icmpv6 type echo-request accept
        ip6 nexthdr 0 ip6 saddr fe80::/10 accept comment "MLD: nexthdr 0; nft lists this value as 'ip' (IPPROTO_IP) - it is NOT IPv4"

        # Docker containers that publish host ports — RustDesk is the FIRST exception to
        # the old "none expected by policy (compose uses traefik-public only)" note: hbbs/hbbr run
        # `network_mode: host` because UDP rendezvous + TCP hole punching need the real source
        # address (docker's userland proxy SNAT would destroy it), so there is no DNAT path and this
        # chain is the only gate. See the allow below.
        # RustDesk family-support server: hbbs 21115/tcp (NAT-type test) + 21116/tcp+udp
        # (rendezvous/heartbeat/hole-punch), hbbr 21117/tcp (relay). Open to the world BY DESIGN:
        # the family machines must reach this introduction point from networks we do not control,
        # so the gate is the shared server keypair (ENCRYPTED_ONLY=1 -> `-k _` on BOTH hbbs and
        # hbbr), not the source address. NO `limit rate` here on purpose: a silent drop under a
        # burst is a dead support session, which is the failure this service exists to prevent.
        # ⛔ 21118/21119 (hbbs/hbbr WebSocket, web-client only) stay DELIBERATELY absent: we run no
        # web client, and upstream trusts unvalidated X-Real-IP/X-Forwarded-For on those ports, so
        # exposing them would let anyone forge the client IP in our logs and skip IP-based blocking.
        # Ports are upstream constants (the container is launched without -p); they are mirrored in
        # templates/docker_services/rustdesk-server/ rather than a group_vars var because a
        # docker_services compose render cannot read vps.yml vars.
        tcp dport { 21115, 21116, 21117 } accept
        udp dport 21116 accept
        # RouterOS remote syslog receiver: rsyslog binds UDP/514 on the
        # wg-s2s VPS address (wg_s2s_vps.ip) and the RB4011 forwards RFC5424
        # syslog there over the tunnel (src = wg_s2s_vps.router_ip, the router
        # wg-s2s side). Scoped: UDP/514 accepted ONLY from that tunnel peer —
        # everything else still dropped (no public/loose syslog surface).
        iifname "wg-s2s" ip saddr {{ wg_s2s_vps.router_ip }} udp dport 514 accept

        # DNS resolver (Technitium PRIMARY, Option A): the VPS publishes
        # host :53/udp+tcp. Source-allow ONLY tailnet CGNAT (100.64.0.0/10) + home
        # WAN (DDNS s.kogler.si — resolved + refreshed by the ansible-managed
        # systemd timer dns-allow-refresh.service). Everything else stays dropped
        # (abuse/amplification surface is the reason this is scoped, not open).
        ip saddr 100.64.0.0/10 udp dport 53 accept     # tailnet (headscale CGNAT)
        ip saddr 100.64.0.0/10 tcp dport 53 accept
        # Home WAN source (DDNS): the timer writes the current A into the
        # dns-allow-home set; accept matches set membership.
        ip saddr @dns-allow-home udp dport 53 accept
        ip saddr @dns-allow-home tcp dport 53 accept

        # Log dropped input at rate-limit (fail2ban / ops visibility)
        limit rate 5/minute log prefix "nft-drop-input: "
        counter drop
    }

    set dns-allow-home {
        type ipv4_addr
        flags interval
        # Populated by the dns-allow-refresh systemd timer (resolves s.kogler.si
        # DDNS A record so the home WAN source can query the DNS primary).
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # DNS PRIMARY published port (:53 -> container) is SOURCE-RESTRICTED here
        # (open-resolver exposure). Docker's published-port DNAT is
        # applied in PREROUTING and then FORWARDED to the container bridge, so the
        # host INPUT source-allow rules below can NEVER see those packets — external
        # traffic reaches the resolver via the generic `oifname "br-*" accept` below.
        # Gate it here instead (a drop in this chain is authoritative over Docker's
        # iptables accept: docker's accept does not lift a chain drop).
        # Allow ONLY tailnet CGNAT + home WAN (dns-allow-home set); drop the rest
        # (scanners / open-resolver probes / amplification source). Mirror of the
        # input rules; identical allow set.
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 ip saddr 100.64.0.0/10 accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 ip saddr 100.64.0.0/10 accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 ip saddr @dns-allow-home accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 ip saddr @dns-allow-home accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 counter drop
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 counter drop

        # Docker bridge forwarding: with br_netfilter loaded,
        # bridge-nf-call-iptables=1 routes CONTAINER↔CONTAINER frames through THIS
        # chain. Docker's custom bridges are named br-<hash> (compose/role-created),
        # so "docker*" (docker0 only) never matches them -> every peer packet falls
        # through to drop -> fleet-wide container isolation while the edge looks up.
        # Accept by interface prefix: docker0 + all br-* bridges. Docker's own
        # ip-filter table keeps inter-network isolation policy.
        iifname "br-*" accept
        oifname "br-*" accept
        iifname "docker*" accept
        oifname "docker*" accept
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

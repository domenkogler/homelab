#!/usr/sbin/nft -f
# nftables ruleset — VPS default-deny inbound (HD-154 / security.md §8)
# Allow: loopback, established/related, :443 (Traefik edge), :51820 (WireGuard S2S).
# Deny everything else inbound. Docker containers on isolated overlay networks
# (traefik-public/services-internal/db-internal) reach the internet via the host
# NAT (docker's own iptables/nftables chains), which this ruleset leaves intact —
# we only gate the HOST-facing input path.

# Scoped table replacement (HD-223 residual, 2026-08-23): this file must NEVER
# begin with 'flush ruleset' — that wipes ALL tables including docker's
# iptables-nft-programmed nat/filter chains until docker re-programs them (caused
# the fleet-wide NAT outage during Incident C recovery). Instead: declare an empty
# table (no-op if absent), delete it, then recreate it below — touching ONLY our
# own table, so docker-managed tables survive every apply and service restart.
table inet filter {}
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # Loopback
        iif lo accept

        # Established/related (outbound-initiated replies)
        ct state established,related accept

        # Public edge
        tcp dport 22 accept         # SSH (ansible-admin) — management path; HD-154 checklist gap found live 2026-08-22 (lockout)
        tcp dport 443 accept        # Traefik HTTPS (wildcard *.kogler.si)
        udp dport 51820 accept      # WireGuard S2S (wg-s2s, home router peer)
        # HD-333 (internal all-app edge, WG-S2S reach, Pkg F): the traefik-tailnet
        # internal edge publishes :4443 on the wg-s2s VPS address (docker compose
        # ports: wg_s2s_vps.ip -> container). Docker's PREROUTING DNAT preempts this
        # input chain, but the HD-313 vps-hardening pattern mandates an explicit
        # input allow scoped to the tunnel peer (defense-in-depth; kopia :51515's
        # allow rides the same docker-DNAT path). Keep in lockstep with
        # wg_internal_edge_port (group_vars/vps.yml).
        iifname "wg-s2s" ip saddr {{ wg_s2s_vps.router_ip }} tcp dport {{ wg_internal_edge_port }} accept
        # ICMP ping (ops sanity) — limited
        ip protocol icmp icmp type echo-request accept

        # Docker containers that publish host ports (e.g. via host network) —
        # none expected on the VPS by policy (compose uses traefik-public only).
        # RouterOS remote syslog receiver (HD-313): rsyslog binds UDP/514 on the
        # wg-s2s VPS address (wg_s2s_vps.ip) and the RB4011 forwards RFC5424
        # syslog there over the tunnel (src = wg_s2s_vps.router_ip, the router
        # wg-s2s side). Scoped: UDP/514 accepted ONLY from that tunnel peer —
        # everything else still dropped (no public/loose syslog surface).
        iifname "wg-s2s" ip saddr {{ wg_s2s_vps.router_ip }} udp dport 514 accept

        # DNS resolver (Technitium PRIMARY, HD-299 / Option A): the VPS publishes
        # host :53/udp+tcp. Source-allow ONLY tailnet CGNAT (100.64.0.0/10) + home
        # WAN (DDNS s.kogler.si — resolved + refreshed by the ansible-managed
        # systemd timer dns-allow-refresh.service). Everything else stays dropped
        # (abuse/amplification surface is the reason this is scoped, not open).
        ip saddr 100.64.0.0/10 udp dport 53 accept     # tailnet (headscale CGNAT)
        ip saddr 100.64.0.0/10 tcp dport 53 accept
        # Home WAN source (DDNS): the timer writes the current A into the
        # dns-allow-home set; accept matches set membership.
        ip saddr @dns-allow-home udp dport 53 accept
        ip saddr @dns-allow-home tcp dport 53 accept

        # Log dropped input at rate-limit (fail2ban / ops visibility)
        limit rate 5/minute log prefix "nft-drop-input: "
        counter drop
    }

    set dns-allow-home {
        type ipv4_addr
        flags interval
        # Populated by the dns-allow-refresh systemd timer (resolves s.kogler.si
        # DDNS A record so the home WAN source can query the DNS primary).
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # DNS PRIMARY published port (:53 -> container) is SOURCE-RESTRICTED here
        # (2026-09-08, open-resolver exposure). Docker's published-port DNAT is
        # applied in PREROUTING and then FORWARDED to the container bridge, so the
        # host INPUT source-allow rules below can NEVER see those packets — external
        # traffic reaches the resolver via the generic `oifname "br-*" accept` below.
        # Gate it here instead (a drop in this chain is authoritative over Docker's
        # iptables accept — proven by the 2026-08-23 fleet-wide isolation incident).
        # Allow ONLY tailnet CGNAT + home WAN (dns-allow-home set); drop the rest
        # (scanners / open-resolver probes / amplification source). Mirror of the
        # input rules; identical allow set.
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 ip saddr 100.64.0.0/10 accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 ip saddr 100.64.0.0/10 accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 ip saddr @dns-allow-home accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 ip saddr @dns-allow-home accept
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} udp dport 53 counter drop
        iifname != "br-*" oifname "br-*" ip daddr {{ tchnitium_dns_overlay_ip }} tcp dport 53 counter drop

        # Docker bridge forwarding (incident 2026-08-23): with br_netfilter loaded,
        # bridge-nf-call-iptables=1 routes CONTAINER↔CONTAINER frames through THIS
        # chain. Docker's custom bridges are named br-<hash> (compose/role-created),
        # so "docker*" (docker0 only) never matched them -> every peer packet fell
        # through to drop -> fleet-wide container isolation while the edge looked up.
        # Accept by interface prefix: docker0 + all br-* bridges. Docker's own
        # ip-filter table keeps inter-network isolation policy.
        iifname "br-*" accept
        oifname "br-*" accept
        iifname "docker*" accept
        oifname "docker*" accept
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

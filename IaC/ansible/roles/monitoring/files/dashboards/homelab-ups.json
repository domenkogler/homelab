{
  "title": "Homelab — UPS",
  "uid": "homelab-ups",
  "tags": ["homelab", "ups"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "type": "stat",
      "title": "Battery charge",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 20 },
            { "color": "green", "value": 50 }
          ]}
        }
      },
      "targets": [{ "refId": "A", "expr": "network_ups_tools_battery_charge", "instant": true }]
    },
    {
      "type": "stat",
      "title": "Runtime left",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "min",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "green", "value": 15 }
          ]}
        }
      },
      "targets": [{ "refId": "A", "expr": "network_ups_tools_battery_runtime / 60", "instant": true }]
    },
    {
      "type": "gauge",
      "title": "Load",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 85 }
          ]}
        }
      },
      "targets": [{ "refId": "A", "expr": "network_ups_tools_ups_load", "instant": true }]
    },
    {
      "type": "stat",
      "title": "Output voltage",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "volt" } },
      "targets": [{ "refId": "A", "expr": "network_ups_tools_output_voltage", "instant": true }]
    },
    {
      "type": "stat",
      "title": "Battery voltage",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "volt" } },
      "targets": [{ "refId": "A", "expr": "network_ups_tools_battery_voltage", "instant": true }]
    },
    {
      "type": "stat",
      "title": "Status",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0 },
            { "color": "red", "value": 1 }
          ]}
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.width", "value": 0 },
              { "id": "custom.hide", "value": true }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (flag) (network_ups_tools_ups_status{flag=~\"OL|OB|LB|RB\"})",
          "legendFormat": "{{flag}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Output voltage over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "volt" } },
      "targets": [
        { "refId": "A", "expr": "network_ups_tools_output_voltage", "legendFormat": "output" }
      ]
    }
  ]
}
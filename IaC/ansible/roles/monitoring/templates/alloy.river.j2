// Alloy configuration — auto-generated by Ansible monitoring role
// See docs/observability.md for architecture.
// Source of truth: IaC/ansible/roles/monitoring/templates/alloy.river.j2

// ---- Host metrics (node_exporter replacement) ----
prometheus.exporter.unix "host" {
    // Default collectors enabled — disk, cpu, load, memory, network, filesystem
    set_collectors = [
        "cpu",
        "diskstats",
        "loadavg",
        "meminfo",
        "netdev",
        "filefd",
        "filesystem",
        "stat",
        "time",
        "uname",
    ]
}

// ---- Docker container logs (via docker.sock) ----
loki.source.docker "container_logs" {
    host = "/var/run/docker.sock"
    targets = []
    forward_to = [loki.process.cleanup]
}

// Clean up log entries — remove noisy fields, parse standard formats
loki.process "cleanup" {
    stage.drop {
        source = "container_name"
        value  = "loki"
    }
    forward_to = [loki.write.local]
}

// ---- Prometheus remote write (metrics → Prometheus) ----
prometheus.remote_write "metrics" {
    endpoint {
        url = "http://127.0.0.1:9090/api/v1/write"

        // Basic queue settings
        queue_config {
            max_samples_per_send = 500
            capacity             = 5000
        }
    }
}

// ---- Loki push (logs → Loki) ----
loki.write "local" {
    endpoint {
        url = "http://127.0.0.1:3100/loki/api/v1/push"

        // Retry config
        retry {
            enabled = true
            min_period = "1s"
            max_period = "30s"
        }
    }
}

// ---- MikroTik SNMP (router + switch — Mgmt VLAN 99, IPs from SSOT) ----
prometheus.exporter.snmp "mikrotik" {
    config_file = "/etc/alloy/snmp.yml"

    targets = [
        {"__address__" = "{{ (network_static_hosts | selectattr('name', 'equalto', 'router') | selectattr('vlan', 'equalto', 99) | first).ip }}", "auth" = "kogler_ro_v2", "module" = "mikrotik"},
        {"__address__" = "{{ (network_static_hosts | selectattr('name', 'equalto', 'switch') | selectattr('vlan', 'equalto', 99) | first).ip }}", "auth" = "kogler_ro_v2", "module" = "mikrotik"},
    ]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// ---- Host metrics → remote_write ----
prometheus.scrape "host_metrics" {
    targets = [
        {"__address__" = "127.0.0.1:{{ alloy_host_metrics_port | default(9998) }}", "job" = "alloy-host", "instance" = "{{ inventory_hostname }}"},
    ]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Wire the unix exporter into the scrape chain
prometheus.exporter.unix "host" {
    // This is wired into the scrape above via port
}
// Note: the unix exporter's listen port is set via CLI flag in the systemd service
// Alloy configuration — auto-generated by Ansible monitoring role
// See docs/observability.md for architecture.
// Source of truth: IaC/ansible/roles/monitoring/templates/alloy.river.j2
//
// Victoria* migration (HD-342): this is the SINGLE scrape + collect tier (topology (B)).
// All scraping happens HERE (host Alloy agents); VictoriaMetrics on the VPS is PURE
// storage/query (no -promscrape.config). Each Alloy remote_writes its scrapes to VM
// at :8428/api/v1/write, and pushes logs to VictoriaLogs at :9428. Grafana queries
// VM/VL on db-internal.
//
// Topology split:
//   VPS Alloy  (alloy_backend_host=127.0.0.1): scrapes VPS-container loopback metrics
//               (traefik:8082, crowdsec:6060, n8n:5678, blackbox-exporter:9115),
//               blackbox probes (http/icmp/wg_icmp via blackbox-exporter:9115),
//               VM self (/metrics 8428), VL self (/metrics 9428), alloy_self.
//   OLDSRV Alloy (alloy_backend_host=wg_s2s_vps.ip): scrapes home exporters
//               (nut_exporter, zfs_exporter on nas), network_clients (HD-343), SNMP
//               (router/switch), and remote_writes home telemetry to the VPS backend.
{% if inventory_hostname == 'spark.kogler.si' %}
// ---- HD-420 hot-set matchers (spark only) ---------------------------------------------
// ONE regex per family, emitted TWICE: as `keep` by the hot 5 s job and as the exact
// complement `drop` by the 60 s cold job on the same target. Two hand-copied lists drift;
// one Jinja string cannot. Disjointness is load-bearing (docs/observability.md §Scrape
// cadence): an overlapping series would arrive at two cadences under identical labels, and
// the only cure is -dedup.minScrapeInterval=5s on the VPS — a shared flag that silently
// re-tunes dedup for every host. With disjoint sets the SERIES NAMES ARE UNCHANGED, so no
// dashboard query and no alert rule changes.
// `source_labels` + the default `separator = ";"` means an absent label contributes the
// empty string, so the trailing `;` on the no-label alternatives is what keeps
// node_cpu_seconds_total{mode!="idle"} OUT of the hot set (140 of its 160 series stay cold —
// the CPU panel's formula reads only mode="idle", 20 series).
// Side effect that is NOT incidental: a `keep` on __name__ also drops each job's own
// bookkeeping (`up`, scrape_samples_*), so `up{job="alloy"}` and the scrape_* series are
// emitted by the COLD job alone and never duplicate.
{% set hot_host = 'node_cpu_seconds_total;idle|node_load(?:1|5);|node_memory_(?:CmaFree|MemAvailable|MemFree|MemTotal|Buffers|Cached|Shmem|SwapCached)_bytes;' %}
{% set hot_vllm = 'vllm:(?:generation_tokens_total|kv_cache_usage_perc|num_preemptions_total|num_requests_running|num_requests_waiting|num_requests_waiting_by_reason|prefix_cache_hits_total|prefix_cache_queries_total|prompt_tokens_by_source_total|prompt_tokens_cached_total|prompt_tokens_total)' %}
{% endif %}

// ---- Host metrics (node_exporter replacement) ----
prometheus.exporter.unix "host" {
    // Explicit collector set (NOT the node_exporter default): everything the
    // dashboards query. `diskstats` carries the disk I/O/throughput series
    // (HD-378) and `hwmon`/`thermal_zone` carry the sensor temperatures — both
    // were missing while Host Overview showed capacity only.
    // hwmon on spark emits chip="nvme_nvme0" (Composite/max/crit) + chip=
    // "thermal_thermal_zone0" (7 acpitz zones) + the mt7925 WiFi PHY; verified
    // against a local node_exporter run on spark, 2026-09-16. It reads
    // /sys/class/hwmon, which exists today with no extra software — the GB10
    // GPU die temperature is NOT in there (no nvidia hwmon chip), that rides
    // DCGM. See docs/observability.md §Host sensors.
    set_collectors = [
        "cpu",
        "diskstats",
        "loadavg",
        "meminfo",
        "netdev",
        "filefd",
        "filesystem",
        "hwmon",
        "thermal_zone",
        "stat",
        "time",
        "uname",
    ]
}

// Consume the host exporter so it actually runs. Alloy components are LAZY: an
// unconsumed exporter collects nothing, which is why VM had zero node_* series
// and Host Overview rendered empty despite `alloy_self` scraping the server
// /metrics. Tag job="alloy" + instance=<host> to match the dashboards
// (node_*{job="alloy"}) and the $instance template variable.
discovery.relabel "host_metrics" {
    targets = prometheus.exporter.unix.host.targets
    rule {
        target_label = "job"
        replacement  = "alloy"
    }
    rule {
        target_label = "instance"
        replacement  = "{{ inventory_hostname }}"
    }
}

prometheus.scrape "host_metrics" {
    targets    = discovery.relabel.host_metrics.output
{% if inventory_hostname == 'spark.kogler.si' %}
    // HD-420: on spark the cold job passes through a drop of the hot set (next block), so the
    // 5 s job below is the ONLY source of those series. On nas/oldsrv/pi/vps the target and
    // forward path are byte-identical to before — the drop is spark-GATED on purpose: the same
    // rule applied fleet-wide would delete node_load1, node_memory_CmaFree_bytes and
    // cpu mode="idle" from every other host, which have no hot job to replace them.
    forward_to = [prometheus.relabel.host_metrics_cold.receiver]
{% else %}
    forward_to = [prometheus.remote_write.metrics.receiver]
{% endif %}
}

{% if inventory_hostname == 'spark.kogler.si' %}
prometheus.relabel "host_metrics_cold" {
    rule {
        source_labels = ["__name__", "mode"]
        regex         = "{{ hot_host }}"
        action        = "drop"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// ---- HD-420 hot host job (spark only) — 5 s ------------------------------------------
// The same exporter target, scraped again. Its job/instance are shaped by its OWN
// discovery.relabel to the SAME values the cold job uses (job="alloy",
// instance=<inventory_hostname>), because that is what every dashboard and the two OOM alert
// rules in vars/main.yml select on — a distinct hot job label would silently unmatch them.
// scrape_timeout 3 s is explicit: at 5 s cadence Alloy's 10 s default would let one hung
// scrape block the cycle.
discovery.relabel "host_metrics_hot" {
    targets = prometheus.exporter.unix.host.targets
    rule {
        target_label = "job"
        replacement  = "alloy"
    }
    rule {
        target_label = "instance"
        replacement  = "{{ inventory_hostname }}"
    }
}

prometheus.scrape "host_metrics_hot" {
    targets         = discovery.relabel.host_metrics_hot.output
    scrape_interval = "5s"
    scrape_timeout  = "3s"
    forward_to      = [prometheus.relabel.host_metrics_hot.receiver]
}

prometheus.relabel "host_metrics_hot" {
    rule {
        source_labels = ["__name__", "mode"]
        regex         = "{{ hot_host }}"
        action        = "keep"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endif %}
// ---- Docker container logs (via Docker JSON log files, port-independent) ----
// DISCOVERY: Alloy's `discovery.docker` only emits targets for containers with host
// port mappings — our fleet is internal-only (no published ports), so it found 0.
// Instead, glob the Docker daemon's JSON log files on disk (they exist for every
// container regardless of ports) with loki.source.file's built-in file_match.
// The `alloy` user reads them via the `docker` group (monitoring role grants g+rX
// on /var/lib/docker/containers).
loki.source.file "container_logs" {
    targets = [{
        __path__ = "/var/lib/docker/containers/*/*-json.log",
    }]
    forward_to = [loki.process.cleanup.receiver]
    file_match {
        enabled     = true
        sync_period = "10s"
    }
}

// Clean up log entries: stage.docker is the purpose-built parser for Docker JSON
// log files — it unpacks `log` (becomes the line), `stream` (label), `time`
// (timestamp), and rewrites the entry. Nothing to hand-parse.
loki.process "cleanup" {
    stage.docker {}
    forward_to = [loki.write.local.receiver]
}

// ---- RouterOS syslog file -> VictoriaLogs (HD-313) ----
// The VPS host rsyslog receiver writes /var/log/remote-syslog/routeros.log
// (RFC5424 from the RB4011 over wg-s2s — provisioned by the monitoring role).
// CrowdSec tails it for WAF/port-scan; VictoriaLogs must ALSO index it for search
// (docs/observability.md SSOT matrix: RouterOS logs -> log store 90d). Only the VPS
// (backend host) holds the file (runs rsyslog; oldsrv collector does not).
// The line is written by rsyslog with trailing newlines; stage.regex drops the
// RFC5424 framing noise but keeps the raw message as the searchable body.
{% if inventory_hostname == 'vps.kogler.si' %}
loki.source.file "routeros_syslog" {
    targets = [{
        __path__ = "/var/log/remote-syslog/routeros.log",
    }]
    forward_to = [loki.process.routeros.receiver]
    file_match {
        enabled     = true
        sync_period = "10s"
    }
}

loki.process "routeros" {
    // RFC5424: <PRI>VERSION TIMESTAMP HOSTNAME APP PROCID MSGID [SD] MSG
    // Keep the whole line as body; label the source for querying (job=routeros-syslog).
    stage.regex {
        expression = "(?P<routeros_msg>.+)"
    }
    stage.labels {
        values = {
            job = "routeros-syslog",
        }
    }
    forward_to = [loki.write.local.receiver]
}
{% endif %}

// ---- Prometheus remote write (metrics → VictoriaMetrics :8428) ----
// Topology (B): Alloy is the ONLY scrape tier; VM is pure storage/query.
prometheus.remote_write "metrics" {
    endpoint {
        url = "http://{{ alloy_backend_host | default('127.0.0.1') }}:8428/api/v1/write"

        // HD-342: VM basic auth via the new victoria-metrics_api item (plaintext -httpAuth).
        basic_auth {
            username = "{{ lookup('community.general.onepassword', 'victoria-metrics_api', field='username', vault=op_vault) }}"
            password = "{{ lookup('community.general.onepassword', 'victoria-metrics_api', field='password', vault=op_vault) }}"
        }

        // Basic queue settings
        queue_config {
            max_samples_per_send = 500
            capacity             = 5000
        }
    }
}

// ---- VictoriaLogs push (logs → VL :9428, Loki-compatible endpoint) ----
// VictoriaLogs accepts the Loki push protocol at POST /insert/loki/api/v1/push.
loki.write "local" {
    endpoint {
        url = "http://{{ alloy_backend_host | default('127.0.0.1') }}:9428/insert/loki/api/v1/push"

        // HD-342: VL basic auth via the new victoria-logs_api item.
        basic_auth {
            username = "{{ lookup('community.general.onepassword', 'victoria-logs_api', field='username', vault=op_vault) }}"
            password = "{{ lookup('community.general.onepassword', 'victoria-logs_api', field='password', vault=op_vault) }}"
        }
    }
}

// ---- MikroTik SNMP (router + switch — Mgmt VLAN 99, IPs from SSOT) ----
// Scraped only by the OLDSRV Alloy (home LAN/Mgmt reach) to avoid duplicate collectors;
// it forwards the SNMP series to the VPS backend like all other home telemetry.
// HD-347: ONE exporter per device — the old single exporter merged router+switch series
// under one flat instance, and the target `name` label is NOT copied to the metrics (verified
// live), so an instance relabel by name is impossible. Splitting per device stays right.
// HD-345 (2026-09-22) corrects the rest of that claim: splitting does NOT give
// instance="router" "for free". Measured in VM, last 1 h: 54 router + 54 switch series of
// ifAdminStatus/ifOperStatus ARE arriving, plus up{job="integrations/snmp/router"}=present —
// the walk was never broken. What is on them is
//   job="integrations/snmp/<dev>"  instance="prometheus.exporter.snmp.<dev>"
// i.e. the component path, and the inline "job" = "alloy-snmp" on the target is OVERWRITTEN by
// Alloy's snmp exporter. Nothing in the walk config, the community or the router can explain
// a label; a post-scrape relabel that REPLACES both is the fix, in this file.
{% if inventory_hostname == 'oldsrv.kogler.si' %}
{% for dev in ['router', 'switch'] %}
prometheus.exporter.snmp "{{ dev }}" {
    config_file = "/etc/alloy/snmp.yml"

    targets = [{
        "__address__" = "{{ (network_static_hosts | selectattr('name', 'equalto', dev) | selectattr('vlan', 'equalto', 99) | first).ip }}",
        "name" = "{{ dev }}",
        "auth" = "kogler_ro_v2",
        "module" = "mikrotik",
        "job" = "alloy-snmp",
    }]
}

prometheus.scrape "snmp_{{ dev }}" {
    targets = prometheus.exporter.snmp.{{ dev }}.targets
    forward_to = [prometheus.relabel.snmp_{{ dev }}.receiver]
}

// HD-345: re-assert the labels the exporters overwrite. No source_labels + the default
// replace action is the standard Prometheus idiom for "set this label" (empty input matches
// the default `(.*)` regex, so `replacement` wins). It lands on every series the scrape
// forwards, `up` included, so `up{job="alloy-snmp", instance="{{ dev }}"}` is the liveness
// query a dashboard or rule can actually write.
prometheus.relabel "snmp_{{ dev }}" {
    rule {
        target_label = "job"
        replacement  = "alloy-snmp"
    }
    rule {
        target_label = "instance"
        replacement  = "{{ dev }}"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endfor %}


// Consume the SNMP exporters so they actually run (Alloy components are LAZY — an
// unconsumed exporter evaluates nothing and its metrics never reach VM). Tag the
// series with job="alloy-snmp" + the per-device instance (from the component id).

// ---- Network-clients exporter (HD-343) — RouterOS-API collector on oldsrv ----
// The network-clients-exporter host binary polls the router read-only API and
// exposes mikrotik_client / mikrotik_static_host on 127.0.0.1:9097. Scrape it
// inside the same process and remote-write to the VPS backend (same channel as SNMP).
prometheus.scrape "network_clients" {
    targets = [{
        "__address__" = "127.0.0.1:{{ network_clients_listen | default(9097) }}",
        "job" = "network-clients",
        "instance" = "{{ inventory_hostname }}",
    }]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// ---- Home exporters (nut + zfs on nas) — OLDSRV Alloy (home LAN reach) ----
// The old Prometheus scraped these from the VPS over the WG tunnel; now the home
// collector scrapes them locally (topology (B), home LAN) and remote_writes to VM.
prometheus.scrape "nut_exporter" {
    targets = [{
        "__address__" = "{{ nut_exporter_host }}:{{ nut_exporter_port }}",
        "job" = "nut_exporter",
    }]
    // DRuggeri/nut_exporter v3: emits only on /ups_metrics?ups=<name> (plain /metrics
    // is empty). Keep the metrics_path + ups param the old job used.
    metrics_path = "/ups_metrics"
    params = {
        ups = ["{{ nut_ups_name | default('powerwalker') }}"],
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

prometheus.scrape "zfs_exporter" {
    targets = [{
        "__address__" = "{{ zfs_exporter_host }}:{{ zfs_exporter_port }}",
        "job" = "zfs_exporter",
    }]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// ---- HA exporter (edge HA /api/prometheus). GATED until Phase 4 ----
// (prometheus_ha_exporter, Wave-2 triage 2026-08-22): no HA behind ha_vip + no token
// file pre-cutover. Flip the var at HD-04 with the HA token + compose mount.
{% if prometheus_ha_exporter | default(false) %}
prometheus.scrape "ha_exporter" {
    targets = [{
        "__address__" = "{{ ha_vip }}:8123",
        "job" = "ha_exporter",
    }]
    metrics_path = "/api/prometheus"
    bearer_token_file = "/etc/prometheus/ha_token"
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endif %}
{% endif %}  {# ends oldsrv-only block #}

// ---- VPS Alloy: VPS-container loopback metrics + blackbox probes + self-scrapes ----
// Only the VPS host-APT Alloy reaches these loopback publishes (traefik/crowdsec/n8n/
// blackbox-exporter on 127.0.0.1) and the VM/VL self-scrape endpoints. See STEP-5
// loopback publishes (HD-342).
{% if inventory_hostname == 'vps.kogler.si' %}
// blackbox-exporter self-scrape (/metrics)
prometheus.scrape "blackbox_exporter" {
    targets = [{
        "__address__" = "127.0.0.1:9115",
        "job" = "blackbox-exporter",
    }]
    metrics_path = "/metrics"
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// HTTP probes for web services (via blackbox-exporter :9115 /probe) — valid blackbox
// target pattern: __address__ = the blackbox exporter, params.target = the probed URL.
// (The old config used the URL as __address__ → Alloy rejected it as an invalid
// hostname, so no http/2xx probe ever ran → Service Reachability empty.)
prometheus.scrape "blackbox_http_probes" {
    targets = [
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://kogler.si", "__param_module" = "http_2xx"},
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://sso.kogler.si", "__param_module" = "http_2xx"},
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://foto.kogler.si", "__param_module" = "http_2xx"},
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://file.kogler.si", "__param_module" = "http_2xx"},
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://git.kogler.si", "__param_module" = "http_2xx"},
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_http_probes", "__param_target" = "https://ha.kogler.si", "__param_module" = "http_2xx"},
    ]
    metrics_path = "/probe"
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// ICMP probes (router + switch on Mgmt VLAN; nas/oldsrv/pi on Home VLAN — IPs from SSOT)
// Valid blackbox pattern: __address__ = the blackbox exporter, __param_target = the IP.
// (Old config used the device IP as __address__ → Alloy scraped the device:9115 and
// failed → up{job=blackbox_icmp}=0, no probe_* series.)
prometheus.scrape "blackbox_icmp" {
    targets = [
{% for hostname in ['router', 'switch'] %}
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_icmp", "__param_target" = "{{ (network_static_hosts | selectattr('name', 'equalto', hostname) | selectattr('vlan', 'equalto', 99) | first).ip }}"},
{% endfor %}
{% for hostname in ['nas', 'oldsrv', 'pi'] %}
        {"__address__" = "127.0.0.1:9115", "job" = "blackbox_icmp", "__param_target" = "{{ (network_static_hosts | selectattr('name', 'equalto', hostname) | selectattr('vlan', 'equalto', 10) | first).ip }}"},
{% endfor %}
    ]
    metrics_path = "/probe"
    params = {
        module = ["icmp"],
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// wg-s2s tunnel-liveness (HD-159): single ICMP probe to the home router's WG-side peer IP.
prometheus.scrape "wg_icmp" {
    targets = [
        {"__address__" = "127.0.0.1:9115", "job" = "wg_icmp", "__param_target" = "{{ wg_s2s_vps.router_ip }}"},
    ]
    metrics_path = "/probe"
    params = {
        module = ["icmp"],
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Service self-metrics: traefik (loopback publish :8082)
prometheus.scrape "traefik" {
    targets = [{
        "__address__" = "127.0.0.1:8082",
        "job" = "traefik",
    }]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Service self-metrics: crowdsec (loopback publish :6060)
prometheus.scrape "crowdsec" {
    targets = [{
        "__address__" = "127.0.0.1:6060",
        "job" = "crowdsec",
    }]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Service self-metrics: n8n (loopback publish :5678, N8N_METRICS)
prometheus.scrape "n8n" {
    targets = [{
        "__address__" = "127.0.0.1:5678",
        "job" = "n8n",
    }]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Self-monitoring: VictoriaMetrics self-scrape (/metrics on 8428)
// HD-347: the scrape needs the same basic_auth as remote_write — VM runs with
// -httpAuth (victoria-metrics_api item), so without auth every scrape is 401 and
// up{job="victoria-metrics"} was permanently 0 (masking the real signal; the old
// `gt 0` evaluator hid it too — see grafana-rules.yml.j2).
prometheus.scrape "vm_self" {
    targets = [{
        "__address__" = "127.0.0.1:8428",
        "job" = "victoria-metrics",
    }]
    // HD-342: same victoria-metrics_api basic auth the Grafana datasource + remote_write use.
    basic_auth {
        username = "{{ lookup('community.general.onepassword', 'victoria-metrics_api', field='username', vault=op_vault) }}"
        password = "{{ lookup('community.general.onepassword', 'victoria-metrics_api', field='password', vault=op_vault) }}"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// Self-monitoring: VictoriaLogs self-scrape (/metrics on 9428)
// HD-347: same basic_auth fix as vm_self — VL requires auth on /metrics.
prometheus.scrape "vl_self" {
    targets = [{
        "__address__" = "127.0.0.1:9428",
        "job" = "victoria-logs",
    }]
    basic_auth {
        username = "{{ lookup('community.general.onepassword', 'victoria-logs_api', field='username', vault=op_vault) }}"
        password = "{{ lookup('community.general.onepassword', 'victoria-logs_api', field='password', vault=op_vault) }}"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endif %}

// ---- vLLM engine metrics (spark GPU node) — HD-368 ----------------
// vLLM exposes its Prometheus metrics on the OpenAI API server /metrics
// (same :8000 port as the API — vllm.usage.metrics, PrometheusStatLogger,
// no separate metrics port). The vLLM dashboards (homelab-vllm-*) query the
// vllm:* metric family tagged with model_name (vLLM-native) + instance
// (ours — the scrape target carries it, like the snmp/network-clients jobs).
// The spark-ai compose publishes :8000 on the spark host loopback only
// (spark_metrics_publish — same pattern as traefik's 127.0.0.1:8082, HD-315);
// this job is the engine half of the pipeline and sits in the spark Alloy.
{% if inventory_hostname == 'spark.kogler.si' and spark_metrics_publish | default(false) %}
prometheus.scrape "vllm" {
    targets = [{
        "__address__" = "127.0.0.1:8000",
        "job" = "vllm",
        "instance" = "spark.kogler.si",
    }]
    forward_to = [prometheus.relabel.vllm_cold.receiver]
}

// HD-420 cold half: the 60 s engine job drops the hot names, so the 5 s job is their only
// source. Everything the panels do NOT name (the 309 request-completion-driven `_bucket{}`
// histogram lines, request_success, time-to-first-token histograms …) stays at 60 s — that
// exclusion is what makes the change ~95 MB/yr instead of ~3.4 GB (docs §What resolution costs).
prometheus.relabel "vllm_cold" {
    rule {
        source_labels = ["__name__"]
        regex         = "{{ hot_vllm }}"
        action        = "drop"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}

// HD-420 hot half: the same endpoint at 5 s, keeping the 11 `vllm:` names the nine panels
// read (15 series with the source=/reason= label values). No engine change is involved:
// measured, `vllm:generation_tokens_total` advanced on every one of 17 consecutive 1 s
// scrapes, so VLLM_LOG_STATS_INTERVAL is the LOG heartbeat, not a publication cap.
prometheus.scrape "vllm_hot" {
    targets = [{
        "__address__" = "127.0.0.1:8000",
        "job" = "vllm",
        "instance" = "spark.kogler.si",
    }]
    scrape_interval = "5s"
    scrape_timeout  = "3s"
    forward_to      = [prometheus.relabel.vllm_hot.receiver]
}

prometheus.relabel "vllm_hot" {
    rule {
        source_labels = ["__name__"]
        regex         = "{{ hot_vllm }}"
        action        = "keep"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endif %}

// ---- DCGM GPU exporter (HD-379) — spark loopback ----
// The GB10's ONLY GPU telemetry source (the host sensors in `hwmon` are SoC/NVMe/WiFi; there is
// no nvidia hwmon chip). Same loopback-publish pattern as the `vllm` job above: the compose
// service `spark-dcgm` binds 127.0.0.1:9400 and this job remote-writes the kept series to VM.
//
// The relabel is the METRIC POLICY, and it is load-bearing. The exporter emits 13 series on
// this device, measured 2026-09-16: six are real, the rest are constant-zero or actively wrong
// (MEMORY_TEMP reports 0 while the drive next to it reports 46 C). Keeping a whitelist here —
// instead of a counter CSV inside the image — means the selection is reviewable in one place:
//   KEEP  GPU_UTIL (88-90 % under load) · GPU_TEMP (50-58 C) · POWER_USAGE (12-39 W) ·
//         TOTAL_ENERGY_CONSUMPTION (mJ) · SM_CLOCK (MHz) · XID_ERRORS · PCIE_REPLAY_COUNTER
//   DROP  MEMORY_TEMP (bogus 0) · MEM_COPY_UTIL / ENC_UTIL / DEC_UTIL (always 0) ·
//         NVLINK_BANDWIDTH_TOTAL (no NVLink) · VGPU_LICENSE_STATUS (no vGPU)
// NEVER AVAILABLE (do not add): the DCP/profiling family — GR_ENGINE_ACTIVE / SM_ACTIVE /
// PIPE_TENSOR_ACTIVE / DRAM_ACTIVE / PCIE_TX_BYTES / PCIE_RX_BYTES — the module refuses to load
// on GB10 ("metric not enabled"; NVIDIA: no DCGM profiling on Spark), and FB_* (VRAM) does not
// exist on a unified-memory device. See docs/observability.md §LLM Dashboard (GPU).
{% if inventory_hostname == 'spark.kogler.si' %}
prometheus.scrape "dcgm" {
    targets = [{
        "__address__" = "127.0.0.1:{{ spark_dcgm_exporter_port }}",
        "job" = "dcgm",
        "instance" = "spark.kogler.si",
    }]
    // HD-420: 5 s. COUPLED PAIR — this cadence is only honest while
    // DCGM_EXPORTER_INTERVAL in templates/docker_services/spark-dcgm/docker-compose.yml.j2
    // is "5000"; at "30000" a 5 s scrape stores six copies of one sample. Neither file may
    // be reverted without the other. It needs no cold twin because the relabel below keeps
    // the exporter's ENTIRE whitelist (7 series) — the hot set and the job are the same set.
    scrape_interval = "5s"
    scrape_timeout  = "3s"
    forward_to = [prometheus.relabel.dcgm.receiver]
}

prometheus.relabel "dcgm" {
    rule {
        source_labels = ["__name__"]
        regex         = "DCGM_FI_DEV_(GPU_UTIL|GPU_TEMP|POWER_USAGE|TOTAL_ENERGY_CONSUMPTION|SM_CLOCK|XID_ERRORS|PCIE_REPLAY_COUNTER)"
        action        = "keep"
    }
    // The exporter stamps Hostname with the CONTAINER ID — it churns on every recreate and
    // reads as a host label without being one. `instance` above is the host identity.
    rule {
        regex  = "^Hostname$"
        action = "labeldrop"
    }
    forward_to = [prometheus.remote_write.metrics.receiver]
}
{% endif %}

// ---- Alloy host metrics (own /metrics) → remote_write ----
// The unix exporter (top of file) exposes host metrics on Alloy's OWN HTTP server
// /metrics (default listen 127.0.0.1:12345 — server.http.listen-addr). Scrape that
// inside the same process and remote-write the series to the VPS VM. There is
// NO per-exporter scrape port (the old `:9998` target was a phantom).
prometheus.scrape "alloy_self" {
    targets = [
        {"__address__" = "127.0.0.1:{{ alloy_metrics_port | default(12345) }}", "job" = "alloy", "instance" = "{{ inventory_hostname }}"},
    ]
    forward_to = [prometheus.remote_write.metrics.receiver]
}

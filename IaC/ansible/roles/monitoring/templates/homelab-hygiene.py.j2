#!/usr/bin/env python3
"""The things that can age out silently, turned into series.

Oldsrv's `traefik-cert-pull.timer` failed every 15 min for DAYS while the wildcard
pair sat on a 26-day-old copy, and nothing in the stack could see either half — a systemd unit's result is
not scraped at all, and the cert pair a CONSUMER holds is not exported anywhere (the one cert rule,
`ssl-cert-expiring`, reads `probe_ssl_earliest_cert_expiry`, which has ZERO series because blackbox emits
no SSL expiry). This exporter is the collector for both.

    homelab_unit_last_success{unit="traefik-cert-pull.service"}   1 | 0
    homelab_unit_result{unit="…", result="success|failed|missing"} 1
    homelab_cert_days_left{consumer="traefik-internal"}           44.2
    homelab_cert_pair_present{consumer="traefik-internal"}        1 | 0
    homelab_pkg_pin_ok{package="alloy"}                           1 | 0
    homelab_pkg_pin_result{package="…", pin="…", result="…", running="…"} 1
    homelab_upgrade_plan_ok                                       1 | 0
    homelab_upgrade_plan_count                                    <packages the plan would upgrade>
    homelab_reboot_required                                       1 | 0
    homelab_hygiene_scrape_ok                                     <unix ts of this collection>

The three `pkg`/`plan`/`reboot` series are the PIN-LAG report: what a host actually runs against what
`group_vars/all/versions.yml` pins, how far the box's own dependency solver is from that state, and
whether a kernel or library swap is still waiting on a reboot. It is the visibility half of a decision
that deliberately rejected an automated upgrade phase — an updater would make the pin advisory, and the
pin is the whole version truth. Nothing here is an updater: `dpkg-query -W` reads the status file without
ever taking the dpkg lock, the solver is invoked as `apt-get -s` (simulate), `apt-mark` is never called,
no unit is touched and nothing is written. The pin arrives as a RENDERED var, so the single copy of the
version stays in `versions.yml` and a bump reaches this report through the next monitoring converge —
which also means the report cannot be fresher than the converge that rendered it.

WHY A BINARY EXPORTER AND NOT A TEXTFILE FILE (the obvious cheaper shape): Alloy's
`prometheus.exporter.unix` here accepts a `textfile {}` block but rejects every attribute name that
would point it at a directory (`collectors_dir`, `directories`, `paths`, `files`, `syntax_version` —
probed against v1.20.1 on the box, each `unrecognized attribute name`, while `textfile {}` with no body
parses), so a textfile leg would have meant shipping the collector blind, to a default directory nobody
could name. This file therefore follows the shape the SAME role already proves live — the
network-clients exporter: a stdlib-only host binary on a loopback port, scraped by this host's Alloy.

FAIL-LOUD BY CONSTRUCTION, because a monitor that reports "healthy" about something it cannot see is how
a failure can go unseen for days:
  * a listed unit that does not EXIST reports last_success=0 with result="missing" — a unit that never
    runs is the purest form of the class, so being wrong about the list costs a visible alert, never
    silence;
  * a cert pair that is absent or unreadable emits `…_pair_present = 0` rather than a NaN days-left
    value: NaN parses, and `NaN < 14` is false, so a vanished pair would have read as "not expiring";
  * a pinned package the host does not carry reads `result="missing"`, not `"match"` — an empty
    `dpkg-query` answer is the one answer that must never look like "in sync with the pin";
  * a solver plan that cannot be read sets `homelab_upgrade_plan_ok = 0` and emits NO count, because a
    `0` there would be indistinguishable from "this box is fully current";
  * `homelab_hygiene_scrape_ok` is the collector's own heartbeat — this exporter is a systemd service,
    i.e. the same failure class, and `time() - heartbeat > 900` is the rule that watches itself.

Collection happens per scrape (`systemctl show`, `openssl x509 -enddate`, `dpkg-query`, one stat on
`/run/reboot-required` — single-digit ms each): no cache to go stale, no second timer to fail silently.
The one exception is the dependency-solver leg, which costs ~1 s and can wait on the dpkg lock: it runs
on its own thread and is served from cache, so no scrape ever waits for apt.
Read-only throughout, no writes.
"""
import datetime
import email.utils
import http.server
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.parse

UNITS = {{ monitoring_hygiene_units | to_json }}
CERTS = {{ monitoring_hygiene_certs | to_json }}
# The mapping is package -> the NAME of its versions.yml var (default: host_apt_pin_vars, the fleet map
# that also drives `apt-mark hold` and the `package=version` install). Each pin is resolved here from the
# var NAME, never typed into this file, and a pin var that does not exist aborts the render rather than
# reporting "no pin" about a healthy box. A pin with no dpkg revision is a FAMILY pin — see matches_pin().
PINS = [
{% for pkg, pin_var in monitoring_hygiene_pins.items() %}
    {"package": {{ pkg | to_json }}, "pin": {{ lookup('vars', pin_var) | to_json }}},
{% endfor %}
]
LISTEN = ("{{ monitoring_hygiene_listen }}", {{ monitoring_hygiene_port }})

# The solver leg only. Measured ~1.1 s of CPU per call on a server, so a 1-minute scrape cadence must
# not buy one per scrape; PLAN_RETRY re-reads sooner after a failed attempt so a transient wedged lock
# does not go unreported for a whole TTL.
PLAN_TTL = 900.0
PLAN_RETRY = 60.0
PLAN_TIMEOUT = 60.0
PLAN_LOCK = threading.Lock()
PLAN_CACHE: dict = {"next_at": 0.0, "lines": None, "refreshing": False}
PLAN_HEAD = [
    "# HELP homelab_upgrade_plan_ok 1 when a simulated upgrade plan has been read.",
    "# TYPE homelab_upgrade_plan_ok gauge",
    "# HELP homelab_upgrade_plan_count Packages `apt-get -s upgrade` would upgrade.",
    "# TYPE homelab_upgrade_plan_count gauge",
]


def show(unit: str) -> dict:
    """`systemctl show` for one unit as a dict (key=value lines; NOT `--value`, so a key the unit does
    not have stays distinguishable from an empty one). stderr is kept under `_err` so a failed
    invocation is explainable in the log instead of becoming a silent "healthy"."""
    r = subprocess.run(
        ["systemctl", "show", unit, "-p", "LoadState", "-p", "ActiveState", "-p", "Result"],
        capture_output=True, text=True, check=False,
    )
    out: dict = {"_err": (r.stderr or "").strip()[:140]}
    for line in (r.stdout or "").splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    return out


def sel(labels: str) -> str:
    """`{labels}` ASSEMBLED rather than written. This file is a Jinja template, so a literal brace
    followed by `%` anywhere in it is parsed as a statement — the first draft of this file failed the
    converge that proved it: a format placeholder that began with a brace-percent was parsed as a Jinja
    statement and the template died with `Encountered unknown tag 's'`."""
    return "{" + labels + "}"


def unit_lines(unit: str) -> list[str]:
    st = show(unit)
    load, active, result = st.get("LoadState", ""), st.get("ActiveState", ""), st.get("Result", "")
    if not load:
        # `systemctl show` gave nothing at all (bad sandboxing, a systemd we cannot talk to). Reporting
        # "success" here would be the fail-open version of the very bug this row hunts, so it alerts.
        print("WARN: no systemctl output for %s (%s)" % (unit, st.get("_err", "")), file=sys.stderr)
        ok, reason = 0, "unknown"
    elif load in ("not-found", "masked"):
        # Not "fine": nothing runs here, so nothing can fail. `masked` is included for the same reason
        # — the incident class here is a unit that answers "inactive" while doing no work.
        ok, reason = 0, "missing"
    elif active == "failed" or (result and result != "success"):
        ok, reason = 0, "failed"
    else:
        ok, reason = 1, result or "success"
    q = sel('unit="%s"' % unit)
    return [
        "# HELP homelab_unit_last_success 1 when the unit exists and its last run succeeded.",
        "# TYPE homelab_unit_last_success gauge",
        "homelab_unit_last_success%s %d" % (q, ok),
        'homelab_unit_result%s %s' % (sel('unit="%s", result="%s"' % (unit, reason)), "1"),
    ]


def _as_utc(value: str):
    """Both forms openssl prints, and neither may silently become a naive local-time datetime: a naive
    parse shifts the age by the host's UTC offset, which on a two-week threshold is a day of slop."""
    v = value.strip()
    for suffix in ("Z", " GMT", " UTC"):            # `-dateopt iso_8601` → "YYYY-MM-DD HH:MM:SSZ"
        if v.endswith(suffix):
            try:
                dt = datetime.datetime.fromisoformat(v[: -len(suffix)].strip().replace(" ", "T"))
                return dt if dt.tzinfo else dt.replace(tzinfo=datetime.timezone.utc)
            except ValueError:
                pass
    try:                                            # default form → "Nov 20 12:00:00 2026 GMT"
        dt = email.utils.parsedate_to_datetime(value)
        return dt if dt.tzinfo else dt.replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def cert_exdate(path: str) -> datetime.datetime:
    """notAfter of a PEM. `-dateopt iso_8601` keeps the parse unambiguous; the second attempt covers an
    openssl too old for the flag (openssl < 3.0 printed only the RFC-822-ish default form)."""
    base = ["openssl", "x509", "-in", path, "-noout", "-enddate"]
    err = ""
    for extra in (["-dateopt", "iso_8601"], []):
        r = subprocess.run(base + extra, capture_output=True, text=True, check=False)
        err = (r.stderr or "").strip()[:120]
        line = (r.stdout or "").strip()
        if "notAfter=" in line:
            dt = _as_utc(line.split("notAfter=", 1)[1])
            if dt:
                return dt
    raise ValueError("no parseable notAfter from %s (%s)" % (path, err))


def cert_lines(consumer: str, path: str) -> list[str]:
    q = sel('consumer="%s"' % consumer)
    head = [
        "# HELP homelab_cert_pair_present 1 when the cert pair this consumer edge loads exists.",
        "# TYPE homelab_cert_pair_present gauge",
        "# HELP homelab_cert_days_left Days until this consumer's cert pair expires.",
        "# TYPE homelab_cert_days_left gauge",
    ]
    if not os.path.isfile(path):
        return head + ["homelab_cert_pair_present%s 0" % q]
    try:
        days = (cert_exdate(path) - datetime.datetime.now(datetime.timezone.utc)).total_seconds() / 86400.0
    except Exception as exc:                        # unreadable / not a cert / clock nonsense
        print("WARN: %s: %s" % (path, exc), file=sys.stderr)
        return head + ["homelab_cert_pair_present%s 0" % q]
    return head + [
        "homelab_cert_pair_present%s 1" % q,
        "homelab_cert_days_left%s %.2f" % (q, days),
    ]


def dpkg_version(package: str) -> tuple[str, str]:
    """Installed version of one package, and an error string when there is none to read.
    `dpkg-query -W` reads `/var/lib/dpkg/status` and never takes the dpkg lock — the read this whole leg
    is built on, because a report that had to acquire the lock would be a report that can wait on (or
    interrupt) an install. An unspawnable binary is reported the same way as an unreadable answer: one
    missing tool must not take the other legs' scrape down with it. `LC_ALL=C` because the
    absent-package message is translated, and the branch below reads it — the same locale trap the
    solver leg documents."""
    try:
        r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", package], capture_output=True, text=True,
                           check=False, env=dict(os.environ, LC_ALL="C", LANG="C"))
    except OSError as exc:                          # no dpkg on this box
        return "", "spawn failed %s" % exc
    ver = (r.stdout or "").strip()
    if ver:
        return ver, ""
    return "", "rc=%d %s" % (r.returncode, (r.stderr or "").strip()[:140])


def dpkg_upstream(version: str) -> str:
    """The dpkg UPSTREAM version: everything before the LAST hyphen, where the Debian revision starts.
    `5:29.8.2-1~debian.13~trixie` and `5:29.8.2-1~ubuntu.24.04~noble` are the same release with two
    distro stamps, which is exactly why one fleet-wide pin can name only this part of the string."""
    return version.rsplit("-", 1)[0] if "-" in version else version


def matches_pin(pin: str, running: str) -> bool:
    """The comparison rule, stated once for the whole fleet. A pin that carries a dpkg revision (it has
    a hyphen — `alloy_version` = `1.20.1-1`) is a deb pin and compares EXACTLY. A pin that carries none
    is a FAMILY pin: it names the upstream version and lets the revision belong to the box, because one
    suite publishes the same release under two distro stamps — that compares on the upstream part.
    Equality either way: a box ahead of its pin is as broken as a box behind it. roles/docker asserts
    the same rule after installing the suite — one concept, one name, both places."""
    return running == pin if "-" in pin else dpkg_upstream(running) == pin


def pin_lines(package: str, pin: str) -> list[str]:
    """Running version vs the pin, as the unit leg already does it: one alertable gauge and one series
    that carries the WHY. Equality is the test, not ordering — the drift this reports has gone both ways
    in practice (a box ahead of its pin is as broken as a box behind it, and pinning a downgrade is
    never the fix), and the two version strings travel as labels so the reader can tell which way."""
    running, err = dpkg_version(package)
    if running:
        state = "match" if matches_pin(pin, running) else "differ"
    elif "no packages found" in err:
        # Not carried by this host at all — the honest reading of a fleet-wide list on one host, and
        # the reason a rule keys on result="differ" rather than on this gauge alone.
        state = "missing"
    else:
        # dpkg gave nothing explainable. "No version" must never collapse into "match".
        state = "unknown"
        print("WARN: dpkg-query %s: %s" % (package, err), file=sys.stderr)
    q = sel('package="%s"' % package)
    return [
        "# HELP homelab_pkg_pin_ok 1 when the installed version matches the versions.yml pin.",
        "# TYPE homelab_pkg_pin_ok gauge",
        "homelab_pkg_pin_ok%s %d" % (q, 1 if state == "match" else 0),
        'homelab_pkg_pin_result%s %s'
        % (sel('package="%s", pin="%s", result="%s", running="%s"' % (package, pin, state, running)), "1"),
    ]


def _plan_read() -> list[str]:
    """The one blocking call: `apt-get -s upgrade`, i.e. this box's OWN solver asked what it would do.

    Three things make the read non-obvious, all of them load-bearing:
      * `-s` is the whole safety story: apt prints its plan and executes nothing. Never add `-y`, never
        drop `-s`, never set `apt::get::simulate=false` — that last one turns the call into a real
        upgrade attempt (measured: it fails asking for the dpkg lock, which is the only reason an
        unprivileged operator ever survives typing it).
      * `apt::get::show-upgraded=false` keeps the summary line and drops the per-package list, so the
        call costs ~1 s instead of dragging thousands of package names through a pipe.
      * `LC_ALL=C` because the summary line is TRANSLATED: on this fleet's locale the whole output is
        Slovene and only the `Inst`/`Conf` tokens stay English, so parsing without forcing the locale
        would find no count and report it as "nothing pending" — the fail-open half of the bug class.

    A HELD package does not appear in this count (the solver keeps it back instead); the pin legs are
    what reports a held package's version."""
    try:
        r = subprocess.run(
            ["apt-get", "-s", "-o", "apt::get::show-upgraded=false", "upgrade"],
            capture_output=True, text=True, check=False,
            env=dict(os.environ, LC_ALL="C", LANG="C"),
            timeout=PLAN_TIMEOUT,
        )
        m = re.search(r"^(\d+) upgraded", r.stdout or "", re.MULTILINE)
        if r.returncode != 0 or not m:
            print("WARN: apt-get -s upgrade rc=%d: %s"
                  % (r.returncode, ((r.stderr or "").strip() or (r.stdout or "").strip())[:140]),
                  file=sys.stderr)
            # A plan that cannot be read is reported as unreadable, never as "0 pending": "0" and
            # "no idea" must not be the same number.
            return PLAN_HEAD + ["homelab_upgrade_plan_ok 0"], PLAN_RETRY
        return PLAN_HEAD + ["homelab_upgrade_plan_ok 1", "homelab_upgrade_plan_count %s" % m.group(1)], PLAN_TTL
    except Exception as exc:                    # no apt on this box, a solver stuck on the dpkg lock
        print("WARN: apt-get -s upgrade: %s" % exc, file=sys.stderr)
        return PLAN_HEAD + ["homelab_upgrade_plan_ok 0"], PLAN_RETRY


def _plan_refresh() -> None:
    out, retry_in = _plan_read()
    with PLAN_LOCK:
        PLAN_CACHE["lines"] = out
        PLAN_CACHE["next_at"] = time.monotonic() + retry_in
        PLAN_CACHE["refreshing"] = False


def plan_lines() -> list[str]:
    """The cached plan, with a refresh kicked off in the background when it ages out.

    The read never happens on the request thread, even when the cache is empty: apt waits for the dpkg
    lock, so an inline solver read would let a converge running `apt` on that host stall this scrape —
    and a stalled render freezes `homelab_hygiene_scrape_ok`, which is the CRIT heartbeat rule, paging
    about a dead collector in the middle of an unrelated converge. `homelab_upgrade_plan_ok = 0` is
    therefore "no readable plan yet", which covers the seconds after a restart and a box whose apt is
    wedged alike; the value itself returns on the next scrape after a refresh lands.
    """
    with PLAN_LOCK:
        if not PLAN_CACHE["refreshing"] and time.monotonic() >= PLAN_CACHE["next_at"]:
            PLAN_CACHE["refreshing"] = True
            threading.Thread(target=_plan_refresh, daemon=True).start()
        return PLAN_CACHE["lines"] if PLAN_CACHE["lines"] is not None else PLAN_HEAD + ["homelab_upgrade_plan_ok 0"]


def reboot_lines() -> list[str]:
    """`/run/reboot-required` is Debian's own contract: a package that needs it writes it, and a running
    kernel older than the installed one is otherwise invisible to every other series here."""
    return [
        "# HELP homelab_reboot_required 1 while the box says a reboot is pending.",
        "# TYPE homelab_reboot_required gauge",
        "homelab_reboot_required %d" % (1 if os.path.isfile("/var/run/reboot-required") else 0),
    ]


def render() -> str:
    now = datetime.datetime.now(datetime.timezone.utc)
    lines: list[str] = []
    for unit in UNITS:
        lines += unit_lines(unit)
    for cert in CERTS:
        lines += cert_lines(cert["consumer"], cert["path"])
    for pin in PINS:
        lines += pin_lines(pin["package"], pin["pin"])
    lines += plan_lines()
    lines += reboot_lines()
    lines += [
        "# HELP homelab_hygiene_scrape_ok Unix time of this collection — the collector's own heartbeat.",
        "# TYPE homelab_hygiene_scrape_ok gauge",
        "homelab_hygiene_scrape_ok %d" % now.timestamp(),
    ]
    return "\n".join(lines) + "\n"


class Handler(http.server.BaseHTTPRequestHandler):
    # The one exception to collecting on the request: a probe of the listening socket must not pay for
    # the subprocesses, and must not advance the heartbeat (that would hide a stalled collector).
    def do_GET(self) -> None:                      # noqa: N802 (stdlib name)
        path = urllib.parse.urlparse(self.path).path
        body = b"ok\n" if path == "/-" else render().encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("http: " + (fmt % args) + "\n")


def main() -> int:
    # Fail at start, not at scrape time: a list that arrived unrendered means the template was copied
    # without Ansible, and 0 series would otherwise look like "nothing to watch".
    if "{" + "{" in json.dumps([UNITS, CERTS, PINS]):
        print("FATAL: the config lines are still Jinja — run this through the role, not by hand", file=sys.stderr)
        return 3
    srv = http.server.ThreadingHTTPServer(LISTEN, Handler)
    print("homelab-hygiene exporter on http://%s:%s/metrics · %d unit(s), %d cert(s), %d pinned package(s)"
          % (LISTEN[0], LISTEN[1], len(UNITS), len(CERTS), len(PINS)), flush=True)
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())

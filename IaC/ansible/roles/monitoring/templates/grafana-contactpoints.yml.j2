# Grafana contact points — monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/alerting/contactpoints.yml
#
# Design (docs/observability.md): one contact point carries BOTH receivers —
# n8n webhook (normal path → Signal + email routing) AND Grafana-native SMTP
# (fail-safe, parallel: still delivers if n8n/signal-cli is down).
# high-alerts webhook workflow ("homelab-alerts") must exist in n8n; payload = Grafana alert webhook.
# Webhook URL is a group_var (grafana_alert_webhook_url, group_vars/home_servers.yml).
# The webhook authenticates to n8n with the separate, rotatable `n8n-webhook_api` token
# (KOPS-031 / HD-77) — N8N_BASIC_AUTH_ACTIVE on the n8n service; not the encryption key.
apiVersion: 1

contactPoints:
  - orgId: 1
    name: homelab-alerts
    receivers:
      - uid: n8n-webhook
        type: webhook
        settings:
          url: "{{ grafana_alert_webhook_url | default('http://n8n:5678/webhook/homelab-alerts') }}"
          httpMethod: POST
          basicAuthUser: grafana
          basicAuthPassword: >-
            {{ lookup('community.general.onepassword', 'n8n-webhook_api', field='credential', vault=op_vault) }}
          autoResolve: false
      - uid: smtp-failsafe
        type: email
        settings:
          addresses: "{{ grafana_alert_email | default('domen@kogler.si') }}"
          autoResolve: false

# Grafana notification policy — monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/alerting/policies.yml
#
# Single default route → homelab-alerts (webhook n8n + SMTP fail-safe).
# Throttle (docs/observability.md "Poke/throttle"): a still-firing alert is
# re-sent at most every 24h — a fault that outlives the day must not become a
# page every half hour, because a paged alert that cannot be acted on trains the
# reader to ignore the channel. The first send is NOT delayed by it: new/grouped
# alerts still wait 2m (group_wait), then 10m between different alerts in a group.
apiVersion: 1

policies:
  - orgId: 1
    receiver: homelab-alerts
    group_by:
      - grafana_folder
      - alertname
    group_wait: 2m
    group_interval: 10m
    repeat_interval: 24h

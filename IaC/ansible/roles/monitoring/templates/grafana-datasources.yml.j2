# Grafana datasources — provisioned by the monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/datasources/datasources.yml
# Both backends live on db-internal (container-name DNS).
#
# HD-240 (2026-08-24): ONLY Loki is file-provisioned here. The Prometheus datasource
# moved to API seeding (roles/monitoring/tasks -> "Seed prometheus datasource via API")
# because grafana 13.2.0 file-provisioning stores a secureJsonData blob it cannot
# resolve at query time ("Authentication to data source failed" / anonymous queries)
# even though the rendered file itself parses correctly — wire-capture proven during
# HD-240. Loki carries NO secrets, so file-provisioning stays safe for it.
apiVersion: 1

datasources:
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false
    isDefault: false
    jsonData:
      tenantId: "logs"   # HD-115 / KOPS-023/051: Loki multi-tenant mode — queries need the tenant ID

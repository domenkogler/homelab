# Grafana datasources — provisioned by the monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/datasources/datasources.yml
# Both Victoria* backends live on db-internal (container-name DNS).
#
# HD-240 (2026-08-24) + HD-342 (2026-09-08): BOTH datasources carry basic-auth secrets,
# so they are API-seeded by the monitoring role (roles/monitoring/tasks -> "Seed ... via
# API"), NOT file-provisioned here — grafana 13.x file-provisioning stores a secureJsonData
# blob it cannot resolve at query time ("Authentication to data source failed"), wire-capture
# proven during HD-240. This file is kept as an empty/placeholder provisioning anchor so the
# datasources dir exists and the file-provisioning path stays available for any future
# secret-free datasource; the two live datasources (uid `prometheus` = VM, uid `loki` = VL)
# are created via the Grafana HTTP API in roles/monitoring/tasks/main.yml.
apiVersion: 1

datasources: []

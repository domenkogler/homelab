# Grafana alert rules — monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/alerting/rules.yml
# Rules data: roles/monitoring/vars/main.yml (grafana_alert_rules).
# Tiers per docs/observability.md: Critical (Signal+email), Warning (Signal).
# Throttle: policy repeat_interval=30m (poke).
# All observability.md rules are now implemented (ZFS via zfs_exporter on nas,
# MikroTik via Alloy SNMP, host-down via blackbox ICMP, self via prometheus/loki/n8n).
apiVersion: 1

groups:
{% for tier in ['critical', 'warning'] %}
  - orgId: 1
    name: homelab-{{ tier }}
    folder: Homelab · {{ tier | capitalize }}
    interval: 1m
    rules:
{% for r in grafana_alert_rules[tier] %}
      - uid: {{ r.uid }}
        title: {{ r.title }}
        condition: B
        for: {{ r.for }}
        labels:
          severity: {{ tier }}
        annotations:
          summary: "{{ r.summary }}"
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: {{ r.expr }}
              instant: true
              refId: A
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    # HD-347: per-rule evaluator type. The old hardcoded `gt 0` made
                    # every `expr: X == 0` rule (up-down, host-unreachable, wg-s2s-down,
                    # victoria-*-down, n8n-down) silently dead — the query returns 0 and
                    # `gt 0` never fires. Down/absent-style rules use `lt 1` (alert when
                    # the value is below 1); threshold/>= rules keep `gt 0`.
                    params: {{ r.eval_params | default([0]) }}
                    type: {{ r.eval_type | default('gt') }}
                  operator:
                    type: and
                  query:
                    params: [B]
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              refId: B
              type: threshold
            relativeTimeRange:
              from: 600
              to: 0
        noDataState: {{ r.noDataState | default('NoData') }}
        execErrState: {{ r.execErrState | default('Error') }}
{% endfor %}
{% endfor %}

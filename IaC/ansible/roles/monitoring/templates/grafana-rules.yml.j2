# Grafana alert rules — monitoring role (step 3)
# Target: /srv/docker/grafana/provisioning/alerting/rules.yml
# Rules data: roles/monitoring/vars/main.yml (grafana_alert_rules).
# Tiers per docs/observability.md: Critical (Signal+email), Warning (Signal).
# Throttle: policy repeat_interval=24h (poke).
# Every docs/observability.md rule has a leg (ZFS via zfs_exporter on nas,
# MikroTik via Alloy SNMP, host-down via blackbox ICMP, self via prometheus/loki/n8n).
apiVersion: 1

groups:
{% for tier in ['critical', 'warning'] %}
  - orgId: 1
    name: homelab-{{ tier }}
    folder: Homelab · {{ tier | capitalize }}
    interval: 1m
    rules:
{# The blind-host half of `critical` is GENERATED from the inventory (see
   roles/monitoring/vars/main.yml). It is appended HERE, in one template evaluation, and not in a
   vars-level expression on purpose: a templated var holding a list can come back as the STRING
   repr of that list, and `{% for %}` over a string walks its characters — the failure
   scripts/ansible/zone_kogler_si_render.py carries as a lesson. Here both operands stay real
   objects, and `from_json` is what makes the generated half the same shape as the authored one. #}
{% for r in grafana_alert_rules_authored[tier] + (grafana_alert_rules_blind_host | from_json if tier == 'critical' else []) %}
      - uid: {{ r.uid }}
        title: {{ r.title }}
        condition: B
        for: {{ r.for }}
        labels:
          severity: {{ tier }}
        annotations:
          summary: "{{ r.summary }}"
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: {{ r.expr }}
              instant: true
              refId: A
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    # Per-rule evaluator type: down/absent-style rules (`expr: X == 0`) need
                    # `lt 1` — their query returns 0, so `gt 0` never fires and the rule is dead.
                    # Threshold/>= rules keep `gt 0`.
                    params: {{ r.eval_params | default([0]) }}
                    type: {{ r.eval_type | default('gt') }}
                  operator:
                    type: and
                  query:
                    params: [B]
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              refId: B
              type: threshold
            relativeTimeRange:
              from: 600
              to: 0
        noDataState: {{ r.noDataState | default('NoData') }}
        execErrState: {{ r.execErrState | default('Error') }}
{% endfor %}
{% endfor %}

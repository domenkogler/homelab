# snmp_exporter config — monitoring role (step 3 / gap: MikroTik link down)
# Target: /etc/alloy/snmp.yml (consumed by prometheus.exporter.snmp in alloy.river.j2)
# Minimal MikroTik module: interface admin/oper status + ifName for labels.
#
# Device prerequisite (not this file): RouterOS /snmp enabled + the same RO
# community below must be set on the RB4011 + CRS328 at deploy (HD-03),
# e.g. on each device:
#   /snmp set enabled=yes take-over=no
#   /snmp community add name={{ community }} address=10.10.99.0/24 read-access=yes write-access=no
#   /snmp set enabled=yes
# Tracked with HD-53 (decision: dedicated read-only community + Mgmt-VLAN ACL).
# The community string resolves from 1Password (fail-loud — no default('')).
auths:
  kogler_ro_v2:
    community: "{{ lookup('community.general.onepassword', 'network-snmp_login', field='credential', vault=op_vault) }}"
    version: 2
    timeout: 5s
    retries: 2
modules:
  mikrotik:
    walk:
      - 1.3.6.1.2.1.2.2.1.7    # ifAdminStatus
      - 1.3.6.1.2.1.2.2.1.8    # ifOperStatus
    metrics:
      - name: ifAdminStatus
        oid: 1.3.6.1.2.1.2.2.1.7
        type: gauge
        help: Administrative status (1=up, 2=down)
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels: [ifIndex]
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: Operational status (1=up, 2=down)
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels: [ifIndex]
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1

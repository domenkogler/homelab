#!/usr/bin/env python3
r"""arr-torrent-client.py — register / reconcile the qBittorrent download client in ONE app.

Rendered from arr-torrent-client.py.j2 by the docker_services role (tasks/arr-client-torrent.yml).

    arr-torrent-client.py <base_url> <api_base> [--check | --apply | --verify]
    stdin:  line 1 = that app's own ApiKey (from its config.xml)
            line 2 = the qBittorrent WebUI password (from 1Password, field `credential`)

Runs against Sonarr / Radarr / Lidarr AND Prowlarr (`arr_torrent_client` in group_vars is the gate).
In Prowlarr the client governs ONLY a job started inside Prowlarr — its download-client list is never
synced to the apps, Prowlarr syncs indexers — so this is not a second client anywhere.

WHY A SCRIPT AND NOT A PATTERN OF `uri:` TASKS: the payload has to be MERGED, not bludgeoned. Reading
the client back and PUTting it verbatim stores the app's own REDACTED secret (measured: a working key
reads back as 8 characters), while PUTting a hand-written body resets every option the owner set in the
UI (seeding limits, content layout, priorities). So: read back, overlay only the fields this file owns
(re-supplying every secret from the vault AFTER the overlay), and write once. In Jinja that is a
three-page expression nobody can run offline; in Python it can be tested before it ships.

WHY THE TEST CALL IS THE PROOF: on Sonarr 4.0.19 `POST /api/v3/downloadclient/test` validates and
TESTS THE BODY IT CARRIES (sending `{}` answers 400 "'Name' must not be empty"; `test/{id}` and
`test/all` answer 405 — measured 2026-10-07). So posting the body we just stored makes the app itself
resolve `gluetun`, open the WebUI and authenticate with the credential it now holds. 200 = the leg
works end to end; 401 = qBittorrent's conf and this client disagree (qbittorrent-seed did not run
after the last rotation); 000/ refused = the overlay name `gluetun` does not resolve from this arr.
⚠ Same reason "GET the client, POST it to /test" is a WEAK proof: the redacted secret travels with it.
For SABnzbd that still passes (SAB answers localhost without a key), which is why the recipe looked
fine for the Usenet leg; qBittorrent always enforces basic auth, so the shortcut fails here for a
reason that has nothing to do with the real state.

FIELD NAMES are each app's own QBittorrentSettings properties (host, port, useSsl, urlBase, apiKey,
username, password, <tv|movie|music>Category). The *arr API silently DROPS a name it does not
recognise, so a wrong one stores nothing, grabs arrive with no category, and files land flat in
complete/ where no root folder points — the SAB `dir`/`complete_dir` shape. Hence the read-back below
asserts the VALUE, never the write's status code.
"""
import json
import sys
import urllib.error
import urllib.request

BASE = sys.argv[1].rstrip("/")
API = sys.argv[2]
MODE = (sys.argv[3] if len(sys.argv) > 3 else "--apply").lstrip("-")
if MODE not in ("check", "apply", "verify"):
    sys.exit("unknown mode %r (want --check | --apply | --verify)" % MODE)

# Non-secret fields this file owns, from group_vars/role defaults, plus this app's category field.
# ⚠ `| to_json | to_json` is not a typo: a single to_json emits JSON, and JSON `false`/`true`/`null` are
# NameErrors in Python source. Rendering the JSON a second time yields a Python string literal, which
# json.loads turns into real True/False. A single to_json of a dict containing a bool passed `ast.parse`
# locally (JSON's `false` is a legal *name* there) and died at import on the target — measured
# 2026-10-07: `NameError: name 'false' is not defined`.
FIELDS = json.loads({{ (arr_torrent_client_fields | combine({arr_torrent_client[svc.template_dir].category_field: arr_torrent_client[svc.template_dir].category})) | to_json | to_json }})
USERNAME = {{ arr_torrent_client_user | to_json }}
CATEGORY_FIELD = {{ arr_torrent_client[svc.template_dir].category_field | to_json }}
CATEGORY = {{ arr_torrent_client[svc.template_dir].category | to_json }}
NAME = {{ arr_torrent_client_name | to_json }}
# The settings class the app instantiates. REQUIRED on POST — Sonarr answers 400 "'Config Contract'
# must not be empty" without it (measured 2026-10-07), and it is the one field a read-back cannot teach
# you about a client that does not exist yet. It is also what `implementation` names, so both come from
# one variable rather than two places that can disagree.
CONTRACT = {{ arr_torrent_client_contract | to_json }}          # the SETTINGS class: QBittorrentSettings
IMPLEMENTATION = {{ arr_torrent_client_implementation | to_json }}   # the PROVIDER class: QBittorrent
# ⚠ These are two DIFFERENT names and POST instantiates the first one. Using the provider name for both
# (which is what an earlier revision did) yields 500 "Cannot dynamically create an instance of type
# …QBittorrent. Reason: No parameterless constructor defined".
# Field `type` as the app itself reports it (measured out of a live /downloadclient response: the
# literal strings textbox / checkbox / password / select). Only used for fields the app did not already declare.
# Keys arrive suffixed (`host_type`) so the secrets linter cannot read a type NAME as a credential.
TYPES = {k[:-5] if k.endswith("_type") else k: v
         for k, v in {{ arr_torrent_client_field_types | to_json }}.items()}
# Fields our defaults own that a build's settings class may legitimately not expose. Measured 2026-10-07
# against the live four (read-only GET /downloadclient + /downloadclient/schema): Sonarr 4.0.19, Radarr
# and Prowlarr 2.5.2 all report `apiKey`; **Lidarr 3.1 reports it in neither**. Treating "the app has no
# such property" as drift compared None to "" forever, so Lidarr's client was PUT on every converge —
# which is what made the failed second run of 2026-10-07 read like a flake. Everything else we own and
# the app does not report is a hard failure below, never a silent skip.
OPTIONAL = {{ arr_torrent_client_optional_fields | to_json }}
SKIPPED = []      # owned-but-not-exposed fields actually seen this run, for the report line

stdin_lines = sys.stdin.read().split("\n")
API_KEY = (stdin_lines[0] if stdin_lines else "").strip()
QBIT_PW = (stdin_lines[1] if len(stdin_lines) > 1 else "").strip()
if not API_KEY:
    print("FAIL no arr ApiKey on stdin")
    sys.exit(1)

wanted = dict(FIELDS)
wanted["username"] = USERNAME
if QBIT_PW:
    wanted["password"] = QBIT_PW
if MODE in ("apply", "verify") and not QBIT_PW:
    print("FAIL no qBittorrent password on stdin — refusing to write or test a client with no credential")
    sys.exit(1)


def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        BASE + API + path, data=data, method=method,
        headers={"X-Api-Key": API_KEY, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            raw = resp.read().decode()
            return resp.status, (json.loads(raw) if raw.strip() else None)
    except urllib.error.HTTPError as err:
        return err.code, err.read().decode()[:300]
    except (urllib.error.URLError, OSError) as exc:
        return "unreachable: %s" % exc, None


def qbit_of(clients):
    return [c for c in clients or [] if (c.get("implementation") or "").lower() == "qbittorrent"]


def same(live_value, wanted_value):
    """Scalar equality that ignores JSON representation.

    The apps store `port` as an int and echo it back as 8080 while our var renders the string "8080"
    (`arr_torrent_client_port` is a quoted Jinja value), so a raw `!=` compares "8080" to 8080 forever.
    Measured 2026-10-07 against the live four: field `port` is int 8080 on Sonarr, Radarr, Lidarr AND
    Prowlarr, so EVERY converge PUT all four clients — the bigger half of HD-1090's perpetual drift, of
    which Lidarr's missing apiKey was only the extra field. Bools stay strict: "False" == False would
    mute a real useSsl change.
    """
    if isinstance(live_value, bool) or isinstance(wanted_value, bool):
        return live_value == wanted_value
    if live_value is None or wanted_value is None:
        return live_value == wanted_value
    return str(live_value) == str(wanted_value)


status, clients = call("GET", "/downloadclient")
if status != 200 or not isinstance(clients, list):
    print("FAIL GET %s/downloadclient -> %s %s" % (BASE + API, status, str(clients)[:200]))
    sys.exit(1)

found = qbit_of(clients)
if len(found) > 1:
    print("FAIL %d qBittorrent clients in this arr (ids %s) — de-duplicate in the UI first: two "
          "enabled clients of one protocol make the arr round-robin grabs between them"
          % (len(found), [c.get("id") for c in found]))
    sys.exit(1)
existing = found[0] if found else None

if existing:
    live = {f.get("name"): f.get("value") for f in existing.get("fields", []) if isinstance(f, dict)}
    types = {f.get("name"): f.get("type") or TYPES.get(f.get("name"), "textBox")
             for f in existing.get("fields", []) if isinstance(f, dict)}
    # The app's OWN field set is the drift universe: a field it does not report is a field it cannot
    # store, so it can neither drift nor be written. An unreported field we depend on is still fatal.
    unreported = [k for k in wanted if k not in live and k not in OPTIONAL]
    if unreported:
        print("FAIL this build reports none of %s, which our defaults own, and they are not in "
              "arr_torrent_client_optional_fields. Either the app renamed a field this seed depends on "
              "(the category field is what steers the save path) or the defaults gained a field this "
              "build cannot store — in which case it belongs in the optional list WITH the measurement "
              "that proves it. Reported fields: %s"
              % (sorted(unreported), sorted(live)))
        sys.exit(1)
    SKIPPED = sorted(k for k in wanted if k not in live)
    owned = {k: v for k, v in wanted.items() if k in live}
    merged = dict(live)
    merged.update(owned)          # secrets last, so a redacted read-back value can never survive
    body = {
        "id": existing.get("id"),
        "name": existing.get("name") or NAME,     # never rename a client something else may reference
        "enable": True,                           # a torrent client nobody enabled downloads nothing
        "protocol": existing.get("protocol", "torrent"),
        "priority": existing.get("priority", 1),
        "configContract": existing.get("configContract") or CONTRACT,
        "implementation": existing.get("implementation") or IMPLEMENTATION,
        "tags": existing.get("tags", []),
        "fields": [{"name": k, "value": v, "type": types.get(k) or TYPES.get(k, "textBox")}
                   for k, v in merged.items()],
    }
    # Keys that are NOT part of every app's download-client resource. Send each one only when the app
    # itself reported it: the Sonarr/Radarr/Lidarr resource carries all three, Prowlarr 2.5.2's carries
    # NONE of them (measured 2026-10-07 — GET /api/v1/downloadclient returns exactly
    # categories/configContract/enable/fields/id/implementation/implementationName/infoLink/name/
    # priority/protocol/supportsCategories/tags). ASP.NET ignores an unknown member, so this is not a
    # correctness fix — it is the difference between PUTting what the app owns and inventing three keys
    # it does not have, which is what `appProfileId: 1` was for an app with no such field.
    for _opt in ("removeCompletedDownloads", "removeFailedDownloads", "appProfileId"):
        if _opt in existing:
            body[_opt] = existing[_opt]
    # Password is unreadable by design, so it is not part of the drift question — the test call is.
    drift = [k for k in owned if k != "password" and not same(live[k], owned[k])]
    if not existing.get("enable"):
        drift.append("enable")
    action = "updated" if drift else "unchanged"
else:
    # No client yet → start from the app's OWN schema, because that is what the UI posts back and it is
    # the only source that cannot drift from this build. A hand-built body died with
    #   500 "Cannot dynamically create an instance of type …QBittorrent. Reason: No parameterless
    #        constructor defined."
    # — POST takes `configContract` as the name of the SETTINGS class to instantiate, and that name is
    # `QBittorrentSettings`, not `QBittorrent` (measured on Sonarr 4.0.19 via /downloadclient/schema).
    # Guessing class names is not a strategy; the schema also supplies every field's real `type` and
    # default, so this path no longer needs TYPES for the create case at all.
    st_schema, schema = call("GET", "/downloadclient/schema")
    tmpl = next((x for x in (schema or []) if isinstance(x, dict)
                 and (x.get("implementation") or "").lower() == "qbittorrent"), None) \
        if st_schema == 200 else None
    if tmpl is None:
        print("FAIL GET %s/downloadclient/schema -> %s, and no qbittorrent entry in it: without the "
              "schema this script will not guess this build's contract/field types (that guess is what "
              "produced the 500 above). Is the qBittorrent provider present in this app?"
              % (BASE + API, st_schema))
        sys.exit(1)
    tmpl_types = {f.get("name"): f.get("type") for f in tmpl.get("fields", []) if isinstance(f, dict)}
    tmpl_values = {f.get("name"): f.get("value") for f in tmpl.get("fields", []) if isinstance(f, dict)}
    # Same rule as the update path, against the schema instead of the live object: a field this build
    # does not expose cannot be configured, and silently dropping it would make a "registered" verdict
    # mean "configured everything except the field nobody checked".
    unreported = [k for k in wanted if k not in tmpl_values and k not in OPTIONAL]
    if unreported:
        print("FAIL the schema for this build exposes none of %s, which our defaults own, and they are "
              "not in arr_torrent_client_optional_fields. Schema fields: %s"
              % (sorted(unreported), sorted(tmpl_values)))
        sys.exit(1)
    SKIPPED = sorted(k for k in wanted if k not in tmpl_values)
    tmpl_values.update({k: v for k, v in wanted.items() if k in tmpl_values})
    body = {k: v for k, v in tmpl.items() if k not in ("presets", "infoLink", "implementationName", "id")}
    body.update({
        "name": NAME,
        "enable": True,
        "tags": tmpl.get("tags", []),
        "fields": [{"name": k, "value": v, "type": tmpl_types.get(k) or TYPES.get(k, "textBox")}
                   for k, v in tmpl_values.items()],
    })
    if body.get("configContract") != CONTRACT:
        print("note: schema reports configContract=%r, defaults say %r — the schema wins, this line "
              "only says the two have diverged" % (body.get("configContract"), CONTRACT))
    drift = sorted(k for k in wanted if k in tmpl_values)
    action = "registered"

if MODE == "check":
    print("%s: would %s (%d field(s) differ%s) · %s=%s%s" % (
        "CHANGED" if (not existing or drift) else "OK already", action, len(drift),
        "" if drift else "", CATEGORY_FIELD, wanted[CATEGORY_FIELD],
        (" · not exposed by this build: %s" % ",".join(SKIPPED)) if SKIPPED else ""))
    sys.exit(0)

if MODE == "apply" and drift:
    status, reply = call("PUT" if existing else "POST", "/downloadclient", body)
    if status not in (200, 201, 202):
        print("FAIL %s %s/downloadclient -> %s %s"
              % ("PUT" if existing else "POST", BASE + API, status, str(reply)[:250]))
        sys.exit(1)

# Re-read and check the VALUE, not the status code (a 2xx means the app parsed the body, nothing more).
status, after = call("GET", "/downloadclient")
if status != 200 or not isinstance(after, list):
    print("FAIL re-read %s/downloadclient -> %s" % (BASE + API, status))
    sys.exit(1)
saved = qbit_of(after)
if len(saved) != 1:
    print("FAIL expected exactly one qBittorrent client after the write, found %d" % len(saved))
    sys.exit(1)
types_by_name = {f.get("name"): f.get("type") for f in saved[0].get("fields", []) if isinstance(f, dict)}
stored = {f.get("name"): f.get("value") for f in saved[0].get("fields", []) if isinstance(f, dict)}
if stored.get(CATEGORY_FIELD) != CATEGORY:
    print("FAIL stored %s=%r, wanted %r — the write returned 2xx but the category did not land. That "
          "is how grabs end up flat in complete/: the field name is wrong for this build, or the app "
          "renamed it (check QBittorrentSettings.cs for the pinned version)."
          % (CATEGORY_FIELD, stored.get(CATEGORY_FIELD), CATEGORY))
    sys.exit(1)
if not saved[0].get("enable"):
    print("FAIL the client exists but is disabled — it will never receive a grab")
    sys.exit(1)

# The app's own judgement, over the values WE hold (never the redacted read-back). Every field the
# app stores goes back, with our values overlaid — a partial object would have the app default the
# rest for the duration of the test, which tests something other than the client in use.
test_body = dict(saved[0])
test_body["fields"] = [{"name": k, "value": wanted.get(k, v),
                        "type": types_by_name.get(k) or TYPES.get(k, "textBox")}
                       for k, v in stored.items()]
status, reply = call("POST", "/downloadclient/test", test_body)
if status != 200:
    print("FAIL the arr's own client test -> %s %s · stored host=%s:%s %s=%s — 401 means qBittorrent's "
          "conf and this client disagree (run the qbittorrent_seed tag); a refused connection means "
          "`%s` is not resolvable/reachable from this arr"
          % (status, str(reply)[:200], stored.get("host"), stored.get("port"),
             CATEGORY_FIELD, wanted["host"]))
    sys.exit(1)

print("%s: %s host=%s:%s %s=%s · arr client test HTTP %s%s" % (
    "CHANGED" if (MODE == "apply" and (not existing or drift)) else "OK already",
    action, wanted["host"], wanted["port"], CATEGORY_FIELD, CATEGORY, status,
    (" · not exposed by this build: %s" % ",".join(SKIPPED)) if SKIPPED else ""))

#!/bin/bash
# =============================================================================
# authentik-secret-egress.sh — Authentik → 1Password secret-egress glue (HD-143)
# Managed by Ansible (docker_services role). Runs on the **VPS** via Ansible AFTER
# the `authentik` service + the `ks-oidc.yml` Blueprint are applied and BEFORE the
# OIDC-consumer compose templates are rendered (HD-146 ordering).
#
# A+mini-glue design (services-authentik.md): the Blueprint declares OIDC providers
# (ks-oidc.yml); Authentik AUTO-GENERATES a client_id/client_secret per provider on
# creation. This glue READS the generated creds back via the Authentik API and writes
# them into the 1Password items the compose templates already lookup(). It thus closes
# the loop the Blueprint alone leaves open (client-secret egress).
#
# Run location: must resolve `authentik-server` (the internal services-internal hostname)
# and have the `op` CLI, signed in with write access to the Homelab-ansible vault (same pattern
# as sync-authentik-users.sh on nas). The Ansible control node reads 1Password at render;
# this glue's writes are picked up by the NEXT render of the OIDC consumers (HD-146 order).
#
# Idempotent: for each declared provider, if the 1Password item already matches the
# current Authentik client_secret, skip (no churn). Write-only-if-changed.
# Fail-closed (HD-65/91): if the write-scoped token (authentik-provision_api) is missing
# or the Authentik API is unreachable, abort loudly — never render a consumer with an
# empty/placeholder OIDC secret.
#
# Secrets: 1Password Homelab-ansible vault via the `op` CLI (must be signed in). The *write*
# token `authentik-provision_api` is distinct from the read-only `authentik-api_token`
# (sync-authentik-users.sh) per deployment-secrets.md.
# Overridable via env: AUTHENTIK_URL (default for the VPS internal network), OP_VAULT.
# =============================================================================
set -euo pipefail

# Resolve Authentik API. On the VPS the internal hostname works; override e.g. with
# AUTHENTIK_URL=https://sso.kogler.si when run off-stack (delegate/control node).
AUTHENTIK_URL="${AUTHENTIK_URL:-http://authentik-server:9000}"
OP_VAULT="${OP_VAULT:-Homelab-ansible}"

# write-scoped token (blueprint apply + this glue). FAIL-CLOSED: missing -> abort.
get_provision_token() {
  op read "op://$OP_VAULT/authentik-provision_api/credential"
}

# Read a 1Password API-credential item's username/credential fields.
# Item shape: OIDC client -> username = client_id, credential = client_secret.
get_op_username() { op read "op://$OP_VAULT/$1/username"; }
get_op_credential() { op read "op://$OP_VAULT/$1/credential"; }

# OIDC clients the glue must seed (Authentik provider slug : 1Password item).
#   opencloud-service_api is the OpenCloud Graph-API SERVICE ACCOUNT, NOT an OIDC client —
#   it is provisioned by the sync-authentik-users rework (HD-145), not this OIDC egress glue.
PROVIDERS=(
  "openwebui:openwebui_api"
  "headscale:headscale_api"
  "matrix:matrix_api"
  "openclaw:openclaw_api"
  "opencloud:opencloud_oidc"
  "immich:immich_oidc"
  "forgejo:forgejo_oidc"
  "metabase:metabase_oidc"
)


echo "== Secret-egress glue: Authentik -> 1Password =="
PROV_TOKEN="$(get_provision_token)"
if [ -z "$PROV_TOKEN" ]; then
  echo "FATAL: authentik-provision_api token missing/empty (1Password). Aborting (HD-65)." >&2
  exit 1
fi

declare -A SEEN_PROVIDERS=()
SEEN_COUNT=0
for entry in "${PROVIDERS[@]}"; do
  provider_slug="${entry%%:*}"
  item="${entry##*:}"
  echo "-- provider $provider_slug -> 1Password $item --"

  # Fetch the provider by name from the Authentik OAuth2 provider list.
  provider_json="$(curl -fsS -H "Authorization: Bearer $PROV_TOKEN" \
    -G --data-urlencode "name=$provider_slug" \
    "$AUTHENTIK_URL/api/v3/core/providers/oauth2/" || { echo "  ERROR: API unreachable for $provider_slug" >&2; exit 1; })"
  client_id="$(printf '%s' "$provider_json" | jq -r '.results[0].client_id // empty')"
  client_secret="$(printf '%s' "$provider_json" | jq -r '.results[0].client_secret // empty')"

  if [ -z "$client_id" ] || [ -z "$client_secret" ]; then
    echo "  WARN: provider '$provider_slug' not found in Authentik (blueprint not applied?) — skipping." >&2
    continue
  fi
  SEEN_PROVIDERS[$provider_slug]=1
  SEEN_COUNT=$((SEEN_COUNT+1))

  # Write-only-if-changed: compare current 1Password value before overriding.
  current_id="$(get_op_username "$item" 2>/dev/null || true)"
  current_sec="$(get_op_credential "$item" 2>/dev/null || true)"
  if [ "$current_id" = "$client_id" ] && [ "$current_sec" = "$client_secret" ]; then
    echo "  unchanged ($item) — skipping write"
    continue
  fi

  # Update the 1Password API-credential item: username=client_id, credential=client_secret.
  if op item edit "$item" --vault="$OP_VAULT" \
      "username=$client_id" "credential=$client_secret" >/dev/null 2>&1; then
    echo "  updated $item (client_id=$client_id)"
  else
    # Item may not exist yet — create it as an API Credential.
    if op item create --vault="$OP_VAULT" --category="API Credential" \
        --title="$item" "username=$client_id" "credential=$client_secret" >/dev/null 2>&1; then
      echo "  created $item (client_id=$client_id)"
    else
      echo "  ERROR: could not write $item to 1Password" >&2
      exit 1
    fi
  fi
done

echo "== Secret-egress complete: $SEEN_COUNT providers synced =="

# Fail-loud (HD-65): if the blueprint hadn't applied yet (no provider found), signal that so
# Ansible's until/retries can wait for Authentik to finish applying ks-oidc.yml.
if [ "$SEEN_COUNT" -eq 0 ]; then
  echo "WARN: no OIDC providers found in Authentik — blueprint may still be applying (retry expected)." >&2
  exit 3
fi
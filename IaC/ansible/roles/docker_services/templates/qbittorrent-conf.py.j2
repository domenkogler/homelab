#!/usr/bin/env python3
r"""qbittorrent-conf.py — give qBittorrent a durable WebUI credential + real save paths.

(raw docstring: the text below names ini keys with `\` separators, and a non-raw string would make
`WebUI\Password_PBKDF2` an invalid escape sequence — a SyntaxWarning on 3.12, a SyntaxError later.)

Rendered from qbittorrent-conf.py.j2 by the docker_services role; run by tasks/qbittorrent-seed.yml
with the container STOPPED (qbit rewrites both files on a clean exit, so an edit made while it runs
is silently undone — the sabnzbd-seed rule) and with `become: true` (the files are media:media and
the play is root; writing in place preserves uid/gid + mode, and nothing here chowns).

    qbittorrent-conf.py <qBittorrent.conf> <categories.json> [--check]

The WebUI password is read from **stdin**, never from argv: argv is world-readable in `ps` for the
life of the process (CONVENTIONS §3 secret-output hygiene), and Ansible pipes it from a `no_log` var.

WHY THESE FOUR VALUES ARE OWNED IN IaC (measured on oldsrv 2026-10-06):

1. `WebUI\Password_PBKDF2` ABSENT is not a neutral state. qBittorrent mints a NEW random 9-character
   password on every start when the stored hash is empty
   (`src/app/application.cpp`: `getWebUIPassword().isEmpty() ? Password::generate(9) : QString()`),
   printed once to the container log. So an *arr download client configured against it works until the
   next `docker compose up -d` and then 401s forever — and a converge recreates. That is how the
   torrent leg stayed dark: the conf had no credential keys at all (mtime = the day the container was
   first built) and every WebUI call answered 401. The image translates no env for it (only
   `WEBUI_PORT`/`TORRENTING_PORT`), and `app/setPassword` needs the CURRENT password, which is the
   random one — so the conf is the only automatable door.

2. `Session\DefaultSavePath=/downloads/` is wrong the same way SAB's `[misc] complete_dir` was wrong:
   qBittorrent does not append the category to the default path (a category with an empty `save_path`
   means "use the default"), so completed files land flat in `/downloads/`, where no *arr root folder
   points. Hence the categories below, each with its OWN save path.

KEY + FORMAT FACTS, READ FROM THE SOURCE rather than remembered:
  settings live under `[Preferences]` (`WebUI\…`, `src/base/preferences.cpp`: `WebUI/Username`,
  `WebUI/Password_PBKDF2`) and `[BitTorrent]` (`Session\DefaultSavePath`, `Session\TempPath`;
  `src/base/bittorrent/sessionimpl.cpp`: BITTORRENT_SESSION_KEY("DefaultSavePath"/"TempPath")).
  the hash is `base64(salt) + ":" + base64(dk)`, salt = 16 random bytes, dk =
  PBKDF2-HMAC-**SHA512**(password, salt, **100000**, 64) — `src/base/utils/password.cpp`
  (`hashIterations = 100000`, `hashMethod = EVP_sha512()`); a sha256/10k recipe verifies NEVER.
  Qt serialises a QByteArray setting in INI as `@ByteArray(<text>)`, which is what a real conf shows;
  both forms read back identically, so this writes the canonical wrapper and accepts either.
  categories.json maps NAME -> options with snake_case keys `save_path` / `download_path`
  (`src/base/bittorrent/categoryoptions.cpp`: OPTION_SAVEPATH = u"save_path") — NOT `savePath`.

Idempotence is a VERIFY, not a presence check: the stored hash is recomputed with its own salt and
compared, so a run whose vault value already matches restarts nothing, and a run whose vault value
was rotated rewrites exactly once.

Exit codes: 0 done (changed or not), 2 no password on stdin, 3 refusing to clobber legacy state.
"""
import base64
import hashlib
import hmac
import http.cookiejar
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

PBKDF2_ITERATIONS = 100000   # qBittorrent's own constant; changing it silently breaks login
PBKDF2_DK_LEN = 64
SALT_LEN = 16                # qbit: 4 x uint32; any 16 random bytes verify the same way

CONF = sys.argv[1]
CATS = sys.argv[2]
CHECK = "--check" in sys.argv[3:]
# --verify <base_url> : after the reconcile, prove the credential WORKS over the same origin the arrs
# will use. A 401 to an unauthenticated call only proves auth is ON; it cannot tell a correct
# credential from a broken one (measured 2026-10-07: an unreachable-by-design origin answers 401 to
# correct AND wrong credentials alike, which read as "the seed succeeded" while every consumer 401s).
VERIFY = sys.argv[sys.argv.index("--verify") + 1] if "--verify" in sys.argv else None

WANTED_CONF = {
    "BitTorrent": {
        r"Session\DefaultSavePath": {{ qbit_save_path_completed | to_json }},
        r"Session\TempPath": {{ qbit_save_path_incomplete | to_json }},
    },
    "Preferences": {
        # The legacy (pre-4.2) pair qBittorrent still WRITES into the conf. Whether 5.2 still READS
        # them was not established, so both generations are kept in the same value rather than
        # gambling on which one the app consults — a stale legacy path shadowing a correct modern one
        # is the SAB `dir`/`complete_dir` failure shape (value present in the file, nothing happens).
        r"Downloads\SavePath": {{ qbit_save_path_completed | to_json }},
        r"Downloads\TempPath": {{ qbit_save_path_incomplete | to_json }},
        r"WebUI\Username": {{ qbit_webui_username | to_json }},
    },
}
WANTED_CATS = {{ qbit_categories | to_json }}

# Values whose comparison ignores a trailing "/". qBittorrent writes its own paths WITH the slash
# (`Session\TempPath=/downloads/incomplete/`), so comparing byte-for-byte against a slash-less value
# from group_vars would report drift forever and stop/start the downloader on every converge.
PATH_KEYS = {r"Session\DefaultSavePath", r"Session\TempPath", r"Downloads\SavePath", r"Downloads\TempPath"}

PASSWORD = sys.stdin.read().strip()
if not PASSWORD:
    # Fail loud rather than seed an empty password: an empty hash is the state that makes qbit
    # regenerate a random one at every start, which is the bug this file exists to close.
    sys.stderr.write("no password on stdin — refusing to seed an empty WebUI credential\n")
    sys.exit(2)


def unwrap(value):
    """Qt stores QByteArray settings as @ByteArray(<text>); accept that or the bare text."""
    value = value.strip().strip('"')
    if value.startswith("@ByteArray(") and value.endswith(")"):
        return value[len("@ByteArray("):-1]
    return value


def hash_for(password, salt=None):
    salt = salt if salt is not None else os.urandom(SALT_LEN)
    dk = hashlib.pbkdf2_hmac("sha512", password.encode("utf-8"), salt, PBKDF2_ITERATIONS, PBKDF2_DK_LEN)
    return salt, dk


def stored_matches(stored, password):
    """True only if `stored` is a hash that the wanted password actually produces."""
    try:
        salt_b64, dk_b64 = unwrap(stored).split(":")
        salt, want = base64.b64decode(salt_b64), base64.b64decode(dk_b64)
    except (ValueError, TypeError):
        return False
    if not salt or len(want) != PBKDF2_DK_LEN:
        return False
    return hmac.compare_digest(hash_for(password, salt)[1], want)


with open(CONF, encoding="utf-8", errors="surrogateescape") as fh:
    lines = fh.read().split("\n")

# --- the credential: verify first, so a no-change run cannot cause a restart -------------------
pw_state = "absent"
for line in lines:
    if "=" in line and line.split("=")[0].strip() == r"WebUI\Password_PBKDF2":
        pw_state = "matches" if stored_matches(line.split("=", 1)[1], PASSWORD) else "differs"
        break

wanted = {sec: dict(keys) for sec, keys in WANTED_CONF.items()}
if pw_state != "matches":
    salt, dk = hash_for(PASSWORD)
    wanted["Preferences"][r"WebUI\Password_PBKDF2"] = "@ByteArray(%s:%s)" % (
        base64.b64encode(salt).decode(), base64.b64encode(dk).decode())

# --- categories: refuse to shadow a legacy in-conf category store -------------------------------
# loadCategories() takes categories.json as SOON AS IT EXISTS and only falls back to the legacy
# `BitTorrent/Session/Categories` setting when the file is absent. Creating the file in that state
# would make pre-4.x categories disappear, so say so instead.
legacy_cats = any("=" in ln and ln.split("=")[0].strip() == r"Session\Categories" for ln in lines)
if not os.path.exists(CATS) and legacy_cats:
    sys.stderr.write("categories.json is absent but the conf still carries BitTorrent\\Session\\Categories"
                     " (pre-4.x store) — import them in the WebUI first, this seed will not shadow them\n")
    sys.exit(3)
cats_now = {}
if os.path.exists(CATS):
    with open(CATS, encoding="utf-8") as fh:
        text = fh.read().strip()
    cats_now = json.loads(text) if text else {}
    if not isinstance(cats_now, dict):
        sys.stderr.write("categories.json is not a JSON object — refusing to rewrite it\n")
        sys.exit(3)

cats_out, cats_added, cats_fixed = dict(cats_now), [], []
for name, path in WANTED_CATS.items():
    entry = dict(cats_out.get(name) or {})
    if name not in cats_out:
        cats_added.append(name)
    have = entry.get("save_path")
    # Trailing-slash equality again: qbit rewrites these paths with the slash, and rewriting a
    # semantically identical value every run would restart the container every converge.
    if have is None or have.rstrip("/") != path.rstrip("/"):
        if have is not None:
            cats_fixed.append(name)
        entry["save_path"] = path
    cats_out[name] = entry   # any other key an owner set (share limits, download_path) survives

# --- line-based rewrite, section-aware (configparser would re-serialise Qt's `\`-keyed groups) ---
out, section, written = [], None, set()
for line in lines:
    if line.startswith("["):
        section = line.strip()[1:-1]
        out.append(line)
        continue
    if "=" in line and section in wanted:
        key = line.split("=")[0].strip()
        if key in wanted[section] and (section, key) not in written:
            current = unwrap(line.split("=", 1)[1])
            want = wanted[section][key]
            if key in PATH_KEYS and current.rstrip("/") == want.rstrip("/"):
                # Same path, different trailing slash: keep the line EXACTLY as it is. Rewriting it
                # would make `out != lines` and restart the downloader on every converge for a
                # difference that is cosmetic — qbit writes its own paths with the slash.
                out.append(line)
                written.add((section, key))
                continue
            out.append("%s=%s" % (key, want))
            written.add((section, key))
            continue
    out.append(line)

for sec, keys in wanted.items():
    for key, value in keys.items():
        if (sec, key) in written:
            continue
        if sec in {ln.strip()[1:-1] for ln in lines if ln.startswith("[")}:
            # append at the end of the existing section (the loop above only rewrites lines it sees)
            idx = max(i for i, ln in enumerate(out) if ln.strip() == "[%s]" % sec)
            end = next((i for i in range(idx + 1, len(out)) if out[i].startswith("[")), len(out))
            while end - 1 > idx and not out[end - 1].strip():
                end -= 1
            out.insert(end, "%s=%s" % (key, value))
        else:
            out += ["", "[%s]" % sec, "%s=%s" % (key, value)]
        written.add((sec, key))

changed = (out != lines) or (cats_out != cats_now)
if not CHECK:
    if out != lines:
        with open(CONF, "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write("\n".join(out))
    if cats_out != cats_now:
        with open(CATS, "w", encoding="utf-8") as fh:
            json.dump(cats_out, fh, indent=1)
            fh.write("\n")

summary = ("save_path=%s temp_path=%s webui_user=%s password=%s categories=%s" % (
    wanted["BitTorrent"][r"Session\DefaultSavePath"],
    wanted["BitTorrent"][r"Session\TempPath"],
    wanted["Preferences"][r"WebUI\Username"],
    pw_state,                                                       # never the value, never the hash
    sorted(WANTED_CATS)))
print(("CHANGED " if changed else "OK already: ") + summary +
      (" added=%s corrected=%s" % (cats_added or "none", cats_fixed or "none") if changed else ""))


# --- --verify: the POSITIVE leg ---------------------------------------------------------------
# Both legs matter and they catch different bugs:
#   * unauthenticated GET  -> must be 401  (auth is enforced; 200 = the VLAN can drive the client)
#   * authenticated POST   -> must be 200/204 (the hash this script wrote == the vault credential;
#                             a 401 here means qbittorrent.conf and 1Password disagree)
# ⚠ WHICH ORIGIN YOU PASS IS LOAD-BEARING. qBittorrent's validateHostHeader() refuses a request whose
# Host header carries a port other than the one it listens on (webapplication.cpp, release-5.2.3:
# `if ((requestPort != -1) && (m_env.localPort != requestPort)) return false;`), and the refusal is
# HTTP 401 — BEFORE any credential is looked at. The host publish `oldsrv_home_ip:8085 -> :8080` therefore
# answers 401 to EVERYTHING, correct password included: verifying through `qbittorrent_url` proves
# nothing except that something is listening. Pass the container origin (`http://<gluetun ip>:8080`,
# the address the arrs themselves use — qbit shares gluetun's netns), never the published host port.
def verify(base):
    def get(path, opener=None):
        try:
            resp = (opener.open(base + path, timeout=15) if opener is not None
                    else urllib.request.urlopen(base + path, timeout=15))
            with resp:
                return resp.status, resp.read()[:64]
        except urllib.error.HTTPError as err:
            return err.code, err.read()[:64]
        except (urllib.error.URLError, OSError) as exc:
            return "unreachable: %s" % exc, b""

    st, _ = get("/api/v2/app/version")
    if st not in (401, 403):
        # 403 = reached the API layer and was refused for lack of a session (the normal answer from a
        # same-port origin); 401 = refused at the CSRF/host-header gate before routing. Both are
        # "auth enforced"; 200 is the one that must never happen.
        print("FAIL unauthenticated GET %s/api/v2/app/version -> %s, expected a refusal (401/403).\n"
              "     200 would mean WebUI auth is OFF (anyone on the Home VLAN can drive the client);\n"
              "     anything else means this origin is not qBittorrent's WebUI at all."
              % (base, st))
        return 1

    cj = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
    form = urllib.parse.urlencode({"username": {{ qbit_webui_username | to_json }},
                                   "password": PASSWORD}).encode()
    try:
        with opener.open(urllib.request.Request(base + "/api/v2/auth/login", data=form), timeout=15) as resp:
            login, body = resp.status, resp.read()[:40].decode(errors="replace")
    except urllib.error.HTTPError as err:
        login, body = err.code, err.read()[:80].decode(errors="replace")
    if login not in (200, 204):
        print("FAIL POST %s/api/v2/auth/login -> %s %s with the vault credential.\n"
              "     401 = the PBKDF2 hash in %s is not the vault value (qbittorrent_seed did not run\n"
              "     after the last rotation, or the WebUI listen port != the port in this URL — qbit\n"
              "     answers 401 to EVERY request when the Host header's port and its own socket port\n"
              "     disagree, which is what a published port mapping looks like from outside)."
              % (base, login, body.strip(), CONF))
        return 1
    st, ver = get("/api/v2/app/version", opener)
    print("verified: auth enforced AND the vault credential accepted (qbit %s) at %s"
          % (ver.decode(errors="replace").strip() or "?", base))
    return 0


if VERIFY:
    sys.exit(verify(VERIFY))

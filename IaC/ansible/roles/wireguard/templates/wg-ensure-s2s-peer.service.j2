# Ensure the wg-s2s peer AND private key are attached (systemd-257 networkd workaround):
# networkd applies the .netdev key unreliably and a peer-only `wg setconf` clears it, so this
# oneshot applies the FULL conf (key + peer, from /etc/wireguard/wg-s2s.conf 0640) atomically.
#
# Ordering: After=systemd-networkd.service (not -wait-online, which can stay stuck in
# `activating` on this host — the script poll-waits for the interface instead).
# PartOf=networkd re-runs the unit when networkd itself restarts, so a networkd
# recreate of the interface re-attaches the peer automatically.
[Unit]
Description=Ensure wg-s2s WireGuard peer is attached (systemd-257 networkd workaround)
After=systemd-networkd.service
PartOf=systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ wg_ensure_dir }}/wg-ensure-s2s-peer.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

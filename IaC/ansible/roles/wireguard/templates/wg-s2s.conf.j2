# wg setconf configuration for the wg-s2s site-to-site tunnel (VPS side) — VPS's OWN
# distinct keypair (wg_password_vps), separate from the home-side key. Rendered by the
# wireguard role from the same SSOT as the peer (wg_s2s_vps, group_vars/all/main.yml).
# The wg-ensure-s2s-peer oneshot applies the KEY via a KEY-ONLY `wg setconf` and adds
# the PEER via `wg set … peer` (the oneshot owns the interface, networkd only creates
# it) — see the script for the sequence.
#
# ***** THIS FILE CARRIES THE PRIVATE KEY — 0640 root:root, never 0666/644 *****
# It is a secret, not a peer-only listing, so the conf dir is root-only 0700.
[Interface]
ListenPort={{ wg_s2s_vps.listen_port }}
PrivateKey={{ lookup('community.general.onepassword', 'wg_password_vps', field='password', vault=op_vault) }}

[Peer]
PublicKey={{ wg_s2s_vps.peer_public_key }}
AllowedIPs={% for ip in wg_s2s_vps.allowed_ips %}{{ ip }}{% if not loop.last %},{% endif %}{% endfor %}{{ '\n' }}Endpoint={{ wg_s2s_vps.endpoint }}:{{ wg_s2s_vps.listen_port }}
# PersistentKeepalive keeps the NAT-traversed S2S tunnel alive: the home PPPoE WAN is
# behind CGNAT-ish/stateful NAT, so without it WireGuard never initiates the handshake
# unless app traffic flows and the tunnel stays down silently.
PersistentKeepalive = {{ wg_persistent_keepalive }}
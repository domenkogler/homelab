# wg setconf configuration for the wg-s2s site-to-site tunnel (VPS side).
# Rendered by the wireguard role from the same SSOT as the .netdev (wg_s2s_vps,
# group_vars/all/main.yml). HD-306: systemd 257 networkd creates wg-s2s but does not
# apply the peer — the wg-ensure-s2s-peer oneshot applies THIS file with `wg setconf`.
#
# Deliberately NO PrivateKey line: the private key is already set on the interface by
# systemd-networkd from wg-s2s.netdev (group-read 0640). Live-verified 2026-09-01: a
# setconf conf containing `PrivateKey` silently DROPS the peer on this kernel (wgtools
# sets the key via a separate netlink op that breaks the subsequent peer-add); the same
# conf without PrivateKey attaches + persists. This file therefore carries no secret.
[Interface]
ListenPort={{ wg_s2s_vps.listen_port }}

[Peer]
PublicKey={{ wg_s2s_vps.peer_public_key }}
AllowedIPs={% for ip in wg_s2s_vps.allowed_ips %}{{ ip }}{% if not loop.last %},{% endif %}{% endfor %}{{ '\n' }}Endpoint={{ wg_s2s_vps.endpoint }}:{{ wg_s2s_vps.listen_port }}
# HD-285: keepalive keeps the NAT-traversed S2S tunnel alive (home PPPoE WAN is
# behind CGNAT-ish/stateful NAT — without it WireGuard never initiates the
# handshake unless app traffic flows, so the tunnel stayed down silently).
PersistentKeepalive = {{ wg_persistent_keepalive }}
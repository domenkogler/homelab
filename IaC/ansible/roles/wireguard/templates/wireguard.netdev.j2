# WireGuard interface for the site-to-site tunnel (wg-s2s) — VPS side.
# .netdev is CREATE-ONLY: networkd 257 applies a [WireGuard] key but NEVER [WireGuardPeer]
# and OWNS the iface — userspace `wg set peer` is removed within seconds. networkd only here
# creates wg-s2s; the wg-ensure-s2s-peer oneshot owns key + peer (.network: Unmanaged).
[NetDev]
Name={{ wg_interface }}
Kind=wireguard
Description=VPS <-> home router S2S tunnel (oneshot-managed)
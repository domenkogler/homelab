# WireGuard .network for the site-to-site tunnel (wg-s2s) — VPS side.
# HD-285: networkd must NOT configure wg-s2s — the wg-ensure-s2s-peer oneshot
# owns the interface (create-if-missing, key + peer). This .network marks it
# Unmanaged so networkd never re-applies a peer-less config. The /30 address is
# applied by the oneshot too (from the conf); not here.
[Match]
Name={{ wg_interface }}

[Network]
Unmanaged=yes

[Link]
RequiredForOnline=no
# WireGuard .network for the site-to-site tunnel (wg-s2s) — VPS side.
# networkd must NOT configure wg-s2s — the wg-ensure-s2s-peer oneshot owns the
# interface (create-if-missing, key + peer, /30 address). Unmanaged here so networkd
# never re-applies a peer-less config.
[Match]
Name={{ wg_interface }}

[Network]
Unmanaged=yes

[Link]
RequiredForOnline=no
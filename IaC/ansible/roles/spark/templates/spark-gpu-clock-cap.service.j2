[Unit]
# GB10 has no power-limit control at all (`nvidia-smi -pl` unsupported, `power.limit` reads N/A) and no
# writable temperature target either (GPU Target / Slowdown / Shutdown T.Limit all read N/A — probed
# 2026-09-28), so a graphics-clock CEILING is the only software power/thermal lever on this SoC. See
# docs/hardware-spark.md §GPU clock cap for why the ceiling sits at the default application clock.
Description=spark GB10 GPU graphics-clock cap ({{ spark_gpu_clock_cap_mhz }} MHz) — the only power lever on this SoC
# The cap is driver state, not persistent hardware config: it is LOST on every boot, and
# this box has a documented history of hard power-cycles (docs/hardware-spark.md §As-measured
# SMART row). Without this unit the cap only exists until the next power event.
After=systemd-modules-load.service
# Condition* is a SILENT skip, so it is only honest beside a loud half: the role's tasks read
# clocks.max.sm back and ASSERT it, and they fail outright if nvidia-smi is missing. The path is
# hard-coded on purpose (verified on the box 2026-09-28: `command -v nvidia-smi` → /usr/bin/nvidia-smi
# itself, owned by nvidia-utils-580) — a path nobody overrides is dead config, and this role has
# already removed one piece of it. If DGX OS relocates the binary, fix it here and in tasks/, in review.
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -lgc {{ spark_gpu_clock_cap_mhz }}
# Hand the clocks back on stop, so `spark_gpu_clock_cap_enable: false` (which drives
# `state: stopped` in tasks/) genuinely UNDOES the cap instead of leaving it pinned forever.
ExecStop=/usr/bin/nvidia-smi -rgc
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target

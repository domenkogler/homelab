# SPDX-License-Identifier: Apache-2.0
# spark-profile-fast8 — the UltraFast patch stack re-anchored on the v0.32 base image.
#
# WHAT THIS IS. The same patch stack as upstream's `Dockerfile.iter6c` + `Dockerfile.iter6d`, in
# upstream's own step order, with the anchors that the v0.32 layout moved. One layer instead of two:
# a two-layer build needs an intermediate tag, and a tag is only ever a name to write, so a single
# layer removes a name this lineage could otherwise get wrong. Nothing here is a new idea — every
# step exists upstream; only paths, class names and constants are re-anchored, plus the two steps
# whose anchor v0.32.0 already fixed or moved (flagged in place, each with a guard that proves the
# claim at build time).
#
# PROVENANCE. Every anchor below carries the v0.32.0 evidence for it (`path:line` of the upstream tag
# source, or the HTTP status of the path). Anchors that could NOT be proven offline live in
# spark/reports/hd1206-v32-port-20261026/README.md, and a step whose patcher is anchor-asserting
# (upstream's own `assert n == 1, "anchor found N times (want 1)"` in its patchers) fails the build
# loudly if that patcher's code anchor moved — which is the safe direction.
#
# NEVER `docker build` this file by hand: the ARGs are rendered from group_vars by
# roles/spark-profile-fast8, so the base digest and the output tag exist in exactly one place.
# Shape of the command (values from group_vars/all/versions.yml):
#   docker build --network none --pull=false -f Dockerfile.v32 \
#     --build-arg BASE=<spark_vllm_v32_base_image> --build-arg MAMBA_UTILS_GUARD=<see step 7> \
#     -t <spark_vllm_ultrafast_v32_tag> .

# No default on purpose: the base digest is the pin in group_vars/all/versions.yml, and a default
# here would be a second copy of it that can drift. Omit --build-arg BASE and the build stops at FROM.
ARG BASE
FROM ${BASE}

# ${SP}: python3.12 site-packages — v0.32.0 docker/Dockerfile:25-26 pins CUDA 13.0.3 / Python 3.12.
ARG SP=/usr/local/lib/python3.12/dist-packages
# The model package is `vllm/models/qwen4_exp/…` at v0.32.0. Evidence:
#   vllm/models/qwen3_8_flash_next/nvidia/ple_layer.py -> HTTP 404 at the tag
#   vllm/models/qwen4_exp/nvidia/ple_layer.py          -> HTTP 200, class Qwen4ExpPLELayer:65
#   vllm/models/qwen4_exp/nvidia/model.py              -> HTTP 200, class Qwen4ExpForCausalLM:693
#   vllm/models/qwen4_exp/nvidia/mtp.py                -> HTTP 200, class Qwen4ExpMTP:400
ARG PLE=${SP}/vllm/models/qwen4_exp/nvidia/ple_layer.py
ARG MODEL_PY=${SP}/vllm/models/qwen4_exp/nvidia/model.py
ARG MTP_PY=${SP}/vllm/models/qwen4_exp/nvidia/mtp.py
# model_state.py is where the n-gram prefetch hook lives; class Qwen4ExpModelState:17, prepare_inputs:95
ARG MODEL_STATE=${SP}/vllm/models/qwen4_exp/nvidia/model_state.py
ARG GPTQ_PY=${SP}/vllm/model_executor/layers/quantization/auto_gptq.py
ARG FLA_UTILS=${SP}/vllm/third_party/flash_linear_attention/ops/utils.py
ARG FLA_CDH=${SP}/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py
ARG MAMBA_UTILS=${SP}/vllm/v1/worker/mamba_utils.py
# The scheduler's KV-config call site — step 5's guard reads it, nothing else in this file does.
ARG SCHED=${SP}/vllm/v1/core/sched/scheduler.py
# The low-latency GEMM's own gate — step 14's guard reads it, nothing else in this file does. Evidence:
#   vllm/models/qwen4_exp/nvidia/low_latency_gemm.py -> HTTP 200 at the tag; gate def :375, its
#   condition :382, the capability-keyed plan table :294-300, the GB10 entry's own dict :171-172
ARG LLG=${SP}/vllm/models/qwen4_exp/nvidia/low_latency_gemm.py

# ---- 1. PLE n-gram table from disk (VLLM_PLE_MMAP=1) ----
# src/vllm_ple_mmap.py here is the STAGED copy, already re-anchored by port_v32.py: its
# `vllm.models.qwen3_8_flash_next.nvidia.model_state` import becomes
# `vllm.models.qwen4_exp.nvidia.model_state` (proven: model_state.py exists at the tag, 200).
COPY src/vllm_ple_mmap.py ${SP}/vllm_ple_mmap.py
# The appended line names the class the hook wraps. At v0.32.0 that class is
# `Qwen4ExpNGramEmbedding`, imported into ple_layer.py's OWN namespace at
# vllm/models/qwen4_exp/nvidia/ple_layer.py:29 (`from .ngram_embedding import …`) — so the name is
# bound in the module the append is written into. Both pre-greps are what make a moved anchor loud
# here instead of a NameError at the first boot.
RUN test -f ${PLE} \
 && grep -q 'class Qwen4ExpPLELayer' ${PLE} \
 && grep -q 'Qwen4ExpNGramEmbedding' ${PLE} \
 && cp ${PLE} ${PLE}.orig \
 && printf '\n\n# --- qwen38-flash-dgx: serve the PLE n-gram table from disk (VLLM_PLE_MMAP=1) ---\nfrom vllm_ple_mmap import apply as _ple_mmap_apply\n_ple_mmap_apply(Qwen4ExpNGramEmbedding)\n' >> ${PLE} \
 && grep -q '_ple_mmap_apply(Qwen4ExpNGramEmbedding)' ${PLE} \
 && python3 -c "import ast; ast.parse(open('${PLE}').read()); print('ple_layer.py patched OK')"

# ---- 2. GB10 shared-memory constant (the fla backend table) ----
# sed exits 0 when it matches nothing, so the constant is counted BEFORE the substitution and the
# marker is grepped after: `test -eq 1` fails if upstream moved or duplicated the line, and the
# post-grep fails if the substitution did not land. The target value is the same box's ADA entry in
# the same enum (vllm/third_party/flash_linear_attention/ops/utils.py:180 `ADA = 101376`); the line
# being rewritten is :183 `DEFAULT = 102400`.
RUN test "$(grep -c '^    DEFAULT = 102400' ${FLA_UTILS})" -eq 1 \
 && sed -i 's|^    DEFAULT = 102400.*$|    DEFAULT = 101376  # spark-fla-shmem: GB10 99KiB = ADA, big GDN tiles fit|' ${FLA_UTILS} \
 && grep -q 'spark-fla-shmem' ${FLA_UTILS} \
 && ! grep -q 'DEFAULT = 102400' ${FLA_UTILS} \
 && echo "fla shmem gate patched"

# ---- 3. Blackwell tl.dot race: pin the autotune to num_warps 2 (fla#953) ----
# Anchor proven at v0.32.0 vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py:37
# (`for num_warps in [2, 4]`, exactly one occurrence in that file).
RUN test "$(grep -c 'for num_warps in \[2, 4\]' ${FLA_CDH})" -eq 1 \
 && sed -i 's|for num_warps in \[2, 4\]|for num_warps in [2]  # spark-fla-warps: fla#953 Blackwell tl.dot race|' ${FLA_CDH} \
 && grep -q 'spark-fla-warps' ${FLA_CDH} \
 && ! grep -q 'for num_warps in \[2, 4\]' ${FLA_CDH} \
 && echo "fla num_warps pinned"

# ---- 4. int4+fp8 hybrid dispatch (VLLM_FP8_HYBRID=1) ----
# Constitutive on the AR-hybrid checkpoint: without it the boot dies at the first safetensors shard.
# vllm/model_executor/layers/quantization/auto_gptq.py: HTTP 200 at the tag (class
# AutoGPTQLinearMethod:301); the hook takes no class argument, so only the path is an anchor.
COPY src/vllm_fp8_hybrid.py ${SP}/vllm_fp8_hybrid.py
RUN test -f ${GPTQ_PY} \
 && cp ${GPTQ_PY} ${GPTQ_PY}.orig \
 && printf '\n\n# --- qwen38-flash-dgx: int4+fp8 hybrid dispatch (VLLM_FP8_HYBRID=1) ---\nfrom vllm_fp8_hybrid import apply as _fp8_hybrid_apply\n_fp8_hybrid_apply()\n' >> ${GPTQ_PY} \
 && grep -q '_fp8_hybrid_apply()' ${GPTQ_PY} \
 && python3 -c "import ast; ast.parse(open('${GPTQ_PY}').read()); print('auto_gptq.py patched OK')"

# ---- 5. The never-evict plumbing — applied here, while the flag itself stays rejected ----
# Upstream's patch_never_evict.py adds `--never-evict-kv-cache-*`. Nothing in this repository renders
# the pair: the flag is REJECTED (docs/services-ai-rejected.md — zero blocks reserved, prefix caching
# already serves 95.1 %), every profile's never_evict_prompt is the EMPTY anchor so the compose
# template renders no pair (IaC/ansible/templates/docker_services/spark-ai/docker-compose.yml.j2:83),
# and spark_llm_never_evict_capable_images names `ultrafast` alone, so roles/spark-llm-profile and
# scripts/gate/check_spark_llm_gate.py refuse the flag on any other lineage. A re-decide edits that
# list in review; it does not inherit a patcher from this step.
# The RULED port (owner ruling, report §7b: port everything, drop nothing) ships the patch set as
# it stands, so the image carries the plumbing and nothing renders the dial — a statement about the
# artifact, not a revival of the flag: `spark_llm_never_evict_prompt` stays "" and stays rejected.
# Its one moved anchor is re-anchored in port_v32.py: v0.32 inserted
# `enable_mamba_shared_prefix_checkpoint=( … ),` between the watermark argument and the closing paren
# at v1/core/sched/scheduler.py:342-345, which is the two-line sequence the day-0 patcher opened on.
# The three counts are that patch read in the finished layer, so "plumbing present, dial unreadable"
# is proved by the build rather than asserted by a comment.
COPY src/patch_never_evict.py /tmp/patch_never_evict.py
RUN python3 /tmp/patch_never_evict.py \
 && test "$(grep -c -F 'never_evict_kv_cache_prompt_includes' ${SP}/vllm/config/cache.py)" -eq 2 \
 && test "$(grep -c -F 'never-evict-kv-cache' ${SP}/vllm/engine/arg_utils.py)" -eq 2 \
 && test "$(grep -c -F '_pin_needle' ${SCHED})" -eq 5 \
 && echo "never-evict: plumbing applied at this base; the dial stays rejected and empty" \
 && rm /tmp/patch_never_evict.py

# ---- 6. lm_head under the checkpoint's quant config (model.py + mtp.py) ----
# Anchor proven at both call sites, one occurrence per file:
#   vllm/models/qwen4_exp/nvidia/model.py:740   (12-space indent, vllm_config in scope at :730)
#   vllm/models/qwen4_exp/nvidia/mtp.py:432     (20-space indent, vllm_config in scope at :421)
# Unlike upstream's single `grep -c` over BOTH files (which exits 0 if either file matched), each
# file is counted separately here, so a patch that lands in one file and misses the other cannot
# pass.
RUN test -f ${MODEL_PY} && test -f ${MTP_PY} \
 && test "$(grep -cF 'prefix=maybe_prefix(prefix, "lm_head"),' ${MODEL_PY})" -eq 1 \
 && test "$(grep -cF 'prefix=maybe_prefix(prefix, "lm_head"),' ${MTP_PY})" -eq 1 \
 && cp ${MODEL_PY} ${MODEL_PY}.orig && cp ${MTP_PY} ${MTP_PY}.orig \
 && sed -i 's|prefix=maybe_prefix(prefix, "lm_head"),|quant_config=vllm_config.quant_config,\n            prefix=maybe_prefix(prefix, "lm_head"),|' ${MODEL_PY} \
 && sed -i 's|prefix=maybe_prefix(prefix, "lm_head"),|quant_config=vllm_config.quant_config,\n                    prefix=maybe_prefix(prefix, "lm_head"),|' ${MTP_PY} \
 && grep -q 'quant_config=vllm_config.quant_config' ${MODEL_PY} \
 && grep -q 'quant_config=vllm_config.quant_config' ${MTP_PY} \
 && python3 -c "import ast; [ast.parse(open(p).read()) for p in ('${MODEL_PY}','${MTP_PY}')]; print('lm_head patched OK in model.py + mtp.py')"

# ---- 7. The mamba state-copy guard, ported onto this base's own file ----
# Upstream's step is a WHOLE-FILE COPY of their `mamba_utils_guarded.py` over the image's
# `vllm/v1/worker/mamba_utils.py`. That snapshot is the DAY-0 file plus the guard — 1641 lines
# against this base's 1654, 329 changed lines over 39 hunks — and the delta is three layers, not one
# (report §7 reads it inside the base image at the pin digest):
#   * the guard itself is snapshot-side only: `guard_hits` 0, `state_num_blocks` 0 in this base, so
#     the base will never supply it and it is owed,
#   * v0.32 ADDS `get_aligned_state_indices_multi_group_kernel` (:39), `_reinterpret_u64_as_i64`
#     (:185) and `compute_aligned_state_indices` (:1106), none of which the snapshot has seen,
#   * v0.32 DELETED the day-0 `*_mamba_all*` pair that the snapshot still carries, and re-typed
#     `postprocess_mamba_align_gpu`'s `input_batch` to `InputBatch` (:1449) where the snapshot says
#     `GPUInputBatch`, a class this base does not import.
# So the copy is a three-layer revert, which is the one failure mode a green build cannot show. The
# guard is ported instead by patch_mamba_guard_v32.py: 13 anchors, each carrying the v0.32.0
# file:line it was read at, all counts measured before anything is written, and the guard's 31 lines
# landing byte-for-byte where the day-0 file has them. The kernels' only other referent,
# v1/worker/gpu/model_states/mamba_hybrid.py, reaches them through `run_fused_precopy` / :222 and
# `run_fused_postprocess_align` / :396 — signatures this patch does not change.
#
# MAMBA_UTILS_GUARD is tri-state and the shipped value is `patch`
# (roles/spark-profile-fast8/defaults/main.yml):
#   patch  — run the patcher, then count the FINISHED file in both directions. The default.
#   apply  — the revert-to-copy escape hatch: prints what it costs, then puts the snapshot over the
#            file. An owner act, recorded in its own commit, for a base where the port cannot work.
#   refuse — stop the build. Any value that is neither `patch` nor `apply` also stops it, so a typo
#            cannot pick a side silently.
# The post-greps read the file, not the patcher's stdout: 19 and 12 are the day-0 artifact's own
# `grep -c -F` counts, i.e. what the live `fast` image answers today, so the port can be compared
# against the guard that lineage runs on rather than trusted.
ARG MAMBA_UTILS_GUARD=patch
# The snapshot is `apply`'s input only, so the step ends by removing it: the finished layer keeps no
# copy of a 1641-line file that `patch` never reads. A COPY cannot be gated on an ARG, so what that
# does not buy is independence from the file's existence — if the checkout ever drops
# `src/mamba_utils_guarded.py`, this COPY is where a `patch` build stops, not any check in the step
# (which no longer touches the file in `patch` mode, and `test -f`s it in `apply`); the fix then is
# to delete the hatch in its own commit, not to stub the COPY.
COPY src/mamba_utils_guarded.py /tmp/mamba_utils_guarded.py
COPY patch_mamba_guard_v32.py /tmp/patch_mamba_guard_v32.py
RUN test -f ${MAMBA_UTILS} \
 && if [ "${MAMBA_UTILS_GUARD}" = "refuse" ]; then \
      echo 'REFUSED: MAMBA_UTILS_GUARD=refuse stops this build. The shipped value is "patch", which'; \
      echo 'ports the guard onto' ${MAMBA_UTILS} 'with anchored insertions; "apply" is the'; \
      echo 'revert-to-copy hatch below. Either is a deliberate value in'; \
      echo 'roles/spark-profile-fast8/defaults/main.yml, never a flag on a one-off build.'; \
      exit 1; \
    fi \
 && if [ "${MAMBA_UTILS_GUARD}" != "patch" ] && [ "${MAMBA_UTILS_GUARD}" != "apply" ]; then \
      echo 'REFUSED: MAMBA_UTILS_GUARD=' "'${MAMBA_UTILS_GUARD}'" 'is neither "patch" nor "apply".'; \
      echo 'An unrecognised value must not choose a side by accident.'; \
      exit 1; \
    fi \
 && if [ "${MAMBA_UTILS_GUARD}" = "apply" ]; then \
      test -f /tmp/mamba_utils_guarded.py \
      && cp ${MAMBA_UTILS} ${MAMBA_UTILS}.orig \
      && echo 'APPLY — the whole-file copy. It costs three layers at once:' \
      && echo '  1. it adds the guard, which IS what is owed (this base has 0 occurrences of it),' \
      && echo '  2. it reinstalls the day-0 *_mamba_all* pair that v0.32 deleted, and' \
      && echo '  3. it deletes get_aligned_state_indices_multi_group_kernel and' \
      && echo '     compute_aligned_state_indices, and re-types the input_batch argument of' \
      && echo '     postprocess_mamba_align_gpu back to GPUInputBatch, which this base does not import' \
      && cp /tmp/mamba_utils_guarded.py ${MAMBA_UTILS} \
      && DRIFT=$(diff -u ${MAMBA_UTILS}.orig ${MAMBA_UTILS} | grep -c '^[+-]' || true) \
      && echo "  ${DRIFT} changed lines against this image's own copy (329 at the read; record it)" \
      && echo 'mamba_utils.py: day-0 snapshot installed — this image is NOT the ported lineage'; \
    else \
      python3 /tmp/patch_mamba_guard_v32.py \
      && test "$(grep -c -F 'guard_hits' ${MAMBA_UTILS})" -eq 19 \
      && test "$(grep -c -F 'state_num_blocks' ${MAMBA_UTILS})" -eq 12 \
      && test "$(grep -c -F 'tl.atomic_add(guard_hits_ptr, 1)' ${MAMBA_UTILS})" -eq 4 \
      && test "$(grep -c -F 'postprocess_mamba_all' ${MAMBA_UTILS})" -eq 0 \
      && test "$(grep -c -F 'preprocess_mamba_all_specdec' ${MAMBA_UTILS})" -eq 0 \
      && test "$(grep -c -F 'GPUInputBatch' ${MAMBA_UTILS})" -eq 0 \
      && test "$(grep -c -F 'get_aligned_state_indices_multi_group_kernel' ${MAMBA_UTILS})" -eq 2 \
      && test "$(grep -c -F 'compute_aligned_state_indices' ${MAMBA_UTILS})" -eq 2 \
      && echo 'mamba_utils.py: guard ported onto this base, day-0 pair still absent, v0.32 kernels intact'; \
    fi \
 && python3 -c "import ast; ast.parse(open('${MAMBA_UTILS}').read()); print('mamba_utils.py parses')" \
 && rm /tmp/patch_mamba_guard_v32.py /tmp/mamba_utils_guarded.py

# ---- 8–10. The three host-side patchers upstream runs verbatim ----
# Each targets model-agnostic vllm paths that exist at the tag (kv_cache_coordinator,
# single_type_kv_cache_manager, block_pool, scheduler, v1/worker/gpu/model_states/mamba_hybrid.py
# :74 class MambaHybridModelState, v1/worker/gpu/model_runner.py:193 class GPUModelRunner) and each
# asserts its own anchors are unique, so base drift stops the build instead of shipping.
COPY src/patch_hit_debug.py /tmp/patch_hit_debug.py
RUN python3 /tmp/patch_hit_debug.py && rm /tmp/patch_hit_debug.py

COPY src/patch_mamba_align_split.py /tmp/patch_mamba_align_split.py
RUN python3 /tmp/patch_mamba_align_split.py && rm /tmp/patch_mamba_align_split.py

COPY src/patch_step_profile.py /tmp/patch_step_profile.py
RUN python3 /tmp/patch_step_profile.py && rm /tmp/patch_step_profile.py

# ---- 11. Reduced MTP draft vocabulary (VLLM_MTP_DRAFT_VOCAB) ----
# The wrapped class is `Qwen4ExpMTP` at v0.32.0 — proven twice: the class definition at
# vllm/models/qwen4_exp/nvidia/mtp.py:400 and the model registry entry
# vllm/model_executor/models/registry.py:696 ("Qwen4ExpMTP" -> vllm.models.qwen4_exp).
COPY src/draft_vocab_common.py ${SP}/draft_vocab_common.py
COPY src/vllm_mtp_draft_vocab.py ${SP}/vllm_mtp_draft_vocab.py
RUN test -f ${MTP_PY} \
 && grep -q 'class Qwen4ExpMTP' ${MTP_PY} \
 && printf '\n\n# --- qwen38-flash-dgx: reduced MTP draft vocabulary (VLLM_MTP_DRAFT_VOCAB) ---\nfrom vllm_mtp_draft_vocab import apply as _mtp_draft_vocab_apply\n_mtp_draft_vocab_apply(Qwen4ExpMTP)\n' >> ${MTP_PY} \
 && grep -q '_mtp_draft_vocab_apply(Qwen4ExpMTP)' ${MTP_PY} \
 && python3 -c "import ast; ast.parse(open('${MTP_PY}').read()); print('mtp.py draft-vocab hook patched OK')"

# ---- 12. The short-conv async H2D patch — NOT applied, and the build proves why ----
# Upstream's patch_short_conv_async_h2d.py rewrites two blocking `.to(device)` transfers in the
# short-conv metadata builder. v0.32.0 already does the async transfer for BOTH of them:
# vllm/v1/attention/backends/short_conv_attn.py:334 and :337 are `async_tensor_h2d(` calls, so the
# day-0 anchor is gone and running that patcher here would only produce a confusing failure. The
# grep below is the guard for that claim: if a future base loses the async transfer, the build stops
# and says so instead of quietly serving a blocking transfer.
RUN grep -q 'spec_req_idx = async_tensor_h2d(' ${SP}/vllm/v1/attention/backends/short_conv_attn.py \
 && echo "short-conv async H2D: already upstream at this base, patcher not applied"

# ---- 13–17. The rest of upstream's patchers, verbatim ----
# Each is the STAGED copy of a day-0 file: the one target path v0.32 moved is re-anchored in
# port_v32.py and everything else runs as the recipe wrote it. Step 14 is the exception, and it is
# written up in its own block below — a plain comment, not a step header, so the census keeps
# attributing these four patchers to 13–17.
# patch_in_proj_ba_gemv.py appends `_in_proj_ba_gemv_apply(QwenGatedDeltaNetAttention)` to
# vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py — class proven at that file:454.
COPY src/patch_measure_draft_mass.py /tmp/patch_measure_draft_mass.py
RUN python3 /tmp/patch_measure_draft_mass.py && rm /tmp/patch_measure_draft_mass.py

# 14. The SM12x low-latency GEMM gate — SUBSUMED by this base's plan table, and the build proves it
# (a comment, not a step header: these legs still belong to the 13–17 block the census reads)
# Upstream's patch_low_latency_gemm_sm12x.py widened a gate this base does not have. Its day-0 side
# was `if dtype != torch.bfloat16 or not _is_sm103():` with `_is_sm103()` = `is_device_capability((10,
# 3))`; at v0.32.0 that whole shape is replaced by a plan table keyed on device capability —
# QWEN4_EXP_GEMM_PLANS_BY_CAPABILITY (:294-300), whose (12, 1) entry is QWEN4_EXP_SM121_GEMM_PLANS
# (:171-172, its own comment: "DGX Spark (GB10) plans for TP=1 and TP=2 local shapes"), reached
# through _runtime_ok (:308-317) and gated bf16-only by enable_qwen4_exp_low_latency_gemm (:375,
# condition :382). RULED A+ (owner; report §7b): subsumed, so this step applies NOTHING
# and guards the POST-state — §7b's rule 1, the shape step 12 uses — which is why a patcher that is
# still staged is named here and run nowhere. That is the sanctioned short_conv shape, not a drop,
# so the port-everything ruling holds.
#
# Subsumption is a fact about this box, read not inferred: `nvidia-smi --query-gpu=compute_cap`
# answers 12.1 on the GB10, so the day-0 predicate (10, 3) was never true here and day-0 `fast` took
# the F.linear fallback on every call — R3's block could not fire on this hardware even at day 0.
# What the base keys its plans by is the capability this box actually reports, so the effect the
# patcher existed to install is already the code path. Whether the (12, 1) plan is TAKEN at runtime
# is a dispatch question, and the flip window owes a check for it; a build cannot answer it.
# The three counts are that claim read in the layer: drop the (12, 1) entry, rename its plan dict, or
# re-widen the bf16 return and the build stops here instead of shipping an image whose GEMM path is
# a mystery. The `QWEN38NEXT_LOW_LATENCY_GEMM` dial is deliberately NOT read here — 0 files in the
# installed tree name it (report §7b), so it is set by the profile and unread at this base.
RUN test "$(grep -c -F 'if dtype != torch.bfloat16 or not plans:' ${LLG})" -eq 1 \
 && test "$(grep -c -F '(12, 1): QWEN4_EXP_SM121_GEMM_PLANS' ${LLG})" -eq 1 \
 && test "$(grep -c -F 'QWEN4_EXP_SM121_GEMM_PLANS: dict' ${LLG})" -eq 1 \
 && echo "R3 subsumed (GB10 12.1 ⊄ (10,3); plans keyed by capability): bf16-only return + the (12, 1) GB10 plan entry present, patcher not applied"

COPY src/vllm_inproj_ba_gemv.py ${SP}/vllm_inproj_ba_gemv.py
COPY src/patch_in_proj_ba_gemv.py /tmp/patch_in_proj_ba_gemv.py
RUN python3 /tmp/patch_in_proj_ba_gemv.py && rm /tmp/patch_in_proj_ba_gemv.py

COPY src/patch_ple_rendezvous.py /tmp/patch_ple_rendezvous.py
RUN python3 /tmp/patch_ple_rendezvous.py && rm /tmp/patch_ple_rendezvous.py

COPY src/patch_verify_topk_pivot.py /tmp/patch_verify_topk_pivot.py
RUN python3 /tmp/patch_verify_topk_pivot.py && rm /tmp/patch_verify_topk_pivot.py

# ---- 18–19. What Dockerfile.iter6d added on top (merged into this layer) ----
COPY src/patch_block_drop.py /tmp/patch_block_drop.py
RUN python3 /tmp/patch_block_drop.py && rm /tmp/patch_block_drop.py

COPY src/patch_r7_logger.py /tmp/patch_r7_logger.py
RUN python3 /tmp/patch_r7_logger.py && rm /tmp/patch_r7_logger.py

# Every patched module must at least parse. This is upstream's own gate shape (`ast.parse` after
# each append), applied once more to the finished layer over the files this lineage touched.
RUN python3 -c "import ast; [ast.parse(open(p).read()) for p in ('${PLE}','${MODEL_PY}','${MTP_PY}','${GPTQ_PY}','${SP}/vllm_ple_mmap.py','${SP}/vllm_fp8_hybrid.py','${SP}/vllm_inproj_ba_gemv.py','${SP}/draft_vocab_common.py','${SP}/vllm_mtp_draft_vocab.py')]; print('every patched module parses')"

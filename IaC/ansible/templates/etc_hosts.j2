{{ ansible_managed | comment }}
127.0.0.1   localhost
::1         localhost ip6-localhost ip6-loopback

# All *.kogler.si hostnames are resolved by Technitium DNS (split-horizon).
# Static entries below are bootstrap-only — keep in sync with inventory.ini.
# See docs/network-dns.md for the full DNS architecture.
# SSOT: network_static_hosts (group_vars/all/main.yml) — per-host IP by short
# name + preferred VLAN (Home 10 for LAN hosts, Mgmt 99 for network gear), so
# this renders correctly regardless of which hosts Ansible gathered in a
# --limit run (hostvars ansible_host leaks a per-run override to every entry, so a host
# can resolve to another host's IP and its clients fail with 'Connection refused').
{% for host in groups['all'] %}
{% if host != 'localhost' %}
{% set short = host.split('.')[0] %}
{% if short == 'router' or short == 'switch' or short == 'ups' or short == 'ilo' %}
{% set ns = network_static_hosts | selectattr('name', 'equalto', short) | selectattr('vlan', 'equalto', 99) | list %}
{% else %}
{% set ns = network_static_hosts | selectattr('name', 'equalto', short) | selectattr('vlan', 'equalto', 10) | list %}
{% endif %}
{% if ns | length > 0 %}
{{ ns[0].ip }}  {{ host }} {{ short }}
{% endif %}
{% endif %}
{% endfor %}

{{ ansible_managed | comment }}
# Homepage status widgets — auto-generated by docker_services post-deploy hook.
# See docs/interfaces.md and docs/observability.md.
#
# HD-316: reachability + resource widgets.
#   - resources: VPS CPU/RAM/disk gauges (Homepage resource widget reads the host
#     the container runs on — the VPS, per HD-135b VPS-residency of homepage).
#   - siteMonitor reachability for the PUBLIC service set (family + technical
#     lanes that are publicly routable). Tailnet-only FQDNs are deliberately NOT
#     monitored here — the homepage container is not a tailnet node (it would
#     render permanent false-red dots); their health lives in Grafana (stats).

- resources:
    cpu: true
    memory: true
    disk: /

# Reachability (siteMonitor) — public CNAMEs the homepage container can resolve.
# Grouped by the same families as services.yaml so family users see one health
# story. Costs 1 probe/second each; keep the set to the family-critical public
# apps (observability.md reachability policy: blackbox probe_success is the
# authoritative probe; Homepage widget is the eyeball view).
- Site Monitor:
    - kogler.si:
        icon: fa-home
        href: https://{{ domain_local | default('kogler.si') }}
    - sso.kogler.si:
        icon: fa-user-lock
        href: https://sso.{{ domain_local | default('kogler.si') }}
    - foto.kogler.si:
        icon: fa-images
        href: https://foto.{{ domain_local | default('kogler.si') }}
    - file.kogler.si:
        icon: fa-folder-open
        href: https://file.{{ domain_local | default('kogler.si') }}
    - git.kogler.si:
        icon: fa-git
        href: https://git.{{ domain_local | default('kogler.si') }}
    - chat.kogler.si:
        icon: fa-comments
        href: https://chat.{{ domain_local | default('kogler.si') }}
    - bin.kogler.si:
        icon: fa-link
        href: https://bin.{{ domain_local | default('kogler.si') }}
    - drop.kogler.si:
        icon: fa-upload
        href: https://drop.{{ domain_local | default('kogler.si') }}
    - office.kogler.si:
        icon: fa-file
        href: https://office.{{ domain_local | default('kogler.si') }}
    - pdf.kogler.si:
        icon: fa-file-pdf
        href: https://pdf.{{ domain_local | default('kogler.si') }}
    - vpn.kogler.si:
        icon: fa-network-wired
        href: https://vpn.{{ domain_local | default('kogler.si') }}

# ---- Renewals calendar widget ----
# Shows upcoming subscription renewals pulled from iCal/CalDAV feeds
# (group_vars/subscriptions.yml `calendar_url`). Rendered only for subscriptions
# that have a feed URL set — i.e. AFTER deployment when CalDAV (Infomaniak kSuite,
# HD-30) is live. Until then this block produces no widgets (infra-only).
{% set with_cal = subscriptions | selectattr('calendar_url', 'defined') | selectattr('calendar_url') | list %}
{% if with_cal | length > 0 %}
- calendar:
{% for s in with_cal %}
    - {{ s.name | replace(' ', '-') | lower }}:
        url: {{ s.calendar_url }}
{% endfor %}
{% endif %}
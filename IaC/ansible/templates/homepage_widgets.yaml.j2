{{ ansible_managed | comment }}
# Homepage status widgets — auto-generated by docker_services post-deploy hook.
# See docs/interfaces.md and docs/observability.md.
#
# Reachability + resource widgets.
#   - resources: VPS CPU/RAM/disk gauges (Homepage resource widget reads the host
#     the container runs on — the VPS, where homepage runs).
#   - siteMonitor reachability for the PUBLIC service set (family + technical
#     lanes that are publicly routable). Tailnet-only FQDNs are deliberately NOT
#     monitored here — the homepage container is not a tailnet node (it would
#     render permanent false-red dots); their health lives in Grafana (stats).
{% set d = domain_local | default('kogler.si') %}

- resources:
    cpu: true
    memory: true
    disk: /

# Reachability (siteMonitor) — public CNAMEs the homepage container can resolve.
# The list is `homepage_probe_hosts` (group_vars/vps.yml), so the widget and the tiles can
# never disagree about what is probeable. Costs 1 probe/second each; keep the set to the
# family-critical public apps (observability.md reachability policy: blackbox probe_success is
# the authoritative probe; Homepage widget is the eyeball view).
{% set probe_icons = {
     'kogler.si': 'mdi-home',
     'sso': 'mdi-account-lock',
     'foto': 'mdi-image-multiple',
     'file': 'mdi-folder-open',
     'git': 'mdi-git',
     'chat': 'mdi-comment-text-outline',
     'bin': 'mdi-link',
     'drop': 'mdi-upload',
     'office': 'mdi-file',
     'pdf': 'mdi-file-pdf-box',
     'vpn': 'mdi-lan',
     'media': 'mdi-film-roll' } %}
{% set probe_hosts = homepage_probe_hosts | default(['kogler.si', 'sso', 'foto', 'file', 'git', 'chat', 'bin', 'drop', 'office', 'pdf', 'vpn', 'media']) %}
{% set immich_host = (homepage_immich_url | default('https://foto.' ~ d)).split('//')[1].split('/')[0] %}
- Site Monitor:
{% for h in probe_hosts %}
{% set target = immich_host if h == 'foto' else (h ~ '.' ~ d if h != d else h) %}
    - {{ target }}:
        icon: {{ probe_icons[h] | default('mdi-web') }}
        href: https://{{ target }}
{% endfor %}

# ---- Renewals calendar widget ----
# Shows upcoming subscription renewals pulled from iCal/CalDAV feeds
# (group_vars/subscriptions.yml `calendar_url`). Rendered only for subscriptions
# that have a feed URL set — a subscription without a CalDAV (Infomaniak kSuite)
# feed produces no widget here (infra-only).
{% set with_cal = subscriptions | selectattr('calendar_url', 'defined') | selectattr('calendar_url') | list %}
{% if with_cal | length > 0 %}
- calendar:
{% for s in with_cal %}
    - {{ s.name | replace(' ', '-') | lower }}:
        url: {{ s.calendar_url }}
{% endfor %}
{% endif %}
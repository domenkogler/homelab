# ---- Subscriptions / renewal reminders (SSOT: group_vars/subscriptions.yml) ----
# One tile per subscription (active + planned). Soonest renewal first so the
# next due date cannot be missed, then ongoing/no-end-date entries, then planned.
# Renewals within reminder_days appear first on the home launcher (HD-133).
# Generated by the docker_services post-deploy hook; do not hand-edit.
{% set active = subscriptions | selectattr('status', 'equalto', 'active') | list %}
{% set renewing = active | selectattr('valid_until') | sort(attribute='valid_until') | list %}
{% set ongoing = active | rejectattr('valid_until') | list %}
{% set planned = subscriptions | selectattr('status', 'equalto', 'planned') | list %}
- Subscriptions:
{% for s in renewing %}
    - {{ s.name }}:
        icon: {{ s.icon | default('fa-circle') }}
        href: {{ s.url | default('#') }}
        description: "{{ '0,00 €' if s.cost_eur == 0 else '%.2f €' | format(s.cost_eur) }}/mo{% if s.valid_until %} · renews {{ s.valid_until }}{% endif %}"
{% endfor %}
{% for s in ongoing %}
    - {{ s.name }}:
        icon: {{ s.icon | default('fa-circle') }}
        href: {{ s.url | default('#') }}
        description: "{{ '0,00 €' if s.cost_eur == 0 else '%.2f €' | format(s.cost_eur) }}/mo{% if s.name == 'Telekom Slovenije (ISP)' %} · ongoing{% endif %}"
{% endfor %}
{% for s in planned %}
    - {{ s.name }} (planned):
        icon: {{ s.icon | default('fa-circle') }}
        href: {{ s.url | default('#') }}
        description: "📦 planned — buy then record here"
{% endfor %}
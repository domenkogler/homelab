{{ ansible_managed | comment }}
# Homepage service layout — auto-generated by docker_services post-deploy hook.
# Source of truth: group_vars/vps.yml docker_services list (homepage moved to the
# VPS per HD-180; implemented HD-183).
# See docs/interfaces.md for the 6-tier interface model.

# HD-17: manual HA failover buttons (docs/smart-home-failover.md). href cards call
# the ha-failover-api endpoint on oldsrv (?token= GET; POST with X-Failover-Token
# also supported). Forward REQUIRES the HmIP-RFUSB stick physically moved to oldsrv.
# Gated (HD-217): rendered only when group_var homepage_failover_button is true -
# false until HD-17 goes live (Phase 4), so no dead buttons / undefined-var lookups.
{% if homepage_failover_button %}
- Smart Home Failover:
    - HA Forward Takeover:
        icon: sh-home-assistant
        href: "http://{{ failover_api_url }}/failover?token={{ lookup('community.general.onepassword', 'ha-failover_api', field='credential', vault=op_vault) }}"
        description: Pi → oldsrv (RMat → wait CCU → VIP → HA standby)
    - HA Reverse Failback:
        icon: sh-home-assistant
        href: "http://{{ failover_api_url }}/failback?token={{ lookup('community.general.onepassword', 'ha-failover_api', field='credential', vault=op_vault) }}"
        description: oldsrv → Pi (VIP back, standby off)
{% endif %}

# TODO: full service layout — one tile per docker_services entry with a health
# check pointing at its Traefik route (6-tier model per interfaces.md). Defined here later.

# ---- Subscriptions / renewal reminders (SSOT: group_vars/subscriptions.yml) ----
# One tile per subscription (active + planned); description shows cost + renewal date.
# Renewals within reminder_days appear first on the home launcher so they cannot be missed.
# Generated by the docker_services post-deploy hook; do not hand-edit.
{% set active = subscriptions | selectattr('status', 'equalto', 'active') | list %}
{% set planned = subscriptions | selectattr('status', 'equalto', 'planned') | list %}
- Subscriptions:
{% for s in active %}
    - {{ s.name }}:
        icon: {{ s.icon | default('fa-circle') }}
        href: {{ s.url | default('#') }}
        description: "{{ '0,00 €' if s.cost_eur == 0 else '%.2f €' | format(s.cost_eur) }}/mo{% if s.valid_until %} · renews {{ s.valid_until }}{% endif %}"
{% endfor %}
{% for s in planned %}
    - {{ s.name }} (planned):
        icon: {{ s.icon | default('fa-circle') }}
        href: {{ s.url | default('#') }}
        description: "📦 planned — buy then record here"
{% endfor %}
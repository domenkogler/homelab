# openclaw docker-compose.yml — AI agent / orchestration gateway (docs/services-ai.md)
#   Family AI agent: models -> LiteLLM (spine); the OpenCloud WebDAV skill reads/writes
#   family files; it is registered as a model in LiteLLM so Open WebUI can invoke it.
#   Internal backend on services-internal — no public edge.
#
#   OpenClaw is config/onboarding-driven: it reads a schema-validated JSON5 config
#   (OPENCLAW_CONFIG_PATH) and REFUSES to start on invalid/mismatched config. The config (agent
#   loop, LiteLLM model binding, OpenCloud WebDAV credential, gateway token) is generated by
#   `openclaw onboard` / `openclaw configure` at deploy, not a static env template. This compose
#   provides the pinned gateway + state volumes; onboarding is a separate deploy step.
#
#   Secrets (fail-closed): openclaw_gateway_token, openclaw-opencloud_api; LiteLLM auth =
#     scoped virtual key `openclaw-litellm_api` (NOT litellm_api)
#   (gateway/Control-UI auth), openclaw-opencloud_api (OpenCloud WebDAV credential).
#   Image pinned via openclaw_version (GHCR; young project).
services:
  openclaw:
    image: ghcr.io/openclaw/openclaw:{{ openclaw_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: openclaw
    restart: unless-stopped
    # The gateway hard-exits without openclaw.json (generated by `openclaw onboard` at deploy).
    # --allow-unconfigured keeps the unit Up honestly-unconfigured instead of crash-looping;
    # onboarding is still required for agent use.
    command: ["node", "openclaw.mjs", "gateway", "--allow-unconfigured"]
    networks:
      - services-internal       # reach LiteLLM (models); Open WebUI consumes the agent
    extra_hosts:
      - "host.docker.internal:host-gateway"   # OpenClaw Docker-sandbox host mapping
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      OPENCLAW_HOME: /home/node
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: "{{ vault['openclaw_gateway_token'].password | replace('$','$$') }}"
      # OpenCloud WebDAV credential (app-specific password, scoped service user). Consumed by
      # `openclaw onboard` / the openclaw.json WebDAV block at deploy; fail-loud.
      OPENCLOUD_WEBDAV_USERNAME: "{{ vault['openclaw-opencloud_api'].username | replace('$','$$') }}"
      OPENCLOUD_WEBDAV_PASSWORD: "{{ vault['openclaw-opencloud_api'].credential | replace('$','$$') }}"
      # Model backend = LiteLLM (spine). OpenClaw talks to LiteLLM as an OpenAI-compatible
      # provider; the full binding set lives in openclaw.json at deploy — the credential is the
      # SCOPED virtual key minted into `openclaw-litellm_api` by the bootstrap glue
      # (agent-scope, budget-capped). The master key is never used here.
      # No host ports; the Control UI is reachable via services-internal only.
    volumes:
      - /srv/docker/openclaw:/home/node/.openclaw            # config + state (openclaw.json; include in Kopia scope)
      - /srv/docker/openclaw/workspace:/home/node/.openclaw/workspace
      - /srv/docker/openclaw/auth:/home/node/.config/openclaw # auth-profile secrets
networks:
  services-internal:
    external: true
# openclaw docker-compose.yml — AI agent / orchestration gateway (docs/services-ai.md, HD-104)
#   Ex-Clawd. Family AI agent: models -> LiteLLM (spine, HD-100); OpenCloud WebDAV skill
#   reads/writes family files; registered as a model in LiteLLM so Open WebUI (HD-101) can
#   invoke it. Internal backend on services-internal — no public edge.
#
#   NOTE (HD-104): OpenClaw is config/onboarding-driven — it reads a schema-validated JSON5
#   config (OPENCLAW_CONFIG_PATH) and REFUSES to start on invalid/mismatched config. The
#   config (agent loop, LiteLLM model binding, OpenCloud WebDAV credential, gateway token)
#   is generated by `openclaw onboard` / `openclaw configure` at deploy, not a static env
#   template. This compose provides the pinned gateway + state volumes; onboarding is the
#   deploy-gated step.
#
#   Secrets (fail-closed): litellm_master_key (backend auth), openclaw_gateway_token
#   (gateway/Control-UI auth), openclaw-opencloud_api (OpenCloud WebDAV credential, HD-160).
#   Image pinned via openclaw_version (GHCR; young project).
services:
  openclaw:
    image: ghcr.io/openclaw/openclaw:{{ openclaw_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: openclaw
    restart: unless-stopped
    # Wave-3 round-2 triage 2026-08-22: the gateway hard-exits without openclaw.json (generated
    # by `openclaw onboard`, deploy-gated HD-104). --allow-unconfigured keeps the unit Up
    # honestly-unconfigured instead of crash-looping; onboarding still required for agent use.
    command: ["node", "openclaw.mjs", "gateway", "--allow-unconfigured"]
    networks:
      - services-internal       # reach LiteLLM (models); Open WebUI consumes the agent
    extra_hosts:
      - "host.docker.internal:host-gateway"   # OpenClaw Docker-sandbox host mapping
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      OPENCLAW_HOME: /home/node
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: "{{ lookup('community.general.onepassword', 'openclaw_gateway_token', field='password', vault=op_vault) }}"
      # HD-160: OpenCloud WebDAV credential (app-specific password, scoped service user).
      # Consumed by `openclaw onboard` / `openclaw.json` WebDAV block at deploy; fail-loud.
      OPENCLOUD_WEBDAV_USERNAME: "{{ lookup('community.general.onepassword', 'openclaw-opencloud_api', field='username', vault=op_vault) }}"
      OPENCLOUD_WEBDAV_PASSWORD: "{{ lookup('community.general.onepassword', 'openclaw-opencloud_api', field='credential', vault=op_vault) }}"
      # Model backend = LiteLLM (spine). OpenClaw talks to LitLLM as an OpenAI-compatible
      # provider; full binding set in openclaw.json at deploy (LITELLM_MASTER_KEY auth).
      # No host ports (HD-62); Control UI reachable via services-internal only.
    volumes:
      - /srv/docker/openclaw:/home/node/.openclaw            # config + state (openclaw.json; include in Kopia scope)
      - /srv/docker/openclaw/workspace:/home/node/.openclaw/workspace
      - /srv/docker/openclaw/auth:/home/node/.config/openclaw # auth-profile secrets
networks:
  services-internal:
    external: true
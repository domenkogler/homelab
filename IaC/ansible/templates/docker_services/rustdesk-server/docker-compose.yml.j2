# rustdesk-server docker-compose.yml — self-hosted RustDesk rendezvous (hbbs) + relay (hbbr)
#   The family-support introduction point. The server lives on the **VPS**, never on oldsrv: a
#   rescue tool behind the thing it rescues is not a rescue, and making it reachable at home
#   would need a public listener on the crown-jewel host. Owning section:
#   docs/services-admin.md §RustDesk.
#
#   IMAGE = rustdesk/rustdesk-server-s6, the SUPERVISOR image (busybox:stable + s6-overlay).
#   hbbs and hbbr run as two supervised services in ONE container sharing one working dir
#   (/data): both binaries `cd /data` and load the SAME id_ed25519 keypair, and s6 orders hbbs
#   after `key-secret` + hbbr. The non-s6 image is two containers with no supervisor and none of
#   the env knobs below. WorkingDir /data (VOLUME), Entrypoint /init, ExposedPorts 21115-21119.
#     * HEALTHCHECK is baked into the image (`s6-svstat` on the two service dirs), so it is
#       INHERITED, not overridden: hbbs/hbbr expose no HTTP surface, so supervision state is the
#       only health signal.
#     * s6 republishes the CONTAINER environment into each service via `with-contenv`, so every
#       knob below must arrive as container env — a `.env` file would not reach them.
#
#   network_mode: host: hbbs does UDP rendezvous + TCP hole punching and must see the REAL source
#   address/port of every client to classify NAT type and punch correctly; 21115 (NAT-type test)
#   and UDP 21116 (heartbeat) are address-sensitive by protocol. Docker's userland proxy SNATs
#   container-network traffic to the bridge gateway, which destroys exactly that information, and
#   upstream specifies `--net=host` on Linux for this reason. Consequences, all accepted: NO
#   `ports:` (no DNAT — every packet hits the host INPUT chain, where roles/vps-hardening decides
#   reach), NO docker networks (no Traefik route, no CrowdSec HTTP bouncer), and the hbbs (21115)
#   / hbbr (21117) admin consoles become host-loopback-only, which is where they belong.
#
#   REACH is enforced in roles/vps-hardening/templates/nftables.conf.j2, NOT here: the input
#   policy is drop and host networking has no DNAT. Allow 21115/tcp, 21116/tcp+udp, 21117/tcp.
#   21118 (hbbs WebSocket) and 21119 (hbbr WebSocket) are DELIBERATELY NOT ALLOWED: they exist
#   only for the RustDesk web client, which is not used, and on those ports hbbs/hbbr trust
#   unvalidated `X-Real-IP`/`X-Forwarded-For` headers, so anyone who can reach them can forge the
#   client IP in logs and walk past IP-based blocking. The container still BINDS both (upstream
#   builds them in; the `-b/--bind` flag needs a newer release than the pin), so the firewall is
#   what closes them — see docs/services-admin.md §RustDesk. There is no web console: the HTTP
#   console is a **Pro** feature, and the OSS server is configured by env/flags and administered
#   over its loopback command console (`printf 'always-use-relay Y' | nc 127.0.0.1 21115`,
#   `printf 'h' | nc 127.0.0.1 21117`).
#
#   SECRETS (fail-loud, no default()) — rustdesk_login: `username` = the server PUBLIC key and
#   `password` = the server SECRET key (base64), generated once OFFLINE into the vault
#   (docs/deployment-secrets.md). The s6 `key-secret` step seeds /data only when the file is
#   absent, then chmod 0600 + `rustdesk-utils validatekeypair`, and HALTS on a half-present or
#   mismatched pair — so the live file is authoritative and editing the vault item alone changes
#   nothing. The item is NOT_AUTO_ROTATABLE: rotating it orphans every enrolled client, whose
#   saved key no longer matches. The keypair appears in `docker inspect` output (compose env),
#   so treat that output as secret-bearing.
#
#   BANDWIDTH is the real cost of this service, not RAM — quota arithmetic and the reasoning are
#   in docs/services-admin.md §Relay bandwidth cap. The caps are OSS hbbr knobs read from the
#   environment at start-up (unit = Mb/s counted as 1024² bit/s), and ALWAYS_USE_RELAY=N keeps
#   sessions on hole-punched direct paths, so the relay — and the quota — is spent only when
#   punching fails. The five caps are SSOT'd in the registry row (group_vars/vps.yml) and read as
#   svc.* here, so they stay group_vars-authored per CONVENTIONS §2.
services:
  rustdesk-server:
    image: rustdesk/rustdesk-server-s6:{{ rustdesk_server_version }}
    container_name: rustdesk-server
    restart: unless-stopped
    # Justified above (NAT/hole-punch fidelity = the upstream recommendation). No `ports:` and no
    # `networks:` — host-net makes both meaningless, and validate-docker-services.py rejects the
    # combination outright.
    network_mode: host
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Both binaries write only in /data (bind-mounted below); s6-overlay needs /run writable
    # (also /var/run via the image's symlink) and busybox wants /tmp. If an apply shows EROFS
    # anywhere else, the honest fix is a narrower tmpfs for that path — not dropping read_only.
    read_only: true
    tmpfs:
      - /tmp
      # :exec is REQUIRED, not cosmetic — s6-overlay stage0 execs /run/s6/basedir/bin/init and
      # docker's default tmpfs opts are noexec, so the container restart-loops on exit 126
      # (`/run/s6/basedir/bin/init: Permission denied`). s6 images need /run mounted with :exec.
      - /run:exec
    volumes:
      # THE state of this service: id_ed25519 + id_ed25519.pub (+ db_v2.sqlite3, blacklists).
      # Backup scope: docs/backup.md / Kopia (CONVENTIONS §5 step 6 — the keypair is also seeded
      # in 1Password, so a loss of /data is recoverable without re-enrolling clients).
      - /srv/docker/rustdesk-server/data:/data
    environment:
      TZ: "{{ timezone }}"
      # The s6 default is the placeholder `relay.example.com`, which hbbs would hand to every
      # client as their relay address — it MUST be overridden. The VPS public IPv4 is SSOT'd as
      # `dns_primary_ip` (group_vars/all/main.yml); no port suffix, because hbbr runs on its
      # default 21117 (this service never passes `-p`), so there is no tunable to keep in sync
      # with the nftables allow.
      RELAY: "{{ dns_primary_ip }}"
      # Key validation ON for BOTH servers: adds `-k _` to hbbs and hbbr. Without it the relay
      # runs with upstream's deliberate empty-key default, i.e. ANY client can relay through it.
      ENCRYPTED_ONLY: "1"
      # Direct (hole-punched) first; relay only as the fallback. Y here would put every session on
      # the VPS quota.
      ALWAYS_USE_RELAY: "N"
      # hbbr logs its effective caps at start-up (`TOTAL_BANDWIDTH: …Mb/s`) — that line is the
      # evidence the caps below actually took effect.
      RUST_LOG: "info"
      SINGLE_BANDWIDTH: "{{ svc.relay_single_mbps }}"
      TOTAL_BANDWIDTH: "{{ svc.relay_total_mbps }}"
      LIMIT_SPEED: "{{ svc.relay_limit_mbps }}"
      DOWNGRADE_THRESHOLD: "{{ svc.relay_downgrade_threshold }}"
      DOWNGRADE_START_CHECK: "{{ svc.relay_downgrade_start_check_s }}"
      # Compose-parsed text ⇒ escape `$`. A RustDesk key is base64 (`A–Z a–z 0-9 + / =`), so the
      # filter is a no-op today; it stays so a hand-pasted or re-issued value can never be
      # silently truncated by compose interpolation.
      KEY_PUB: >-
        {{ vault['rustdesk_login'].username | replace('$','$$') }}
      KEY_PRIV: >-
        {{ vault['rustdesk_login'].password | replace('$','$$') }}
    deploy:
      resources:
        limits:
          # Quoted string — compose's schema requires limits.memory to be a string.
          # Upstream's own floor for this server is "a basic cloud server… you can also use a
          # Raspberry Pi"; the relay buffers are bounded by the Mb/s caps above, so this is a
          # ceiling against a runaway process, not a working-set estimate.
          memory: "512m"

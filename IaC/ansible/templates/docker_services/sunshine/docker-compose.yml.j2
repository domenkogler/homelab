# sunshine docker-compose.yml — Game streaming host (Moonlight)
#   Manual start (restart: "no") — user stops AI containers first to free
#   AMD dGPU VRAM, then starts this container for game streaming.
#   GPU encoding via /dev/dri (VAAPI/AMF). Needs /dev/uinput for virtual gamepad.
#   No Traefik labels (not running unless gaming). Web UI on 47990 for config.
#
#   Debian 13 (Trixie): /dev/input access may need apparmor=unconfined or
#   cap_add SYS_ADMIN if input events don't reach the container.
#   Verify render GID ({{ gpu_render_gid }}) matches the host.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  sunshine:
    image: lizardbyte/sunshine:{{ sunshine_version }}
    container_name: sunshine
    restart: "no"                     # manual start for gaming sessions
    networks:
      - services-internal
    devices:
      - /dev/dri:/dev/dri             # AMD GPU encoding (VAAPI/AMF)
      - /dev/input:/dev/input:ro       # gamepad/keyboard/mouse input
      - /dev/uinput:/dev/uinput        # virtual gamepad creation
    group_add:
      - "{{ gpu_render_gid }}"
      - "{{ gpu_video_gid }}"
    volumes:
      - /srv/docker/sunshine/config:/home/sunshine/.config/sunshine
      - /run/udev:/run/udev:ro        # device enumeration
    ports:
      - "47989:47989/tcp"              # streaming (Moonlight)
      - "47990:47990/tcp"              # web config UI
      - "47991:47991/udp"              # streaming (UDP)
      - "48010:48010/udp"              # streaming (UDP)
      # Host ports kept (HD-62): Moonlight clients connect from LAN/VPN, so loopback/
      # drop would break streaming. `restart: "no"` = manual-start gaming timer, so the
      # exposure is time-limited. Bind to the LAN/Headscale interface if narrower is wanted.
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      SUNSHINE_USER: domen
networks:
  services-internal:
    external: true
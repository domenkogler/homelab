# onlyoffice-docs docker-compose.yml — ONLYOFFICE Docs Server (office.kogler.si)
#   In-browser Word/Excel/PPT editor for OpenCloud — WOPI helper.
#   NOT an identity surface: no Authentik OIDC client, NOT behind Forward-Auth.
#   The browser holds the user's Authentik session (via OpenCloud file.kogler.si);
#   OpenCloud <-> ONLYOFFICE trust each other over signed WOPI calls with a shared
#   JWT secret (opencloud-collab_password). See docs/services-office.md §ONLYOFFICE.
#
#   Networking: `traefik-public` (Traefik routes it; no host ports) + a
#   existing `db-internal` fleet segment for the three sidecars (postgres/redis/
#   rabbitmq). OpenCloud talks to ONLYOFFICE over the EDGE (COLLABORATION_APP_ADDR
#   = https://office.kogler.si) and receives WOPI callbacks at https://file.kogler.si
#   — so NO services-internal membership (nothing calls DS from inside the Docker
#   fabric). TLS via the wildcard *.kogler.si cert on the Traefik route. Port 80 = http.
#
#   WHY SIDECARS: the image bundles LOCAL postgres/rabbitmq/redis and starts them when their
#   hosts resolve to `localhost`. Under cap_drop: ALL the embedded init fails on chown/chmod, so
#   postgres never listens, the editor hangs on "Waiting for connection to the localhost host on
#   port 5432", and WOPI discovery from OpenCloud 502s. Wiring DB_HOST / AMQP_URI /
#   REDIS_SERVER_HOST flips run-document-server.sh into external mode and skips the embedded set.
#
#   Env names this image reads: DB_TYPE/DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PWD (NOT DB_PASS!),
#   AMQP_URI (the legacy RABBITMQ_SERVER_URL/AMQP_SERVER_URL are deprecated), and
#   REDIS_SERVER_HOST / REDIS_SERVER_PORT (REDIS_HOST/REDIS_PORT do not exist).
#
#   Image: onlyoffice/documentserver, pinned via `onlyoffice_version` (CONVENTIONS §7); the
#   sidecar pins live in versions.yml.
#
#   State: ONLYOFFICE per-user document cache under /var/lib/onlyoffice + sidecar
#   state under /srv/docker/onlyoffice-docs/{postgres,redis} — all REGENERABLE
#   (SSOT stays OpenCloud; NOT backed up). RabbitMQ holds only transient editor
#   queues -> named volume (image-initialized ownership; avoids a second
#   bind_owner_uid on the service entry).
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     opencloud-collab_password   (password: shared WOPI JWT secret, same value BOTH sides)
#     onlyoffice_db               (Database: username=<db user>, password=<db password>)
#     onlyoffice-rabbitmq_login   (Login: username=<amqp user>, password=<amqp password>)
{# The Postgres bind target is deliberately version-INDEPENDENT: PGDATA is pinned in the env
#   block below, which is what lets one mount shape serve 16 and 18. #}
services:
  onlyoffice-docs:
    image: onlyoffice/documentserver:{{ onlyoffice_version }}
    # cap_drop: ALL is NOT possible on this image: supervisord's per-child setuid EPERMs even
    # with the full setuid-cap whitelist (CHOWN/DAC_READ_SEARCH/FOWNER/SETUID/SETGID), while a raw
    # setpriv --init-groups as root succeeds — image-internal privilege handling is incompatible
    # with cap whitelisting. Compensating controls: read_only, NO host ports,
    # traefik-public+db-internal networks only, regenerable state, edge WAF. Revisit when upstream
    # cleans its init.
    container_name: onlyoffice-docs
    restart: unless-stopped
    depends_on:
      onlyoffice-postgres:
        condition: service_healthy
      onlyoffice-redis:
        condition: service_healthy
      onlyoffice-rabbitmq:
        condition: service_healthy
    networks:
      - traefik-public
      - db-internal
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # WOPI discovery (/hosting/discovery) is served by the bundled example app — WITHOUT it
      # OpenCloud's collaboration service cannot register the editor (discovery 404s). The image
      # default is disabled.
      EXAMPLE_ENABLED: "true"
      # WOPI_ENABLED=true is what makes DS serve the WOPI discovery XML at
      # /hosting/discovery (the endpoint OpenCloud's collaboration service polls to
      # register the editor; without it discovery 404s and .docx falls back to
      # download). Image default is OFF (run-document-server.sh reads WOPI_ENABLED,
      # defaults false). With WOPI_ENABLED=true the DS script writes wopi.enable=true
      # and auto-generates a public/private WOPI keypair (modulus/exponent) into
      # /etc/onlyoffice/documentserver/local.json on first boot — REGENERABLE, no
      # literal secret to store (never put key material here).
      WOPI_ENABLED: "true"
      # Shared WOPI JWT — MUST match OpenCloud's COLLABORATION_JWT_SECRET exactly.
      # 1Password lookup on both sides; fail-loud if absent. Folded block
      # scalar >- (never an inline double-quoted lookup): quote/backslash characters
      # in the 1P value must not break the RENDERED compose file.
      JWT_ENABLED: "true"
      JWT_SECRET: >-
        {{ vault['opencloud-collab_password'].password | replace('$','$$') }}
      JWT_HEADER: "Authorization"
      # --- external PostgreSQL (sidecar) ---
      DB_TYPE: postgres
      DB_HOST: onlyoffice-postgres
      DB_PORT: "5432"
      DB_NAME: onlyoffice
      DB_USER: "{{ vault['onlyoffice_db'].username | replace('$','$$') }}"
      DB_PWD: "{{ vault['onlyoffice_db'].password | replace('$','$$') }}"
      # --- external Redis (sidecar) ---
      REDIS_SERVER_HOST: onlyoffice-redis
      REDIS_SERVER_PORT: "6379"
      # --- external RabbitMQ (sidecar); urlencode: generated passwords may contain URI-hostile chars
      AMQP_URI: "amqp://{{ vault['onlyoffice-rabbitmq_login'].username }}:{{ vault['onlyoffice-rabbitmq_login'].password | urlencode }}@onlyoffice-rabbitmq:5672"
    volumes:
      - /srv/docker/onlyoffice-docs:/var/lib/onlyoffice
      # ⛔ Named volumes, NOT the image's own `Config.Volumes` paths left unmapped: the image declares
      # /var/www/onlyoffice/Data + /var/log/onlyoffice, and a mapped-less image VOLUME path gets a FRESH
      # ANONYMOUS volume at every container create, seeded from the image's content at that path — so the
      # recreate orphans the previous copy where it stands, and for the Data path the orphan is a WOPI
      # keypair: left unmapped, this service grows one dangling volume per recreate AND leaves the minted
      # pair only in the volume the last recreate abandoned. `/var/www/onlyoffice/Data` holds regenerable
      # key material and is `ds`-writable, so a named volume both preserves the current pair across recreates
      # and keeps it OUT of the dangling set instead of in it.
      - onlyoffice-data:/var/www/onlyoffice/Data
      - onlyoffice-logs:/var/log/onlyoffice
    labels:
      traefik.enable: "true"
      traefik.http.routers.onlyoffice.rule: "Host(`office.kogler.si`)"
      traefik.http.routers.onlyoffice.entrypoints: websecure
      {{ 'traefik.http.routers.onlyoffice.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      # NO Forward-Auth — ONLYOFFICE is a WOPI worker, not a user app. The
      # OpenCloud side (file.kogler.si) authenticates the user; this route needs the
      # WAF (crowdsec-only@file), same as the OpenCloud route, plus onlyoffice-csp@file
      # (upgrade-insecure-requests response header): DS emits http:// cache URLs to
      # the browser over the WOPI session websocket (upstream #2186) -> mixed content
      # blocked -> "Prenos ni uspel" empty doc. The header makes the browser upgrade
      # every http:// request on this origin to https://.
      traefik.http.routers.onlyoffice.middlewares: crowdsec-only@file,onlyoffice-csp@file
      traefik.http.services.onlyoffice.loadbalancer.server.port: "80"

  onlyoffice-postgres:
    image: postgres:{{ onlyoffice_pg_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql
    container_name: onlyoffice-postgres
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - db-internal
    volumes:
      # Named volume, NOT a host bind under /srv/docker/onlyoffice-docs: DS mounts the PARENT dir
      # and its init does a recursive chown to the ds uids (105/107) — a nested postgres datadir
      # gets corrupted (base/* owned 105:107 -> 'could not open file' on every catalog read, which
      # also breaks the db_role_sync ALTER). Named volumes are invisible to that walk.
      - onlyoffice-pgdata:/var/lib/postgresql/data
    environment:
      # ⚠ PG 18 defaults to the ICU locale provider; every cluster here was initdb-ed with
      #   libc/en_US.utf8. Left to the default, an 18 cluster restores the same rows with
      #   different sort semantics — ORDER BY / index ordering changes silently. Pin it here.
      POSTGRES_INITDB_ARGS: "--locale=en_US.utf8 --locale-provider=libc"
      # PG 18 images move PGDATA to the version-specific /var/lib/postgresql/18/docker and their
#   entrypoint REFUSES to start when it finds a cluster anywhere else - and the parent-mount layout
#   it recommends does not work under this fleet's cap_drop: ALL, because the root phase then lacks
#   CAP_DAC_OVERRIDE and cannot write a uid-70 0700 directory. Pinning PGDATA to the existing mount
#   keeps ONE mount shape for 16 and 18.
      PGDATA: /var/lib/postgresql/data
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      POSTGRES_DB: onlyoffice
      POSTGRES_USER: "{{ vault['onlyoffice_db'].username | replace('$','$$') }}"
      POSTGRES_PASSWORD: "{{ vault['onlyoffice_db'].password | replace('$','$$') }}"

  onlyoffice-redis:
    image: redis:{{ onlyoffice_redis_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
    container_name: onlyoffice-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - db-internal
    volumes:
      # Named volume for the same mount-overlap reason as onlyoffice-pgdata above.
      - onlyoffice-redis-data:/data

  onlyoffice-rabbitmq:
    image: rabbitmq:{{ onlyoffice_rabbitmq_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID   # entrypoint su-execs root -> rabbitmq user; setgroups EPERMs under bare cap_drop
    container_name: onlyoffice-rabbitmq
    restart: unless-stopped
    healthcheck:
      # Probe as the rabbitmq user: the image has no USER -> docker runs probes as
      # root, but under cap_drop: ALL root lacks DAC_OVERRIDE and cannot read the 0400
      # rabbitmq-owned .erlang.cookie -> eternal exit-78 eacces. su-exec ships in alpine.
      test: ["CMD-SHELL", "su-exec rabbitmq rabbitmq-diagnostics -q ping"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - db-internal
    volumes:
      - onlyoffice-rabbitmq-data:/var/lib/rabbitmq
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # Applied at FIRST mnesia init only (rotation => manual, see NOT_AUTO_ROTATABLE)
      RABBITMQ_DEFAULT_USER: "{{ vault['onlyoffice-rabbitmq_login'].username | replace('$','$$') }}"
      RABBITMQ_DEFAULT_PASS: "{{ vault['onlyoffice-rabbitmq_login'].password | replace('$','$$') }}"

networks:
  traefik-public:
    external: true
  db-internal:
    external: true

volumes:
  onlyoffice-rabbitmq-data:
  onlyoffice-pgdata:
  onlyoffice-redis-data:
  # The two document-server paths this service maps explicitly instead of letting the image
  # VOLUME stand unmapped. Compose prefixes them with the project name, so live they are
  # `onlyoffice-docs_onlyoffice-data` / `onlyoffice-docs_onlyoffice-logs`.
  onlyoffice-data:
  onlyoffice-logs:

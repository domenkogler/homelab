# onlyoffice-docs docker-compose.yml — ONLYOFFICE Docs Server (office.kogler.si)
#   In-browser Word/Excel/PPT editor for OpenCloud — WOPI helper (HD-166).
#   NOT an identity surface: no Authentik OIDC client, NOT behind Forward-Auth.
#   The browser holds the user's Authentik session (via OpenCloud file.kogler.si);
#   OpenCloud <-> ONLYOFFICE trust each other over signed WOPI calls with a shared
#   JWT secret (opencloud-collab_password). See docs/services-office.md §ONLYOFFICE.
#
#   Networking: `traefik-public` only (Traefik routes to it); no host ports (HD-62).
#   TLS via the wildcard *.kogler.si cert on the Traefik route. Image port 80 = http.
#
#   Image: onlyoffice/documentserver, pinned via `onlyoffice_version` (HD-134/§7 —
#   registry-verified 9.3.0.1 on 2026-08-19; MUST re-verify at first deploy).
#   Stateful: ONLYOFFICE keeps a per-user document cache under /var/lib/onlyoffice
#   (regenerable — NOT backed up; the SSOT is OpenCloud). No user data.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     opencloud-collab_password   (password: shared JWT secret, same value on BOTH sides)
services:
  onlyoffice-docs:
    image: onlyoffice/documentserver:{{ onlyoffice_version }}
    cap_drop:
      - ALL
    container_name: onlyoffice-docs
    restart: unless-stopped
    networks:
      - traefik-public
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # Shared WOPI JWT — MUST match OpenCloud's COLLABORATION_JWT_SECRET exactly.
      # 1Password lookup on both sides; fail-loud if absent (HD-65).
      JWT_ENABLED: "true"
      JWT_SECRET: "{{ lookup('community.general.onepassword', 'opencloud-collab_password', field='password', vault=op_vault) }}"
      JWT_HEADER: "Authorization"
    volumes:
      - /srv/docker/onlyoffice-docs:/var/lib/onlyoffice
    labels:
      traefik.enable: "true"
      traefik.http.routers.onlyoffice.rule: "Host(`office.kogler.si`)"
      traefik.http.routers.onlyoffice.entrypoints: websecure
      {% if traefik_acme_issuer is defined and traefik_acme_issuer %}
      traefik.http.routers.onlyoffice.tls.certresolver: letsencrypt
      {% endif %}
      # HD-166: NO Forward-Auth — ONLYOFFICE is a WOPI worker, not a user app. The
      # OpenCloud side (file.kogler.si) authenticates the user; this route only needs
      # the WAF (crowdsec-only@file), same as the OpenCloud route.
      traefik.http.routers.onlyoffice.middlewares: crowdsec-only@file
      traefik.http.services.onlyoffice.loadbalancer.server.port: "80"
networks:
  traefik-public:
    external: true

# bazarr docker-compose.yml — Subtitles (bazarr.kogler.si)
#   Writes .srt next to media files in library directories (needs library rw).
#   Forward-Auth. linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#   NFS mount from nas bulk/media → /mnt/nas/media/media.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed (no secrets for basic sub-titling)
services:
  bazarr:
    image: linuxserver/bazarr:{{ bazarr_version }}
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    # read_only intentionally ABSENT: linuxserver s6-overlay images
    # do not support read_only root — it causes /run/s6 exec + /config/Sentry init
    # failures. Keep cap_drop: ALL + /run:exec for the remaining hardening.
    tmpfs:
      - /tmp
      - /run:exec
    container_name: bazarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    ports:
      # Loopback publish so the host-net home edge can reach the backend.
      # ⛔ THIS is what owns loopback :6767 on oldsrv. Upstream's default Paseo daemon port is the
      # same number, so the seat takes `paseo_ports.oldsrv` (6769) instead of that default — check
      # `paseo_ports` in group_vars/all/main.yml before moving either one. Any claim here that the
      # conflict resolves itself is wrong in every direction: both bind loopback, neither the
      # tailnet address.
      - "{{ bazarr_bind }}:{{ bazarr_host_port }}:6767"
    volumes:
      - /srv/docker/bazarr/config:/config
      - /mnt/nas/media/media:/media                # rw — writes subtitles next to media
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.bazarr.rule: "Host(`bazarr.kogler.si`)"
      traefik.http.routers.bazarr.entrypoints: websecure
      {{ 'traefik.http.routers.bazarr.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      traefik.http.routers.bazarr.middlewares: authentik-forward-auth@file
      traefik.http.services.bazarr.loadbalancer.server.port: "6767"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

# tuwunel docker-compose.yml — Matrix homeserver (matrix.kogler.si)
#   Public + federated. Matrix-native SSO -> Authentik OIDC; NO Traefik Forward-Auth
#   on /_matrix/* (docs/services-matrix.md, services-traefik.md, services-authentik.md).
#   server_name = kogler.si (clean @user:kogler.si IDs), delegated to matrix.kogler.si
#   via .well-known. The APEX half of that delegation is served by THIS container — see
#   the matrix-wellknown router below.
#   RocksDB file store (NO external Postgres) — stateful data bind-mounted to
#   /srv/docker/matrix (included in ZFS/Kopia backup). Config = tuwunel.toml.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     matrix_api      (API Credential: username=<client_id>, credential=<client_secret>) — Authentik OIDC client
#     matrix_password (Password: bootstrap registration_token + registration_shared_secret)
services:
  matrix:
    image: jevolk/tuwunel:{{ tuwunel_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: matrix
    restart: unless-stopped
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # Tuwunel reads its config from TUWUNEL_CONFIG (tuwunel.toml below). The built-in
      # HEALTHCHECK reads the same file, so reported health matches real listeners.
      TUWUNEL_CONFIG: /etc/tuwunel/tuwunel.toml
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/matrix:/var/lib/tuwunel              # RocksDB + media (stateful, backed up)
      - ./tuwunel.toml:/etc/tuwunel/tuwunel.toml:ro      # config (server_name, OIDC, well-known)
    labels:
      traefik.enable: "true"
      traefik.http.routers.matrix.rule: "Host(`matrix.kogler.si`)"
      traefik.http.routers.matrix.entrypoints: websecure
      traefik.http.routers.matrix.middlewares: crowdsec-only@file   # CrowdSec block-list; Matrix-native SSO, no Forward-Auth
      {{ 'traefik.http.routers.matrix.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # Intentional: NO authentik-forward-auth middleware here — the homeserver owns its
      # auth via Matrix-native SSO (docs/services-matrix.md). Wrapping /_matrix/* would
      # break federation + native clients.
      traefik.http.services.matrix.loadbalancer.server.port: "8008"
      # ── The root-domain (apex) delegation, served by THIS backend ────────────
      # A remote homeserver resolves the APEX, because server_name = kogler.si, and the apex
      # host is the family launchpad behind Forward-Auth — a 302 to sso.kogler.si instead of
      # the delegation JSON is what kills inbound federation. There is no
      # `_matrix._tcp`/`_matrix._https` SRV record anywhere, so this well-known is the ONLY
      # delegation we have. It publishes exactly the two static bodies that matrix.kogler.si
      # already serves publicly, so nothing new is disclosed and nothing on
      # `chat.`/`matrix.`/`sso.` changes: Matrix-native SSO for the family is untouched.
      # PathPrefix is scoped to `/.well-known/matrix` and NOT to all of `/.well-known/*`, so no
      # future well-known inherits a public path; priority is set EXPLICITLY rather than relying
      # on Traefik's rule-length tie-break against the launchpad's Host(`kogler.si`) router.
      traefik.http.routers.matrix-wellknown.rule: "Host(`kogler.si`) && PathPrefix(`/.well-known/matrix`)"
      traefik.http.routers.matrix-wellknown.entrypoints: websecure
      traefik.http.routers.matrix-wellknown.priority: "100"
      traefik.http.routers.matrix-wellknown.service: matrix
      traefik.http.routers.matrix-wellknown.middlewares: crowdsec-only@file   # block-list stays; Forward-Auth deliberately does not
      {{ 'traefik.http.routers.matrix-wellknown.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

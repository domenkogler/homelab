# tuwunel.toml — Matrix homeserver config (docs/services-matrix.md)
# Rendered by Ansible; secrets resolved from 1Password `Homelab-ansible` at deploy time.
#
# server_name is PERMANENT — it cannot be changed without a DB wipe. We deliberately use
# the root domain `kogler.si` (clean @user:kogler.si IDs) and delegate the physical host
# to matrix.kogler.si via .well-known (that root-domain delegation is HD-47).
# [global] header REQUIRED (Wave-2 triage 2026-08-22): tuwunel rejects any mix of bare
# top-level keys with a [global.*] subtable profile - all plain keys must live under it.
[global]
server_name = "kogler.si"
database_path = "/var/lib/tuwunel"
address = ["0.0.0.0"]
port = 8008
max_request_size = 20000000   # bytes (~20 MB)

# --- Registration (closed by default — no manual config toggling, ever) ---
# Registration is DISABLED. Family members' accounts are created automatically by
# logging in via the Authentik OIDC provider (SSO auto-provisions Matrix users) —
# there is no open-registration surface to manage or later remember to turn off.
allow_registration = false
# The Synapse-style /_synapse/admin/v1/register endpoint stays available (enabled by
# this shared secret) for out-of-band account creation + admin promotion — e.g. to
# bootstrap the first admin. No config edits required for day-to-day operation.
registration_shared_secret = "{{ lookup('community.general.onepassword', 'matrix_password', field='password', vault=op_vault) | replace('\\','\\\\') | replace('"','\\"') }}"

# --- Federation posture (HD-122 / KOPS-033 — DECIDED 2026-08-18) ---
# Open federation is intentionally kept (matches the recorded KOPS-033 acceptance in
# security.md §7: a federated homeserver interoperating with the wider Matrix world).
# Two hardenings that fit a family exposure model WITHOUT breaking federation:
#
#  1) require_auth_for_profile_requests=true — requires auth on the unauthenticated
#     GET profile endpoints, preventing anonymous PROFILE SCRAPING (harvesting family
#     MXIDs / display names). This is the discoverability half of the "any user can
#     DM the family" concern.
#  2) allow_public_room_directory_over_federation stays false (Conduwuit default) so
#     /publicRooms spiders cannot enumerate our server's public room directory.
#
# NOTE: `trusted_servers` is a KEY-NOTARY list (used to gather other servers' signing
# keys for signature verification) — it is NOT an ingress allow-list and does NOT
# control who can DM our users. Do not repurpose it as a "federation permit-list":
# Conduwuit/Tuwunel has no per-server inbound allow-list; federation is global on/off
# (and the docs warn against disabling it after the fact). Truly stopping unsolicited
# DMs is client-side (per-user ignore/block in Element), out of server control.
allow_federation = true
trusted_servers = ["matrix.org"]   # key-notary only — matrix.org is the default Synapse notary
require_auth_for_profile_requests = true

# --- Discovery (served at matrix.kogler.si) ---
# [global.well_known] makes matrix.kogler.si/.well-known/matrix/{client,server} work for
# clients pointed here. Root-domain delegation (kogler.si/.well-known -> matrix.kogler.si)
# is a Traefik static host and belongs to HD-47.
[global.well_known]
client = "https://matrix.kogler.si"
server = "matrix.kogler.si:443"

# --- Authentik OIDC — Matrix-native SSO (docs/services-authentik.md) ---
#   - client_id / client_secret  -> 1Password `matrix_api` (API credential item:
#     username = client_id, credential = client_secret), seeded by the secret-egress glue (HD-143)
#     from the Authentik Blueprint-declared provider (ks-oidc.yml, HD-142).
#   - issuer_url must match the Authentik OIDC provider discovery URL.
#   - The provider's redirect/Allowed redirect URI must be registered EXACTLY as:
[[global.identity_provider]]
brand = "Authentik"
client_id = "{{ lookup('community.general.onepassword', 'matrix_api', field='username', vault=op_vault) }}"
client_secret = "{{ lookup('community.general.onepassword', 'matrix_api', field='credential', vault=op_vault) | replace('\\','\\\\') | replace('"','\\"') }}"
issuer_url = "https://sso.kogler.si/application/o/matrix/"   # adjust <slug> to Authentik app
callback_url = "https://matrix.kogler.si/_matrix/client/unstable/login/sso/callback/{{ lookup('community.general.onepassword', 'matrix_api', field='username', vault=op_vault) }}"
scope = ["openid", "profile", "email"]

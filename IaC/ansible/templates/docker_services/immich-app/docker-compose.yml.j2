# immich-app docker-compose.yml — Photo management (foto.kogler.si)
#   Server + Microservices + PostgreSQL + Redis. Hybrid storage:
#   - Local NVMe /srv/docker/immich/upload (thumbs, encoded-video, ML cache)
#   - NFS originals from nas tank/data/immich → /usr/src/app/upload/library
#   Storage template enabled so big write-once originals land on NAS.
#   UPLOAD_LOCATION = /usr/src/app/upload (the local mount root).
#   Face thumbnails backed up nightly (bulk/data/immich-thumbs).
#   Forward-Auth.
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#   immich_db  (Database: username=<db user>, password=<db password>)
services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ immich_version | default('release') }}
    container_name: immich-server
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/immich/upload:/usr/src/app/upload   # local NVMe: thumbs, encoded-video, ML cache
      - /mnt/nas/data/immich:/usr/src/app/upload/library   # NFS originals (storage template on)
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_USERNAME: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      DB_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      DB_DATABASE_NAME: immich
      DB_HOST: immich-postgres
      DB_PORT: "5432"
      REDIS_HOSTNAME: immich-redis
      IMMICH_MACHINE_LEARNING_URL: "http://immich-ml:3003"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.immich.rule: "Host(`foto.kogler.si`)"
      traefik.http.routers.immich.entrypoints: websecure
      traefik.http.routers.immich.tls.certresolver: letsencrypt
      traefik.http.routers.immich.middlewares: authentik-forward-auth@file
      traefik.http.services.immich.loadbalancer.server.port: "2283"
    depends_on:
      immich-postgres:
        condition: service_healthy
      immich-redis:
        condition: service_started

  immich-microservices:
    image: ghcr.io/immich-app/immich-server:{{ immich_version | default('release') }}
    container_name: immich-microservices
    restart: unless-stopped
    networks:
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/immich/upload:/usr/src/app/upload
      - /mnt/nas/data/immich:/usr/src/app/upload/library
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_USERNAME: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      DB_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      DB_DATABASE_NAME: immich
      DB_HOST: immich-postgres
      DB_PORT: "5432"
      REDIS_HOSTNAME: immich-redis
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    depends_on:
      immich-postgres:
        condition: service_healthy
      immich-redis:
        condition: service_started

  immich-postgres:
    image: tensorchord/pgvecto.rs:pg14-v0.2.0
    container_name: immich-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      POSTGRES_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      POSTGRES_DB: immich
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  immich-redis:
    image: redis:7-alpine
    container_name: immich-redis
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true
# immich-app docker-compose.yml — Photo management (foto.kogler.si)
#   Immich v3: server + PostgreSQL + Valkey. Microservices merged into server.
#   Storage decision (HD-135, 2026-08-18) — Immich runs on the VPS; three-way split:
#     * Local NVMe (/srv/docker/immich): Postgres DB + Valkey + upload/thumbs (hot).
#     * Live Hetzner Box (CIFS /mnt/storagebox): originals (library/) AND encoded-video
#       (cold/bulk, sequential reads) — via the Immich storage template (a DB/UI setting
#       at deploy, configured on the VPS after first deploy, NOT compose env).
#     * ML on oldsrv GPU (IMMICH_MACHINE_LEARNING_URL, WG tunnel).
#   Supersedes the older "originals on S3/MinIO" plan — the live Box is CIFS, not S3.
#   Addons: DB (Postgres), Valkey. Forward-Auth.
#
#   Secrets (deployment-secrets.md):
#     immich_db  (Database) — Postgres
#     minio_login (login)  — kept for legacy; originals now go to the live Box (CIFS), not MinIO
services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ immich_version | default('release') }}
    container_name: immich-server
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/immich/upload:/data               # local NVMe: thumbs, encoded-video (NOT originals)
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_USERNAME: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      DB_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      DB_DATABASE_NAME: immich
      DB_HOST: immich-postgres
      DB_PORT: "5432"
      REDIS_HOSTNAME: immich-valkey
      IMMICH_MACHINE_LEARNING_URL: "http://immich-ml:3003"
      # LEGACY/SUPERSEDED (HD-135, 2026-08-18): S3/MinIO originals. Keep the block for now —
      # the active deployment switches originals + encoded-video to the live Box (CIFS) via the
      # Immich storage template. Remove these IMMICH_S3_* vars once the storage-template path
      # is wired to the Box and MinIO is retired. (Thumbs stay on local /data regardless.)
      IMMICH_S3_ENDPOINT: "http://minio:9000"
      IMMICH_S3_USE_SSL: "false"
      IMMICH_S3_ACCESS_KEY: "{{ lookup('community.general.onepassword', 'minio_login', field='username', vault=op_vault) }}"
      IMMICH_S3_SECRET_KEY: "{{ lookup('community.general.onepassword', 'minio_login', field='password', vault=op_vault) }}"
      IMMICH_S3_REGION: us-east-1
      IMMICH_S3_BUCKET: immich-originals
      IMMICH_S3_FORCE_PATH_STYLE: "true"
      # === OIDC via Authentik (HD-148) — native OIDC for web + mobile ===
      # v3 mobile is OAuth-capable (app.immich:///oauth-callback). Provider declared in the
      # Authentik Blueprint (ks-oidc.yml, HD-142); client creds seeded into `immich_oidc` by the
      # secret-egress glue (HD-143). Must be Authorization Code (Confidential client), never implicit.
      IMMICH_OAUTH_ISSUER_URL: "https://sso.kogler.si/application/o/immich/"
      IMMICH_OAUTH_CLIENT_ID: "{{ lookup('community.general.onepassword', 'immich_oidc', field='username', vault=op_vault) }}"
      IMMICH_OAUTH_CLIENT_SECRET: "{{ lookup('community.general.onepassword', 'immich_oidc', field='credential', vault=op_vault) }}"
      IMMICH_OAUTH_SCOPE: "openid profile email"
      IMMICH_OAUTH_STORAGE_LABEL_CLAIM: preferred_username
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.immich.rule: "Host(`foto.kogler.si`)"
      traefik.http.routers.immich.entrypoints: websecure
      traefik.http.routers.immich.tls.certresolver: letsencrypt
      # HD-148: native OIDC enabled (mobile OAuth). NOT behind Forward-Auth — replacing with
      # crowdsec-only@file so the mobile app.immich:///oauth-callback OAuth isn't blocked by a
      # browser-redirect SSO layer, while keeping WAF protection.
      traefik.http.routers.immich.middlewares: crowdsec-only@file
      traefik.http.services.immich.loadbalancer.server.port: "2283"
    depends_on:
      immich-postgres:
        condition: service_healthy
      immich-valkey:
        condition: service_started

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    container_name: immich-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      POSTGRES_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: "--data-checksums"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    shm_size: 128mb
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  immich-valkey:
    image: docker.io/valkey/valkey:9
    container_name: immich-valkey
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/valkey:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true
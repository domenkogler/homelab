# immich-app docker-compose.yml — Photo management (foto.kogler.si)
#   Immich v3: server + PostgreSQL + Valkey. Microservices merged into server.
#   Storage (docs/storage.md §Immich Hybrid Storage): Immich runs on the VPS — local NVMe
#   /srv/docker/immich for Postgres/Valkey/thumbs (hot), the Hetzner Box over CIFS for
#   originals + encoded-video (cold), set in the Immich storage template, never compose env.
#   ML runs on oldsrv's GPU: IMMICH_MACHINE_LEARNING_URL is SSOT-derived in group_vars/all/ and
#   crosses hosts over the WG S2S tunnel, because Docker DNS cannot resolve across hosts;
#   immich-ml publishes :3003 bound to oldsrv's Home IP.
#   Auth: native OIDC, not Forward-Auth — but the OIDC settings are NOT in this file: Immich v3
#   reads no OAuth env var at all (see the note in the environment block); they live in the
#   DB-backed system config, written by immich-seed.yml.
#
#   Secrets (deployment-secrets.md):
#     immich_db  (Database) — Postgres
#     immich_oidc (api) — Authentik OIDC client (username=client_id, credential=client_secret).
#         Consumed by the SEED task (API PUT), NOT by this compose.
#     immich-admin_login (login) — the Immich admin seat (username=email, password). SEED task only.
#     immich-ml-internal_api (api) — shared ML API-key auth immich-app -> immich-ml
services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ immich_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: immich-server
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/immich/upload:/data               # local NVMe: thumbs, encoded-video (NOT originals)
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_USERNAME: "{{ vault['immich_db'].username | replace('$','$$') }}"
      DB_PASSWORD: "{{ vault['immich_db'].password | replace('$','$$') }}"
      DB_DATABASE_NAME: immich
      DB_HOSTNAME: immich-postgres   # upstream var IS DB_HOSTNAME (DB_HOST is silently ignored - Wave-2 triage 2026-08-22)
      DB_PORT: "5432"
      REDIS_HOSTNAME: immich-valkey
      # immich-ml runs on oldsrv, so its container name is unresolvable from the VPS: an
      # SSOT-derived cross-host URL over the WG S2S tunnel (key auth below).
      IMMICH_MACHINE_LEARNING_URL: "{{ immich_ml_url }}"
      # ML API-key auth: immich-ml validates this header so only immich-app can drive ML
      # inference (fail-loud: a missing item aborts the render). Shared with immich-ml.
      IMMICH_MACHINE_LEARNING_KEY: "{{ vault['immich-ml-internal_api'].credential | replace('$','$$') }}"
      # Originals + encoded-video live on the Hetzner Box CIFS mount, configured through the
      # Immich storage template (a DB/UI setting, not compose env); thumbs/DB stay on /data.

      # === OIDC: no env var here has any effect — Immich v3 reads no `IMMICH_OAUTH_*` (its env
      # whitelist is BOOTSTRAP vars only). Settings live in the DB row
      # system_metadata.key='system-config', written by tasks/immich-seed.yml from
      # immich_oauth_* + the `immich_oidc` item. Acceptance is the OIDC button on the login page,
      # then a real login — not this file. → docs/deployment-oidc.md §Immich native-OIDC note
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.immich.rule: "Host(`foto.kogler.si`)"
      traefik.http.routers.immich.entrypoints: websecure
      {{ 'traefik.http.routers.immich.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # Native OIDC (mobile OAuth), NOT behind Forward-Auth: the mobile OAuth callback must not
      # cross a browser-redirect SSO layer, so this router uses crowdsec-only@file + WAF.
      traefik.http.routers.immich.middlewares: crowdsec-only@file
      traefik.http.services.immich.loadbalancer.server.port: "2283"
    depends_on:
      immich-postgres:
        condition: service_healthy
      immich-valkey:
        condition: service_started

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
      - /etc/postgresql       # entrypoint copies its config here — read_only rootfs needs it as tmpfs
    container_name: immich-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: "{{ vault['immich_db'].username | replace('$','$$') }}"
      POSTGRES_PASSWORD: "{{ vault['immich_db'].password | replace('$','$$') }}"
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: "--data-checksums"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    shm_size: 128mb
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  immich-valkey:
    image: docker.io/valkey/valkey:{{ immich_valkey_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
    container_name: immich-valkey
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/valkey:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

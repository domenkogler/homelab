# immich-app docker-compose.yml — Photo management (foto.kogler.si)
#   Immich v3: server + PostgreSQL + Valkey. Microservices merged into server.
#   Storage per HD-131 D1: ORIGINALS on S3 (MinIO local now, box/cloud later);
#   thumbs/encoded-video stay on local NVMe. Originals are S3-backed from day one.
#   Addons: DB (Postgres), Valkey. Forward-Auth.
#
#   Secrets (deployment-secrets.md):
#     immich_db  (Database) — Postgres
#     minio_login (login)  — MinIO/S3 access key + secret (named IMMICH_S3_*)
services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ immich_version | default('release') }}
    container_name: immich-server
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/immich/upload:/data               # local NVMe: thumbs, encoded-video (NOT originals)
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_USERNAME: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      DB_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      DB_DATABASE_NAME: immich
      DB_HOST: immich-postgres
      DB_PORT: "5432"
      REDIS_HOSTNAME: immich-valkey
      IMMICH_MACHINE_LEARNING_URL: "http://immich-ml:3003"
      # ORIGINALS on S3 (MinIO) — HD-131 D1. Create the bucket (immich-originals) + access
      # key in MinIO, then these map Immich originals to S3. Thumbs stay on local /data.
      IMMICH_S3_ENDPOINT: "http://minio:9000"
      IMMICH_S3_USE_SSL: "false"
      IMMICH_S3_ACCESS_KEY: "{{ lookup('community.general.onepassword', 'minio_login', field='username', vault=op_vault) }}"
      IMMICH_S3_SECRET_KEY: "{{ lookup('community.general.onepassword', 'minio_login', field='password', vault=op_vault) }}"
      IMMICH_S3_REGION: us-east-1
      IMMICH_S3_BUCKET: immich-originals
      IMMICH_S3_FORCE_PATH_STYLE: "true"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.immich.rule: "Host(`foto.kogler.si`)"
      traefik.http.routers.immich.entrypoints: websecure
      traefik.http.routers.immich.tls.certresolver: letsencrypt
      traefik.http.routers.immich.middlewares: authentik-forward-auth@file
      traefik.http.services.immich.loadbalancer.server.port: "2283"
    depends_on:
      immich-postgres:
        condition: service_healthy
      immich-valkey:
        condition: service_started

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    container_name: immich-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      POSTGRES_PASSWORD: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: "--data-checksums"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    shm_size: 128mb
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  immich-valkey:
    image: docker.io/valkey/valkey:9
    container_name: immich-valkey
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/immich/valkey:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true
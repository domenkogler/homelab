# ollama docker-compose.yml — RX 7600 pinned-services tier (decision #24, 2026-09-15)
#   Serves the SMALL PINNED services on the oldsrv RX 7600: Whisper STT + bge-m3 embed +
#   bge-reranker. NOT generation — the big models run on spark (GB10, decision #24).
#   GPU-accelerated via AMD ROCm (/dev/dri, /dev/kfd). Accessed ONLY by the LiteLLM
#   spine on the dedicated `llm-backend` network (fully isolated — HD-59). Ollama
#   deliberately does NOT sit on `services-internal`: its local API has no native auth,
#   so the network itself is the boundary (same precedent as the isolated `db-internal`
#   bridge). LiteLLM (HD-100) joins `services-internal` (for consumers) + `llm-backend`
#   (to reach Ollama). No web UI, no Traefik labels.
#   OLLAMA_KEEP_ALIVE=5m keeps models warm between requests. Image `:rocm` == latest
#   release incl. bundled ROCm runtime (plain `:latest` has no ROCm support).
#   The `:rocm` image is the PROVEN RDNA3 path (verified 2026-08-21) — the same
#   container-bundled-ROCm doctrine as immich-ml (docs/hardware-gpu.md).
#
#   Models (pulled at first boot via the ollama_pull_models var):
#     whisper-large-v3-turbo  — STT (voice pipeline, docs/smart-home-voice.md)
#     bge-m3                  — embeddings (1024-dim, Qdrant RAG, docs/services-ai.md §5b)
#     bge-reranker-v2-m3      — rerank (Qdrant RAG top-20→top-5)
#   LiteLLM fronts these as `ollama/whisper-large-v3-turbo`, `ollama/bge-m3`,
#   `ollama/bge-reranker-v2-m3` (models-in-DB, HD-247).
#
# Secrets: none needed (models are public, no API keys).
services:
  ollama:
    image: ollama/ollama:{{ ollama_version }}
    container_name: ollama
    restart: always               # must start at boot before user login
    networks:
      - llm-backend
    devices:
      - /dev/dri:/dev/dri
      - /dev/kfd:/dev/kfd
    group_add:
      - "{{ gpu_render_gid }}"
      - "{{ gpu_video_gid }}"
    volumes:
      - /srv/models/ollama:/root/.ollama          # nvme/models dataset — no snapshots, no backup
    environment:
      OLLAMA_KEEP_ALIVE: "{{ ollama_keep_alive | default('5m') }}"
      OLLAMA_HOST: "0.0.0.0"      # bound only on llm-backend; reachable only by LiteLLM
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  llm-backend:
    external: true
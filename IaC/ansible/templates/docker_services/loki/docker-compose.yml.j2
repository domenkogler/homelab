# loki docker-compose.yml — single-node log aggregation (14d retention, SSD)
#   Alloy (host agent) pushes container/host logs here over loopback (127.0.0.1).
#   Grafana queries Loki over db-internal; no web UI of its own, no Traefik labels.
#   HD-115: multi-tenant auth (auth_enabled=true) — push + query carry tenant 'logs'.
#   TSDB data is regenerable and NOT backed up (docs/backup.md).
#   See docs/observability.md. Secrets via
#   {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }} — none needed here.
services:
  loki:
    image: grafana/loki:{{ loki_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: loki
    restart: unless-stopped
    command:
      - "-config.file=/etc/loki/loki.yaml"
      - "-config.expand-env=true"
    networks:
      - db-internal
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki-data:/loki
    ports:
      - "{{ wg_s2s_vps.ip if (wg_s2s_vps.peer_public_key | default('') | length > 0) else '127.0.0.1' }}:3100:3100"   # binds WG addr (oldsrv Alloy) only when tunnel intended; else loopback (HD-62)
volumes:
  loki-data:
networks:
  db-internal:
    external: true
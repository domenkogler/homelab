# tube-archivist docker-compose.yml — Personal YouTube archive (oldsrv)
#   "Own YouTube": headless yt-dlp wrapper that downloads channels/playlists/single
#   videos (incl. subtitles + comments) on a schedule — NO Google account needed.
#   https://github.com/tubearchivist/tubearchivist
#
#   OFFICIAL DEPLOY SHAPE (docs.tubearchivist.com/installation/docker-compose):
#   THREE containers — app + ElasticSearch (index) + Redis (queue/cache). The app
#   image is bbilly1/tubearchivist (Docker Hub), ES = bbilly1/tubearchivist-es
#   (recommended), Redis = official redis. Stores metadata in ES, queues in Redis.
#
#   PLACEMENT: OLDSRV, INTERNAL-ONLY. UI narrow-bound to the oldsrv Home-IP :8000
#   (homelable precedent). Requires HOST sysctl vm.max_map_count=262144 for ES
#   (set by the docker_services role — see roles/docker_services/tasks/main.yml).
#
#   STORAGE: downloads live in a `bulk/media/tube` subdir on nas — the SAME bulk/media
#   dataset, so hardlink-import stays valid.
#   AUTH: own browser login at first run (internal edge; no Forward-Auth). All vault lookups
#   fail-closed and escape '$'. Jellyfin plugin keys optional later.
#
#   VERSION PINS: app {{ tube_archivist_version }}, ES {{ tube_archivist_es_version }},
#   redis 7-alpine. ES/Redis carry no secrets.
services:
  tube-archivist:
    image: bbilly1/tubearchivist:{{ tube_archivist_version }}
    restart: unless-stopped
    container_name: tube-archivist
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    networks:
      - traefik-public
      - services-internal
    ports:
      # Web UI — internal-only narrow-bind on oldsrv Home-IP (homelable precedent).
      - "{{ oldsrv_home_ip }}:8000:8000"
    depends_on:
      - archivist-es
      - archivist-redis
    environment:
      # Required env vars (upstream compose).
      # ES_URL must be HTTPS: tubearchivist-es enables xpack.security and serves TLS (a
      # self-signed bundle baked into the image); plaintext http:// is rejected with "received
      # plaintext http traffic on an https channel" and TA never bootstraps. TA 0.x bundles the
      # CA/self-signed acceptance for the es container on the service overlay.
      ES_URL: "https://archivist-es:9200"
      REDIS_CON: "redis://archivist-redis:6379"
      HOST_UID: "{{ storage_uid }}"
      HOST_GID: "{{ storage_gid }}"
      TA_HOST: "http://tube.kogler.si"     # hostname (internal-only)
      # NOTE: these 1P values go through folded block scalars `>-`, never inline quotes: a
      # secret containing `\d`, `"`, `'`, `:` breaks a quoted scalar and go-yaml aborts the
      # compose config ("found unknown escape character").
      TA_USERNAME: >-
        {{ vault['tube-archivist_login'].username | replace('$','$$') }}
      TA_PASSWORD: >-
        {{ vault['tube-archivist_login'].credential | replace('$','$$') }}
      # ES 'elastic' superuser password — the SAME value the archivist-es container gets as
      # ELASTIC_PASSWORD (TA fails its env-check without it).
      ELASTIC_PASSWORD: >-
        {{ vault['tube-archivist-es'].password | replace('$','$$') }}
      # tubearchivist-es serves TLS with its self-signed bundled CA (http_ca.crt);
      # the app's urllib3 would reject it. Official upstream switch for exactly this
      # two-container setup (docs.tubearchivist.com/env-vars: ES_DISABLE_VERIFY_SSL).
      ES_DISABLE_VERIFY_SSL: "true"
      # Jellyfin plugin API token (optional; if the plugin is used later).
      TA_TOKEN: >-
        {{ vault['tube-archivist_ui'].credential | default('') | replace('$','$$') }}
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /srv/docker/tube-archivist/cache:/cache        # persistent artwork/cache
      - /mnt/nas/media/tube:/youtube:rw                # NEW `bulk/media/tube` subdir (media library)

  archivist-es:
    image: bbilly1/tubearchivist-es:{{ tube_archivist_es_version }}
    restart: unless-stopped
    container_name: archivist-es
    cap_drop:
      - ALL
    cap_add:
      - IPC_LOCK        # ES memory locking requirement (mlockall)
    tmpfs:
      - /tmp
    networks:
      - services-internal
    environment:
      ES_JAVA_OPTS: "-Xms512m -Xmx512m"    # keep ES heap modest on oldsrv (48 GB RAM)
      # The same bootstrap password the TA app uses (ELASTIC_PASSWORD): the tubearchivist-es
      # image enables ES security and expects it as the 'elastic' password.
      ELASTIC_PASSWORD: >-
        {{ vault['tube-archivist-es'].password | replace('$','$$') }}
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /srv/docker/tube-archivist/es:/usr/share/elasticsearch/data   # ES index (kopia scope)

  archivist-redis:
    image: redis:{{ tube_archivist_redis_version }}
    restart: unless-stopped
    container_name: archivist-redis
    cap_drop:
      - ALL
    cap_add:
      - CHOWN   # the redis entrypoint chowns /data to uid 999 then setprivs down; cap_drop ALL strips CHOWN -> "chown: .: Operation not permitted" crash-loop
      - DAC_OVERRIDE   # a 700 group-1000 appendonlydir from a prior incarnation blocks the chown probe traversal: root-in-container without DAC_OVERRIDE cannot stat a 0700 dir owned by another user -> "find: ./appendonlydir: Permission denied" restart-loop
      - SETUID
      - SETGID   # redis setprivs down to uid 999 after the chown; cap_drop ALL strips SETUID/SETGID -> "setpriv: setresuid failed" restart(127)
    tmpfs:
      - /tmp
    networks:
      - services-internal
    command: ["redis-server", "--appendonly", "yes"]   # persistence
    volumes:
      - /srv/docker/tube-archivist/redis:/data         # Redis AOF (kopia scope)

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
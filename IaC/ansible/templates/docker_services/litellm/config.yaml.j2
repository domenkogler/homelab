# LiteLLM config.yaml — LLM gateway/router spine (docs/services-ai.md)
#   Single OpenAI-compatible endpoint for the AI stack; the ONLY component holding
#   upstream keys (openrouter_api). Local models -> Ollama on `llm-backend`.
#   Rendered by the docker_services role; secrets resolved from 1Password at render time.
#
#   model_list is NOT rendered here. With STORE_MODEL_IN_DB=true the
#   model catalog lives in the litellm-db Postgres runtime and is Admin-UI-managed
#   (git drift accepted — services-ai.md §9 decision 13). At first
#   deploy, recreate the entries via the Admin UI/API with the
#   parameters (ollama/bge-m3 @1024 dims; ollama/bge-reranker-v2-m3) —
#   see this service's compose-header runbook.
#   The SPARK generation model (spark/qwen3.8-flash-next) is ALSO a runtime
#   entry in this DB — `base_url: https://llm.kogler.si/v1` and NO api_key: the bearer arrives
#   from the container's OPENAI_API_KEY env (1P `spark-llm_api`; name resolution via the
#   service's extra_hosts glue). https because spark's :80 edge is redirect-only.
#   The LAN instance carries the SAME entry (base_url identical — it reaches spark by the
#   same name, resolved on the LAN). Reach legs: VPS → spark_home_ip over wg-s2s; oldsrv →
#   same VLAN 10. Neither is rendered here: model entries are runtime
#   DB state (Admin UI / POST /model/new), never git-rendered (decision 13).
litellm_settings:
  drop_params: true
  # HD-1121: `prometheus` is the callback that MOUNTS the metrics endpoint. In this pin
  # (`litellm_version`, group_vars/all/versions.yml) `PrometheusLogger._mount_metrics_endpoint()`
  # is called from the callback loader only, so without this line `GET /metrics` answers 404 even
  # WITH a valid admin bearer — the measured finding in
  # docs/observability.md §Why the LiteLLM surface is dark. The endpoint
  # keeps its auth middleware (no `require_auth_for_metrics_endpoint: false`): the publish that
  # makes it reachable is loopback-only, and an unauthenticated `/metrics` would also be readable
  # through the tailnet-only `litellm.kogler.si` route, which proxies every path here.
  # The scrape job is deliberately NOT in the tree yet — it waits on a scoped metrics key
  # (todo.md HD-1121), never on `litellm_api`, which stays the admin/bootstrap credential.
  callbacks:
    - prometheus

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY   # admin/bootstrap credential ONLY:
                                              # consumers use scoped virtual keys minted by
                                              # the bootstrap-keys glue into 1Password.

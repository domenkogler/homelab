{{ ansible_managed | comment }}
# headscale configuration — auto-generated from template.
# OIDC provider is declared in the Authentik Blueprint (ks-oidc.yml, HD-142); client
# creds (`username`=client_id, `credential`=client_secret) are seeded into `headscale_api`
# by the secret-egress glue (HD-143).
#   Issuer OIDC: https://sso.kogler.si/application/o/headscale/   Redirect: https://vpn.kogler.si/oidc/callback

server_url: https://vpn.kogler.si
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443
log:
  level: info

# Database — SQLite (single node, no external Postgres needed)
database:
  type: sqlite3
  sqlite:
    path: /var/lib/headscale/db.sqlite

# OIDC via Authentik (provider declared in ks-oidc.yml Blueprint; creds seeded by glue, HD-142/143)
oidc:
  issuer: "https://sso.kogler.si/application/o/headscale/"
  client_id: "{{ vault['headscale_api'].username }}"
  # client_secret may contain : " ' or YAML-special chars (HD-233 lesson: the rotated
  # headscale_api value broke headscale/headplane on restart) -> block scalar >- is the
  # YAML-safe default for secrets from 1Password.
  client_secret: >-
    {{ vault['headscale_api'].credential }}
  scope: ["openid", "profile", "email"]
  allowed_domains:
    - kogler.si
  # Authentik's default 'email' scope mapping hardcodes email_verified: False (verified
  # 2026-08-26 against authentik 2026.5.6 source), and headscale defaults
  # email_verified_required: true -> every OIDC login died 'unverified email' (HD-252,
  # live log 2026-08-26). Access is still gated by allowed_domains: kogler.si below and
  # the users are internal family accounts with real @kogler.si emails; the strict
  # default is relaxed for THIS OIDC client only (headscale+headplane share it). The
  # 'correct' fix (Authentik emitting verified=true) is tracked separately; see todo HD-255
  # / this template header for the provider-scoped-scope-mapping option.
  email_verified_required: false

# DNS configuration — schema migrated for headscale >= 0.24 (pinned 0.29.3; Wave-2
# triage 2026-08-22): dns_config: -> dns:, acl_policy_path: -> policy.path.
dns:
  # Wave-3 round-4 triage 2026-08-22: headscale >= 0.24 REJECTS server_url inside
  # base_domain (MagicDNS could shadow the DERP/control plane). Node names therefore live
  # under the dedicated ts.kogler.si subtree (<node>.ts.kogler.si); the control plane stays
  # https://vpn.kogler.si. DECISION REVERSIBLE until first client enrols - nothing existed.
  base_domain: ts.kogler.si
  magic_dns: true
  override_local_dns: false
  # HD-135b follow-up (2026-08-28): make MagicDNS answer the PLAIN `*.kogler.si` names
  # too (stats/logs/csui/sec/traefik/auto), not just the *.ts.kogler.si base_domain.
  # headscale appends search_domains to its MagicDNS local domains (hscontrol/types/
  # config.go:918/1010 -> cfg.Domains = append(cfg.Domains, dns.SearchDomains...)), so
  # the extra_records below are answered by MagicDNS for BOTH namespaces without
  # touching Technitium (which has no records for the VPS-hosted dashboards).
  # The client's search list gains `kogler.si`; extra_records for stats.kogler.si etc.
  # then resolve through MagicDNS, not the system resolver (verified live 2026-08-28:
  # without this, plain *.kogler.si went to the system resolver -> NXDOMAIN).
  search_domains:
    - "{{ wildcard_cert_domain }}"   # kogler.si
  nameservers:
    - "{{ dns_primary_ip }}"   # Technitium PRIMARY (VPS, dns-servers overlay — HD-299, first in chain)
    - "{{ (network_static_hosts | selectattr('name', 'equalto', 'oldsrv') | selectattr('vlan', 'equalto', 10) | first).ip }}"  # Technitium SECONDARY (oldsrv)
    - "{{ (network_static_hosts | selectattr('name', 'equalto', 'pi') | selectattr('vlan', 'equalto', 10) | first).ip }}"  # Technitium TERTIARY (Pi)
  # HD-135b follow-up (tailnet-only dashboards): the tailnet Traefik edge serves
  # stats/logs/csui/sec/traefik/auto (and their *.ts.kogler.si MagicDNS twins) on
  # the sidecar node `vps-obs` (tag:sidecar). These custom A records make the CLEAN
  # subdomain names resolve for tailnet clients via MagicDNS — both namespaces are
  # declared here so `stats.kogler.si` AND `stats.ts.kogler.si` work. headscale ≥0.24
  # schema (pinned 0.29.3): `dns.extra_records` = [{name, type, value}].
  # The target IP is the sidecar's tailnet IPv4, assigned SEQUENTIALLY by headscale
  # at node join (current nodes: 100.64.0.3 laptop, 100.64.0.4 phone). It is NOT
  # known at authoring time → rendered from `tailnet_sidecar_ip` (group_vars/vps.yml,
  # default ""). Deploy step: read `headscale nodes list` after the sidecar joins,
  # set `tailnet_sidecar_ip`, re-converge + restart headscale. Leave empty → no
  # extra_records (fail-loud render guard below).
  #
  # HD-268c (2026-08-29): the schema is now {name, ip} dicts. `ip` defaults to
  # `tailnet_sidecar_ip` when omitted (the observability entries stay terse), and
  # the Pattern-A sidecars (HD-268c) pin their own tailnet IP. Records render
  # for BOTH the plain `*.kogler.si` and the `*.ts.kogler.si` namespaces —
  # identical pattern for both observability edge and Pattern-A sidecars.
  extra_records:
{% set _any_ip = tailnet_sidecar_ip | default('', true) or tailnet_dsh_ip | default('', true) or tailnet_pi_dev_ip | default('', true) %}
{% if _any_ip %}
{% for sub in tailnet_subdomains | default([{'name':'stats'},{'name':'logs'},{'name':'csui'},{'name':'sec'},{'name':'traefik'},{'name':'auto'}]) %}
{% set _ip = sub.ip | default(tailnet_sidecar_ip) %}
    - name: "{{ sub.name }}.kogler.si"
      type: "A"
      value: "{{ _ip }}"
    - name: "{{ sub.name }}.ts.kogler.si"
      type: "A"
      value: "{{ _ip }}"
{% endfor %}
{% else %}
    # All tailnet_*_ip unset -> no extra_records (deploy step fills them from
    # `headscale nodes list` after each sidecar joins; see header comment above)
    []
{% endif %}

# ACL/traffic policy (HD-84 / KOPS-022): points at the rendered policy.hujson
# mounted next to this config. NOTE: OIDC-authenticated clients are AUTO-APPROVED
# by Headscale (no separate registration gate here), so the ACL is what stops a
# rogue auto-joined node from reaching the mesh — see policy.hujson.j2.
# Schema migrated for headscale >= 0.24 (pinned 0.29.3, Wave-2 triage 2026-08-22).
policy:
  path: /etc/headscale/policy.hujson
logtail:
  enabled: false

# Tailscale v2 protocol keys (headscale >= 0.24; Wave-3 round-2 triage 2026-08-22).
# Generated by headscale on first start inside the rw data bind (/srv/docker/headscale/data).
noise:
  private_key_path: /var/lib/headscale/noise_private.key

# DERP relay map (required >= 0.24; Wave-3 R5): without it the initial DERP map is empty
# and headscale refuses to start. Uses the public Tailscale DERP relays - fine for a
# family mesh; self-hosted DERP is a possible future hardening.
derp:
  auto_update_enabled: true
  urls:
    - https://controlplane.tailscale.com/derpmap/default

# Node IP prefixes (required >= 0.24; Wave-3 round-3 triage 2026-08-22). Values = the
# Tailscale-standard CGNAT defaults headscale historically implied when unset.
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
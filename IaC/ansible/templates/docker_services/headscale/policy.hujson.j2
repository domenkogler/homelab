// {{ ansible_managed }}
// headscale ACL policy — auto-generated from template (HD-84 / KOPS-022).
//
// This is the *traffic* policy for the kogler.si mobile mesh (Headscale).
// Behaviour note: OIDC-authenticated clients are AUTO-APPROVED (there is no separate
// registration gate in config.yaml), so this file is the enforcement boundary:
// it decides what an auto-joined family node may reach.
//
// Default posture (TIGHTENED, HD-252 ④): deny-by-default. A node may talk ONLY to nodes
// owned by a listed family user, or to a service tag an explicit rule names — see `acls`.
// Rogue/untagged nodes (e.g. auto-joined via a leaked pre-auth key or an unknown OIDC
// subject) are denied by headscale's empty-default for anything not explicitly accepted.
//
// User reference format (verified against headscale v0.29.3 policy v2 tests + docs):
//   src  = the OIDC user's email, e.g. "domen@kogler.si"
//   dst  = same email + ":<port>", e.g. "domen@kogler.si:*" (:* = all ports)
// Headscale resolves these against each user's Email field. The localpart form
// ("domen@") also works for src; the full email is used here for explicitness.
//
// NOTE on tags: headscale v2 requires a tag to be DECLARED in tagOwners before a
// pre-auth key may carry it, and there is no autogroup:admin source here (the admin
// username only exists post-OIDC). So tagOwners is NOT empty and never was since
// HD-135b — it lists exactly the service tags this tailnet uses. User-to-user traffic
// remains email-based (see `acls`); a tag is how a NON-user node gets scoped in.
//
// Adding a family member: add one accept rule per user mirroring the layout below.
{
  "groups": {},

  // Only the mesh administrator may own a tag. Headscale v2 has no autogroup:admin here
  // (Wave-3 R5) and the admin username only exists after OIDC login, so every tag is
  // owned by the admin's email and nothing is self-service: a pre-auth key minted on the
  // VPS CLI is the only way a node acquires a tag (no policy check on the CLI path).
  //
  // HD-135b (2026-08-28): the VPS observability sidecar carries `tag:sidecar` so the
  // tailnet can reach the admin dashboards. HD-405 (2026-09-20) adds `tag:dev` for the one
  // home host. Both are service nodes, not users, so the admin email is the tag owner.
  // NOTE: headscale v0.29.3 tagOwners require the owner as FULL EMAIL (post-OIDC
  // "domen@kogler.si") — the bare username "domen" fails policy parse with
  // 'invalid owner format' and crash-loops headscale (live 2026-08-28).
  "tagOwners": {
    "tag:sidecar": ["domen@kogler.si"],
    // HD-405 (2026-09-20): the ONE home host that joins the tailnet (oldsrv). Declared here
    // BEFORE the preauth key that carries it is minted — the tag is what keeps the node OUT
    // of the user's own-node namespace: a preauth-key node lands in headscale's synthetic
    // `tagged-devices` user, so `dst: ["domen@kogler.si:*"]` cannot reach it and the ONLY
    // way in is the explicit port-scoped rule below. That is the whole point: the box holding
    // the vault token is reachable on 443, not on ":*". If this lane ever needs another port
    // (SSH, RustDesk), add it deliberately — do not widen this to :*
    // (HD-415 2026-09-22 added one DNS rule; it is NOT under this tag — it names the node's
    //  own address, so acquiring `tag:dev` does not grant resolver access.)
    "tag:dev": ["domen@kogler.si"],
    // HD-435 (2026-09-25, owner approved the node AND the grant): the SECOND permitted home
    // node — the Pi, which carries `traefik-ha` (the HA standby edge). Its own tag, on
    // purpose, rather than borrowing `tag:dev`:
    //   * `tag:dev` is the DEV SEAT tag, and its own comment above invites another port
    //     ("if this lane ever needs another port (SSH, RustDesk), add it deliberately").
    //     A shared tag would hand the Pi every dev-seat port the day someone adds one —
    //     the same silent-inheritance hazard the HD-415 note below calls out for DNS, and
    //     this row's owner condition was literally "the tag decides the reach surface".
    //   * With its own tag, the Pi's entire inbound tailnet surface is this one rule: 443.
    // No `udp 53` rule is added for it and none may be inferred: the Pi is the LAN Technitium
    // TERTIARY (and the IoT VLAN's forced dst-nat target), which is a LAN role needing no ACL
    // grant; naming it a TAILNET nameserver would be a separate, address-scoped rule, written
    // on purpose, exactly like oldsrv's below. No routes, no LAN bridge, no exit node, no
    // Tailscale SSH — the boundary permits TWO home nodes and still zero home subnets.
    "tag:home-edge": ["domen@kogler.si"]
  },

  // REAL ACL — TIGHTENED at first enrolment (HD-84 / HD-252 ④, 2026-08-26).
  // Family mesh is currently a single user (domen@kogler.si, OIDC-linked). Each member
  // may reach their OWN nodes; everything else is denied by default. Extend the list
  // as family members join (add one {"src":["<user>@kogler.si"],"dst":["<user>@kogler.si:*"]}
  // entry per member).
  "acls": [
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["domen@kogler.si:*"]
    },
    // HD-135b follow-up (2026-08-28): the owner's devices may reach the VPS
    // traefik-tailnet edge (tag:sidecar) on port 443 — the tailnet Traefik HTTPS
    // listener for the admin dashboards (stats/logs/csui/sec/traefik/auto, + *.ts
    // twins). The old tailscale-serve ports 8080..8085 are GONE. Keep deny-by-default
    // for everything else — the sidecar is the ONLY tailnet surface for these apps.
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["tag:sidecar:443"]
    },
    // HD-405 (2026-09-20): oldsrv's tailnet node, **tcp/443 only** (owner decision 2026-09-20;
    // amended 2026-09-22 for ONE DNS rule — see immediately below, and note it is scoped to
    // the node ADDRESS, not to this tag).
    // What this does NOT do, and must not: no LAN bridge, no advertised routes (the node
    // joins with --advertise-routes absent and `headscale routes list` stays empty), no
    // exit node (HD-408, still the Pi), no Tailscale SSH, and nothing at all toward
    // VLAN 20/30 — the Shelly/KNX/IoT/guest invariant is intact because the tailnet still
    // has no path into any home subnet. Everything the owner reaches away from home arrives
    // as `dst-ip = the node's own 100.64.x address`, terminated by oldsrv's own edge.
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["tag:dev:443"]
    },
    // HD-435 (2026-09-25, owner-approved grant): the Pi's tailnet node, **tcp/443 only**.
    // Why this exists: today the tailnet's ONLY answer for HA is oldsrv's node, so the
    // house's most critical service is unreachable from away whenever the box that happens
    // to be the tailnet node is down — which is not hypothetical while oldsrv sits L2-dead
    // (HD-455). Same shape as the rule above, same limits: no routes, no LAN bridge, no
    // exit node, no Tailscale SSH, and nothing toward VLAN 20/30.
    // ⚠ This grants by TAG, so the tag the node lands with IS the reach surface — a
    // preauth key carrying anything else (or nothing) silently produces a node that either
    // cannot be reached at all or is reachable on more than 443. Mint the key with
    // `--tags tag:home-edge` and read the assignment back before trusting the grant.
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["tag:home-edge:443"]
    }
    // HD-415 (2026-09-22, owner decision): **DNS only** — udp/53 to oldsrv's tailnet node
    // address, so the tailnet can use the resolver that is reachable from wherever the device
    // is (docs/network-dns.md §The resolution requirement). Without this rule the netmap
    // drops the phone's DNS queries to that nameserver and the whole `*.kogler.si` zone goes
    // dark away from home, which is why the nameserver entry and this rule ship together.
    // Deliberate shape:
    //   * `proto: udp` — this grants DNS and nothing else; tcp/53 stays closed (answers here
    //     are small A records; a truncated-over-UDP answer would need this widened, and that
    //     would be a separate owner call).
    //   * dst = the node ADDRESS, not `tag:dev` — a second node that ever takes `tag:dev`
    //     must not silently inherit a resolver grant. Every node that is ever named as a
    //     tailnet nameserver needs its own rule here, written on purpose.
    //   * src = the owner's user, like every other rule in this file. A tagged/service node
    //     that ever needs to query this resolver gets its own rule, also on purpose.
    // Everything else in the 2026-09-20 invariant stands: no LAN bridge, no routes, no exit
    // node, no Tailscale SSH, nothing toward IoT/guest.
    // Rendered only when the node address is known (SSOT tailnet_oldsrv_ip) — the same
    // condition that puts the entry in dns.nameservers, so the two never diverge.
{% if tailnet_oldsrv_ip %}
    ,
    {
      "action": "accept",
      "proto": "udp",
      "src": ["domen@kogler.si"],
      "dst": ["{{ tailnet_oldsrv_ip }}/32:53"]
    }
{% else %}
    // (tailnet_oldsrv_ip unset — no resolver node to name, so no DNS rule)
{% endif %}
  ]
}
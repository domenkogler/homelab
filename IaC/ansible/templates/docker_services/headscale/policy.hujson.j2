// {{ ansible_managed }}
// headscale ACL policy — auto-generated from template (HD-84 / KOPS-022).
//
// This is the *traffic* policy for the kogler.si mobile mesh (Headscale).
// Behaviour note: OIDC-authenticated clients are AUTO-APPROVED (there is no separate
// registration gate in config.yaml), so this file is the enforcement boundary:
// it decides what an auto-joined family node may reach.
//
// Default posture (TIGHTENED, HD-252 ④): deny-by-default. A node may talk ONLY to
// nodes owned by a listed family user — see the `acls` list below. Rogue/untagged
// nodes (e.g. auto-joined via a leaked pre-auth key or an unknown OIDC subject) are
// denied by headscale's empty-default for anything not explicitly accepted.
//
// User reference format (verified against headscale v0.29.3 policy v2 tests + docs):
//   src  = the OIDC user's email, e.g. "domen@kogler.si"
//   dst  = same email + ":<port>", e.g. "domen@kogler.si:*" (:* = all ports)
// Headscale resolves these against each user's Email field. The localpart form
// ("domen@") also works for src; the full email is used here for explicitness.
//
// NOTE on tags (the older HD-84 target): headscale v2 requires tags to be DECLARED
// in tagOwners before ACLs may reference them, and there is no autogroup:admin source
// here (admin username only exists post-OIDC). tagOwners is therefore intentionally
// left EMPTY and ACLs are user-EMAIL-based rather than tag-based. If/when more family
// members join and we want shared-service nodes (tag:kogler), add the tag + owner here
// and switch these rules to tag:*, e.g. src:["tag:kogler"] dst:["tag:kogler:*"].
//
// Adding a family member: add one accept rule per user mirroring the layout below.
{
  "groups": {},

  // Only the mesh administrator may apply a kogler tag. Headscale v2 has no
  // autogroup:admin here (Wave-3 R5) and the admin username only exists after OIDC
  // login — so tagOwners stays EMPTY: tagging happens server-side via
  // `headscale nodes tag` (CLI on the VPS, no policy check). Populate with the admin's
  // username ONLY if self-service advertise-tags is ever wanted.
  //
  // EXCEPTION (HD-135b, 2026-08-28): the VPS observability sidecar advertises
  // `tag:sidecar` (see docker_services/tailscale-sidecar) so the tailnet can reach the
  // admin dashboards. It is a service node, not a user, so the admin email is the
  // tag owner. Any node carrying tag:sidecar is by construction the VPS sidecar.
  // NOTE: headscale v0.29.3 tagOwners require the owner as FULL EMAIL (post-OIDC
  // "domen@kogler.si") — the bare username "domen" fails policy parse with
  // 'invalid owner format' and crash-loops headscale (live 2026-08-28).
  "tagOwners": {
    "tag:sidecar": ["domen@kogler.si"]
  },

  // REAL ACL — TIGHTENED at first enrolment (HD-84 / HD-252 ④, 2026-08-26).
  // Family mesh is currently a single user (domen@kogler.si, OIDC-linked). Each member
  // may reach their OWN nodes; everything else is denied by default. Extend the list
  // as family members join (add one {"src":["<user>@kogler.si"],"dst":["<user>@kogler.si:*"]}
  // entry per member).
  "acls": [
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["domen@kogler.si:*"]
    },
    // HD-135b follow-up (2026-08-28): the owner's devices may reach the VPS
    // traefik-tailnet edge (tag:sidecar) on port 443 — the tailnet Traefik HTTPS
    // listener for the admin dashboards (stats/logs/csui/sec/traefik/auto, + *.ts
    // twins). The old tailscale-serve ports 8080..8085 are GONE. Keep deny-by-default
    // for everything else — the sidecar is the ONLY tailnet surface for these apps.
    {
      "action": "accept",
      "src": ["domen@kogler.si"],
      "dst": ["tag:sidecar:443"]
    }
  ]
}
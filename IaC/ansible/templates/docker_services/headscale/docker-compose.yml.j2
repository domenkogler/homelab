# headscale docker-compose.yml — Tailscale coordination server (vpn.kogler.si)
#   Web UI on port 8080, gRPC metrics on port 9090 (internal).
#   OIDC via config.yaml (Authentik provider declared in ks-oidc.yml Blueprint, HD-142).
#
#   Config is mounted from config.yaml.j2 (rendered alongside this compose file).
#   Data persistence in /srv/docker/headscale/data/.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     headscale_api    (API Credential: username=<OIDC client_id>, credential=<OIDC client_secret>)
services:
  headscale:
    image: headscale/headscale:{{ headscale_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: headscale
    restart: unless-stopped
    networks:
      - traefik-public
    volumes:
      - /srv/docker/headscale/data:/var/lib/headscale
      - ./config.yaml:/etc/headscale/config.yaml:ro
      - ./policy.hujson:/etc/headscale/policy.hujson:ro
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.headscale.rule: "Host(`vpn.kogler.si`)"
      traefik.http.routers.headscale.entrypoints: websecure
      {% if traefik_acme_issuer is defined and traefik_acme_issuer %}
      traefik.http.routers.headscale.tls.certresolver: letsencrypt
      {% endif %}
      traefik.http.routers.headscale.middlewares: authentik-forward-auth@file
      traefik.http.services.headscale.loadbalancer.server.port: "8080"
networks:
  traefik-public:
    external: true

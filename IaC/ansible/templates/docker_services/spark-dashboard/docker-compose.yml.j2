# spark-dashboard docker-compose.yml — LAN bridge for the NVIDIA DGX Dashboard
#   DGX OS ships the dashboard as `dgx-dashboard.service` (port from
#   /opt/nvidia/dgx-dashboard-service/ports.env = 11000) bound to **loopback only** —
#   NVIDIA offers no bind-host flag and removed the "bind to LAN" RFE (NVIDIA forums
#   347956: "not possible at the moment"). Officially the dashboard is reached via
#   SSH tunnel / NVIDIA Sync / a desktop app launcher on the box.
#
#   The supported LAN exposure is a reverse proxy as a Docker sidecar: a **Traefik
#   file-provider edge ON spark** — host-net, two entrypoints (spark_home_ip:11000 =
#   dashboard, :11002 = admin JupyterLab, from
#   /opt/nvidia/dgx-dashboard-service/jupyterlab_ports.yaml), and dynamic/routes.yml.j2
#   proxies to 127.0.0.1:<port> on the host. A socat bridge does not work here: the
#   alpine/socat ENTRYPOINT is `socat`, so a compose `command:` list hands EVERY address
#   pair to ONE socat invocation → "exactly 2 addresses required (there are 4)"
#   crash-loop; a multi-pair relay would need `entrypoint: []` + a `sh -c` wrapper with
#   both socat processes backgrounded and the wrapper alive as PID 1.
#   Same reachability with one process, no digests, no socat argv quirks, and the
#   dashboard keeps its own
#   local-user+password login (docs/hardware-spark.md §Remote management) — never
#   0.0.0.0, Home-VLAN-only, no public record.
#
#   No secrets (plain HTTP proxy, no 1P items — stays OUT of the vault derive-map
#   like spark-ai). Image: traefik {{ traefik_version }} (pinned, versions.yml).
services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik-spark
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE          # bind 11000/11002 on the Home-VLAN IP
    read_only: true
    tmpfs:
      - /tmp
    network_mode: host            # must reach 127.0.0.1:11000/11002 on the host (DGX
                                  # services are loopback-only; no docker bridge IP can)
    restart: unless-stopped
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - ./dynamic:/etc/traefik/dynamic:ro   # file-provider routes (no docker.sock)
      - ./certs:/etc/traefik/certs:ro        # wildcard pair pulled from the VPS issuer (offline-safe)
    command:
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=true"
      - "--entrypoints.dashboard.address={{ spark_home_ip }}:11000"
      - "--entrypoints.jupyter.address={{ spark_home_ip }}:11002"
      # Name-based HTTPS edge — serve db-spark.kogler.si / llm.kogler.si on :443
      # (TLS from the pulled wildcard pair, same consumer pattern as the Pi/oldsrv edges) and
      # redirect :80→:443. The port URLs (spark_home_ip:11000/:11002) STAY as entrypoints
      # so the pre-existing dashboard links keep working; the route table picks :443 for names.
      - "--entrypoints.lm.address={{ spark_home_ip }}:443"
      - "--entrypoints.lm-http.address={{ spark_home_ip }}:80"
      - "--ping=true"                 # /ping health endpoint for the healthcheck below
      - "--log.level=INFO"
    # HSTS: set in dynamic/routes.yml.j2 (hsts middleware on the db-spark/llm
    # :443 routers) — NOT here: Traefik CLI flags cannot declare middlewares
    # ("failed to decode configuration from flags: field not found, node: http" is the
    # crash-loop when tried). Only entrypoints/providers/ping are CLI-configurable.
    # (No ACME on this edge; TLS = the pulled wildcard pair in ./certs, consumer pattern.)
    # healthcheck unchanged — /ping stays the probe (spark's dashboard/Jupyter are loopback-
    # HTTP backends with their own login; TSL/HSTS don't affect it).
    healthcheck:
      # Traefik's /ping (enabled above) — the dashboard/jupyter PROXY health is
      # separate (jupyter :11002 is on-demand, only exists while a lab is Running —
      # intentionally NOT part of the probe; a stopped lab would otherwise mark the
      # whole bridge unhealthy).
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # (No second healthcheck: a CMD-SHELL wget on a stray port probes a port nothing
    #  listens on and overrides the correct /ping check. The traefik healthcheck --ping
    #  form above is the one that passes.)
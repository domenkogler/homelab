# spark-dashboard dynamic/tls.yml — consumer default-store TLS (HD-370)
#   Same pattern as the traefik-internal / traefik-ha consumer edges: NO ACME resolver on
#   Same pattern as the traefik-internal / traefik-ha consumer edges: NO ACME resolver on
#   this edge — the wildcard *.kogler.si pair is served from the DEFAULT store below,
#   pulled from the VPS issuer (traefik-cert-pull consumer wiring, the docker_services role;
#   Pi ha-cert-sync precedent). Routers without an explicit certResolver (db-spark, llm) fall
#   back to this store, so every name route on this edge gets TLS.
#   File names come from the shared wildcard_cert_file / wildcard_cert_key_file vars
#   (group_vars/all.yml) so the issuer, the pull timer and this config can never drift.
#   HD-389: also serve the *.ts.kogler.si wildcard pair (same traefik-tailnet pattern) so the
#   .ts twin names (llm.ts.kogler.si / db-spark.ts.kogler.si) terminate this edge with a valid
#   cert when the VPS tailnet edge TLS-in-TLS-forwards them (live 404/502: spark only routed
#   the plain names, so the .ts SNI got no router + the default store had no ts pair).
tls:
  certificates:
    - certFile: "/etc/traefik/certs/{{ wildcard_cert_file }}"
      keyFile: "/etc/traefik/certs/{{ wildcard_cert_key_file }}"
    # HD-389: the *.ts.kogler.si pair (requested alongside *.kogler.si on the issuer) is
    # already on this box (ts.kogler.si.pem / ts.kogler.si-key.pem, certs-rename pattern);
    # declare it so .ts SNI handshakes get the right cert.
    - certFile: "/etc/traefik/certs/ts.kogler.si.pem"
      keyFile: "/etc/traefik/certs/ts.kogler.si-key.pem"
  stores:
    default:
      defaultCertificate:
        certFile: "/etc/traefik/certs/{{ wildcard_cert_file }}"
        keyFile: "/etc/traefik/certs/{{ wildcard_cert_key_file }}"
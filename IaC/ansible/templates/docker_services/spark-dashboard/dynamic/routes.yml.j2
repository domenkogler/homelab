# spark-dashboard — dynamic routes (file provider). NVIDIA DGX Dashboard LAN bridge
# on spark (HD-364 rework; see docker-compose.yml.j2 header for the socat→Traefik
# decision). Proxies the on-box loopback dashboard (:11000) and admin JupyterLab
# (:11002) onto the Home-VLAN IP at the same ports, so a LAN browser reaches
# http://spark.kogler.si:11000 (dashboard) / :11002 (JupyterLab, admin).
#
#   - Entrypoints are address+port bound (spark_home_ip:11000/11002) — never
#     0.0.0.0, no public record, Home-VLAN only.
#   - Route rule: explicit `Host(spark.kogler.si)` (NOT a HostRegexp catch-all). Live
#     proof 2026-09-15: HostRegexp({host:.+}) left the router silently non-matching →
#     Traefik's own 404 on `dashboard`/`jupyter`; with the explicit Host rule, name-based
#     requests (browser `http://spark.kogler.si:11000`) match and proxy to the loopback
#     backends (IP-host requests like `curl http://10.10.1.40:11000/` are expected 404 —
#     they don't match the Host rule; use the name). Same pattern as the oldsrv home edge.
#   - No Forward-Auth / no CrowdSec / no ACME: the dashboard owns its login (local
#     user+password, docs/hardware-spark.md §Remote management); loopback HTTP.
#   - JupyterLab spawns ON DEMAND from the dashboard's JupyterLab panel (Start);
#     until a lab is Running, 127.0.0.1:11002 has no listener and the route idles.
#   - The dashboard 'Software Update' flow reboots/restarts dgx-dashboard.service;
#     Traefik keeps RUNNING through it (just reconnects on the next request).
http:
  routers:
    dgx-dashboard:
      rule: "Host(`spark.kogler.si`)"
      entryPoints:
        - dashboard
      service: dgx-dashboard-backend
      priority: 1
    dgx-jupyter:
      rule: "Host(`spark.kogler.si`)"
      entryPoints:
        - jupyter
      service: dgx-jupyter-backend
      priority: 1

  services:
    dgx-dashboard-backend:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:11000"
        passHostHeader: true
    dgx-jupyter-backend:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:11002"
        passHostHeader: true
# spark-dashboard — dynamic routes (file provider). NVIDIA DGX Dashboard + LLM-edge on spark
#   (HD-364 rework; see docker-compose.yml.j2 header for the socat→Traefik decision).
#   HD-370: this edge is now ALSO the **name edge for spark's AI endpoints** — it fronts the
#   dashboard AND the llm.kogler.si OpenAI-API on the Home VLAN, TLS from the pulled wildcard
#   pair (cert CONSUMER, Pi ha-cert-sync precedent — see dynamic/tls.yml.j2). It no longer
#   serves plain HTTP on the LAN: :80 exists only as a redirect-to-https, everything answers
#   on :443. The legacy port URLs (spark_home_ip:11000/:11002) stay as entrypoints so
#   pre-existing dashboard links keep working; the routes below pick :443 for names.
#
#   - Entrypoints are address+port bound (spark_home_ip:11000/:11002/:443/:80) — never
#     0.0.0.0, no public record, Home-VLAN only.
#   - Route rule: explicit `Host(spark.kogler.si)`-style rules (NOT a HostRegexp catch-all).
#     Live proof 2026-09-15: HostRegexp({host:.+}) left the router silently non-matching →
#     Traefik's own 404 — with explicit Host rules, name-based requests match and proxy to the
#     loopback backends (IP-host requests are expected 404 — use the names).
#   - No Forward-Auth / no CrowdSec: the dashboard owns its login (local user+password,
#     docs/hardware-spark.md §Remote management); llm.kogler.si is gated by the ENGINE's own
#     --api-key (spark-llm_api vault item) — the AI spine (LiteLLM ×2) + pi are the only
#     holders. No middleware on the LLM path: the bearer key IS the auth.
#   - HD-451 (2026-09-23): the dashboard's URL of record is the SHORT NAME — `spark.kogler.si`
#     on the LAN, `spark.ts.kogler.si` off-LAN (tailnet-only, never public). `db-spark*` is
#     LEGACY: still routed, no new consumers. See the `spark-dashboard-name` router for why the
#     plain host name is deliberately never published into MagicDNS.
#   - HSTS is set here (hsts middleware on the :443 name routers — see the middlewares
#     block below; NOT CLI flags, Traefik cannot declare those) so browsers remember
#     https-only for these names.
#   - JupyterLab spawns ON DEMAND from the dashboard's JupyterLab panel (Start);
#     until a lab is Running, 127.0.0.1:11002 has no listener and the route idles.

http:
  middlewares:
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true
    # HD-370/HD-451: HSTS for the name edge — browsers remember https-only for the spark short names,
    # db-spark and llm so LAN↔tailnet roaming (the phone case) never offers the plaintext :80 record to the
    # client. Declared HERE (dynamic file), never as CLI flags — Traefik CLI cannot
    # declare middlewares (live crash-loop 2026-09-15, see the compose header).
    hsts:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false

  routers:
    # --- legacy port entrypoints (unchanged URLs, for the pre-existing dashboard links) ---
    dgx-dashboard:
      rule: "Host(`spark.kogler.si`)"
      entryPoints:
        - dashboard
      service: dgx-dashboard-backend
      priority: 1
    dgx-jupyter:
      rule: "Host(`spark.kogler.si`)"
      entryPoints:
        - jupyter
      service: dgx-jupyter-backend
      priority: 1

    # --- name-based HTTPS routes (HD-370; HD-451 adds the short names) ---
    # HD-451 (2026-09-23): the SHORT NAME is the dashboard's URL of record, on the same backend
    # as the LEGACY `db-spark` router below:
    #   `spark.kogler.si`    — LAN answer (Technitium, home instances only) → this edge directly
    #   `spark.ts.kogler.si` — tailnet-only (headscale `dns.extra_records`, rendered by
    #                          `tailnet_ts_only_subdomains` in group_vars/vps.yml) → the VPS
    #                          tailnet edge → WG S2S → this edge
    # Neither is a public record, by construction and by owner decision. TLS: both names are
    # covered by the pulled `*.kogler.si` / `*.ts.kogler.si` pair in the default store. The
    # backend does not veto the Host (measured 2026-09-23: :11000 with `Host: spark.kogler.si`
    # → 200), so no Host rewriting is needed here.
    spark-dashboard-name:
      rule: "Host(`spark.kogler.si`) || Host(`spark.ts.kogler.si`)"
      entryPoints:
        - lm
      middlewares:
        - hsts
      service: dgx-dashboard-backend
      tls: true
      priority: 1
    db-spark:
      rule: "Host(`db-spark.kogler.si`) || Host(`db-spark.ts.kogler.si`)"
      entryPoints:
        - lm
      middlewares:
        - hsts
      service: dgx-dashboard-backend
      tls: true
      priority: 1
    llm-kogler:
      rule: "Host(`llm.kogler.si`) || Host(`llm.ts.kogler.si`)"
      entryPoints:
        - lm
      middlewares:
        - hsts
      service: llm-backend
      tls: true
      priority: 1

    # --- :80 → :443 redirect for the names (never serves content on :80) ---
    spark-dashboard-name-http:
      # HD-451: must carry the same name set as `spark-dashboard-name` — a missing entry here
      # means a hand-typed http:// URL dead-ends on the :80 listener instead of redirecting.
      rule: "Host(`spark.kogler.si`) || Host(`spark.ts.kogler.si`)"
      entryPoints:
        - lm-http
      middlewares:
        - redirect-to-https
      service: noop@internal
      priority: 10
    db-spark-http:
      rule: "Host(`db-spark.kogler.si`) || Host(`db-spark.ts.kogler.si`)"
      entryPoints:
        - lm-http
      middlewares:
        - redirect-to-https
      service: noop@internal
      priority: 10
    llm-kogler-http:
      rule: "Host(`llm.kogler.si`) || Host(`llm.ts.kogler.si`)"
      entryPoints:
        - lm-http
      middlewares:
        - redirect-to-https
      service: noop@internal
      priority: 10

  services:
    dgx-dashboard-backend:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:11000"
        passHostHeader: true
    dgx-jupyter-backend:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:11002"
        passHostHeader: true
    llm-backend:
      loadBalancer:
        servers:
          # HD-370: engine-port indirection — vLLM :8000 today, SGLang's port when the S2/S3
          # lane wins. The LiteLLMs' base_url and this route never change across engines.
          - url: "http://127.0.0.1:{{ spark_engine_port }}"
        passHostHeader: true
# embed docker-compose.yml — pinned-AI embedding leg on the RX 7600
#   llama.cpp `llama-server` serving bge-m3 Q8_0 as an embedder over Vulkan, OpenAI-shaped
#   POST /v1/embeddings. Same image + same backend family as the `reranker` leg — the tier is
#   deliberately TWO published images, not three engines.
#   Why llama.cpp instead of the Ollama leg: materially faster ingest and far less
#   VRAM/RSS at cosine-equivalent vectors with dim 1024 unchanged (docs/services-ai-bench.md
#   §3b), so this is ROUTING, not a corpus migration: the Qdrant re-index is NOT
#   triggered. The Ollama `:rocm` leg stays enabled above as the FALLBACK RUNG.
#   `--embd-normalize 2` (L2) pins what the GGUF metadata implies (|v| = 1.0).
#   Network doctrine: `llm-backend` only, NO published ports, NO Traefik labels — no auth
#   on this API, so the network is the boundary; Qdrant/OWUI/Docling go through LiteLLM.
#   ONE gated exception: `ai_tier_metrics_publish` adds a 127.0.0.1 publish of this leg's own port so
#   the host's Alloy can scrape `/metrics` (llama.cpp serves metrics on the API port; there is no
#   separate metrics port). The publish and the `--metrics` flag below are the SAME gated switch, and it
#   is off by default: nothing is exposed and nothing restarts until someone flips the var (the shape is
#   `spark_metrics_publish` in templates/docker_services/spark-ai/, same purpose, same discipline).
#   Device: the dGPU render node only (renderD129); the iGPU is Xorg + Jellyfin QSV and is
#   slower than CPU (bench §4).
#   Resident by design (no keep-alive/LRU in llama-server; `--sleep-idle-seconds` costs a
#   reload). Model: sha256-verified fetch into /srv/models/embed, mounted :ro.
#
# Secrets: NONE — out of _template_vault_items, zero vault lookups.
services:
  embed:
    image: "{{ llama_cpp_vulkan_image }}"
    container_name: embed
    restart: unless-stopped
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      - llm-backend
{% if ai_tier_metrics_publish | default(false) %}
    ports:
      # Loopback-only, for the host Alloy (prometheus.scrape "llama_cpp" in roles/monitoring).
      # Never 0.0.0.0 and never a LAN publish: the API has no auth.
      - "127.0.0.1:{{ ai_tier_embed_port }}:{{ ai_tier_embed_port }}"
{% endif %}
    devices:
      - "{{ gpu_vulkan_render_node }}:{{ gpu_vulkan_render_node }}"
    group_add:
      - "{{ gpu_render_gid }}"
    volumes:
      - /srv/models/embed:/models:ro
    entrypoint: ["/app/llama-server"]
    command:
      - "-m"
      - "/models/bge-m3-q8_0.gguf"                 # 1024-dim — the dimension Qdrant holds
      - "--embedding"
      - "--pooling"
      - "cls"                                      # explicit, not inherited from GGUF metadata
      - "--embd-normalize"
      - "2"
      - "--device"
      - "Vulkan0"
      - "--ctx-size"
      - "{{ ai_tier_gguf_ctx_size }}"              # llama.cpp truncates SILENTLY past this; the
                                                   # server default 512 would cut a real ingest
                                                   # chunk (docs/services-ai.md §5b = 512/64 tokens)
      - "--batch-size"
      - "{{ ai_tier_gguf_batch_size }}"            # with the default 512 this
                                                   # endpoint answers HTTP 500 "input (842 tokens) is
                                                   # too large to process" - a hard failure at almost
                                                   # exactly the documented 512-token chunk + specials
      - "--ubatch-size"
      - "{{ ai_tier_gguf_ubatch_size }}"           # the 500 above is really an Ubatch complaint, and
                                                   # this (not ctx-size) is where the VRAM is spent
      - "--host"
      - "0.0.0.0"                                  # llm-backend only — never published
      - "--port"
      - "{{ ai_tier_embed_port }}"
{% if ai_tier_metrics_publish | default(false) %}
      # Proved on the pinned image (read-only `docker exec embed /app/llama-server --help`):
      # "--metrics  enable prometheus compatible metrics endpoint (default: disabled)".
      - "--metrics"
{% endif %}
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    # Same :8080-hardcoded image healthcheck problem as the reranker leg (`unhealthy`
    # while /health answers 200). Re-point at the actual port.
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ ai_tier_embed_port }}/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 90s
    deploy:
      resources:
        limits:
          memory: "{{ ai_tier_embed_memory_limit }}"
networks:
  llm-backend:
    external: true

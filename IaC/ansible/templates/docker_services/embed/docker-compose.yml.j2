# embed docker-compose.yml — pinned-AI embedding leg on the RX 7600 (HD-391, decision #27)
#   llama.cpp `llama-server` serving bge-m3 Q8_0 as an embedder over Vulkan, OpenAI-shaped
#   POST /v1/embeddings. Same image + same backend family as the `reranker` leg — the tier is
#   deliberately TWO published images, not three engines (decision #27).
#   WHY MOVE IT OFF OLLAMA (it already worked): measured 15 ms vs ~500 ms per query chunk,
#   2.3x faster ingest, 326 MiB vs 899 MiB VRAM, 157 MiB vs 2.19 GiB host RSS — and cosine
#   0.99960 mean / 0.99856 min against the LIVE Ollama vectors with dim 1024 unchanged, so
#   this is ROUTING, not a corpus migration: HD-268's Qdrant re-index is NOT triggered
#   (docs/services-ai-bench.md §3b). The Ollama `:rocm` leg stays enabled above as the
#   FALLBACK RUNG and retires only after this leg is live-verified.
#   `--embd-normalize 2` (L2) pins what the GGUF metadata implies; the cosine-verification
#   run measured |v| = 1.0, so this states the measured behaviour instead of inheriting it.
#   Network doctrine (HD-59): `llm-backend` only, NO `ports:`, NO Traefik labels — no auth
#   on this API, so the network is the boundary; Qdrant/OWUI/Docling go through LiteLLM.
#   Device: the dGPU render node only (renderD129); the iGPU is Xorg + Jellyfin QSV and is
#   slower than CPU (bench §4).
#   Resident by design (no keep-alive/LRU in llama-server; `--sleep-idle-seconds` costs a
#   reload). Model: sha256-verified fetch into /srv/models/embed, mounted :ro.
#
# Secrets: NONE — out of _template_vault_items, zero vault lookups.
services:
  embed:
    image: "{{ llama_cpp_vulkan_image }}"
    container_name: embed
    restart: unless-stopped
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      - llm-backend
    devices:
      - "{{ gpu_vulkan_render_node }}:{{ gpu_vulkan_render_node }}"
    group_add:
      - "{{ gpu_render_gid }}"
    volumes:
      - /srv/models/embed:/models:ro
    entrypoint: ["/app/llama-server"]
    command:
      - "-m"
      - "/models/bge-m3-q8_0.gguf"                 # 1024-dim — the dimension Qdrant holds
      - "--embedding"
      - "--pooling"
      - "cls"                                      # explicit, not inherited from GGUF metadata
      - "--embd-normalize"
      - "2"
      - "--device"
      - "Vulkan0"
      - "--ctx-size"
      - "{{ ai_tier_gguf_ctx_size }}"              # llama.cpp truncates SILENTLY past this; the
                                                   # server default 512 would cut a real ingest
                                                   # chunk (docs/services-ai.md §5b = 512/64 tokens)
      - "--host"
      - "0.0.0.0"                                  # llm-backend only — never published
      - "--port"
      - "{{ ai_tier_embed_port }}"
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    deploy:
      resources:
        limits:
          memory: "{{ ai_tier_embed_memory_limit }}"
networks:
  llm-backend:
    external: true

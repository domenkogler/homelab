# qbittorrent docker-compose.yml — Torrent client + gluetun VPN sidecar
#   torrent.kogler.si — Forward-Auth. qBittorrent routes through gluetun
#   (PrivadoVPN, WireGuard). network_mode: service:gluetun
#   means qBittorrent has no own network — Traefik labels go on gluetun.
#   Save paths → /mnt/nas/media/downloads/complete/<cat> for TRaSH hardlink import.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#   privado-vpn_api  (API Credential: WIREGUARD_PRIVATE_KEY — the ONLY secret)
# VPN provider: custom WireGuard (HD-318c). gluetun DROPPED the native `privado`
#   provider, so gluetun runs in `custom` mode and the endpoint is supplied
#   explicitly. NON-secret endpoint/address values come from group_vars
#   home_servers.yml (privado_vpn_* SSOT) — see docs/services-downloads.md.
services:
  gluetun:
    # qm12/gluetun fork is GONE (probe 2026-08-21) → upstream qmcgaw/gluetun
    image: qmcgaw/gluetun:{{ gluetun_version }}
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      - traefik-public
      - services-internal
    environment:
      VPN_SERVICE_PROVIDER: custom        # gluetun dropped `privado` → explicit endpoint (HD-318c)
      VPN_TYPE: wireguard
      # [Peer] Endpoint — gluetun custom requires an IP literal (no DNS, qdm12/gluetun#2680)
      WIREGUARD_ENDPOINT_IP: "{{ privado_vpn_endpoint_ip }}"
      WIREGUARD_ENDPOINT_PORT: "{{ privado_vpn_endpoint_port }}"
      # [Peer] server public key (non-secret)
      WIREGUARD_PUBLIC_KEY: "{{ privado_vpn_public_key }}"
      # [Peer]/[Interface] client identity — private key is the 1Password secret
      WIREGUARD_PRIVATE_KEY: "{{ vault['privado-vpn_api'].credential | replace('$','$$') }}"
      # [Interface] tunnel client address (WG full-tunnel, AllowedIPs 0.0.0.0/0 is the default)
      WIREGUARD_ADDRESSES: "{{ privado_vpn_address }}/{{ privado_vpn_cidr }}"
    labels:
      traefik.enable: "true"
      # qBittorrent web UI is reachable through gluetun namespace on :8080
      traefik.http.routers.qbittorrent.rule: "Host(`torrent.kogler.si`)"
      traefik.http.routers.qbittorrent.entrypoints: websecure
      {{ 'traefik.http.routers.qbittorrent.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.qbittorrent.middlewares: authentik-forward-auth@file
      traefik.http.services.qbittorrent.loadbalancer.server.port: "8080"

  qbittorrent:
    image: linuxserver/qbittorrent:{{ qbittorrent_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: qbittorrent
    restart: unless-stopped
    network_mode: "service:gluetun"          # no own network — shares gluetun namespace
    depends_on:
      - gluetun
    volumes:
      - /srv/docker/qbittorrent/config:/config
      - /mnt/nas/media/downloads:/downloads   # rw — downloads/complete/<cat>
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

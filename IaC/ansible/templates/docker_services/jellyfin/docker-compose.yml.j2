# jellyfin docker-compose.yml — Media server (media.kogler.si)
#   OWN LOGIN (no Authentik Forward-Auth — client apps need direct auth).
#   iGPU transcode via /dev/dri (Intel HD 630 QuickSync), user: "{{ storage_uid }}:{{ storage_gid }}" (shared `media` owner).
#   /mnt/nas/media/media mounted ro. Cache on local NVMe for performance.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  jellyfin:
    image: jellyfin/jellyfin:{{ jellyfin_version }}
    container_name: jellyfin
    user: "{{ storage_uid }}:{{ storage_gid }}"
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    devices:
      - /dev/dri:/dev/dri          # Intel HD 630 QuickSync
    ports:
      # The labels below only reach Jellyfin from the OVERLAY edge; traefik-internal runs
      # `network_mode: host`, so publish on the host (loopback, like actual-budget :5006 /
      # immich-ml :3003) or LAN requests 502. Loopback keeps Jellyfin login off the VLAN.
      - "{{ jellyfin_bind }}:{{ jellyfin_host_port }}:8096"
    group_add:
      - "{{ gpu_render_gid | default(104) }}"
      - "{{ gpu_video_gid | default(44) }}"
    volumes:
      - /srv/docker/jellyfin/config:/config
      - /srv/docker/jellyfin/cache:/cache
      - /mnt/nas/media/media:/media:ro             # ro — library access, writes go to /config + /cache
    environment:
      JELLYFIN_PublishedServerUrl: media.kogler.si
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.jellyfin.rule: "Host(`media.kogler.si`)"
      traefik.http.routers.jellyfin.entrypoints: websecure
      traefik.http.routers.jellyfin.middlewares: crowdsec-only@file   # CrowdSec block-list; own login, no Forward-Auth
      {{ 'traefik.http.routers.jellyfin.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      # NOTE: no authentik-forward-auth — Jellyfin has its own login (client apps)
      traefik.http.services.jellyfin.loadbalancer.server.port: "8096"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

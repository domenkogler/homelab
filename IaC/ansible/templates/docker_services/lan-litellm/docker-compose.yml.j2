# lan-litellm docker-compose.yml — LAN LiteLLM instance (oldsrv; dev-AI tier)
#   SECOND LiteLLM for the DEV side (dsh / pi-dev / future OpenHands), separate
#   from the VPS family instance: VPS = family (open-webui, openclaw, docling, qdrant, rag-mcp),
#   LAN = dev (dsh + pi-dev on oldsrv) with spark as its local inference backend. Each instance
#   owns its OWN Postgres (litellm-db) + scoped keys, both Kopia-backed.
#   → docs/services-ai.md §AI hosting split — family AI on the VPS, dev/pinned AI on oldsrv + spark
#
#   DEPLOY-GATED ON SPARK: this service stays `enabled: false` in group_vars/home_servers.yml
#   until the spark node is provisioned. Do NOT flip it live. (Thin clone of
#   templates/docker_services/litellm/.)
#
#   Reach model: `llitellm.kogler.si` is served by the oldsrv traefik-internal HOME edge (name +
#   TLS, not ports — the llogs pattern). The home edge is host-net and reaches this container on
#   oldsrv_home_ip:4000, so the compose keeps that publish (that IS how host-net edges reach
#   backends — see jellyfin/lan-litellm precedent). No 0.0.0.0 bind; no VPS-side exposure.
#   LOCAL INFERENCE: the spark model entry uses `https://llm.kogler.si/v1` as base_url (LAN name
#   -> spark_home_ip -> spark's own :443 name edge -> engine :8000) with the spark-llm_api bearer
#   key. https, NOT http: spark's :80 edge is redirect-only and the OpenAI SDK does not follow a
#   307 on POST /v1/chat/completions.
#   The key reaches the entry as the container env `OPENAI_API_KEY` (the openai-provider
#   credential, from 1P `spark-llm_api` below), so the DB row carries NO key and the literal never
#   enters the Kopia-backed lan-litellm-db — `api_key: os.environ/…` in a DB param is NOT expanded
#   by this LiteLLM version. Resolution: `extra_hosts` glue below — oldsrv's host resolv.conf is
#   public-only (WAN-out survival by design) and /etc/hosts is NOT inherited by containers, so a
#   container cannot resolve home-split names itself. Management API stays docker-exec-only.
#
#   Secrets (all fail-closed): reuses the SAME 1Password items as the VPS instance — litellm_api,
#   openrouter_api, litellm_db, spark-llm_api — and the db_backup DB06 story applies unchanged.
#   On spark convergence the POSTGRES_* values fan out from the same vault items.
#   → docs/deployment-ai-stack-secrets.md
#   SCOPED KEYS: this instance mints its OWN — the registry entry carries `bootstrap_keys: true`
#   and its consumer records are the `litellm_scoped_keys` list in group_vars/home_servers.yml
#   (one row today: `home-assistant` → `home-assistant_api`; Docling/OWUI grants still pending).
#   Keep that list a NON-EMPTY real list: the glue fails loud when no specs render, and a
#   key-with-only-comments parses as None, which `| default([])` does not rescue. Coding
#   harnesses are not consumers of this instance — they reach spark directly.
#   → docs/services-ai.md §4. LLM routing & keys
{# The Postgres bind target is deliberately version-INDEPENDENT: PGDATA is pinned in the env
#   block below, which is what lets one mount shape serve 16 and 18. #}
services:
  lan-litellm:
    image: docker.litellm.ai/berriai/litellm:{{ litellm_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: lan-litellm
    restart: unless-stopped
    # Container-local glue for the LAN-only spark name (see header). Same value on
    # both LiteLLMs — spark_home_ip is SSOT-derived, not hand-typed.
    extra_hosts:
      - "llm.kogler.si:{{ spark_home_ip }}"
    ports:
      - "{{ oldsrv_home_ip }}:4000:4000"     # host-net home-edge reach for llitellm.kogler.si (llogs pattern); never 0.0.0.0
    networks:
      - services-internal
      - llm-backend                 # reach local inference (spark/Triton) once provisioned
      - db-internal                 # reach lan-litellm-db
    volumes:
      - ./config.yaml:/app/config.yaml:ro          # rendered from config.yaml.j2 (same pattern as the VPS litellm)
      - /srv/docker/lan-litellm:/app/.data        # misc app state (Kopia scope)
    depends_on:
      lan-litellm-db:
        condition: service_healthy
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      LITELLM_MASTER_KEY: "{{ vault['litellm_api'].credential | replace('$','$$') }}"
      OPENROUTER_API_KEY: "{{ vault['openrouter_api'].credential | replace('$','$$') }}"
      # spark engine bearer key (1P `spark-llm_api`) as the openai-provider credential, so
      # the DB model entry carries NO key (this build does not expand os.environ/ in DB params).
      # CAVEAT: a future bare `openai/…` entry without its own api_key inherits this key.
      OPENAI_API_KEY: "{{ vault['spark-llm_api'].credential | replace('$','$$') }}"
      # No Cohere provider: embed/rerank are local on the oldsrv RX 7600.
      STORE_MODEL_IN_DB: "true"
      DATABASE_URL: >-
        postgres://{{ vault['litellm_db'].username | urlencode }}:{{ vault['litellm_db'].password | urlencode }}@lan-litellm-db:5432/litellm
    command: ["--config", "/app/config.yaml"]
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request;urllib.request.urlopen('http://localhost:4000/health/liveliness')\""]
      interval: 10s
      timeout: 10s
      retries: 12

  lan-litellm-db:
    image: postgres:{{ lan_litellm_db_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql
    container_name: lan-litellm-db
    restart: unless-stopped
    networks:
      - db-internal                 # NOT on services-internal
    volumes:
      - /srv/docker/lan-litellm/postgres:/var/lib/postgresql/data
    environment:
      # ⚠ PG 18 defaults to the ICU locale provider; every cluster here was initdb-ed with
      #   libc/en_US.utf8. Left to the default, an 18 cluster restores the same rows with
      #   different sort semantics — ORDER BY / index ordering changes silently. Pin it here.
      POSTGRES_INITDB_ARGS: "--locale=en_US.utf8 --locale-provider=libc"
      # PG 18 images move PGDATA to the version-specific /var/lib/postgresql/18/docker and their
#   entrypoint REFUSES to start when it finds a cluster anywhere else - and the parent-mount layout
#   it recommends does not work under this fleet's cap_drop: ALL, because the root phase then lacks
#   CAP_DAC_OVERRIDE and cannot write a uid-70 0700 directory. Pinning PGDATA to the existing mount
#   keeps ONE mount shape for 16 and 18.
      PGDATA: /var/lib/postgresql/data
      POSTGRES_DB: litellm
      POSTGRES_USER: "{{ vault['litellm_db'].username | replace('$','$$') }}"
      POSTGRES_PASSWORD: >-
        {{ vault['litellm_db'].password | replace('$','$$') }}
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

networks:
  services-internal:
    external: true
  llm-backend:
    external: true
  db-internal:
    external: true
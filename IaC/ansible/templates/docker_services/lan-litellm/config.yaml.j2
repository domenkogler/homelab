# lan-litellm config.yaml — LAN (dev-side) LiteLLM gateway config (HD-356/HD-370)
#   Clone of templates/docker_services/litellm/config.yaml.j2 for the LAN instance
#   (oldsrv; dev consumers dsh / pi-dev / future OpenHands). Same model story as the
#   VPS instance — see that file for the full rationale.
#
#   Rendered by the docker_services role (registered in
#   roles/docker_services/defaults/main.yml _extra_templates: lan-litellm); secrets
#   resolved from 1Password at render time.
#
#   HD-247 v2: model_list is NO LONGER rendered here. With STORE_MODEL_IN_DB=true the
#   model catalog lives in the lan-litellm-db Postgres runtime and is Admin-UI-managed
#   (git drift accepted by owner decision — services-ai.md §9 decision 13). The SPARK
#   generation model (spark/qwen3.8-flash-next) is ALSO a runtime entry in THIS DB —
#   its `base_url` is `http://llm.kogler.si` (LAN name → spark_home_ip → spark's own
#   :443 edge → llm-backend engine) with the spark-llm_api bearer key. Admin-UI
#   create step, never rendered here (HD-370 deploy-gate step 4).
litellm_settings:
  drop_params: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY   # admin/bootstrap credential ONLY (HD-247):
                                              # consumers use scoped virtual keys minted by
                                              # the bootstrap-keys glue into 1Password.

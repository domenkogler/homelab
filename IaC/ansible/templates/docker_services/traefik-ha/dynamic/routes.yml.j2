# traefik-ha — dynamic routes (file provider). Serves ha.kogler.si + dns-pi.kogler.si:
# the services hosted on the Pi that must stay reachable when oldsrv is DOWN.
#   - ha:      same `ha` route semantics as the oldsrv `traefik` (backend = VIP:8123),
#              NO Authentik Forward-Auth (breaks the Companion WebSocket/token flow).
#   - dns-pi:  Technitium SECONDARY web UI (dns-pi.kogler.si → VIP, served by THIS
#              edge so it survives an oldsrv outage; backend = local host
#              {{ technitium_secondary_ip }}:5380). No Forward-Auth — a
#              management surface with its own login, internal-only.
#   NOTE — no crowdsec-only here (HD-118): CrowdSec runs on oldsrv and is DOWN whenever
#   this failover edge is live (oldsrv is down). Adding the bouncer here would query a
#   dead LAPI and fail the ha route open/closed at exactly the moment it must survive,
#   so the Pi edge intentionally stays CrowdSec-free. oldsrv's own `traefik` ha route
#   (which has local CrowdSec) is the HD-118 target.
#   - http-redirect: catch-all :80 → :443 (the `web` entrypoint).
#   ACME is DISABLED on this edge — TLS comes from the cert files pulled from the
#   VPS (the single ACME issuer; see tls.certificates below). No certResolver is
#   configured.

http:
  middlewares:
{% if tailnet_pi_ip is defined and tailnet_pi_ip %}
    # HD-435: HA rejects X-Forwarded-* from a proxy it does not trust, and `ha_trusted_proxies`
    # covers the edge container addresses — not a tailnet node address. Same fix as
    # traefik-internal's `ha-ts` router: strip the headers on the tailnet leg instead of
    # widening HA's trust list to a tailnet range.
    ha-ts-strip-forwarded:
      headers:
        customRequestHeaders:
          X-Forwarded-For: ""
          X-Forwarded-Proto: ""
          X-Forwarded-Host: ""
          X-Forwarded-Server: ""
{% endif %}
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true

  routers:
    ha:
      rule: "Host(`ha.kogler.si`)"
      entryPoints:
        - websecure
      service: ha-backend
      tls: true
      # NOTE: no authentik-forward-auth@file middleware on the ha route
    dns-pi:
      rule: "Host(`dns-pi.kogler.si`)"
      entryPoints:
        - websecure
      service: dns-pi-backend
      tls: true
      # NOTE: no authentik-forward-auth on the dns-pi route (own-login mgmt surface)
    http-redirect:
      rule: "HostRegexp(`{host:.+}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: noop@internal
{% if tailnet_pi_ip is defined and tailnet_pi_ip %}
    # --- HA over the TAILNET (HD-435) — the away path, node-direct, survives oldsrv down ---
    # Matches `ha.{{ tailnet_base_domain }}` (the tailnet-only twin published by
    # tailnet_ts_only_subdomains) and this node's own MagicDNS name, so it answers BEFORE any
    # `ha.kogler.si` extra-record exists — which is deliberate: publishing the PLAIN name into
    # MagicDNS answers it client-side for a phone that is standing at home, taking HA off the
    # VIP and onto a node for people who did not ask for that. The plain-name dual-A publish is
    # the HD-435/HD-436 `zone_kogler_si` `tailnet: dual` step and lands with the record
    # vocabulary, not here.
    # NO authentik-forward-auth — same reason as the `ha` route above: it breaks the Companion
    # app's token/WebSocket flow (docs/smart-home.md).
    ha-ts:
      rule: "Host(`ha.{{ tailnet_base_domain }}`) || Host(`{{ tailnet_pi_node_name }}.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      middlewares:
        - ha-ts-strip-forwarded
      service: ha-backend
      tls: true
{% endif %}

  services:
    ha-backend:
      loadBalancer:
        servers:
          - url: "http://{{ ha_vip }}:8123"
    dns-pi-backend:
      loadBalancer:
        servers:
          - url: "http://{{ technitium_secondary_ip }}:5380"

# Wildcard *.kogler.si cert pair, pulled from the VPS `traefik` (the single ACME
# issuer, HD-178/HD-181/HD-204; Cloudflare DNS-01) by the ha-cert-sync timer.
# File names come from the shared
# `wildcard_cert_file` / `wildcard_cert_key_file` vars in group_vars/all.yml so the
# VPS issuer, the pull timer and this config can never drift.
# Offline-safe: both routes stay TLS-valid even when WAN/ACME is down.
tls:
  certificates:
    - certFile: "/etc/traefik/certs/{{ wildcard_cert_file }}"
      keyFile: "/etc/traefik/certs/{{ wildcard_cert_key_file }}"

# traefik-ha — dynamic routes (file provider). Serves ha.kogler.si + dns-pi.kogler.si:
# the services hosted on the Pi that must stay reachable when oldsrv is DOWN.
#   - ha:      same `ha` route semantics as the oldsrv `traefik` (backend = VIP:8123),
#              NO Authentik Forward-Auth (breaks the Companion WebSocket/token flow).
#   - dns-pi:  Technitium SECONDARY web UI (dns-pi.kogler.si → VIP, served by THIS
#              edge so it survives an oldsrv outage; backend = local host
#              {{ technitium_secondary_ip }}:5380). No Forward-Auth — a
#              management surface with its own login, internal-only.
#   NOTE — no crowdsec-only here: CrowdSec runs on oldsrv and is DOWN whenever this failover
#   edge is live, so the bouncer would query a dead LAPI and fail the ha route open/closed at
#   exactly the moment it must survive. The Pi edge stays CrowdSec-free by design; oldsrv's own
#   `traefik` ha route (which has local CrowdSec) carries the bouncer.
#   - http-redirect: catch-all :80 → :443 (the `web` entrypoint).
#   ACME is DISABLED on this edge — TLS comes from the cert files pulled from the
#   VPS (the single ACME issuer; see tls.certificates below). No certResolver is
#   configured.

http:
  middlewares:
{% if tailnet_pi_ip is defined and tailnet_pi_ip %}
    # HA rejects X-Forwarded-* from a proxy it does not trust, and `ha_trusted_proxies` covers
    # the edge container addresses — not a tailnet node address. Strip the headers on the
    # tailnet leg instead of widening HA's trust list to a tailnet range.
    ha-ts-strip-forwarded:
      headers:
        customRequestHeaders:
          X-Forwarded-For: ""
          X-Forwarded-Proto: ""
          X-Forwarded-Host: ""
          X-Forwarded-Server: ""
{% endif %}
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true

  routers:
    ha:
      rule: "Host(`ha.kogler.si`)"
      entryPoints:
        - websecure
      service: ha-backend
      tls: true
      # NOTE: no authentik-forward-auth@file middleware on the ha route
    dns-pi:
      rule: "Host(`dns-pi.kogler.si`)"
      entryPoints:
        - websecure
      service: dns-pi-backend
      tls: true
      # NOTE: no authentik-forward-auth on the dns-pi route (own-login mgmt surface)
    http-redirect:
      rule: "HostRegexp(`.+`)"
      # v3 needs the PLAIN regex. The v2 template form HostRegexp(`{host:.+}`) parses and
      # reports the router as `enabled` while matching NOTHING — http:// then 404s on every
      # edge even though the config text reads correctly.
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: noop@internal
{% if tailnet_pi_ip is defined and tailnet_pi_ip %}
    # --- HA over the TAILNET — the away path, node-direct, survives oldsrv down ---
    # Matches `ha.{{ tailnet_base_domain }}` (the tailnet-only twin published by
    # tailnet_ts_only_subdomains) and this node's MagicDNS name, so it answers BEFORE any
    # `ha.kogler.si` extra-record exists. Publishing the PLAIN name into MagicDNS would answer
    # it client-side for a phone standing at home and move HA off the VIP onto a node unasked,
    # so the dual-A publish belongs to the record vocabulary, not to this router.
    # NO authentik-forward-auth — as above, it breaks the Companion token/WebSocket flow.
    ha-ts:
      rule: "Host(`ha.{{ tailnet_base_domain }}`) || Host(`{{ tailnet_pi_node_name }}.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      middlewares:
        - ha-ts-strip-forwarded
      service: ha-backend
      tls: true
{% endif %}

  services:
    ha-backend:
      loadBalancer:
        servers:
          - url: "http://{{ ha_vip }}:8123"
    dns-pi-backend:
      loadBalancer:
        servers:
          - url: "http://{{ technitium_secondary_ip }}:5380"

# Wildcard *.kogler.si cert pair, pulled from the VPS `traefik` (the single ACME issuer,
# Cloudflare DNS-01) by the ha-cert-sync timer. File names come from the shared
# File names come from the shared
# `wildcard_cert_file` / `wildcard_cert_key_file` vars in group_vars/all/ so the
# VPS issuer, the pull timer and this config can never drift.
# Offline-safe: both routes stay TLS-valid even when WAN/ACME is down.
tls:
  certificates:
    - certFile: "/etc/traefik/certs/{{ wildcard_cert_file }}"
      keyFile: "/etc/traefik/certs/{{ wildcard_cert_key_file }}"

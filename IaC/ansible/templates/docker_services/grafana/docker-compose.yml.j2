# grafana docker-compose.yml — Observability dashboards (stats.kogler.si)
#   Queries Prometheus + Loki on db-internal. Admin auth via Authentik
#   Forward-Auth (no OIDC — the Forward-Auth layer handles auth).
#   SMTP configured for fail-safe alert contact point.
#
#   Provisioning configs (datasources, dashboards, alerting) are mounted
#   from /srv/docker/grafana/provisioning/ and populated by the monitoring
#   Ansible role (or manually).
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     grafana_login        (Login: password=<admin password>)
#     smtp_login   (Login: username=<SMTP user>, password=<SMTP password>)
services:
  grafana:
    image: grafana/grafana:{{ grafana_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: grafana
    restart: unless-stopped
    networks:
      - traefik-public
      - db-internal
    volumes:
      - /srv/docker/grafana/data:/var/lib/grafana
      - /srv/docker/grafana/provisioning:/etc/grafana/provisioning
    environment:
      # Admin account — behind Authentik Forward-Auth (admin uses Forward-Auth SSO,
      # this account is the break-glass / provisioning owner).
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "{{ lookup('community.general.onepassword', 'grafana_login', field='password', vault=op_vault) }}"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      # Single auth path (KOPS-008 / HD-82): force every login through the Authentik
      # Forward-Auth proxy — the Grafana login form is disabled so the admin account
      # can't be reached by a direct bypass. Admin stays reachable via API/basic auth
      # for provisioning (break-glass).
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      # Auth proxy — trusts the Authentik Forward-Auth headers passed by Traefik.
      # Users who pass Forward-Auth are auto-logged in, skipping the Grafana login form.
      # Header-trust hardening (S16/HD-190, HD-81 precedent):
      #   • WHITELIST pins the auth-proxy source to the Traefik edge container IPs
      #     (traefik_edge_ips) — a forged X-authentik-* header sent directly from a
      #     compromised sibling container on traefik-public is rejected by source IP.
      #   • AUTO_SIGN_UP off — no account is auto-created from a header; users must be
      #     mapped explicitly (admin/API/provisioning) before they can log in.
      #   Residual risk (documented): [auth.proxy] performs NO signature validation of
      #   the header itself in Grafana OSS — signed-header validation would require the
      #   separate [auth.jwt] module (jwks_url against the Authentik OIDC app) — revisit
      #   at deploy once the sso OIDC app JWKS path is live-verifiable. Compensating
      #   controls: edge whitelist above + CrowdSec bouncer + fail2ban http-auth jail.
      GF_AUTH_PROXY_ENABLED: "true"
      GF_AUTH_PROXY_HEADER_NAME: X-authentik-email
      GF_AUTH_PROXY_HEADER_PROPERTY: email
      GF_AUTH_PROXY_WHITELIST: "{{ traefik_edge_ips | join(',') }}"
      GF_AUTH_PROXY_AUTO_SIGN_UP: "false"
      # Server
      GF_SERVER_ROOT_URL: "https://stats.kogler.si"
      GF_SERVER_DOMAIN: stats.kogler.si
      # SMTP — fail-safe contact point (parallel to n8n → Signal)
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: "{{ grafana_smtp_host | default('localhost:25') }}"
      GF_SMTP_USER: "{{ lookup('community.general.onepassword', 'smtp_login', field='username', vault=op_vault) }}"
      GF_SMTP_PASSWORD: "{{ lookup('community.general.onepassword', 'smtp_login', field='password', vault=op_vault) }}"
      GF_SMTP_FROM_ADDRESS: "grafana@kogler.si"
      GF_SMTP_FROM_NAME: Grafana
      # No OIDC env vars — auth is handled by Authentik Forward-Auth in Traefik.
      # OIDC can be configured via provisioning if needed later.
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.grafana.rule: "Host(`stats.kogler.si`)"
      traefik.http.routers.grafana.entrypoints: websecure
      {{ 'traefik.http.routers.grafana.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.grafana.middlewares: authentik-forward-auth@file
      traefik.http.services.grafana.loadbalancer.server.port: "3000"
networks:
  traefik-public:
    external: true
  db-internal:
    external: true

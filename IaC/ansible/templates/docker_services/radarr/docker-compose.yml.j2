# radarr docker-compose.yml — Movies (radarr.kogler.si)
#   TRaSH hardlink import: /mnt/nas/media/downloads/complete/movies → /mnt/nas/media/media/movies.
#   Forward-Auth. linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  radarr:
    image: linuxserver/radarr:{{ radarr_version }}
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    # read_only intentionally ABSENT (HD-318): linuxserver s6-overlay images
    # do not support read_only root — it caused /run/s6 exec + /config/Sentry init
    # failures. Keep cap_drop: ALL + /run:exec for the remaining hardening.
    tmpfs:
      - /tmp
      - /run:exec
      # HD-1081: this image chowns /run/radarr-temp at startup, but cap_drop: ALL above removes
      # CAP_CHOWN, so that chown fails and the dir stays root:root 0755. ASP.NET Core writes its
      # DataProtection key ring (the cookie-signing keys) there via TMPDIR, so an unwritable dir
      # means the app cannot issue a session cookie — every login bounces back to /login. Mount
      # it 1777 explicitly; no capability has to be given back.
      - /run/radarr-temp:mode=1777,exec
    container_name: radarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    ports:
      # HD-419 pattern: loopback publish so the host-net home edge can reach the backend.
      - "{{ radarr_bind }}:{{ radarr_host_port }}:7878"
    volumes:
      - /srv/docker/radarr/config:/config
      - /mnt/nas/media/media:/media              # rw — creates movies/ folder, hardlink import
      - /mnt/nas/media/downloads:/downloads       # rw — downloads/complete/movies
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.radarr.rule: "Host(`radarr.kogler.si`)"
      traefik.http.routers.radarr.entrypoints: websecure
      {{ 'traefik.http.routers.radarr.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.radarr.middlewares: authentik-forward-auth@file
      traefik.http.services.radarr.loadbalancer.server.port: "7878"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

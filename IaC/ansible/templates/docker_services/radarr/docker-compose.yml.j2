# radarr docker-compose.yml — Movies (radarr.kogler.si)
#   TRaSH hardlink import: /mnt/nas/media/downloads/complete/movies → /mnt/nas/media/media/movies.
#   Forward-Auth. linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}
#   — none needed
services:
  radarr:
    image: linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/radarr/config:/config
      - /mnt/nas/media/media:/media              # rw — creates movies/ folder, hardlink import
      - /mnt/nas/media/downloads:/downloads       # rw — downloads/complete/movies
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.radarr.rule: "Host(`radarr.kogler.si`)"
      traefik.http.routers.radarr.entrypoints: websecure
      traefik.http.routers.radarr.tls.certresolver: letsencrypt
      traefik.http.routers.radarr.middlewares: authentik-forward-auth@file
      traefik.http.services.radarr.loadbalancer.server.port: "7878"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
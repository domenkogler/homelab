# pgvector docker-compose.yml — AI-stack RAG vector store (pgvector)
#   PostgreSQL with the pgvector extension for Open WebUI RAG (embeddings + chat history).
#   On `db-internal` (fully isolated overlay — same precedent as the other DBs); reachable
#   only by the consuming AI services (Open WebUI) once they're deployed. docs/services-ai.md,
#   docs/backup.md (HD-102).
#
#   Image: pgvector/pgvector, pinned to pg16 on Debian 13 (trixie) via pgvector_version
#   (HD-61/KOPS-053 convention). SQL port 5432 stays on the overlay — NO host port.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     pgvector_db  (Database: username=<db user>, password=<db password>) — fail-closed (HD-65)
#   Backup: covered by db-backup DB04 block -> Kopia snapshots the dump scratch dir (HD-102;
#   RAG index + chat history = "irretrievable metadata", KOPS-026 class, docs/backup.md).
services:
  pgvector:
    image: pgvector/pgvector:{{ pgvector_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: pgvector
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/pgvector:/var/lib/postgresql/data   # nvme dataset; RAG index + chat history (backed up via db-backup)
    environment:
      POSTGRES_USER: "{{ lookup('community.general.onepassword', 'pgvector_db', field='username', vault=op_vault) }}"
      POSTGRES_PASSWORD: "{{ lookup('community.general.onepassword', 'pgvector_db', field='password', vault=op_vault) }}"
      POSTGRES_DB: pgvector
      POSTGRES_INITDB_ARGS: "--data-checksums"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    shm_size: 128mb
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 12
networks:
  db-internal:
    external: true
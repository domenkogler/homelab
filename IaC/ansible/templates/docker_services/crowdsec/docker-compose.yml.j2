# crowdsec docker-compose.yml — WAF & brute-force protection
#   Parses Traefik + Authentik logs, maintains a community blocklist,
#   and feeds the CrowdSec bouncer middleware in Traefik.
#
#   No web UI — the CrowdSec dashboard is served via the Metabase
#   container (sec.kogler.si) which queries the CrowdSec LAPI.
#
#   Docker socket access enables container-log parsing (Traefik logs).
#   No 1Password secrets required for basic operation.
#   See docs/services-traefik.md §CrowdSec.
services:
  crowdsec:
    image: crowdsecurity/crowdsec:{{ crowdsec_version }}
    cap_drop:
      - ALL
    # read_only REMOVED (Wave-3 round-2 triage 2026-08-22): upstream docker_start.sh seeds
    # and re-links /staging at every boot and assumes it persists on the rootfs; a tmpfs
    # /staging starts empty, the seed glob degenerates and PID 1 aborts. Same Class-B
    # relaxation precedent as forgejo/metabase. Follow-up candidate: upstream rootless work.
    tmpfs:
      - /tmp
    container_name: crowdsec
    restart: unless-stopped
    networks:
      - traefik-public
    volumes:
      - /srv/docker/crowdsec/config:/etc/crowdsec
      - /srv/docker/crowdsec/db:/var/lib/crowdsec/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      COLLECTIONS: "{{ crowdsec_collections }}"
      # LAPI is enabled by default; Metabase queries it on :8080 internally.
      # No Traefik labels — CrowdSec is not a web-facing service.
networks:
  traefik-public:
    external: true
# keepalived.conf — STANDBY node (oldsrv) for HA VIP
#   Vault-escape note: this file is consumed by keepalived itself (NOT `docker compose`
#   interpolation), so `{{ vault['…'] }}` values pass through unchanged. Compose's `$`-
#   substitution only applies to compose files (HD-270/HD-233 lesson). Raw `auth_pass
#   {{ vault['ha-vrrp_password'].password }}` here is safe — no `| replace('$','$$')`.
#   VIP 10.10.1.200 on the Home VLAN. Priority is LOWER than the Pi primary,
#   so in normal operation the Pi owns the VIP. On Pi failure, this node
#   takes over (manual forward takeover per docs/smart-home-failover.md).
#
# NOTE: VRRP crosses L2; both nodes must be reachable on the Home VLAN.
# The Pi primary uses the same file with state MASTER and a higher priority.

vrrp_instance HA_VIP {
    state BACKUP
    interface eth0            # interface on the Home VLAN (VLAN 10)
    virtual_router_id 51
    priority 100              # primary (Pi) uses a higher priority, e.g. 110
    advert_int 1
    nopreempt                 # do NOT auto-steal the VIP back → prevents split-brain
    authentication {
        auth_type PASS
        auth_pass {{ vault['ha-vrrp_password'].password }}
    }
    virtual_ipaddress {
        {{ ha_vip }}/{{ ha_vip_cidr }}        # HA VIP — same on primary + standby
    }
}

# sabnzbd docker-compose.yml — Usenet downloader (sab.kogler.si)
#   Eweka NL, plain LAN (no VPN — Eweka is a licensed service).
#   Categories movies/tv/music → /mnt/nas/media/downloads/complete/<cat>
#   for TRaSH hardlink import. Forward-Auth.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed (Eweka credentials set via web UI, not env vars)
services:
  sabnzbd:
    image: linuxserver/sabnzbd:{{ sabnzbd_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: sabnzbd
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/sabnzbd/config:/config
      - /mnt/nas/media/downloads:/downloads     # rw — downloads/complete/<cat>
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.sabnzbd.rule: "Host(`sab.kogler.si`)"
      traefik.http.routers.sabnzbd.entrypoints: websecure
      {{ '' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.sabnzbd.middlewares: authentik-forward-auth@file
      traefik.http.services.sabnzbd.loadbalancer.server.port: "8080"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

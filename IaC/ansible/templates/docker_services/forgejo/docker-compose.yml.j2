# forgejo docker-compose.yml — Git hosting (git.kogler.si)
#   Postgres-backed, OIDC via Authentik (native, NOT forward-auth — Forgejo must own its auth
#   state for API/SSH). HD-148: Authentik provider + `forgejo_oidc` client declared in the
#   Blueprint + client creds seeded by the glue. DEPLOY-VERIFY (HD-149):
#   - Register the OIDC source in the Forgejo ADMIN UI (Site Administration > Authentication
#     Sources > Add > OAuth2 > OpenID Connect), NOT env-injected (needs DB formatting sync).
#     Set the Authentication Name (e.g. `Authentik`) — it MUST match the callback path exactly:
#     https://git.kogler.si/user/oauth2/<Authentication Name>/callback
#   - Client ID / Secret / Issuer -> from `forgejo_oidc` (username/credential) + the Blueprint.
#   - ROOT_URL must be https (app.ini) or Authentik rejects the callback.
#   - Once the source is registered + verified, switch this route from Forward-Auth to
#     crowdsec-only@file (Forgejo handles its own auth). Until then it stays behind
#     Forward-Auth so git/web are never left unauthenticated.
#   Data in /srv/docker/forgejo/ (included in Kopia backup).
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     forgejo_db       (Database: username=<db user>, password=<db password>)
#     forgejo_oidc     (api: username=client_id, credential=client_secret — Authentik OIDC client)
services:
  forgejo:
    image: codeberg.org/forgejo/forgejo:{{ forgejo_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    # read_only REMOVED (Wave-2 triage 2026-08-22): Forgejo boots via s6-svscan /etc/s6 and
    # must create its supervision lock INSIDE that dir on the rootfs; a tmpfs over /etc/s6
    # would mask the bundled init scripts. Follow-up candidate: -rootless image variant.
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: forgejo
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/forgejo/data:/data
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      FORGEJO__database__DB_TYPE: postgres
      FORGEJO__database__HOST: forgejo-db:5432
      FORGEJO__database__NAME: forgejo
      FORGEJO__database__USER: "{{ vault['forgejo_db'].username }}"
      FORGEJO__database__PASSWD: "{{ vault['forgejo_db'].password }}"
      # Server identity (Wave-3 R5): without these the first-boot wizard defaulted
      # AppURL to http://localhost:3000, breaking links/mail/OIDC callbacks.
      FORGEJO__server__DOMAIN: git.kogler.si
      FORGEJO__server__ROOT_URL: https://git.kogler.si/
      # HD-230 (2026-08-23, owner decision): native-OIDC SSO replaces the forward-auth
      # wall. First SSO login associates by email with the existing local account; the
      # OAuth source itself is registered idempotently post-up (deploy-service.yml,
      # `gitea admin auth add-oauth`) from vault item forgejo_oidc — HD-148 design.
      FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION: "true"
      FORGEJO__oauth2_client__OPENID_CONNECT_SCOPES: "openid profile email"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.forgejo.rule: "Host(`git.kogler.si`)"
      traefik.http.routers.forgejo.entrypoints: websecure
      {{ 'traefik.http.routers.forgejo.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # HD-230: crowdsec-only tier — auth moved IN-APP to native OIDC (Authentik);
      # forward-auth wall removed so SSO callbacks and m2m API hits reach forgejo directly.
      traefik.http.routers.forgejo.middlewares: crowdsec-only@file
      traefik.http.services.forgejo.loadbalancer.server.port: "3000"
    depends_on:
      - forgejo-db

  forgejo-db:
    image: postgres:16-alpine
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: forgejo-db
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/forgejo/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: forgejo
      POSTGRES_USER: "{{ vault['forgejo_db'].username }}"
      POSTGRES_PASSWORD: "{{ vault['forgejo_db'].password }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

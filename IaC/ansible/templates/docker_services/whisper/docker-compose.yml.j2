# whisper docker-compose.yml — pinned-AI STT leg on the RX 7600
#   whisper.cpp `whisper-server` on the VULKAN backend (RADV, gfx1102). Serves the voice
#   pipeline's STT. `--inference-path /v1/audio/transcriptions` makes it OpenAI-shaped
#   NATIVELY (docs/services-ai-bench.md §2) — that satisfies an OpenAI-shaped client, which is
#   what LiteLLM's `local-stt` row is. ⛔ It is NOT what Home Assistant speaks: on the HA pin the
#   `whisper` integration is a `virtual` / `supported_by: wyoming` stub, so Assist reaches local STT
#   ONLY over the Wyoming protocol, which this container does not serve
#   (docs/smart-home-voice.md §Components). Nothing in this file hands HA a voice pipeline.
#   WHY VULKAN AND NOT ROCm: no `whisper.cpp` ROCm/HIP artifact is published at all (ghcr
#   tags = main, main-musa, main-intel, main-cuda, main-vulkan, main-arm64,
#   main-vulkan-arm64; Docker Hub ggmlorg/whisper.cpp = 404), so a HIP recipe would be a
#   self-build with no Renovate trail. Vulkan/RADV is native RDNA3 and needs NO ROCm userspace
#   and NO /dev/kfd — and drops the per-ROCm-runtime host-RAM tax.
#   Network doctrine (same as ollama): reached ONLY by LiteLLM on the dedicated
#   `llm-backend` bridge. This API has NO auth, so the network IS the boundary — hence NO
#   `ports:` and NO Traefik labels. Consumers reach it through LiteLLM, never directly.
#   Device: ONLY the dGPU render node (`gpu_vulkan_render_node` = renderD129). renderD128 is
#   the HD 630 iGPU: it is the family desktop's Xorg device AND the Jellyfin QSV transcoder,
#   and it is measured SLOWER THAN CPU for this work (bench §4). No GGML_VK_VISIBLE_DEVICES:
#   with only renderD129 mounted, Vulkan0 is unambiguous.
#   Resident by design: whisper-server loads the model at start and has no unloading path;
#   the tier budget is ~2.4 GiB of 8 GiB (docs/services-ai.md §3a). The mem cap below leaves
#   room for the CPU-fallback path so the cap never becomes the thing that kills the leg.
#   Model: fetched + sha256-verified by the generic model-fetch task (svc.model_* on the
#   registry entry) into /srv/models/whisper (nvme/models dataset — regenerable, never
#   backed up), mounted :ro.
#
# Secrets: NONE (public model artifact, no API key on an unexposed bridge) — intentionally
#   OUT of _template_vault_items, renders with zero vault lookups (same as ollama/spark-ai).
services:
  whisper:
    image: "{{ whisper_cpp_vulkan_image }}"
    container_name: whisper
    restart: unless-stopped
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      - llm-backend
    devices:
      - "{{ gpu_vulkan_render_node }}:{{ gpu_vulkan_render_node }}"
    group_add:
      - "{{ gpu_render_gid }}"
    volumes:
      - /srv/models/whisper:/models:ro
    entrypoint: ["/app/build/bin/whisper-server"]
    command:
      - "--inference-path"
      - "/v1/audio/transcriptions"
      - "--host"
      - "0.0.0.0"                                  # bound on llm-backend only — never published
      - "--port"
      - "{{ ai_tier_whisper_port }}"
      - "-m"
      - "/models/ggml-large-v3-turbo.bin"          # fp16 (plan of record); q5_0 = -1.0 GiB relief
      - "-l"
      - "auto"                                     # auto-detect — the pipeline is Slovenian
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    # Image-level HEALTHCHECK is hardcoded to :8080; this leg listens on its own port, so the
    # inherited check exits 7 (connection refused) and the container reads `unhealthy` while it
    # answers 200. Override it against the ACTUAL port — a health signal that
    # cannot fail is worse than none, and `unhealthy` poisons every future "what is actually
    # live" census. start_period covers Vulkan init + weight load.
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ ai_tier_whisper_port }}/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 90s
    deploy:
      resources:
        limits:
          # Quoted: compose's schema requires limits.memory to be a STRING (pre-deploy
          # validation catches an int — spark-dcgm precedent).
          memory: "{{ ai_tier_whisper_memory_limit }}"
networks:
  llm-backend:
    external: true

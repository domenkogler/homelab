# kopia-server docker-compose.yml — Off-site backup repository server
#   Web UI + S3-backed repository (iDrive e2). Auto-creates the repository
#   on first start if no config exists. On oldsrv in Phase 1; moves to VPS
#   in Phase 2.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     kopia_password  (Password: repository master password)
#     kopia-s3_api    (API Credential: username=<S3 access key>, credential=<S3 secret key>)
#   Config vars (group_vars/all.yml):
#     kopia_s3_bucket, kopia_s3_endpoint
services:
  kopia-server:
    image: kopia/kopia:{{ kopia_version | default('latest') }}
    container_name: kopia-server
    restart: unless-stopped
    command:
      - sh
      - -c
      - |
        set -e
        if [ ! -f /app/config/config.json ]; then
          echo "Creating S3 repository..."
          kopia repository create s3 \
            --bucket="${KOPIA_S3_BUCKET:?}" \
            --endpoint="${KOPIA_S3_ENDPOINT:?}" \
            --access-key="${KOPIA_S3_ACCESS_KEY:?}" \
            --secret-access-key="${KOPIA_S3_SECRET_ACCESS_KEY:?}"
        fi
        exec kopia server start --address=0.0.0.0:51515 --insecure --without-password
    networks:
      - services-internal
    volumes:
      - /srv/docker/kopia-server/config:/app/config
      - /srv/docker/kopia-server/cache:/app/cache
    environment:
      KOPIA_PASSWORD: "{{ lookup('community.general.onepassword', 'kopia_password', field='password', vault=op_vault) }}"
      KOPIA_S3_BUCKET: "{{ kopia_s3_bucket | default('kogler-homelab') }}"
      KOPIA_S3_ENDPOINT: "{{ kopia_s3_endpoint | default('https://e2.idy.io') }}"
      KOPIA_S3_ACCESS_KEY: "{{ lookup('community.general.onepassword', 'kopia-s3_api', field='username', vault=op_vault) }}"
      KOPIA_S3_SECRET_ACCESS_KEY: "{{ lookup('community.general.onepassword', 'kopia-s3_api', field='credential', vault=op_vault) }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  services-internal:
    external: true
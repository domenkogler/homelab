# kopia-server docker-compose.yml — Off-site backup repository server
#   Web UI + SFTP-backed repository on the Hetzner Storage Box **backup** (u653424, SSH/SFTP port 23,
#   SSH-key auth — NO password, NOT S3). Auto-creates the repository on first start if no config
#   exists. On the VPS (Phase 1.5); a second agent also runs on oldsrv. Backend decided HD-31/HD-135:
#   the Hetzner Storage Box supports SSH/SFTP only (no S3/object storage).
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     kopia_password       (Password: repository master password)
#     kopia-server-internal_api (API Credential: username=<server-admin-user@host>, credential=<password>)
#                              — server auth (HD-59/HD-318a): replaces `--without-password`. The htpasswd
#                              gets BOTH the generic admin entry AND the per-client user@host the backup
#                              agent presents (`kopia_agent_user`, group_vars/all.yml — see the boot script).
#                              The repo user (`kopia server users add`) password MUST equal the repo master
#                              password (kopia quirk, verified live 2026-09-08); password is written
#                              plaintext to server.htpasswd at 0600.
#   Backup-box SFTP connection (NOT a secret item): SSH-key auth via `Hertzner-SB-Backup` (1Password connection
#   ref); host/user/port/path from `kopia_sftp_*` in group_vars/all.yml. No kopia-sftp_api item, and the legacy
#   kopia-s3_api (iDrive e2 S3) is retired.
#   Config vars (group_vars/all.yml):
#     kopia_sftp_host, kopia_sftp_port, kopia_sftp_user (backup box u653424, port 23)
#
#   Reach (HD-191): the oldsrv agent connects over the WG S2S tunnel — :51515 is
#   published ONLY on the VPS tunnel address (wg_s2s_vps.ip), never 0.0.0.0.
services:
  kopia-server:
    image: kopia/kopia:{{ kopia_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
      - /app/logs   # image sets KOPIA_LOG_DIR=/app/logs - EROFS under read_only without it
    # Wave-2 triage 2026-08-22: image ENTRYPOINT is /bin/kopia; without clearing it the
    # command below resolved to `kopia sh -c ...` and died instantly. entrypoint: [] makes
    # the sh -c bootstrap script PID 1 argv.
    entrypoint: []
    container_name: kopia-server
    restart: unless-stopped
    ports:
      # HD-191: WG-only reach for the oldsrv agent. Fail-loud guard mirrors the
      # authentik LDAP bind (HD-186): unprovisioned router pubkey -> loopback only.
      # Non-secret `default('')` (CONVENTIONS §3): structural fallback for the WG peer-key
      # gate; `else '127.0.0.1'` is a loopback IP, NOT a 1Password secret — fail-loud would
      # be wrong here. See HD-62 + HD-186 precedent (loki/prometheus/authentik LDAP line).
      - "{{ wg_s2s_vps.ip if (wg_s2s_vps.peer_public_key | default('') | length > 0) else '127.0.0.1' }}:51515:51515"
    command:
      - sh
      - -c
      - |
        set -e
        # Fail loud: server auth identity is REQUIRED (HD-59 / HD-65) — never start an
        # unauthenticated Kopia server on services-internal.
        : "$${KOPIA_SERVER_USER:? kopia-server_internal_api.username missing — aborting}"
        : "$${KOPIA_SERVER_PASSWORD:? kopia-server_internal_api.credential missing — aborting}"
        # Write the htpasswd file (plaintext form accepted by tg123/go-htpasswd), 0600.
        # HD-59: the generic `kopia-server-internal_api.username` entry (server admin /
        # UI identity) AND the per-client `oldsrv-agent@oldsrv.kogler.si` identity the
        # backup agent presents via `--override-username/--override-hostname` (kopia's
        # htpasswd-file = allowed `user@hostname` entries; a client whose presented
        # user@host is absent gets `access denied` — HD-318a live). Both share the same
        # credential (kopia-server-internal_api.credential); it must match the agent
        # URL userinfo exactly.
        printf '%s:%s\n' "$${KOPIA_SERVER_USER}" "$${KOPIA_SERVER_PASSWORD}" > /app/config/server.htpasswd
        printf '%s:%s\n' "$${KOPIA_AGENT_USER}" "$${KOPIA_SERVER_PASSWORD}" >> /app/config/server.htpasswd
        chmod 600 /app/config/server.htpasswd
        if [ ! -f /app/config/repository.config ]; then
          echo "Creating SFTP repository on backup box..."
          # Hetzner Storage Box backup (u653424) = SSH/SFTP only port 23, SSH-key auth (no password).
          # Strict pinning (KOPS-050): --keyfile/--known-hosts point at two files SEEDED into the
          # config bind before first start (Wave-3 R2 triage; --no-check-known-hosts does not exist
          # in kopia 0.23.1): /srv/docker/kopia-server/config/sftp_key = private key of the
          # backup-box SSH identity (1Password, 0600); .../config/known_hosts = ssh-keyscan -p 23
          # <backup-box-host> output. Repo path under the box home; sole consumer (Hetzner model).
          # NOTE: the gate file is `repository.config` (kopia's repo-connection file written by
          # `kopia repository create`), NOT config.json (an unrelated technitium zone file) —
          # HD-271-followup: the old config.json gate re-created an existing repo every boot and
          # crash-looped with "found existing data in storage location" once the repo existed.
          kopia repository create sftp \
            --username="$${KOPIA_SFTP_USER:?}" \
            --host="$${KOPIA_SFTP_HOST:?}" \
            --port="$${KOPIA_SFTP_PORT:?}" \
            --path="$${KOPIA_SFTP_PATH:?}" \
            --known-hosts=/app/config/known_hosts \
            --keyfile=/app/config/sftp_key \
            --password="$${KOPIA_PASSWORD:?}"
        fi
        # --- TLS transport (HD-318a): plain-HTTP is HARD-REJECTED by `kopia repository
        # connect server` in 0.23.x ("invalid server address, must be 'https://host:port'") —
        # no client-side --insecure exists, and a version pin to an http-accepting kopia
        # is not viable (verified in source + live 2026-09-08). kopia's OWN
        # `--tls-generate-cert` (in-memory) regenerates a FRESH cert every restart, so the
        # pinned fingerprint would change and the oldsrv agent would break after the first
        # server bounce. The durable fix = a PERSISTED self-signed cert+key pair (generated
        # once, never regenerated — kopia's maybeGenerateTLS refuses to overwrite existing
        # files) with the agent pinned to its stable SHA-256 fingerprint.
        #   The files live on the host config bind (/srv/docker/kopia-server/config/) so
        # they survive container rebuilds. If absent (fresh/recovered volume), generate
        # them here with a SAN covering the wg-s2s address + loopback; the agent pins the
        # fingerprint, so transport security DOES NOT depend on trusting any CA.
        if [ ! -f /app/config/tls.crt ] || [ ! -f /app/config/tls.key ]; then
          echo "Generating persisted TLS certificate for kopia-server..."
          openssl req -x509 -newkey rsa:4096 -nodes \
            -keyout /app/config/tls.key \
            -out /app/config/tls.crt \
            -days 3650 \
            -subj "/CN=kopia-server" \
            -addext "subjectAltName=IP:$${KOPIA_SERVER_ADDR_HOST:-127.0.0.1},IP:127.0.0.1" \
            >/dev/null 2>&1
          chmod 600 /app/config/tls.key
        fi
        # Print the fingerprint once (owner/agent pinning reference).
        echo "kopia-server TLS fingerprint (sha256):"
        openssl x509 -in /app/config/tls.crt -noout -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr 'A-Z' 'a-z'
        if [ ! -f /app/config/tls-sha256 ]; then
          openssl x509 -in /app/config/tls.crt -noout -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr 'A-Z' 'a-z' > /app/config/tls-sha256
        fi
        # HD-318a: provision the backup-client repository user (kopia's server-auth model:
        # "Server will allow connections from users whose accounts are stored in the
        # repository" — the htpasswd alone is NOT sufficient for session auth; the repo
        # user (user@host) must exist in the users store). The user password is the REPO
        # MASTER password (KOPIA_PASSWORD) — the same the client uses for `connect server
        # --password=` (kopia quirk: the per-user password must equal the repo password;
        # verified live 2026-09-08 — a non-repo-password user was 'access denied' at the
        # session stage even with a matching htpasswd entry). Idempotent: users add fails
        # if the user exists, so try set-after-add.
        if ! kopia server users list | grep -q "^$${KOPIA_AGENT_USER}$"; then
          echo "Adding kopia repo user $${KOPIA_AGENT_USER}..."
          kopia server users add "$${KOPIA_AGENT_USER}" --user-password="$${KOPIA_PASSWORD}"
        else
          # keep the password in sync with the repo password (idempotent re-seed)
          kopia server users set "$${KOPIA_AGENT_USER}" --user-password="$${KOPIA_PASSWORD}" || true
        fi
        exec kopia server start --address=0.0.0.0:51515 \
          --tls-cert-file=/app/config/tls.crt \
          --tls-key-file=/app/config/tls.key \
          --htpasswd-file=/app/config/server.htpasswd  # no without-password (HD-59)
    networks:
      - services-internal
    volumes:
      - /srv/docker/kopia-server/config:/app/config
      - /srv/docker/kopia-server/cache:/app/cache
    environment:
      KOPIA_PASSWORD: "{{ vault['kopia_password'].password | replace('$','$$') }}"
      # Backup box SFTP connection (Hetzner Storage Box backup, u653424, port 23, SSH-key auth).
      # kopia_sftp_* values in group_vars/all.yml; NO kopia-s3_api anymore (iDrive dropped, HD-31).
      KOPIA_SFTP_USER: "{{ kopia_sftp_user | default('u653424') }}"
      KOPIA_SFTP_HOST: "{{ kopia_sftp_host | default('u653424.your-storagebox.de') }}"
      KOPIA_SFTP_PORT: "{{ kopia_sftp_port | default(23) }}"
      KOPIA_SFTP_PATH: "{{ kopia_sftp_path | default('/kopia') }}"
      # Server auth (HD-59): user@host + password for the htpasswd file. No default('') —
      # a missing 1Password item must abort render (fail-loud, HD-65).
      # (HD-318a: the TLS SAN host is supplied via .env.j2 — compose interpolates it into
      #  the boot command at parse time; a runtime env var is unnecessary and would confuse.)
      KOPIA_SERVER_USER: "{{ vault['kopia-server-internal_api'].username | replace('$','$$') }}"
      KOPIA_SERVER_PASSWORD: "{{ vault['kopia-server-internal_api'].credential | replace('$','$$') }}"
      # HD-318a: the per-client identity the oldsrv backup agent presents (must exist
      # in the htpasswd as user@host). Same credential as the server admin entry.
      KOPIA_AGENT_USER: "{{ kopia_agent_user }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  services-internal:
    external: true
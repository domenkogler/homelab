# Ansible managed - compose interpolation values (rendered from 1Password).
# Vault-escape note: this file is consumed by the kopia binary directly (NOT `docker compose`
# interpolation), so `{{ vault['…'] }}` values pass through unchanged. Compose's `$`-substitution
# only applies to compose files (HD-270/HD-233 lesson). Raw vault creds here are safe — no
# `| replace('$','$$')` needed. (The composing docker-compose.yml.j2 maps `env_file:` to
# this path and the container reads it at startup.)
KOPIA_SERVER_USER={{ vault['kopia-server-internal_api'].username }}
KOPIA_SERVER_PASSWORD={{ vault['kopia-server-internal_api'].credential }}
KOPIA_SFTP_HOST={{ kopia_sftp_host }}
KOPIA_SFTP_PORT={{ kopia_sftp_port }}
KOPIA_SFTP_USER={{ kopia_sftp_user }}
KOPIA_SFTP_PATH={{ kopia_sftp_path }}
KOPIA_PASSWORD={{ vault['kopia_password'].password }}

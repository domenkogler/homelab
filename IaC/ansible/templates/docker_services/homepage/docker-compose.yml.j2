# homepage docker-compose.yml — family launchpad (kogler.si root + home.kogler.si alias)
#   Runs on the VPS next to the public edge (moved from oldsrv per HD-180; implemented
#   HD-183). The route below IS these Docker-provider labels: they register on the VPS
#   traefik over traefik-public once this compose deploys there (audit J10 mechanism).
#   The file provider (traefik dynamic/routes.yml) stays reserved for non-container
#   backends — no duplicate route there.
#   Authentik Forward-Auth (no anonymous access). Reachability/health status is
#   widget/probe-based (siteMonitor probes per tile + blackbox probe_success widgets,
#   homepage_widgets.yaml.j2) — deliberately NO Docker socket here: on the VPS it would
#   only ever see VPS containers, never the oldsrv services the dashboard links to
#   (HD-180 consequence).
#   services.yaml + widgets.yaml are auto-generated by the docker_services post-deploy
#   hook. See docs/services.md + docs/interfaces.md. Secrets via
#   {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }} — none needed here.
services:
  homepage:
    image: ghcr.io/gethomepage/homepage:{{ homepage_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: homepage
    restart: unless-stopped
    environment:
      # Host-header allow-list: the apex AND the `home.` alias — exactly the two hosts
      # the router rule serves; homepage rejects any other Host header.
      HOMEPAGE_ALLOWED_HOSTS: "{{ domain_local | default('kogler.si') }},home.{{ domain_local | default('kogler.si') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    networks:
      - traefik-public
    volumes:
      - ./config:/app/config                            # services.yaml + widgets.yaml (auto-generated)
    labels:
      traefik.enable: "true"
      traefik.http.routers.homepage.rule: "Host(`kogler.si`) || Host(`home.kogler.si`)"
      traefik.http.routers.homepage.entrypoints: websecure
      {% if traefik_acme_issuer is defined and traefik_acme_issuer %}
      traefik.http.routers.homepage.tls.certresolver: letsencrypt
      {% endif %}
      traefik.http.routers.homepage.middlewares: authentik-forward-auth@file
      traefik.http.services.homepage.loadbalancer.server.port: "3000"
networks:
  traefik-public:
    external: true

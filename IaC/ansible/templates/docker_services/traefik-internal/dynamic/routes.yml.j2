# traefik-internal — dynamic routes (file provider). Home-LAN internal all-app edge.
#   Serves THE FULL route table ("all routes on all three nodes" — VPS traefik-tailnet
#   + this + Pi traefik-ha). Home-hosted backends are on the oldsrv LAN IP (host-net —
#   these are the same containers the main public/label edge serves); VPS-hosted
#   backends are reached via the VPS traefik-tailnet edge (WG-S2S, :4443).
#
#   - NO Forward-Auth and NO crowdsec-only middleware anywhere on this edge: both
#     depend on VPS containers (Authentik, CrowdSec LAPI) and would fail exactly when
#     this edge must survive WAN-out. Every app here owns its login (*arr/downloaders =
#     built-in Forms auth; Jellyfin/Seerr/SeerrNG = local login).
#   - http-redirect: catch-all :80 → :443 on BOTH entrypoint pairs (web + web-lan).
#   - ACME is DISABLED — TLS comes from the pulled wildcard pair (tls.certificates
#     below, same pattern as traefik-ha). Offline-safe.
#
# Route set (home-hosted 13 + ha + dns-pi + VPS-hosted set):
 #   media (jellyfin, loopback-published :8096) · seerr (:5055) · seerrng (:5055) · sonarr (:8989) ·
#   radarr (:7878) · lidarr (:8686) · prowlarr (:9696) · bazarr (:6767) ·
#   profilarr (:6868) · sab (:8080) · torrent (:8080) · ha (→ VIP:8123) ·
#   dns-pi (→ VIP → technitium-secondary:5380) · VPS set (foto/file/git/ai/… via
#   wg-s2s traefik-tailnet :4443).
http:
  middlewares:
    # HA refuses any request that carries X-Forwarded-For unless the SENDING socket is in
    # HA's `trusted_proxies`: from oldsrv, `Host: ha.kogler.si` + XFF -> 400 Bad Request
    # from aiohttp, without XFF -> 200; direct VIP:8123 -> 200. Check what the ACTIVE HA
    # host actually enforces before trusting the symptom — and it is NOT the rendered
    # `configuration.yaml`: once `yaml_migration_done` is true HA reads `http` from
    # `<config>/.storage/http`, so this host's address can be in the YAML, survive every
    # converge, and still answer 400. Read the object
    # (`python3 -c "import json;d=json.load(open('/opt/home-assistant-primary/config/.storage/http'));print(d['data']['stable']['trusted_proxies'],d['data']['pending']['trusted_proxies'])"`
    # on the ACTIVE node) and reconcile it there — `roles/home_assistant/tasks/pi.yml`, tag `hd418`, owns
    # that write. Strip the
    # forwarding headers on
    # the tailnet router ONLY: HA then sees a plain, non-proxied request, keeps the Host the
    # client used, and no smart-home config has to change (fixing it on the HA side would
    # mean trusting oldsrv as a proxy + a HA restart). Cost: HA logs the src as oldsrv for
    # this one path, so an HA brute-force ban here would hit the node, not the phone.
    # End-state: HA trusts this edge and
    # serves HA direct, which also repairs the standby edge. The trust side HAS landed: the
    # active node's `.storage/http` now carries the rendered `ha_trusted_proxies` list in `stable` and
    # `pending`, so this host's Home address is on it. What has NOT been taken from this box is the
    # XFF-present → 200 read through this middleware, so the middleware stays.
    ha-ts-strip-forwarded:
      headers:
        customRequestHeaders:
          X-Forwarded-For: ""
          X-Forwarded-Proto: ""
          X-Forwarded-Host: ""
          X-Forwarded-Server: ""
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true
    redirect-to-https-lan:
      redirectScheme:
        scheme: https
        permanent: true
    # HSTS for every :443 route — assigned ENTRYPOINT-wide in the compose CLI
    # (--entrypoints.websecure[.lan].http.middlewares=hsts@file; see its header for why
    # this lives here and not as CLI flags).
    hsts:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false

  routers:
    # --- home-hosted set (lands on the oldsrv LAN IP) ---
    media:
      rule: "Host(`media.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: media-backend
      tls: true
    seerr:
      rule: "Host(`seerr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: seerr-backend
      tls: true
    seerrng:
      rule: "Host(`seerrng.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: seerrng-backend
      tls: true
    sonarr:
      rule: "Host(`sonarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: sonarr-backend
      tls: true
    radarr:
      rule: "Host(`radarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: radarr-backend
      tls: true
    lidarr:
      rule: "Host(`lidarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: lidarr-backend
      tls: true
    prowlarr:
      rule: "Host(`prowlarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: prowlarr-backend
      tls: true
    bazarr:
      rule: "Host(`bazarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: bazarr-backend
      tls: true
    profilarr:
      rule: "Host(`profilarr.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: profilarr-backend
      tls: true
    sab:
      rule: "Host(`sab.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: sab-backend
      tls: true
    torrent:
      rule: "Host(`torrent.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: torrent-backend
      tls: true
    # --- music trio ---
    # Own logins (Aurral/Slskd local auth + the slskd token), NO forward-auth anywhere on this
    # edge — the home edge carries none by design (WAN-out survival). Backends are the oldsrv
    # publishes in group_vars/all/main.yml (`*_url`), never a literal address here.
    aurral:
      rule: "Host(`aurral.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: aurral-backend
      tls: true
    slskd:
      rule: "Host(`slskd.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: slskd-backend
      tls: true
    lidarr-ydl:
      rule: "Host(`lidarr-ydl.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: lidarr-ydl-backend
      tls: true
    # Metabase (BI sandbox, oldsrv). Own NATIVE login — no Forward-Auth and no OIDC anywhere on
    # this name (Metabase OSS has no SSO), and this edge carries no auth middleware at all, so the
    # router is the door and Metabase's own login is the only check behind it.
    metabase:
      rule: "Host(`metabase.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: metabase-backend
      tls: true
    # LAN log hub (Dozzle multi-host): llogs.kogler.si
    # served by the traefik-internal HOME edge (WAN-out survival — no VPS dependency).
    # Backend = the oldsrv Dozzle hub (:8081); it shows oldsrv + pi + spark containers
    # (remote agents on the Home VLAN). LAN-only — the split-horizon record resolves
    # this name to oldsrv_home_ip on the home instances only (never the VPS primary).
    llogs:
      rule: "Host(`llogs.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: llogs-backend
      tls: true
    # The LAN LiteLLM (oldsrv, dev-side AI spine — the simple-querier tier; decision #26
    # routes the coding harnesses direct to the engine and the dsh/pi-dev services are gone) with
    # spark/llm.kogler.si as its inference backend). LLitellm.kogler.si on the HOME edge so
    # LAN clients get it name-based + TLS (wildcard from the pulled pair), same as llogs.
    # Backend = the lan-litellm container published on oldsrv_home_ip:4000 (host-net edge
    # reach; the container's compose publish — identical to llogs → :8081).
    llitellm:
      rule: "Host(`llitellm.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: llitellm-backend
      tls: true
    # --- HA + DNS UI (VIP; this edge serves ha only while oldsrv owns the VIP) ---
    ha:
      rule: "Host(`ha.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: ha-backend
      tls: true
    # --- HA over the TAILNET — the away-from-home path, node-direct ---
{% if tailnet_oldsrv_ip is defined and tailnet_oldsrv_ip %}
    # The plain `ha.kogler.si` above stays LAN/VIP-only on purpose: MagicDNS answers
    # extra_records CLIENT-SIDE on Android/iOS, so repointing the plain name would also send
    # a tailnet-enabled phone *at home* through oldsrv instead of the VIP — a new oldsrv
    # dependency inside the failure domain smart-home-failover.md is about. A `.ts` twin has
    # no resolver to fight (docs/network-dns.md §Split-Horizon rule #1).
    # NO forward-auth here either — same reason as `ha`: Authentik would break the Companion
    # app's token/WebSocket flow (docs/smart-home.md).
    ha-ts:
      rule: "Host(`ha.{{ tailnet_base_domain }}`) || Host(`{{ tailnet_oldsrv_node_name }}.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      middlewares:
        - ha-ts-strip-forwarded
      service: ha-backend
      tls: true
    # The pi agent web UI (`pi-web` under `domen`) — tailnet-only BY CONSTRUCTION:
    # headscale publishes `pi-oldsrv.{{ tailnet_base_domain }}` AND its second name
    # `pi-dev.{{ tailnet_base_domain }}` (both in tailnet_ts_only_subdomains —
    # one seat, two names, one token; pi-oldsrv stays canonical),
    # this listener exists only on oldsrv's own tailnet address, and the seat binds loopback, so
    # the door set is {tailnet ACL, this router, the daemon's own PI_WEB_TOKEN}. NO
    # authentik-forward-auth: a phone-driven PWA cannot complete an
    # Authentik sub-request, and a token-gated cockpit does not need a second identity that it
    # cannot answer. No `web`-entrypoint redirect here on purpose — this edge declares no :80 on
    # the tailnet address, so a plain-HTTP client never reaches it at all.
    pi-oldsrv-ts:
      rule: "Host(`pi-oldsrv.{{ tailnet_base_domain }}`) || Host(`pi-dev.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: pi-oldsrv-backend
      tls: true
    # --- home-hosted *arr / media / downloaders / music trio over the TAILNET (the arr door) ---
    # Away-from-home path for the whole home set: node-direct on oldsrv's OWN tailnet address, the
    # same posture as ha-ts / pi-oldsrv-ts / cockpit-nas-ts — NO VPS hop, so it works during a
    # WAN-out at home and off-LAN. The `.ts` twins live in `tailnet_ts_only_subdomains` and publish
    # the `.ts` namespace ONLY (MagicDNS answers client-side; the plain home name must never be
    # re-pointed). NO forward-auth: the tailnet ACL is the gate and every app here owns
    # its login (a phone PWA cannot complete an Authentik sub-request).
    # Backends are the same `*_url` vars the LAN routers use — which is why a future flip
    # (loopback-only publishes) has to move these routes in the SAME converge, or this set 502s
    # exactly the way the LAN leg failed.
    media-ts:
      rule: "Host(`media.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: media-backend
      tls: true
    seerr-ts:
      rule: "Host(`seerr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: seerr-backend
      tls: true
    seerrng-ts:
      rule: "Host(`seerrng.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: seerrng-backend
      tls: true
    sonarr-ts:
      rule: "Host(`sonarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: sonarr-backend
      tls: true
    radarr-ts:
      rule: "Host(`radarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: radarr-backend
      tls: true
    lidarr-ts:
      rule: "Host(`lidarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: lidarr-backend
      tls: true
    prowlarr-ts:
      rule: "Host(`prowlarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: prowlarr-backend
      tls: true
    bazarr-ts:
      rule: "Host(`bazarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: bazarr-backend
      tls: true
    profilarr-ts:
      rule: "Host(`profilarr.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: profilarr-backend
      tls: true
    sab-ts:
      rule: "Host(`sab.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: sab-backend
      tls: true
    torrent-ts:
      rule: "Host(`torrent.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: torrent-backend
      tls: true
    aurral-ts:
      rule: "Host(`aurral.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: aurral-backend
      tls: true
    slskd-ts:
      rule: "Host(`slskd.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: slskd-backend
      tls: true
    lidarr-ydl-ts:
      rule: "Host(`lidarr-ydl.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: lidarr-ydl-backend
      tls: true
    metabase-ts:
      rule: "Host(`metabase.{{ tailnet_base_domain }}`)"
      entryPoints:
        - websecure-ts
      service: metabase-backend
      tls: true
{% endif %}
    dns-pi:
      rule: "Host(`dns-pi.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: dns-pi-backend
      tls: true
    # --- VPS-hosted set (via the wg-s2s traefik-tailnet edge) ---
    foto:
      rule: "Host(`foto.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: foto-backend
      tls: true
    file:
      rule: "Host(`file.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: file-backend
      tls: true
    git:
      rule: "Host(`git.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: git-backend
      tls: true
    ai:
      rule: "Host(`ai.kogler.si`)"
      entryPoints:
        - websecure
        - websecure-lan
      service: ai-backend
      tls: true
    http-redirect:
      rule: "HostRegexp(`.+`)"
      # Traefik v3 needs the PLAIN regex. The v2 template form
      # HostRegexp(`{host:.+}`) parses and reports the router as `enabled` while
      # matching NOTHING — verified in a clean v3.7.11 container (404 with
      # the template, 301 with this form), which is why http:// has 404-ed on every
      # edge for the whole life of this file while the config text read correctly.
      entryPoints:
        - web
        - web-lan
      middlewares:
        - redirect-to-https
      service: noop@internal

  services:
    # Jellyfin publishes on loopback only (see `jellyfin_url` in group_vars) — the
    # container itself is on the overlay networks, so an edge on the host has no path to it
    # until that publish exists. This line was 502 for exactly that reason.
    media-backend:
      loadBalancer:
        servers:
          - url: "{{ jellyfin_url }}"
    seerr-backend:
      loadBalancer:
        servers:
          - url: "{{ seerr_url }}"
    # seerrng is a SEPARATE container behind its OWN host port ({{ seerrng_host_port }});
    # it must never share seerr-backend (both listen :5055 inside — the silent-wrong-app bug
    # this row repaired).
    seerrng-backend:
      loadBalancer:
        servers:
          - url: "{{ seerrng_url }}"
    sonarr-backend:
      loadBalancer:
        servers:
          - url: "{{ sonarr_url }}"
    radarr-backend:
      loadBalancer:
        servers:
          - url: "{{ radarr_url }}"
    lidarr-backend:
      loadBalancer:
        servers:
          - url: "{{ lidarr_url }}"
    prowlarr-backend:
      loadBalancer:
        servers:
          - url: "{{ prowlarr_url }}"
    bazarr-backend:
      loadBalancer:
        servers:
          - url: "{{ bazarr_url }}"
    profilarr-backend:
      loadBalancer:
        servers:
          - url: "{{ profilarr_url }}"
    sab-backend:
      loadBalancer:
        servers:
          - url: "{{ sabnzbd_url }}"
    torrent-backend:
      loadBalancer:
        servers:
          - url: "{{ qbittorrent_url }}"
    aurral-backend:
      loadBalancer:
        servers:
          - url: "{{ aurral_url }}"
    slskd-backend:
      loadBalancer:
        servers:
          - url: "{{ slskd_url }}"
    lidarr-ydl-backend:
      loadBalancer:
        servers:
          - url: "{{ lidarr_ydl_url }}"
    metabase-backend:
      loadBalancer:
        servers:
          - url: "{{ metabase_url }}"
    llogs-backend:
      loadBalancer:
        servers:
          - url: "http://{{ oldsrv_home_ip }}:8081"
    llitellm-backend:
      loadBalancer:
        servers:
          - url: "{{ lan_litellm_url }}"
    ha-backend:
      loadBalancer:
        servers:
          - url: "http://{{ ha_vip }}:8123"
    # pi-web under `domen`, loopback-bound. This edge is `network_mode: host`, so it
    # reaches the host's own loopback — which is what lets the seat stay OFF the LAN entirely.
    # Port from the reservation var (`cockpit_pi_web_port`, group_vars/all/main.yml); before this
    # router existed that var was a reservation no template read.
    pi-oldsrv-backend:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ cockpit_pi_web_port }}"
    dns-pi-backend:
      loadBalancer:
        servers:
          - url: "http://{{ technitium_secondary_ip }}:5380"
    foto-backend:
      loadBalancer:
        servers:
          - url: "http://{{ wg_s2s_vps.ip }}:{{ wg_internal_edge_port }}"
    file-backend:
      loadBalancer:
        servers:
          - url: "http://{{ wg_s2s_vps.ip }}:{{ wg_internal_edge_port }}"
    git-backend:
      loadBalancer:
        servers:
          - url: "http://{{ wg_s2s_vps.ip }}:{{ wg_internal_edge_port }}"
    ai-backend:
      loadBalancer:
        servers:
          - url: "http://{{ wg_s2s_vps.ip }}:{{ wg_internal_edge_port }}"

tls:
  certificates:
    - certFile: "/etc/traefik/certs/{{ wildcard_cert_file }}"
      keyFile: "/etc/traefik/certs/{{ wildcard_cert_key_file }}"
    # The second issued wildcard, already carried by the cert-pull timer and (until
    # now) unused here. Serves the `*.<ts>` hosts on the tailnet listener; without it Traefik
    # answers that SNI with the default (wrong-name) cert. Guarded by the same condition as
    # the listener, and defaulted, so the standalone validator render (which whitelists its
    # own context and cannot see new group_vars keys) still parses this template.
{% if tailnet_oldsrv_ip is defined and tailnet_oldsrv_ip %}
    - certFile: "/etc/traefik/certs/{{ wildcard_ts_cert_file }}"
      keyFile: "/etc/traefik/certs/{{ wildcard_ts_cert_key_file }}"
{% endif %}
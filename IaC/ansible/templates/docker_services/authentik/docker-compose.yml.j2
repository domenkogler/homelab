# authentik docker-compose.yml — OIDC SSO provider (sso.kogler.si)
#   Server + Worker + PostgreSQL + Redis. Serves the Authentik web UI + API,
#   handles Forward Auth for Traefik, and provides OIDC for downstream services
#   (Matrix, Forgejo, Grafana, …).
#
#   Traefik routes sso.kogler.si -> authentik-server:9000 (HTTP).
#   NO Forward-Auth on Authentik itself (it IS the auth provider).
#   Forward-Auth middleware defined in traefik/dynamic/middlewares.yml.j2.
#
#   Secrets via community.general.onepassword lookups (field names per item type; vault=op_vault):
#     authentik_db       (Database: username=<postgres user>, password=<postgres password>)
#     authentik_password (Password: Django SECRET_KEY)
#     authentik_login    (Login: password=<bootstrap admin password>)

services:
  authentik-postgres:
    image: postgres:16-alpine
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: authentik-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: "{{ authentik_db_name | default('authentik') }}"
      POSTGRES_USER: "{{ vault['authentik_db'].username }}"
      POSTGRES_PASSWORD: "{{ vault['authentik_db'].password }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  authentik-redis:
    image: redis:7-alpine
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
    container_name: authentik-redis
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/redis:/data

  authentik-server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    ports:
      - "127.0.0.1:9000:9000"   # loopback-only API access for the host-side secret-egress glue (HD-143); never WAN
    container_name: authentik-server
    restart: unless-stopped
    # Explicit subcommand REQUIRED: the 2026.5.6 image entrypoint is `ak` with NO default
    # CMD — without this the container runs bare `ak`, prints the management-command
    # help listing and exits 0 in a restart loop (found live Phase 1, 2026-08-22:
    # authentik-server flapping since first deploy; worker works because it passes its
    # own command).
    command: server
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
      # Mounted as a SUBDIR: mounting /blueprints directly shadows the image's
      # /blueprints/{system,default,migrations,...} tree — the server's migrate
      # pre-start then dies on the missing /blueprints/system/bootstrap.yaml every
      # ~9 s (found live Phase 1, 2026-08-22: server "healthy" but 502 on every
      # route, core workers never binding). Discovery is recursive (system/ itself
      # is a subdir), so /blueprints/custom is picked up normally.
      - ./blueprints:/blueprints/custom
    environment:
      AUTHENTIK_SECRET_KEY: "{{ vault['authentik_password'].password }}"
      AUTHENTIK_TOKEN_LENGTH: "86"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ vault['authentik_db'].username }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ vault['authentik_db'].password }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ vault['authentik_login'].password }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: admin@kogler.si
      # Header trust pinned to the Traefik edge container IPs only (S15/HD-190, HD-81
      # precedent) — NEVER the whole traefik-public /16: a spoofed X-Forwarded-For from
      # a compromised sibling container would poison client-IP decisions (rate limits,
      # logs, future conditional-access rules).
      AUTHENTIK_TRUSTED_PROXIES: "{{ traefik_edge_ips | join(',') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.authentik.rule: "Host(`sso.kogler.si`)"
      traefik.http.routers.authentik.entrypoints: websecure
      {{ 'traefik.http.routers.authentik.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # NO authentik-forward-auth — this IS the auth provider. CrowdSec bouncer only
      # (S17a/HD-194): the public login page is the most brute-force-attractive route,
      # so it must not sit behind zero edge protection.
      # SAFE for outpost/OIDC callbacks (reasoned, HD-204/HD-194): the bouncer filters
      # by SOURCE IP only (path-agnostic), and every callback path — OIDC
      # `/application/o/<slug>/callback/`, forward-auth `/outpost.goauthentik.io/*` —
      # arrives as an ordinary browser request from a user IP that is not on the
      # blocklist. Outpost↔server API traffic runs container-direct on
      # services-internal and never traverses this edge router. Compensating brute-
      # force control stays layered: fail2ban http-auth jail (vps-hardening).
      traefik.http.routers.authentik.middlewares: crowdsec-only@file
      traefik.http.services.authentik.loadbalancer.server.port: "9000"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  authentik-worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    networks:
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
      # Blueprint file-discovery also runs worker-side — mirror the server's
      # /blueprints/custom mount so file-based blueprints are discovered+applied.
      - ./blueprints:/blueprints/custom
    environment:
      AUTHENTIK_SECRET_KEY: "{{ vault['authentik_password'].password }}"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ vault['authentik_db'].username }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ vault['authentik_db'].password }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  # ---- Authentik LDAP outpost (D7/HD-132) — Samba pulls auth from here ----
  # Provides Authentik-as-LDAP to Samba on the LAN (nas). This is a *client* served
  # outpost: Authentik stays the SSOT (no push). The outpost echoes the Authentik
  # directory tree (users/groups) over LDAP/LDAPS and validates binds.
  # REQUIRED at deploy (creation order): ensure the Authentik **LDAP provider**
  # (base DN `DC=home,DC=kogler,DC=si`, bind_mode DIRECT) + outpost instance exist —
  # either declared in the `ks-oidc.yml` Blueprint (HD-142) or created in the Authentik UI,
  # then put the generated outpost token in 1Password as `authentik-ldap_bind`
  # (field=password).
  # Reachability (HD-186, decided HD-204): NO public publish — the LDAP port binds
  # ONLY the WireGuard S2S address (prometheus/loki precedent), so Samba (nas, the
  # client) targets the VPS's WG-side address over the tunnel; the WAN path refuses.
  authentik-ldap:
    image: ghcr.io/goauthentik/ldap:{{ authentik_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: authentik-ldap
    restart: unless-stopped
    networks:
      - services-internal
    environment:
      AUTHENTIK_HOST: http://authentik-server:9000
      AUTHENTIK_INSECURE: "true"   # internal HTTP to authentik-server on services-internal only
      AUTHENTIK_TOKEN: "{{ vault['authentik-ldap_bind'].password }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    ports:
      - "{{ wg_s2s_vps.ip if (wg_s2s_vps.peer_public_key | default('') | length > 0) else '127.0.0.1' }}:3389:3389"   # LDAP (outpost binds providers' LDAP port); WG-only bind — Samba (nas) pulls over the S2S tunnel (HD-186); no WAN exposure
    depends_on:
      - authentik-server

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

# authentik docker-compose.yml — OIDC SSO provider (sso.kogler.si)
#   Server + Worker + PostgreSQL + Redis. Serves the Authentik web UI + API,
#   handles Forward Auth for Traefik, and provides OIDC for downstream services
#   (Matrix, Forgejo, Grafana, …).
#
#   Traefik routes sso.kogler.si -> authentik-server:9000 (HTTP).
#   NO Forward-Auth on Authentik itself (it IS the auth provider).
#   Forward-Auth middleware defined in traefik/dynamic/middlewares.yml.j2.
#
#   Secrets via community.general.onepassword lookups (field names per item type; vault=op_vault):
#     authentik_db       (Database: username=<postgres user>, password=<postgres password>)
#     authentik_password (Password: Django SECRET_KEY)
#     authentik_login    (Login: password=<bootstrap admin password>)

{# The Postgres bind target is deliberately version-INDEPENDENT: PGDATA is pinned in the env
#   block below, which is what lets one mount shape serve both major versions. #}
services:
  authentik-postgres:
    image: postgres:{{ authentik_db_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: authentik-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/postgres:/var/lib/postgresql/data
    environment:
      # ⚠ PG 18 initializes with ICU as the DEFAULT locale provider; every cluster here was
      #   initdb-ed with libc/en_US.utf8 (datcollate=en_US.utf8, provider = default/libc on all
      #   six). Left to the default, an 18 cluster would restore the same
      #   rows with different sort semantics and silently change ORDER BY / index ordering, so
      #   the provider is pinned HERE, in the template, before any pin moves. Harmless on 16
      #   (--locale-provider exists since 15) and ignored on a non-empty datadir, so landing it
      #   early costs nothing.
      POSTGRES_INITDB_ARGS: "--locale=en_US.utf8 --locale-provider=libc"
      # PG 18 images moved PGDATA to the version-specific /var/lib/postgresql/18/docker and their
#   entrypoint REFUSES to start when it finds a cluster anywhere else - and the parent-mount layout
#   it recommends does not work under this fleet's cap_drop: ALL, because the root phase then lacks
#   CAP_DAC_OVERRIDE and cannot write a uid-70 0700 directory ("mkdir: can't create
#   directory /var/lib/postgresql/18/: Permission denied"). Pinning PGDATA to the existing mount keeps
#   ONE mount shape across major versions, so a pin move cannot orphan the datadir.
      PGDATA: /var/lib/postgresql/data
      POSTGRES_DB: "{{ authentik_db_name | default('authentik') }}"
      POSTGRES_USER: "{{ vault['authentik_db'].username | replace('$','$$') }}"
      POSTGRES_PASSWORD: "{{ vault['authentik_db'].password | replace('$','$$') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  authentik-redis:
    image: redis:{{ authentik_redis_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
    container_name: authentik-redis
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/redis:/data

  authentik-server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    ports:
      - "127.0.0.1:9000:9000"   # loopback-only API access for the host-side secret-egress glue; never WAN
    container_name: authentik-server
    restart: unless-stopped
    # Explicit subcommand REQUIRED: the image entrypoint is `ak` with NO default
    # CMD — without this the container runs bare `ak`, prints the management-command
    # help listing and exits 0 in a restart loop (the worker works because it passes its
    # own command).
    command: server
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
      # Mounted as a SUBDIR: mounting /blueprints directly shadows the image's
      # /blueprints/{system,default,migrations,...} tree — the server's migrate
      # pre-start then dies on the missing /blueprints/system/bootstrap.yaml every
      # ~9 s (server "healthy" but 502 on every
      # route, core workers never binding). Discovery is recursive (system/ itself
      # is a subdir), so /blueprints/custom is picked up normally.
      - ./blueprints:/blueprints/custom
    environment:
      AUTHENTIK_SECRET_KEY: "{{ vault['authentik_password'].password | replace('$','$$') }}"
      AUTHENTIK_TOKEN_LENGTH: "86"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ vault['authentik_db'].username | replace('$','$$') }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ vault['authentik_db'].password | replace('$','$$') }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ vault['authentik_login'].password | replace('$','$$') }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: admin@kogler.si
      # Header trust pinned to the Traefik edge container IPs only — NEVER the whole traefik-public /16:
      # a spoofed X-Forwarded-For from
      # a compromised sibling container would poison client-IP decisions (rate limits,
      # logs, future conditional-access rules).
      AUTHENTIK_TRUSTED_PROXIES: "{{ traefik_edge_ips | join(',') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.authentik.rule: "Host(`sso.kogler.si`)"
      traefik.http.routers.authentik.entrypoints: websecure
      {{ 'traefik.http.routers.authentik.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      # NO authentik-forward-auth — this IS the auth provider. CrowdSec bouncer only —
      # the public login page is the most brute-force-attractive route, so it must not
      # sit behind zero edge protection.
      # SAFE for outpost/OIDC callbacks: the bouncer filters
      # by SOURCE IP only (path-agnostic), and every callback path — OIDC
      # `/application/o/<slug>/callback/`, forward-auth `/outpost.goauthentik.io/*` —
      # arrives as an ordinary browser request from a user IP that is not on the
      # blocklist. Outpost↔server API traffic runs container-direct on
      # services-internal and never traverses this edge router. Compensating brute-
      # force control stays layered: fail2ban http-auth jail (vps-hardening).
      traefik.http.routers.authentik.middlewares: crowdsec-only@file
      traefik.http.services.authentik.loadbalancer.server.port: "9000"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  authentik-worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql   # unix socket dir — read_only rootfs needs it as tmpfs
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    networks:
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
      # Blueprint file-discovery also runs worker-side — mirror the server's
      # /blueprints/custom mount so file-based blueprints are discovered+applied.
      - ./blueprints:/blueprints/custom
    environment:
      AUTHENTIK_SECRET_KEY: "{{ vault['authentik_password'].password | replace('$','$$') }}"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ vault['authentik_db'].username | replace('$','$$') }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ vault['authentik_db'].password | replace('$','$$') }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  # No `authentik-ldap` outpost belongs here.
  # It had exactly one consumer: Samba on nas pulling auth over the WG S2S tunnel. That passdb
  # is gone (docs/storage-rejected.md — and it could never have authenticated a Windows client,
  # because Authentik serves no `sambaNTPassword`, so there is no NT hash to answer NTLM with).
  # An outpost whose only consumer is gone shows up as `Up (unhealthy)` on an expired token with a
  # WG publish that refuses TCP. Nothing else in the fleet
  # consumes LDAP — Metabase LDAP auth is rejected, every other service rides OIDC.

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

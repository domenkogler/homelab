# authentik docker-compose.yml — OIDC SSO provider (sso.kogler.si)
#   Server + Worker + PostgreSQL + Redis. Serves the Authentik web UI + API,
#   handles Forward Auth for Traefik, and provides OIDC for downstream services
#   (Matrix, Forgejo, Grafana, …).
#
#   Traefik routes sso.kogler.si -> authentik-server:9000 (HTTP).
#   NO Forward-Auth on Authentik itself (it IS the auth provider).
#   Forward-Auth middleware defined in traefik/dynamic/middlewares.yml.j2.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     authentik_db       (Database: username=<postgres user>, password=<postgres password>)
#     authentik_password (Password: Django SECRET_KEY)
#     authentik_login    (Login: password=<bootstrap admin password>)

services:
  authentik-postgres:
    image: postgres:16-alpine
    container_name: authentik-postgres
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/postgres:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: "{{ authentik_db_name | default('authentik') }}"
      POSTGRES_USER: "{{ lookup('community.general.onepassword', 'authentik_db', field='username', vault=op_vault) }}"
      POSTGRES_PASSWORD: "{{ lookup('community.general.onepassword', 'authentik_db', field='password', vault=op_vault) }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 30s

  authentik-redis:
    image: redis:7-alpine
    container_name: authentik-redis
    restart: unless-stopped
    networks:
      - db-internal
    volumes:
      - /srv/docker/authentik/redis:/data

  authentik-server:
    image: ghcr.io/goauthentik/server:{{ authentik_version | default('latest') }}
    container_name: authentik-server
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
      - ./blueprints:/blueprints
    environment:
      AUTHENTIK_SECRET_KEY: "{{ lookup('community.general.onepassword', 'authentik_password', field='password', vault=op_vault) }}"
      AUTHENTIK_TOKEN_LENGTH: "86"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ lookup('community.general.onepassword', 'authentik_db', field='username', vault=op_vault) }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ lookup('community.general.onepassword', 'authentik_db', field='password', vault=op_vault) }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ lookup('community.general.onepassword', 'authentik_login', field='password', vault=op_vault) }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: admin@kogler.si
      AUTHENTIK_TRUSTED_PROXIES: "{{ (network_ranges | selectattr('name', 'equalto', 'traefik-public') | first).cidr | default('172.20.0.0/16') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.authentik.rule: "Host(`sso.kogler.si`)"
      traefik.http.routers.authentik.entrypoints: websecure
      traefik.http.routers.authentik.tls.certresolver: letsencrypt
      # NO authentik-forward-auth — this IS the auth provider
      traefik.http.services.authentik.loadbalancer.server.port: "9000"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  authentik-worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version | default('latest') }}
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    networks:
      - services-internal
      - db-internal
    volumes:
      - /srv/docker/authentik/media:/media
      - /srv/docker/authentik/certs:/certs
      - /srv/docker/authentik/templates:/templates
    environment:
      AUTHENTIK_SECRET_KEY: "{{ lookup('community.general.onepassword', 'authentik_password', field='password', vault=op_vault) }}"
      AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
      AUTHENTIK_POSTGRESQL__HOST: authentik-postgres
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_db_name | default('authentik') }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ lookup('community.general.onepassword', 'authentik_db', field='username', vault=op_vault) }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ lookup('community.general.onepassword', 'authentik_db', field='password', vault=op_vault) }}"
      AUTHENTIK_REDIS__HOST: authentik-redis
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    depends_on:
      authentik-postgres:
        condition: service_healthy
      authentik-redis:
        condition: service_started

  # ---- Authentik LDAP outpost (D7/HD-132) — Samba pulls auth from here ----
  # Provides Authentik-as-LDAP to Samba on the LAN (nas). This is a *client* served
  # outpost: Authentik stays the SSOT (no push). The outpost echoes the Authentik
  # directory tree (users/groups) over LDAP/LDAPS and validates binds.
  # REQUIRED at deploy (creation order): ensure the Authentik **LDAP provider**
  # (base DN `DC=home,DC=kogler,DC=si`, bind_mode DIRECT) + outpost instance exist —
  # either declared in the `ks-oidc.yml` Blueprint (HD-142) or created in the Authentik UI,
  # then put the generated outpost token in 1Password as `authentik-ldap_bind`
  # (field=password). The port below (3389) must be firewall-restricted to the NAS
  # host only (see network-ops / trusted sources) — LDAP creds must not be LAN-wide.
  authentik-ldap:
    image: ghcr.io/goauthentik/ldap:{{ authentik_version | default('latest') }}
    container_name: authentik-ldap
    restart: unless-stopped
    networks:
      - services-internal
    environment:
      AUTHENTIK_HOST: http://authentik-server:9000
      AUTHENTIK_INSECURE: "true"   # internal HTTP to authentik-server on services-internal only
      AUTHENTIK_TOKEN: "{{ lookup('community.general.onepassword', 'authentik-ldap_bind', field='password', vault=op_vault) }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    ports:
      - "3389:3389"   # LDAP (outpost binds providers' LDAP port); Samba on nas reaches oldsrv:3389. Restrict src at firewall.
    depends_on:
      - authentik-server

networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true
# spark-ai docker-compose.yml — Qwen3.8-Flash-Next inference on DGX Spark (GB10)
#   PROFILE-DRIVEN: what renders here is decided by ONE var,
#   `spark_llm_profile` (host_vars/spark.kogler.si.yml) → `spark_llm_profiles`
#   (group_vars/spark.yml). reasoning | graded | fast | fast-sglang.
#   Every engine value below comes from the active profile (directly or through the
#   flat `spark_vllm_*` pass-throughs) — a hardcoded number here is a defect.
#
#   Folded from the reference spark role template and hardened to repo docker_services
#   conventions (network isolation, security, vault).
#
#   Placement: spark.kogler.si — headless AI node. The engine :8000 is NOT
#   published on the LAN — LiteLLM (VPS/oldsrv LAN instance) fronts it (the router decision:
#   llm-d is a Kubernetes inference-pool stack, not a single-node
#   queue gateway; LiteLLM is the router in front). `spark_router_publish` flips a Home-VLAN
#   publish of :8000 for LAN clients once needed. The loopback-only publish
#   (`spark_metrics_publish`, 127.0.0.1:8000) is for the host Alloy → VPS VM vLLM scrape
#   — it never exposes the engine on the LAN.
#
#   ENGINE SWAP: the service name, host port, served model id and bearer key are the
#   CLIENT-FACING CONTRACT and must survive any profile. Only the image,
#   entrypoint, flag family and the mounts change. `profile.engine` selects them:
#     vllm   → --kv-cache-memory-bytes governor, --reasoning-parser, --speculative-config
#     sglang → --mem-fraction-static / --max-total-tokens pool semantics, NEXTN spec
#
#   Secrets: ONE — `spark-llm_api` (bearer on the OpenAI endpoint). vLLM is not
#   secret-free here: this
#   template renders exactly one vault value (item+field name only, never a value in git).
#
#   Storage: weights + PLE tables + KV + compile caches all on the XFS data partition
#   (roles/spark mounts /mnt/spark_nvme; spark_models_dir points there — never EXT4).
#
#   Digest pin: vllm/vllm-openai:qwen38-flash-next @
#   sha256:fc120ece0a388cc0aa1caad4a9f1cd92113484ab7ec2fd0efadd62585be05bf8
#   (multi-arch arm64+amd64; the arm64-cu130 manifest is the DGX Spark candidate).
#   SGLang has NO verified arm64 digest yet → spark_sglang_image is empty on purpose
#   and roles/spark-llm-profile refuses the profile before this file is ever rendered.
{% set profile = spark_llm_profiles[spark_llm_profile] %}
{#  The template indexes spark_llm_profiles DIRECTLY (native dict in both the real
    Ansible render and the offline validator mock) — a Jinja-valued alias such as
    `spark_llm: "{{ spark_llm_profiles[...] }}"` survives Ansible but arrives here as
    a stringified dict under scripts/gate/validate-docker-services.py. #}
{#  Path/flag composition. Every host path a profile can point at is resolved HERE,
    from plain scalar profile keys (image | models_root | ple_host_root | ple_host_base),
    because a Jinja expression written INSIDE spark_llm_profiles is stringified by the
    offline validator (the note above). A profile therefore names a COORDINATE and never a
    path. roles/spark-llm-profile validates every one of these names before this file runs,
    so an unknown name is a gate refusal with a remediation, not a rendered garbage path. #}
{% if profile.image == 'ultrafast' %}
{%   set engine_image = spark_vllm_ultrafast_image %}
{% elif profile.image == 'ultrafast-v32' %}
{#  The fp8-KV lineage: the same patch stack rebuilt on the v0.32 base. Its pin holds the built image
    ID, so what gates the arms that name it is `certified: false` + the uncertified override, and
    roles/spark-llm-profile still refuses them long before this line renders — it must NEVER fall
    through to the `else` below, which would render the BASE
    digest under an fp8 profile (EngineCore dies on the BF16-only QSA guard, restart loop). #}
{%   set engine_image = spark_vllm_ultrafast_v32_image %}
{% elif profile.image == 'sglang' %}
{%   set engine_image = spark_sglang_image %}
{% else %}
{%   set engine_image = spark_vllm_image %}
{% endif %}
{% set model_host_dir = (spark_models_dir_os if profile.models_root == 'os' else spark_models_dir) ~ '/' ~ profile.model_subdir %}
{% if profile.ple_host_root == 'os' %}
{%   set ple_host_dir = spark_models_dir_os %}
{% elif profile.ple_host_base == 'mount' %}
{%   set ple_host_dir = spark_xfs_mount %}
{% else %}
{%   set ple_host_dir = spark_models_dir %}
{% endif %}
{% set command_extra = [] %}
{% if profile.cudagraph_piecewise %}{%   set command_extra = command_extra + spark_llm_ultrafast_cudagraph_args %}{% endif %}
{% if profile.prompt_tokens_details %}{%   set command_extra = command_extra + spark_llm_ultrafast_diag_args %}{% endif %}
{# The pin VALUE is emitted with to_json, NOT wrapped in hand-written quotes. Two reasons, both
   measured: a hand-quoted value reaches argv WITH the quote characters inside it, so the engine
   matches `'<text>'` and the pin is an invisible no-op; and the real value is a multi-line block
   (the operator's pi global instructions), which only survives the `- {{ a }}` emission as a
   properly escaped scalar. scripts/bench/spark-llm-render-matrix.py proves the rendered argument is
   byte-equal to the declared text — the check that would have caught the quote version.
   STATUS: the mechanism is REJECTED (docs/services-ai-rejected.md), so every profile
   resolves never_evict_prompt to "" and this branch renders NOTHING. It stays because the flag is
   a one-line re-decide, and because a profile that set it on an image WITHOUT the patch would
   crash-loop the engine — roles/spark-llm-profile and
   check_spark_llm_gate.py refuse that shape via spark_llm_never_evict_capable_images. #}
{% if profile.never_evict_prompt %}{%   set command_extra = command_extra + ['--never-evict-kv-cache-prompt-includes', profile.never_evict_prompt | to_json, '--never-evict-kv-cache-max-fraction', profile.never_evict_max_fraction | to_json] %}{% endif %}
{#  SGLang-only composed flags. They live in their OWN list rather than in `command_extra`,
    because the engine branches emit differently: the vLLM branch iterates `command_extra`, the
    SGLang branch iterates `sglang_extra + profile.args_extra`. Appending engine-specific flags
    to `command_extra` is how they silently never reach argv — which is exactly what an earlier
    revision of this block did, and the render dump is what shows it. #}
{% set sglang_extra = [] %}
{% if profile.engine == 'sglang' and profile.get('mamba_state_slots') %}{%   set sglang_extra = sglang_extra + ['--max-mamba-cache-size', (profile.max_num_seqs | int) * (profile.mamba_state_slots | int)] %}{% endif %}
{#  DERIVED, never typed: the vendor pins this flag to requests × state-slots, and a hand-typed
    number silently caps concurrency below --max-running-requests (the scheduler admits only what
    the mamba pool holds and reports the effective count in the startup log). Slots per request come
    from the strategy: extra_buffer 5, extra_buffer_lazy 4, no_buffer 1 — declare the real one on
    the profile as `mamba_state_slots` beside max_num_seqs. #}
{% if profile.engine == 'sglang' and profile.get('cache_report', false) %}{%   set sglang_extra = sglang_extra + ['--enable-cache-report'] %}{% endif %}
{#  Without cache-report the prefix tree is invisible on the wire: `usage.prompt_tokens_details.cached_tokens`
    is filled only when the engine may report it, and the point of the radix × dtype grid is to COUNT
    cached prefix tokens per cell instead of inferring reuse from TTFT. EVERY cell carries it — a
    reporting arm beside a blind one is not a grid. ⚠ the flag NAME comes from the SGLang docs, not
    from a boot on this box (no SGLang image is pinned, so none has booted here): verify it with
    `… sglang.launch_server --help-all` in the same change that takes the digest. #}
{% if profile.engine == 'sglang' and not profile.get('radix_cache', true) %}{%   set sglang_extra = sglang_extra + ['--disable-radix-cache'] %}{% endif %}
{#  `radix_cache` is one of the grid's TWO dials (`sg-radix-*` = ON, `sg-no_radix-*` = OFF). It is
    rendered here rather than typed into an args_extra list so the cells cannot drift: all four alias
    the SAME arg list (*sg_radix_args in group_vars/spark.yml), and a grid whose legs differ by two
    things measures nothing. Read with .get() because this template renders under StrictUndefined,
    where `x | default(y)` raises on the ATTRIBUTE before the filter sees it. Absent = true =
    sglang's own default, so no existing profile changes behaviour. #}
{% if profile.engine == 'sglang' and profile.kv_cache_dtype == 'fp8' %}{%   set sglang_extra = sglang_extra + ['--kv-cache-dtype', 'fp8_e4m3'] %}{% endif %}
{#  The grid's second dial, spelled per engine: the profiles declare the LOGICAL dtype (`fp8`, the
    value the gate's bytes-per-token constant prices) and each engine gets its own token — vLLM
    `--kv-cache-dtype fp8`, SGLang `fp8_e4m3`. `auto` renders NOTHING here, which is how the bf16
    cells stay byte-identical to the shape `fast-sglang` already boots. Not emitted for the fp8
    counterpart `--quantization-param-path`: no calibrated scale file exists in any artifact set, so
    SGLang uses 1.0 and the fp8 cells are numerics claims (gates 8–9), which is stated on the
    profiles rather than hidden by a flag. #}
{% set command_extra = command_extra + profile.args_extra | default([]) %}
services:
  vllm-engine:
    # image comes from profile.image → the pins in group_vars/all/versions.yml.
    # Every name resolves through a pin in group_vars/all/versions.yml. An EMPTY pin (sglang) makes
    # the gate refuse the profile long before this line renders, and a served reference is always an
    # immutable ID or digest — never a mutable tag.
    image: "{{ engine_image }}"
    container_name: "{{ spark_vllm_container }}"
    cap_drop:
      - ALL
    cap_add:
      - SYS_PTRACE
      - IPC_LOCK
      - SYS_RESOURCE
    security_opt:
      - no-new-privileges:true

    read_only: true
    tmpfs:
      - /tmp
      - /var/run
    # NOTE: no numactl --membind wrapper — the hardened container (cap_drop:ALL +
    # no-new-privileges) blocks the membind syscall (get_mempolicy: Operation not
    # permitted -> crash-loop). Single-NUMA GB10 makes membind a
    # no-op anyway; vLLM binds tensor-parallel 1 to the one node implicitly.
    entrypoint: {{ spark_llm_engine_entrypoints[profile.engine] | to_json }}
    environment:
      - CUDA_VISIBLE_DEVICES=0
{% if profile.engine == 'vllm' %}
      - VLLM_LOGGING_LEVEL={{ spark_vllm_log_level }}
{% if profile.ple_container_dir | length > 0 %}
      # INT4 (reasoning/graded) or NVFP4 (fast) — whichever sidecar the profile names.
      # Order is load-bearing for render-parity: flipping profiles is the ONLY thing that
      # recreates the container, so a reordered profile re-creates it for no reason.
      # Do NOT set VLLM_PLE_DISK_OFFLOAD_DIR: that is the slow BF16 path
      # (spark/ansible/group_vars/spark_nodes.yml + the primitive-ai card).
      - VLLM_PLE_QUANT_DIR={{ profile.ple_container_dir }}
{% endif %}
{% if profile.ple_offload %}
      # The primitive-ai CPU-offload trio. Rendered ONLY for profiles that use that PLE
      # strategy: the upstream mmap path (ple_mmap: true, the ar-*/v16b arms) reads its table
      # off NVMe through the patched ple_layer.py, and rendering BOTH mechanisms at once is
      # how two PLE implementations fight over one mount. The gate additionally refuses a
      # profile that declares ple_mmap AND ple_overlay: they patch the same file.
      - VLLM_PLE_CPU_OFFLOAD={{ spark_vllm_cpu_offload }}
      - VLLM_PLE_OFFLOAD_READY_TIMEOUT={{ spark_vllm_ple_offload_ready_timeout }}
{% endif %}
{% if profile.ple_mmap %}
      # Upstream PLE-from-disk TABLE knobs (one SSOT list: spark_llm_ple_mmap_env). PREWARM=1
      # is why health_start_period is 2400s on these arms, not the certified lane's 1200s.
      # The KERNEL-DISPATCH knobs live in spark_llm_ple_dispatch_env and render only when
      # the profile opts in via `ple_dispatch: true` — they are the seven knobs that
      # confounded the funnel (A4), and an arm must be able to run the table WITHOUT them.
{%   for e in spark_llm_ple_mmap_env %}
      - {{ e }}
{%   endfor %}
{% endif %}
{% if profile.get('ple_dispatch') %}
      # The kernel-dispatch env set (QWEN38NEXT_* / VLLM_*_GEMM / VLLM_FP8_HYBRID…).
      # Rendered ONLY when the profile opts in.
{%   for e in spark_llm_ple_dispatch_env %}
      - {{ e }}
{%   endfor %}
{% endif %}
{% if profile.draft_vocab %}
      # Reduced MTP draft vocabulary (ids outside the slice score -inf at DRAFT time only;
      # the target still verifies every token, so output is not biased — only accepted
      # length moves). The bind target is fixed by the patch; the file is repo-owned and
      # sha256-pinned, and roles/spark-artifacts verifies the 65,536-line count.
      - VLLM_MTP_DRAFT_VOCAB={{ spark_draft_vocab_container }}
{% endif %}
{% endif %}
      - OMP_NUM_THREADS={{ spark_vllm_omp_num_threads }}
      - SAFETENSORS_FAST_GPU=1
      - PYTORCH_CUDA_ALLOC_CONF={{ spark_vllm_pytorch_cuda_alloc_conf }}
      - TORCHINDUCTOR_CACHE_DIR=/root/.cache/torchinductor
      - NCCL_NSOCKS_PERTHREAD=4
      - NCCL_SOCKET_NTHREADS=2
      # vLLM's usage-stats writer creates
      # ~/.config/usage_stats.json in the WORKER at startup; with the hardened
      # `read_only: true` root FS that write is OSError[Errno 30] and the worker
      # dies (only reached on the fp8 KV path's later init order — the bf16
      # `reasoning` lane never hit it). Disable vLLM's telemetry outright
      # (the standard opt-out trio; this build honors them per usage_lib.py).
      - VLLM_NO_USAGE_STATS=1
      - VLLM_DO_NOT_TRACK=1
      - DO_NOT_TRACK=1
{% for e in profile.env_extra | default([]) %}
      # profile-specific (profile {{ spark_llm_profile }} · env_extra)
      - {{ e }}
{% endfor %}
    volumes:
      # Model (read-only) — <profile models_root>/<profile model_subdir>. `os` = the root
      # partition, so the ~130 GB upstream checkpoint needs
      # no room carved out of XFS and NOTHING has to be deleted for it.
      - {{ model_host_dir }}:/model:ro
{% if profile.ple_overlay %}
      # PLE overlay patches (read-only) — on the XFS data partition. Mapping =
      # spark_llm_overlays (group_vars), the SAME list the profile gate stats.
{% for o in spark_llm_overlays %}
      - {{ spark_overlays_dir }}/{{ o.host }}:{{ o.container }}:ro
{% endfor %}
{% endif %}
{% if profile.ple_host_subdir | length > 0 %}
      # Quantized PLE tables (INT4/NVFP4 sidecar) or the FP8 mmap table (read-only).
      - {{ ple_host_dir }}/{{ profile.ple_host_subdir }}:{{ profile.ple_container_dir }}:ro
{% endif %}
{% if profile.draft_vocab %}
      - {{ spark_draft_vocab_host_file }}:{{ spark_draft_vocab_container }}:ro
{% endif %}
      # KV Cache (read-write, on XFS)
      - {{ spark_xfs_mount }}/kv_cache:/data/kv_cache
{% if profile.get('ple_offload_bind', '') | length > 0 %}
      # File-backed PLE offload store (READ-WRITE, XFS only). The `file` backend WRITES a sparse
      # ~47.7 GiB n-gram table here, so this bind cannot be :ro and must not fall back to the
      # container's own storage (that lands on `/`, EXT4, under the 12 GiB reserve the host-floor
      # gate exists to protect). Rendered only for profiles that declare ple_offload_bind.
      - {{ spark_xfs_mount }}/{{ profile.ple_offload_bind }}:/ple_offload
{% endif %}
      # Compile/quant caches (rootfs is read-only; persist across restarts).
      # vLLM writes BOTH /root/.cache/vllm (runtime cache) AND
      # /root/.cache/torchinductor (torchinductor compile cache) — mounting only
      # the `vllm` child left torchinductor pointing at the read-only rootfs →
      # OSError [Errno 30] Read-only file system crash-loop. Mount the
      # WHOLE /root/.cache from XFS; vllm_cache holds vllm/ + torchinductor/
      # subdirs once the engine writes them. (Shared with SGLang profiles: the
      # dirs are per-engine inside the cache root, and a cold compile cache after
      # an engine swap costs boot time, not correctness.)
      - {{ spark_xfs_mount }}/vllm_cache:/root/.cache
      - {{ spark_xfs_mount }}/triton_cache:/root/.triton
{% if spark_router_publish | default(false) %}
    ports:
      - "{{ spark_home_ip }}:8000:8000"
{% else %}
    # Loopback-only metrics publish: lets the spark host Alloy scrape
    # the engine's Prometheus /metrics (vllm:8000). Same pattern as traefik's
    # dedicated metrics entryPoint (127.0.0.1:8082) — the engine is
    # NOT reachable from the LAN, only the monitoring agent on the box.
    # `spark_router_publish: true` (LAN publish, post-bench) supersedes this.
{% if spark_metrics_publish | default(true) %}
    ports:
      - "127.0.0.1:{{ spark_engine_port }}:{{ spark_engine_port }}"
{% endif %}
{% endif %}
    ipc: host
    shm_size: "{{ spark_vllm_shm_size }}"
    ulimits:
      memlock: {{ spark_vllm_memlock }}
      stack: {{ spark_vllm_stack }}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
        limits:
          memory: {{ spark_vllm_memory_limit }}
    logging:
      driver: "{{ spark_logging_driver }}"
      options:
        max-size: "{{ spark_logging_max_size }}"
        max-file: "{{ spark_logging_max_file }}"
    healthcheck:
      # Engine-port indirection — curl the same port the spark edge's llm route fronts.
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ spark_engine_port }}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 8
      start_period: {{ profile.health_start_period }}   # first PLE-table load ~20 min (recipe)
    restart: unless-stopped
    networks:
      - llm-backend
{% if profile.engine == 'vllm' %}
    command:
      - --model
      - /model
      # Serve a clean model id (the staged weights' dir name is `/model`) so LiteLLM /
      # pi see `spark/qwen3.8-flash-next` in /v1/models instead of `/model`. Engine-swap-ready:
      # SGLang later serves the same id (spark_engine_port flips); keep the id stable across.
      - --served-model-name
      - {{ spark_vllm_served_name }}
      # Bearer auth on the OpenAI endpoint — vLLM --api-key, NOT a secret-free engine
      # anymore: llm.kogler.si is edge-exposed (TLS + a key both required).
      # `spark-llm_api` must not be used for three things at once: the engine accepts
      # BOTH the harness/direct key and the gateway's own `litellm-engine_api`, so rotating one no
      # longer invalidates the other. Multiple keys are ONE flag with N values — vLLM's arg is
      # nargs='+' (`--help` prints `[--api-key API_KEY [API_KEY ...]]`).
      # ⚠ ORDER IS LOAD-BEARING: roles/spark/files/spark-oom-watchdog.sh reads the token FOLLOWING
      # the first `--api-key` as its /metrics bearer, so the harness key (`spark-llm_api`) must stay FIRST.
      - --api-key
      - "{{ vault['spark-llm_api'].credential | replace('$','$$') }}"
      - "{{ vault['litellm-engine_api'].credential | replace('$','$$') }}"
      # compression: NEVER force --quantization. The staged checkpoints declare their
      # own packed format in config.json (AWQ build = compressed-tensors, primitive-ai
      # mixed NVFP4/FP8 = compressed-tensors too) — forcing a flag mismatches →
      # pydantic ValidationError at boot.
      - --trust-remote-code
      - --max-num-seqs
      - "{{ spark_vllm_max_num_seqs }}"
      - --max-model-len
      - "{{ spark_vllm_max_model_len }}"
      - --enable-chunked-prefill
      - --max-num-batched-tokens
      - "{{ spark_vllm_max_num_batched_tokens }}"
      - --enable-prefix-caching
      - --no-enable-flashinfer-autotune
      - --kv-cache-dtype
      - {{ spark_vllm_kv_cache_dtype }}
      # GPU×host unified-memory governance: explicit KV pool via
      # --kv-cache-memory-bytes (= bytes int) — the PRIMARY dial on GB10.
      # In this build, kv_cache_memory_bytes IGNORES gpu_memory_utilization entirely
      # (CacheConfig docstring + gpu_worker.determine_available_memory: "does not
      # respect the gpu_memory_utilization config"), so util is dead/removed — the
      # explicit pool IS the whole budget decision. The profile gate re-checks that
      # this pool holds max_model_len and stays under the certified ceiling.
      - --kv-cache-memory-bytes
      - "{{ spark_vllm_kv_cache_memory }}"
      - --distributed-executor-backend
      - {{ spark_vllm_distributed_executor_backend }}
{% if profile.enforce_eager %}
      - --enforce-eager
{% endif %}
      # CUDA-graph capture-size cap: the build defaults to capturing graphs
      # for batch sizes [1,2,4,8,16,24,32]; max_num_seqs caps the decode batch, so any
      # capture above it is unreachable AND strands memory in the single GB10 pool.
      # Measured basis + incident link: group_vars/spark.yml + docs/spark-incidents.md.
{% if (profile.max_cudagraph_capture_size | int) > 0 %}
      - --max-cudagraph-capture-size
      - "{{ profile.max_cudagraph_capture_size }}"
{% endif %}
      - --reasoning-parser
      - qwen3
      - --tool-call-parser
      - {{ profile.tool_call_parser }}
      - --enable-auto-tool-choice
{% if profile.generation_config_override | default('') | string | trim | length > 0 %}
      # Per-client temperature is the default: the override is only
      # rendered when a profile actually declares one. An EMPTY override crashes
      # argv-parse in this build ("Value '' cannot be converted"), so the flag is omitted
      # entirely when empty.
      - --override-generation-config
      - '{{ profile.generation_config_override }}'
{% endif %}
{% if profile.get('spec_config') %}
      # Merged speculative config (block rejection + probabilistic draft sampling,
      # as upstream publishes them). to_json keeps dict order deterministic, so the render
      # diff of an arm flip is exactly one line.
      - --speculative-config
      - '{{ profile.spec_config | to_json }}'
{% elif (profile.spec_tokens | int) > 0 %}
      - --speculative-config
      - '{"method": "{{ spark_vllm_spec_method }}", "num_speculative_tokens": {{ spark_vllm_spec_tokens }}}'
{% endif %}
{% for a in command_extra %}
      # profile-specific (profile {{ spark_llm_profile }} · composed flags + args_extra)
      - {{ a }}
{% endfor %}
{% else %}
    # SGLang flag family. Contract kept identical to vLLM's:
    # same --model path, same served id, same --api-key, same port, same parsers.
    # Pool semantics DIFFER: SGLang sizes its KV by --mem-fraction-static /
    # --max-total-tokens (both in args_extra), NOT by --kv-cache-memory-bytes.
    # ⚠ ONE REAL DIVERGENCE: SGLang's `api_key` is `Optional[str]`
    # (python/sglang/srt/server_args.py, "Set API key of the server") — ONE key, unlike vLLM's
    # nargs='+'. So this branch cannot hold both the harness key and the gateway's own credential,
    # and if a SGLang profile ever goes live the gateway key shape must be re-decided (edge
    # allow-list or a key-translation hop) BEFORE the LiteLLM containers are pointed at it.
    command:
      - --model-path
      - /model
      - --served-model-name
      - {{ spark_vllm_served_name }}
      - --api-key
      - "{{ vault['spark-llm_api'].credential | replace('$','$$') }}"
      - --host
      - 0.0.0.0
      - --port
      - "{{ spark_engine_port }}"
      - --trust-remote-code
      - --context-length
      - "{{ spark_vllm_max_model_len }}"
      - --max-running-requests
      - "{{ spark_vllm_max_num_seqs }}"
      - --chunked-prefill-size
      - "{{ spark_vllm_max_num_batched_tokens }}"
      - --reasoning-parser
      - qwen3
      - --tool-call-parser
      - {{ profile.tool_call_parser }}
{% for a in sglang_extra + profile.args_extra | default([]) %}
      # profile-specific (profile {{ spark_llm_profile }} · args_extra)
      - {{ a }}
{% endfor %}
{% endif %}



networks:
  llm-backend:
    external: true

# n8n docker-compose.yml — Workflow automation / alert router (auto.kogler.si)
#   Routes Grafana alerts to Signal (via signal-cli-rest-api) and email.
#   Also handles office automation workflows.
#   Renewal-reminder workflow: docs/automation-renewals.md (infra; create post-deploy).
#
#   INTERNAL-ONLY: n8n is reachable ONLY over the tailnet via the traefik-tailnet edge
#   (auto.kogler.si / auto.ts.kogler.si, headscale extra_records). The compose still binds
#   traefik-public (the tailnet edge reaches it by service name); the service owns NO public
#   route.
#
#   SQLite database (no external Postgres). Web UI protected by Authentik Forward-Auth.
#
#   Secrets (docs/deployment-secrets.md master list):
#   - n8n_password    (Password → field=password)  — N8N_ENCRYPTION_KEY (workflow encryption,
#                     long-lived, immutable; rotating = re-encrypt stored credentials).
#   - n8n-webhook_api (API/Password → field=credential) — webhook/API auth token, independently
#                     rotatable (short-lived) so an encryption key is never exposed in webhook
#                     auth.
#   Future: n8n-smtp_login (SMTP relay — provider not chosen yet).
services:
  n8n:
    image: n8nio/n8n:{{ n8n_version }}
    cap_drop:
      - ALL
    # read_only is intentionally absent: n8n writes runtime dirs under $HOME on the rootfs
    # (~/.cache for the task-runner compile), so tmpfs patches would need per-path modes.
    # It runs as node uid 1000, which owns those paths in the image.
    tmpfs:
      - /tmp
    container_name: n8n
    restart: unless-stopped
    ports:
      # Loopback-only publish of the metrics endpoint (:5678, N8N_METRICS) so the VPS host-APT
      # Alloy can scrape n8n /metrics. Loopback-only: n8n itself stays tailnet-only via
      # traefik-tailnet.
      - "127.0.0.1:5678:5678"
    networks:
      - traefik-public
      - services-internal
      - db-internal    # 2026-09-08: Prometheus scrapes n8n:5678/metrics here (N8N_METRICS)
                       # — same pattern as traefik joining db-internal for its metrics entryPoint.
    volumes:
      - /srv/docker/n8n/data:/home/node/.n8n
    environment:
      N8N_PORT: 5678
      N8N_PROTOCOL: https
      N8N_HOST: auto.kogler.si
      WEBHOOK_URL: https://auto.kogler.si
      N8N_ENCRYPTION_KEY: "{{ vault['n8n_password'].password | replace('$','$$') }}"
      # Webhook/API auth — a separate, rotatable token, not the encryption key.
      N8N_BASIC_AUTH_ACTIVE: "true"
      N8N_BASIC_AUTH_USER: grafana
      N8N_BASIC_AUTH_PASSWORD: "{{ vault['n8n-webhook_api'].credential | replace('$','$$') }}"
      N8N_METRICS: "true"
      DB_TYPE: sqlite
      # REQUIRED, and the default is wrong-way-round: isEnvAccessBlocked is
      # N8N_BLOCK_ENV_ACCESS_IN_NODE !== 'false', so unset means BLOCKED, every `$env.*`
      # throws "access to env vars denied", and a lenient onError still reports success. The
      # SIGNAL_* values are the SSOT->runtime handoff; a workflow can then read the whole
      # container env, bounded by n8n being admin-only over the tailnet (labels below).
      N8N_BLOCK_ENV_ACCESS_IN_NODE: "false"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # homelab-alerts workflow env — Signal delivery via signal-cli-rest-api on oldsrv
      # (Home-VLAN publish, WG-reachable from the VPS). Values are 1P-resolved at render; the
      # workflow JSON references these env names, not literals.
      # :8082, not :8080 — oldsrv_home_ip:8080 belongs to pi-dev, so the gateway publishes a
      # distinct port (see the signal-cli-rest-api compose).
      # The gateway takes the token ONLY as `Authorization: Bearer <token>` (X-Api-Key -> 401).
      # The workflow's header must stay in that shape, or every send fails with 401.
      SIGNAL_CLI_URL: "http://{{ oldsrv_home_ip }}:8082/v2/send"
      SIGNAL_API_TOKEN: "{{ vault['signal-internal_api'].credential | replace('$','$$') }}"
      SIGNAL_NUMBER: "{{ vault['signal_api'].username | replace('$','$$') }}"
      # NO default(): this value is required for delivery. A fallback that renders the group
      # NAME is not a recipient — signal-cli-rest-api rejects it and the workflow node swallows
      # the rejection (onError: continueRegularOutput), so delivery fails silently. An empty
      # env is at least visible in the render / `docker inspect`.
      SIGNAL_RECIPIENTS: '{{ signal_alert_recipients | replace('$','$$') }}'
    labels: {}   # INTERNAL-ONLY (HD-135b follow-up): no public Traefik route on the main
                  # edge — n8n is served over the tailnet by the traefik-tailnet edge
                  # (auto.kogler.si / auto.ts.kogler.si).
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

# n8n docker-compose.yml — Workflow automation / alert router (auto.kogler.si)
#   Routes Grafana alerts to Signal (via signal-cli-rest-api) and email.
#   Also handles office automation workflows.
#   Renewal-reminder workflow: docs/automation-renewals.md (infra; create post-deploy).
#
#   INTERNAL-ONLY (HD-135b follow-up): the public `auto.kogler.si` route (main
#   Traefik labels) is REMOVED — n8n is reachable ONLY over the tailnet via the
#   traefik-tailnet edge (auto.kogler.si / auto.ts.kogler.si, headscale extra_records).
#   The compose still binds traefik-public (the tailnet edge reaches it by service
#   name); the service itself owns NO public route.
#
#   SQLite database (no external Postgres). Web UI protected by Authentik Forward-Auth.
#
#   Secrets (docs/deployment-secrets.md master list):
#   - n8n_password    (Password → field=password)  — N8N_ENCRYPTION_KEY (workflow encryption,
#                     long-lived, immutable; rotating = re-encrypt stored credentials).
#   - n8n-webhook_api (API/Password → field=credential) — webhook/API auth token, independently
#                     rotatable (short-lived) so an encryption key is never exposed in webhook
#                     auth (KOPS-031 / HD-77).
#   Future: n8n-smtp_login (SMTP relay — provider not chosen yet).
services:
  n8n:
    image: n8nio/n8n:{{ n8n_version }}
    cap_drop:
      - ALL
    # read_only REMOVED (Wave-3 round-3 triage): n8n writes runtime dirs under $HOME on the
    # rootfs (~/.cache for the task-runner compile); tmpfs patches would need per-path modes.
    # Runs as node uid 1000 which owns those paths on the image.
    tmpfs:
      - /tmp
    container_name: n8n
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/n8n/data:/home/node/.n8n
    environment:
      N8N_PORT: 5678
      N8N_PROTOCOL: https
      N8N_HOST: auto.kogler.si
      WEBHOOK_URL: https://auto.kogler.si
      N8N_ENCRYPTION_KEY: "{{ vault['n8n_password'].password | replace('$','$$') }}"
      # Webhook/API auth — separate, rotatable token from the encryption key (KOPS-031 / HD-77).
      N8N_BASIC_AUTH_ACTIVE: "true"
      N8N_BASIC_AUTH_USER: grafana
      N8N_BASIC_AUTH_PASSWORD: "{{ vault['n8n-webhook_api'].credential | replace('$','$$') }}"
      N8N_METRICS: "true"
      DB_TYPE: sqlite
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels: {}   # INTERNAL-ONLY (HD-135b follow-up): no public Traefik route on the main
                  # edge — n8n is served over the tailnet by the traefik-tailnet edge
                  # (auto.kogler.si / auto.ts.kogler.si).
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

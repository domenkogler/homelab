# db-backup docker-compose.yml — Scheduled database dumps
#   Dumps all homelab Postgres databases to /backup. Configure one DBxx
#   block per database service (authentik, forgejo, immich, opencloud).
#   Each database container must be on a network this service can reach.
#
#   Scheduled via the tiredofit/db-backup cron runner (default: daily at 02:00).
#   Backups are stored to a named volume; the kopia-agent backs up that volume.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     <service>_db    (Database: username=<db user>, password=<db password>)
#                     for each database listed below
services:
  db-backup:
    image: tiredofit/db-backup:{{ db_backup_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_READ_SEARCH
      - FOWNER
      - SETUID
      - SETGID
    # read_only REMOVED (2026-08-23 triage, HD-218 Class-B, crowdsec precedent): this
    # image's s6 cont-init.d MUTATES ITS OWN ROOTFS at every boot — copies service run
    # scripts into /etc/services.available/dbbackup-0X/, writes /usr/bin/backupXX-now
    # wrappers, symlinks /etc/services.d/{03-monitoring,04-scheduling}, rewrites
    # /etc/{msmtprc,sudoers,doas.conf,logrotate.conf} + /root/.bashrc. Under read_only
    # ALL of that failed and /etc/services.d/ stayed EMPTY -> s6 supervised zero
    # services -> the cron scheduler never ran -> NO DUMP EVER EXECUTED (/backup was
    # verified empty while the container looked "Up"). tmpfs/bind cannot satisfy these
    # writes without hiding shipped image content. Hardening retained: cap_drop ALL,
    # no docker socket, internal networks only; writable layer is ephemeral.
    tmpfs:
      - /tmp
      - /var/log/container   # per-boot scratch, regenerated by 05-logging each start
      - /var/log/cron        # ditto, 04-scheduling
      - /assets/logrotate    # ditto, 00-startup mkdir
      - /assets/cron         # ditto, 04-scheduling/05-logging
      - /var/run/postgresql   # unix socket dir
    container_name: db-backup
    restart: unless-stopped
    networks:
      - services-internal
      - db-internal
    environment:
      # No Zabbix server exists anywhere in this stack (Prometheus/Grafana/Loki);
      # disabling skips the whole 03-monitoring init block (/etc/zabbix +
      # /var/lib/zabbix writes) and its dead service link. Honored by the image's
      # 00-container function (verified 2026-08-23).
      CONTAINER_ENABLE_MONITORING: "FALSE"
      # Retention
      COMPRESSION: ZSTD
      RETENTION: "7"
      # Default backup schedule (daily 02:00)
      DB01_TYPE: postgresql
      DB01_HOST: authentik-postgres
      DB01_PORT: "5432"
      DB01_USER: "{{ lookup('community.general.onepassword', 'authentik_db', field='username', vault=op_vault) }}"
      DB01_PASS: "{{ lookup('community.general.onepassword', 'authentik_db', field='password', vault=op_vault) }}"
      DB01_NAME: authentik

      DB02_TYPE: postgresql
      DB02_HOST: forgejo-db
      DB02_PORT: "5432"
      DB02_USER: "{{ lookup('community.general.onepassword', 'forgejo_db', field='username', vault=op_vault) }}"
      DB02_PASS: "{{ lookup('community.general.onepassword', 'forgejo_db', field='password', vault=op_vault) }}"
      DB02_NAME: forgejo

      # Immich Postgres — on db-internal (real service name is `immich-postgres`, not
      # the stale `immich-db` from older notes). KOPS-026 / HD-63.
      DB03_TYPE: postgresql
      DB03_HOST: immich-postgres
      DB03_PORT: "5432"
      DB03_USER: "{{ lookup('community.general.onepassword', 'immich_db', field='username', vault=op_vault) }}"
      DB03_PASS: "{{ lookup('community.general.onepassword', 'immich_db', field='password', vault=op_vault) }}"
      DB03_NAME: immich

      # PGVector (AI-stack RAG vector store, HD-102) — on db-internal; RAG index + chat
      # history = irretrievable metadata (KOPS-026 class) so it must be dumped too.
      DB04_TYPE: postgresql
      DB04_HOST: pgvector
      DB04_PORT: "5432"
      DB04_USER: "{{ lookup('community.general.onepassword', 'pgvector_db', field='username', vault=op_vault) }}"
      DB04_PASS: "{{ lookup('community.general.onepassword', 'pgvector_db', field='password', vault=op_vault) }}"
      DB04_NAME: pgvector

      # OpenCloud uses an EMBEDDED database (no external Postgres) — it is NOT a DBxx
      # block here. Its backup is a tar of the data dir (/srv/docker/opencloud/data,
      # mount `/var/lib/opencloud`), covered by the service-state/OpenCloud Kopia scope
      # rather than db-backup (KOPS-026 / HD-63, docs/backup.md).
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      # s6-overlay state dir: a tmpfs /run is mounted noexec by Docker (stage0 cannot exec
      # its extracted binaries -> exit 126), so it is a host bind instead (Wave-3 R2 triage).
      # Root-owned is fine: s6 stage0 runs as root and manages perms itself.
      - /srv/docker/db-backup/run:/run
      - db-backups:/backup

volumes:
  db-backups:

networks:
  services-internal:
    external: true
  db-internal:
    external: true
# doco-cd docker-compose.yml — GitOps continuous delivery (Doco-CD)
#   Watches the Forgejo repo and deploys compose on merge (webhook + polling).
#   Real schema/docs: https://doco.cd/latest/  (App / Deploy / Git Settings)
#   Host network (needs docker.sock), non-root distroless, cap_drop: [ALL].
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}
#   See docs/deployment.md + docs/deployment-compose.md.
#   ⚠️ NOT ACTIVATED (HD-02) — template is deployable; no scheduler/webhook trigger
#   is enabled on first run, and doco-cd's own 1Password secret provider
#   (SECRET_PROVIDER + external_secrets) wiring is deferred to activation.
services:
  doco-cd:
    image: ghcr.io/kimdre/doco-cd:latest    # Renovate tracks tags on 3-day hold
    container_name: doco-cd
    restart: unless-stopped
    network_mode: host                       # SSOT: CD needs docker.sock on host net
    cap_drop:
      - ALL
    environment:
      GIT_ACCESS_TOKEN: "{{ lookup('community.general.onepassword', 'forgejo_token', vault=op_vault) }}"
      WEBHOOK_SECRET: "{{ lookup('community.general.onepassword', 'doco_cd_webhook_secret', vault=op_vault) }}"
      GIT_SCM_PROVIDER: forgejo
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - doco-cd-data:/data
volumes:
  doco-cd-data:

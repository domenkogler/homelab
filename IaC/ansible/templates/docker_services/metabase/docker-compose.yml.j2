# metabase docker-compose.yml — BI sandbox on OLDSRV (docs/services-admin.md §Metabase).
#   Internal-only, home-hosted: ONE entry, `public: false`, in group_vars/home_servers.yml.
#   No data sources are wired here — an oldsrv sandbox starts empty; the VPS-local sources
#   (CrowdSec SQLite bind, Forgejo/Zipline read-only Postgres over db-internal) stay OFF this
#   box by design, so there is no `db-internal` join either.
#
#   AUTH = Metabase's OWN native login. Metabase OSS has no OIDC/SSO (paid Enterprise only) and
#   LDAP is rejected (docs/services-rejected.md), so there is NO Forward-Auth label, NO OIDC env
#   and no Authentik object for this service anywhere in the tree.
#
#   REACH = the home edge, not a docker-label edge: `traefik-internal` is `network_mode: host`
#   with a file provider only, so container labels are invisible to it. The published LOOPBACK
#   socket below is what its `metabase` / `metabase-ts` routers dial, through the `metabase_url`
#   SSOT var (group_vars/all/main.yml) — bind AND route move together. `traefik.enable: "false"`
#   keeps any docker-provider edge from minting a second, unauthenticated router for :3000.
#
#   SMTP (env-driven): MB_EMAIL_SMTP_* consumes the shared smtp2go SSOT vars
#   (`smtp2go_host`/`smtp2go_port`, group_vars/all/main.yml) + the SHARED `smtp_login` creds via
#   1Password lookup. Env-set settings override AND lock the Admin-UI fields → IaC stays the single
#   source of truth; changing mail config = converge, not clicks.
#   From address notify@kogler.si = the smtp2go account identity (verified sender); the var name
#   is MB_EMAIL_FROM_ADDRESS — `MB_FROM_ADDRESS` is not read, so Metabase would fall back to
#   notifications@metabase.com and smtp2go would reject the reset mail.
#
#   State: the H2 app DB on a named volume, so an upgrade or an experiment cannot lose it.
services:
  metabase:
    image: metabase/metabase:{{ metabase_version }}
    # The stock entrypoint (run_metabase.sh) creates a metabase user/group, chmods the jar and
    # su-drops privileges at every start — each step needs a writable rootfs and SETUID/SETGID,
    # so cap_drop ALL and read_only each independently break startup before Java launches.
    # Future hardening: pinned non-user + verified upstream support.
    tmpfs:
      - /tmp
    container_name: metabase
    restart: unless-stopped
    environment:
      MB_DB_FILE: /metabase.db/metabase.db
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # ---- SMTP: shared smtp2go relay SSOT; creds = shared smtp_login item ----
      MB_EMAIL_SMTP_HOST: "{{ smtp2go_host }}"
      MB_EMAIL_SMTP_PORT: "{{ smtp2go_port }}"
      MB_EMAIL_SMTP_SECURITY: starttls
      MB_EMAIL_SMTP_USERNAME: >-
        {{ vault['smtp_login'].username | replace('$','$$') }}
      MB_EMAIL_SMTP_PASSWORD: >-
        {{ vault['smtp_login'].password | replace('$','$$') }}
      MB_EMAIL_FROM_ADDRESS: notify@kogler.si
      # Canonical name from the registry entry's `subdomain`, so reset mail carries
      # https://metabase.kogler.si/… instead of the default localhost:3000. The wizard's other two
      # choices (anonymous tracking, HTTPS redirect) stay wizard choices per the owning doc —
      # env-setting them here would lock fields the owner still has to see.
      MB_SITE_URL: "https://{{ svc.subdomain | default(svc.name) }}.kogler.si"
    networks:
      - services-internal
      # No db-internal: this service has no database source, and an oldsrv converge must not
      # assume the VPS's db-internal overlay.
    ports:
      # Loopback publish (the `metabase_bind` ruling, group_vars/all/main.yml): the home edge is
      # on this box, so loopback is the reach it needs and the edge stays the only door.
      # Host port 3002, container port 3000 (Metabase's fixed listen).
      - "{{ metabase_bind }}:{{ metabase_host_port }}:3000"
    volumes:
      - metabase-data:/metabase.db
    labels:
{% if not (svc.public is defined and not svc.public) %}
      # The docker-provider form, for a host that runs one. Metabase's login is its OWN (OSS has no
      # OIDC/SSO), so the tier is the CrowdSec block-list and NEVER `authentik-forward-auth` — no
      # Authentik object exists for this service. The rule names the entry's `subdomain`, never a
      # literal host the registry does not declare.
      traefik.enable: "true"
      traefik.http.routers.metabase.rule: "Host(`{{ svc.subdomain | default(svc.name) }}.kogler.si`)"
      traefik.http.routers.metabase.entrypoints: websecure
      {{ 'traefik.http.routers.metabase.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      traefik.http.routers.metabase.middlewares: crowdsec-only@file
      traefik.http.services.metabase.loadbalancer.server.port: "3000"
{% else %}
      # INTERNAL-ONLY (`public: false`, what the registry declares): the home edge
      # (`traefik-internal`) owns the route — it is `network_mode: host` with a file provider, so it
      # dials the loopback publish above and no docker label is read here.
      traefik.enable: "false"
{% endif %}
volumes:
  metabase-data:
networks:
  services-internal:
    external: true

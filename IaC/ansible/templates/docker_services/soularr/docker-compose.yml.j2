# soularr docker-compose.yml — the poller bridge of the music ladder on oldsrv
#   Reads Lidarr's WANTED list, searches Soulseek through slskd, waits for the download, renames +
#   tags the folder and fires Lidarr's DownloadedAlbumsScan. It is the only component that makes
#   discover → request → download → import close itself; without it every Soulseek find is a manual
#   copy. A POLLER, not a web service: no port, no route, one loop per SCRIPT_INTERVAL.
#   https://github.com/mrusse/soularr · docs: services-media.md §Music Pillar
#
#   WHY A CONTAINER, NOT A HOST TIMER: soularr moves files between TWO paths that must resolve
#   identically inside it and inside Lidarr — the slskd completion folder it moves out of, and the
#   folder it hands Lidarr to scan. Those are the same two binds the arrs carry
#   (/mnt/nas/media/media, /mnt/nas/media/downloads) plus services-internal DNS for `lidarr:8686`
#   and the slskd API. A host timer would need both trees on the host and would sit outside the
#   registry that owns the media stack.
#
#   SECRETS are NOT in the compose: they go into the rendered `config/config.ini` (from
#   config/config.ini.j2 by the role's extra-template step, the 1P pre-pass supplying `lidarr_api` +
#   `soulseek-internal_api`). A missing vault item renders an empty key and that leg answers 401 forever,
#   which is why the items are registered under `_template_vault_items.soularr` rather than looked up ad hoc.
#   The render lands next to THIS compose file (that is where the role writes every extra), so it is
#   bind-mounted into the state dir explicitly below — a config rendered to a path the container never
#   mounts is a container running with no config, which for soularr is a startup error, not a silent no-op.
#
#   ARMED. slskd accepts `x-api-key` because the slskd compose now publishes the `soulseek-internal_api`
#   value as `SLSKD_API_KEY`; the same item is `[Slskd] api_key` here, so a rotation is one re-render of
#   both templates. slskd's UI password (`soulseek_api`) is NOT this value and never authenticates an
#   x-api-key call. Both halves move in the same converge: the slskd env change recreates that container
#   and drops the Soulseek session, so read `transfers 0/0 + queue 0` first.
#
#   VERSION PIN: {{ soularr_version }} — ghcr publishes semver (1.2.2 in tags/list), Renovate tracks it.
services:
  soularr:
    image: ghcr.io/mrusse/soularr:{{ soularr_version }}
    container_name: soularr
    hostname: soularr
    restart: unless-stopped
    networks:
      - services-internal
    # python:3.11 base: no s6, no PUID/PGID. Run as the media uid so everything soularr moves into
    # the downloads tree carries it, exactly like the arrs' own writes.
    user: "{{ storage_uid }}:{{ storage_gid }}"
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    volumes:
      # STATE lives on the pool, owned by the container's uid: soularr writes its search-page cursor
      # (.current_page.txt), its failed-import denylist (failed_imports.json) and .soularr.lock into
      # var_dir (/data), so this dir must be writable by storage_uid (bind_dirs pre-creates it 1005-owned).
      - /srv/docker/soularr/config:/data:rw
      # The Ansible-rendered config. The role writes extras NEXT TO THE COMPOSE FILE, so without this
      # second bind the container would start with no config.ini at all and exit on the
      # "Config file does not exist! Please mount /data…" branch. `:ro` because config.ini is Ansible-owned
      # and the WebUI (the only writer in the image) is switched off below — the litellm two-bind pattern.
      # Mounting a FILE inside a mountpoint that is itself a bind creates a 0-byte stub at
      # /srv/docker/soularr/config/config.ini, stacked OVER by this read-only bind. The stub is why dropping
      # this bind does NOT read as a missing file: soularr parses the empty stub and dies on
      # `KeyError: 'Slskd'`, which is a config problem wearing a traceback costume.
      - ./config/config.ini:/data/config.ini:ro
      - /mnt/nas/media/downloads:/downloads:rw     # the SAME bind slskd writes into and Lidarr imports from
    environment:
      TZ: {{ timezone | default('Europe/Ljubljana') }}
      # Poll cadence. Each cycle issues Soulseek searches against OTHER people's servers, so a tight
      # loop is traffic on peers for no gain — Lidarr's wanted list moves on the order of minutes.
      SCRIPT_INTERVAL: "300"
      # The WebUI is a config EDITOR on :8265 and config.ini is Ansible-owned: a live editor on a
      # rendered file is drift with a nice UI. Off, so the config moves in git or not at all.
      WEBUI_ENABLED: "false"
    healthcheck:
      # A poller has no endpoint, and the image ships no healthcheck, so the container cannot answer
      # "is the loop alive" — an exec-based probe on a python image just proves /bin/sh exists.
      # Declared disabled rather than omitted so the gap is a decision on record; the real acceptance
      # read is Lidarr's wanted list shrinking plus one folder appearing in the completion dir.
      disable: true

networks:
  services-internal:
    external: true

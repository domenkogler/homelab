# {{ ansible_managed }}
# soularr config.ini — rendered next to the compose file and bind-mounted at /data/config.ini (read-only);
# soularr's own state (the search-page cursor, the failed-import denylist, the lock file) is written into
# the /data directory bind. Edit the template in git; the WebUI is disabled in the compose precisely so
# nothing else writes here.
#
# FILE MODE IS 0600, OWNED BY THE UID THE CONTAINER RUNS AS (`extra_config_*` on the registry entry), and
# both API keys are PLAINTEXT in it. A 0644 render would leak them to every other uid on this host and a
# root-owned 0600 would be unreadable to a container that dropped its privileges — soularr reads its keys
# from this file and from nowhere else, so the file IS the secret surface and never gets printed (README §2).
# Unlike a compose file this is NOT fed to `docker compose`, so the `| replace('$','$$')` escaping rule does
# NOT apply. What DOES apply: soularr parses this with configparser's ExtendedInterpolation +
# os.path.expandvars, so a value containing `${` is read as a reference to another option and a value
# containing `$NAME` is expanded from the container's env — a secret with either shape must be moved to a
# different item, not escaped here. Both values today are alphanumeric.
#
# The two legs this bridges:
#   [Lidarr]  the wanted list + the DownloadedAlbumsScan that finishes the import.
#   [Slskd]   the search/enqueue/status API, authenticated by `x-api-key`. The value below is the minted
#             `soulseek-internal_api` item and it must be the SAME item the slskd compose renders into
#             `SLSKD_API_KEY`: slskd accepts an x-api-key only against a configured API key, and slskd's UI
#             password (`soulseek_api`, JWT via `POST /api/v0/session`) is NOT an API key — sending it here
#             answers 401. Reachability is by the SIDECAR's name (`gluetun-slskd:5030`), not `slskd:5030`.
#             A probe before any debug: `curl -H "x-api-key: …" http://gluetun-slskd:5030/api/v0/options`.
#
# PATHS ARE NOT FREEFORM. [Slskd] download_dir is the completion folder as SL SKD names it and as
# this container mounts it (/downloads/complete/music); [Lidarr] download_dir is the SAME directory as
# LIDARR names it. soularr renames the folder in place and hands Lidarr that second path, so any
# mismatch is a scan of a directory that exists but is always empty — a silent no-op, not an error.

[Lidarr]
api_key = {{ vault['lidarr_api'].credential }}
host_url = http://lidarr:8686
# Lidarr's own view of the NAS downloads tree (its /downloads bind), music category.
download_dir = /downloads/complete/music
# False = soularr fires the import itself. True would leave every completed album sitting in the
# completion folder for a human — the exact manual step this service exists to remove.
disable_sync = False

[Slskd]
api_key = {{ vault['soulseek-internal_api'].credential }}
# slskd shares the gluetun sidecar's network namespace, so its API is reachable under the SIDECAR's
# name, not its own: `slskd:5030` does not resolve, `gluetun-slskd:5030` answers 200.
host_url = http://gluetun-slskd:5030
url_base = /
download_dir = /downloads/complete/music
# Keep the search entries: they are the audit trail of what was asked of the network, and slskd's
# own history is the only place a stalled Soulseek transfer is visible.
delete_searches = False
stalled_timeout = 3600
# Measured, not guessed: while a peer is actually sending, slskd keeps reporting the transfer as QUEUED,
# so a short bound here deletes an album that is downloading fine. A first album was enqueued at 17:17:35
# and deleted at 17:22:39 — 304 s, the old 300 — while its FLACs were landing in slskd's incomplete tree at
# 17:18 and 17:22. Both patience knobs therefore meet at one hour: the queue can take an hour to move on
# Soulseek; after that the album is gone from the grab list and the next poll re-searches it.
remote_queue_timeout = 3600

[Release Settings]
# Lidarr's own release preference wins over soularr guessing which release the peers hold.
use_selected_lidarr_release = True
use_most_common_tracknum = True
allow_multi_disc = True
accepted_countries = Europe,Japan,United Kingdom,United States,[Worldwide],Australia,Canada
skip_region_check = False
accepted_formats = CD,Digital Media,Vinyl

[Search Settings]
search_timeout = 5000
maximum_peer_queue = 50
minimum_peer_upload_speed = 0
# 0.8 is upstream's default and it matters: a Soulseek result whose filenames do not match Lidarr's
# tracklist is a DIFFERENT release, and importing it writes wrong tags into the master copy.
minimum_filename_match_ratio = 0.8
minimum_search_interval = 5
# flac first, then the lossy fall-backs. The library's quality target is lossless, and the whole
# reason this leg exists is the rarest FLAC — accepting mp3 where a FLAC exists would quietly lower
# the master. Keep `flac 24/192,flac 16/44.1,flac` ahead of the mp3 entries.
allowed_filetypes = flac 24/192,flac 16/44.1,flac,mp3 320,mp3
ignored_users =
album_prepend_artist = False
# incrementing_page: every poll looks one page deeper instead of re-asking for page 1 forever, so a
# rare album is eventually found without anyone touching it.
search_type = incrementing_page
number_of_albums_to_grab = 10
title_blacklist =
search_blacklist =
search_source = missing
# Remember imports that failed and stop re-attempting them: without it one permanently unavailable
# album pins itself at the head of the wanted list and the poller never reaches anything behind it.
failed_import_denylist = True

[Download Settings]
download_filtering = True
use_extension_whitelist = True
# Audio plus the covers/logs the arr would otherwise re-fetch. Anything else a peer shares stays out.
extensions_whitelist = flac,mp3,m3u,cue,jpg,png,txt,nfo,lrc
rename_download_folders = True

[Logging]
level = INFO
format = [%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s
datefmt = %Y-%m-%dT%H:%M:%S%z
# stdout only: `docker logs soularr` is the read, and a rotated file inside /data would be a second
# log nobody collects.
log_to_file = False

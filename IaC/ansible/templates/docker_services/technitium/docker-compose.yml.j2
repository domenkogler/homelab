# technitium docker-compose.yml — Central DNS (PRIMARY on VPS, SECONDARY oldsrv, TERTIARY Pi)
#   Three instances on three separate physical hosts (HD-299, 2026-09-03):
#     - PRIMARY:   VPS  (instance: primary — svc.instance unset/absent renders primary)
#                  runs on the dedicated `dns-servers` overlay, pinned
#                  {{ tchnitium_dns_overlay_ip }} (container address inside the bridge);
#                  serves host :53/udp+tcp to LAN/tailnet clients, web UI at
#                  dns.kogler.si behind Authentik Forward-Auth on the VPS edge.
#                  CLIENT resolver address = VPS PUBLIC IP (dns_primary_ip, HD-299 A).
#     - SECONDARY: oldsrv (instance: secondary) — Home-VLAN node IP, no web-UI labels.
#     - TERTIARY:  Pi    (instance: secondary-pi) — Home-VLAN node IP, no web-UI labels;
#                  web UI at dns-pi.kogler.si via the Pi traefik-ha edge → local :5380
#                  (stays reachable when oldsrv is down).
#   All three serve per-subnet policy + internal *.kogler.si (incl. ha → VIP).
#   See docs/network-dns.md + docs/smart-home-failover.md.
#
#   Important: the DNS tier is a FAILURE-DOMAIN split (VPS vs oldsrv vs Pi) — do NOT
#   co-locate any two instances on one host; that defeats the purpose.
#
#   STATIC RECORDS (every instance): ha.kogler.si → {{ ha_vip }} and
#   dns-pi.kogler.si → {{ ha_vip }} MUST exist as A records on ALL instances.
#   DHCP auto-creation covers leases only, and the VIP is not a lease — without them
#   the traefik-ha / oldsrv edges are unreachable by name.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
{% set _inst = svc.instance | default('primary') %}
services:
  technitium:
    image: technitium/dns-server:{{ technitium_version }}
    cap_drop:
      - ALL
    cap_add:             # merged — NET_BIND_SERVICE (DNS 53) + NET_ADMIN (DHCP/interface control)
      - NET_BIND_SERVICE
      - NET_ADMIN
    # read_only REMOVED (Wave-2 triage parity, forgejo precedent 2026-08-22): Technitium
    # writes runtime state at boot to /etc/dns/{zones,blocklists} + /var/log/technitium —
    # a read-only rootfs crash-loops it (live 2026-09-03). cap_drop: ALL + minimal caps
    # + no host ports (only 53, DNS-standard) keep the hardening posture.
    read_only: false
    tmpfs:
      - /tmp
    # DURABILITY (HD-317 fix, 2026-09-03): Technitium persists ALL runtime state
    # (zones, auth/admin, records, settings) under /etc/dns — a tmpfs there wiped
    # them on every restart (the reason admin/zones kept vanishing). Bind it to a
    # persistent host dir instead: VPS /opt/technitium/dns (primary),
    # /opt/technitium-dns on Pi/oldsrv (secondary/tertiary). Still read-write;
    # Kopia already covers /opt/* (see Volume Strategy note below).
    container_name: "{% if _inst == 'primary' %}technitium{% elif _inst == 'secondary' %}technitium-oldsrv{% else %}technitium-pi{% endif %}"
    restart: unless-stopped
    networks:
{% if _inst == 'primary' %}
      # Primary pinned on the dns-servers overlay — container address is
      # tchnitium_dns_overlay_ip (VPS-local bridge). This is NOT the client-facing
      # resolver (dns_primary_ip = VPS public IP; the overlay pin only stabilizes the
      # address for the VPS Traefik edge + local containers, HD-240 precedent).
      dns-servers:
        ipv4_address: "{{ tchnitium_dns_overlay_ip }}"
{% if svc.subdomain is defined %}
      traefik-public: {}
{% endif %}
{% else %}
      traefik-public: {}
      services-internal: {}
{% endif %}
    ports:
      - "53:53/udp"                # required: clients query DNS on the standard port — network-wide by design (HD-62)
      - "53:53/tcp"
    # NO host 5380 — the web UI is served via Traefik on the overlay network (HD-62).
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      # /opt — DOCUMENTED exception to the /srv/docker/<svc> bind convention (HD-200/D10):
      # this template renders the VPS primary AND the oldsrv secondary AND the Pi tertiary,
      # and the Pi has no oldsrv-style /srv/docker dataset layout; Kopia covers /opt/* so
      # backup coverage is intact. See docs/deployment-compose.md §Volume Strategy.
      - /opt/technitium/config:/etc/technitium      # persistent DB + settings
      - /opt/technitium/dns:/etc/dns                # DURABLE: zones/auth/records (was tmpfs — HD-317)
{% if _inst == 'primary' %}
    labels:
      traefik.enable: "true"
      traefik.http.routers.dns.rule: "Host(`dns.kogler.si`)"
      traefik.http.routers.dns.entrypoints: websecure
      {{ 'traefik.http.routers.dns.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.dns.middlewares: authentik-forward-auth@file   # internal-only (public edge rejects it; tailnet via clean names)
{% endif %}

  # SECONDARY (oldsrv) / TERTIARY (Pi): the same template renders both home instances via
  # svc.instance — no Docker-label web UI (labels can't cross Docker hosts). oldsrv's UI
  # is not exposed (primary web UI lives on the VPS); Pi's is dns-pi.kogler.si via the
  # traefik-ha edge → local :5380, or directly at http://{{ dns_tertiary_ip }}:5380 (== technitium_secondary_ip).

networks:
{% if _inst == 'primary' %}
  dns-servers:
    external: true
{% if svc.subdomain is defined %}
  traefik-public:
    external: true
{% endif %}
{% else %}
  traefik-public:
    external: true
  services-internal:
    external: true
{% endif %}
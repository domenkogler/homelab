# technitium docker-compose.yml — Central DNS (PRIMARY on oldsrv, SECONDARY on the Pi)
#   Two instances on separate physical hosts for DNS redundancy:
#     - PRIMARY: oldsrv (runs with this template + permissions)
#     - SECONDARY: pi.kogler.si (Pi — same image, instance: secondary; moved from nas)
#   Both serve per-subnet policy and internal *.kogler.si (incl. ha → VIP).
#   See docs/network-dns.md + docs/smart-home-failover.md.
#
#   Important: DNS primary + secondary are a FAILURE-DOMAIN split (oldsrv vs Pi).
#   Do NOT run both on the same host — that defeats the purpose.
#
#   STATIC RECORDS (both instances): ha.kogler.si → {{ ha_vip }} and
#   dns-pi.kogler.si → {{ ha_vip }} MUST exist as A records on BOTH
#   primary + secondary. DHCP auto-creation covers leases only, and the VIP is not a lease —
#   without them the traefik-ha / oldsrv edges are unreachable by name.
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault='Homelab') }}

services:
  technitium:
    image: technitium/dns-server:latest
    container_name: technitium
    restart: unless-stopped
    cap_add:
      - NET_ADMIN          # needed for the built-in DHCP / interface control
    networks:
      - services-internal
      - host               # Technitium needs to bind 53 on the management/host interface
    ports:
      - "53:53/udp"
      - "53:53/tcp"
      - "5380:5380"        # web UI: dns.kogler.si (internal only)
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /opt/technitium/config:/etc/technitium      # persistent DB + settings
    labels:
      traefik.enable: "true"
      traefik.http.routers.dns.rule: "Host(`dns.kogler.si`)"
      traefik.http.routers.dns.entrypoints: websecure
      traefik.http.routers.dns.tls.certresolver: letsencrypt
      traefik.http.routers.dns.middlewares: authentik-forward-auth@file   # internal-only

  # SECONDARY instance (Pi/pi.kogler.si): deploy via the same template with instance name
  # technitium-secondary, a different primary/secondary mode, and no Traefik labels
  # (labels can't cross Docker hosts). Its web UI is reachable at dns-pi.kogler.si
  # (resolves to the VIP, served by the Pi's traefik-ha edge → local :5380, so it stays
  # reachable when oldsrv is down — docs/smart-home-failover.md) or directly at
  # http://10.10.1.20:5380.

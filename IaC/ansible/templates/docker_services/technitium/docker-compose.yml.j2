# technitium docker-compose.yml — Central DNS (PRIMARY on VPS, SECONDARY oldsrv, TERTIARY Pi)
#   Three instances on three separate physical hosts:
#     - PRIMARY:   VPS (instance: primary — svc.instance unset/absent renders primary), pinned
#                  to {{ tchnitium_dns_overlay_ip }} on the dedicated `dns-servers` overlay;
#                  serves host :53/udp+tcp, web UI at dns.kogler.si behind Authentik
#                  Forward-Auth on the VPS edge. Client resolver address = dns_primary_ip.
#     - SECONDARY: oldsrv (instance: secondary) — Home-VLAN node IP, no web-UI labels.
#     - TERTIARY:  Pi (instance: secondary-pi) — Home-VLAN node IP; web UI at dns-pi.kogler.si
#                  via the Pi traefik-ha edge -> local :5380, so it stays reachable oldsrv-down.
#   All three serve per-subnet policy + internal *.kogler.si (incl. ha -> VIP).
#   See docs/network-dns.md + docs/smart-home-failover.md.
#
#   Important: the DNS tier is a FAILURE-DOMAIN split (VPS vs oldsrv vs Pi) — do NOT
#   co-locate any two instances on one host; that defeats the purpose.
#
#   STATIC RECORDS (every instance): ha.kogler.si → {{ ha_vip }} and
#   dns-pi.kogler.si → {{ ha_vip }} MUST exist as A records on ALL instances.
#   DHCP auto-creation covers leases only, and the VIP is not a lease — without them
#   the traefik-ha / oldsrv edges are unreachable by name.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
{% set _inst = svc.instance | default('primary') %}
services:
  technitium:
    image: technitium/dns-server:{{ technitium_version }}
    cap_drop:
      - ALL
    cap_add:             # merged — NET_BIND_SERVICE (DNS 53) + NET_ADMIN (DHCP/interface control)
      - NET_BIND_SERVICE
      - NET_ADMIN
    # read_only is intentionally absent: Technitium writes runtime state at boot to
    # /etc/dns/{zones,blocklists} and /var/log/technitium, so a read-only rootfs crash-loops it.
    # cap_drop: ALL + minimal caps + no host ports (only 53, DNS-standard) keep the posture.
    read_only: false
    tmpfs:
      - /tmp
    # DURABILITY: Technitium persists ALL runtime state (zones, auth/admin, records, settings)
    # under /etc/dns — a tmpfs there wipes it on every restart. Bind it to a persistent host dir:
    # VPS /opt/technitium/dns (primary), /opt/technitium-dns on Pi/oldsrv. Still read-write;
    # Kopia covers /opt/* (see the Volume Strategy note below).
    container_name: "{% if _inst == 'primary' %}technitium{% elif _inst == 'secondary' %}technitium-oldsrv{% else %}technitium-pi{% endif %}"
    restart: unless-stopped
    networks:
{% if _inst == 'primary' %}
      # Primary pinned on the dns-servers overlay — the container address is
      # tchnitium_dns_overlay_ip (VPS-local bridge). This is NOT the client-facing resolver:
      # dns_primary_ip is the VPS public IP; the pin only stabilizes the address for the VPS
      # Traefik edge and local containers.
      dns-servers:
        ipv4_address: "{{ tchnitium_dns_overlay_ip }}"
{% if svc.subdomain is defined %}
      traefik-public: {}
{% endif %}
{% else %}
      traefik-public: {}
      services-internal: {}
{% endif %}
    ports:
      - "53:53/udp"                # required: clients query DNS on the standard port - network-wide by design
      - "53:53/tcp"
{% if _inst != 'primary' %}
      # TERTIARY (Pi) web UI: host :5380 — the Pi traefik-ha edge (network_mode: host) routes
      # dns-pi.kogler.si -> http://{{ technitium_secondary_ip }}:5380, so without this publish
      # that route 502s. Oldsrv (secondary) UI is NOT exposed: the primary web UI is on the VPS.
      - "5380:5380/tcp"
{% endif %}
    # PRIMARY (VPS): NO host 5380 — the web UI is served via the VPS Traefik overlay, so the
    # container's internal 5380 is overlay-reachable only.
    # SECONDARY (oldsrv): no UI exposure (no route publishes it).
    # TERTIARY (Pi): host 5380 published above for the traefik-ha dns-pi route.
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      # /opt is a DOCUMENTED exception to the /srv/docker/<svc> bind convention: this template
      # renders the VPS primary, the oldsrv secondary and the Pi tertiary, and the Pi has no
      # /srv/docker dataset layout. Kopia covers /opt/*, so backup coverage is intact — see
      # docs/deployment-compose.md §Volume Strategy.
      - /opt/technitium/config:/etc/technitium      # persistent DB + settings
      - /opt/technitium/dns:/etc/dns                # DURABLE: zones/auth/records live here, so it must not be tmpfs
{% if _inst == 'primary' %}
    labels:
      traefik.enable: "true"
      traefik.http.routers.dns.rule: "Host(`dns.kogler.si`)"
      traefik.http.routers.dns.entrypoints: websecure
      {{ 'traefik.http.routers.dns.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      traefik.http.routers.dns.middlewares: authentik-forward-auth@file   # internal-only (public edge rejects it; tailnet via clean names)
      # Pin the web-UI backend port: the container exposes both 53/tcp and 5380/tcp and Traefik
      # auto-picks the LOWEST exposed numeric port (53 = DNS), which proxies HTTP to it and 502s
      # the authenticated leg. Every overlay-served service pins loadbalancer.server.port.
      traefik.http.services.dns.loadbalancer.server.port: "5380"
{% endif %}

  # SECONDARY (oldsrv) / TERTIARY (Pi): the same template renders both home instances via
  # svc.instance — no Docker-label web UI (labels can't cross Docker hosts). oldsrv's UI
  # is not exposed (primary web UI lives on the VPS); Pi's is dns-pi.kogler.si via the
  # traefik-ha edge → local :5380, or directly at http://{{ dns_tertiary_ip }}:5380 (== technitium_secondary_ip).

networks:
{% if _inst == 'primary' %}
  dns-servers:
    external: true
{% if svc.subdomain is defined %}
  traefik-public:
    external: true
{% endif %}
{% else %}
  traefik-public:
    external: true
  services-internal:
    external: true
{% endif %}
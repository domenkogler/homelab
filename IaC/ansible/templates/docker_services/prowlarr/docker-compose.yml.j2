# prowlarr docker-compose.yml — Indexer registry (prowlarr.kogler.si)
#   Syncs indexers to Sonarr/Radarr/Lidarr. Forward-Auth.
#   linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}
#   — none needed
services:
  prowlarr:
    image: linuxserver/prowlarr:latest
    container_name: prowlarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/prowlarr/config:/config
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.prowlarr.rule: "Host(`prowlarr.kogler.si`)"
      traefik.http.routers.prowlarr.entrypoints: websecure
      traefik.http.routers.prowlarr.tls.certresolver: letsencrypt
      traefik.http.routers.prowlarr.middlewares: authentik-forward-auth@file
      traefik.http.services.prowlarr.loadbalancer.server.port: "9696"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
# open-webui docker-compose.yml — Family chat + RAG UI (ai.kogler.si)
#   The flagship AI-stack UI (docs/services-ai.md, HD-101). Public via the `ai` route:
#   Authentik OIDC (per-user chat/history) + crowdsec-only at the Traefik edge.
#
#   Model backend = LiteLLM (spine, HD-100) over services-internal. RAG reaches:
#     PGVector (db-internal)  — vector store (HD-102)
#     Docling (services-internal) — OCR ingestion (HD-103)
#   So this service joins traefik-public + services-internal + db-internal.
#
#   Secrets (fail-closed, HD-65):
#     openwebui_secret (password -> password)  — WEBUI_SECRET_KEY (session/encryption)
#     owui-public-chat_api (api -> credential) — backend auth to LiteLLM (HD-247 scoped
#     virtual key, minted by the bootstrap-keys glue; chat/completion models only,
#     budget-capped. RAG embedding/rerank envs land with HD-246 using owui-public-rag_api)
#     openwebui_api (api -> username/credential) — Authentik OIDC client_id/secret; seeded by the
#     secret-egress glue (HD-143) from the Blueprint-declared provider (ks-oidc.yml, HD-142)
#   Image: openwebui/open-webui pinned via openwebui_version (HD-61/KOPS-053 convention).
services:
  open-webui:
    image: openwebui/open-webui:{{ openwebui_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: open-webui
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal        # LiteLLM (models) + Docling (OCR)
      - db-internal              # PGVector (RAG vector store)
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      WEBUI_SECRET_KEY: "{{ lookup('community.general.onepassword', 'openwebui_secret', field='password', vault=op_vault) }}"
      # Model backend = LiteLLM (the spine, HD-100). LiteLLM = OpenAI-compatible at :4000/v1.
      # HD-247: scoped VIRTUAL key (chat scope, capped) — never the master key.
      OPENAI_API_BASE_URL: "http://litellm:4000/v1"
      OPENAI_API_KEY: "{{ lookup('community.general.onepassword', 'owui-public-chat_api', field='credential', vault=op_vault) }}"
      # Default model shown in the UI (a LiteLLM-exposed model from config.yaml)
      DEFAULT_MODELS: "ollama/qwen2.5,openrouter/gpt-4o-mini"
      # Authentik OIDC (per-user login). Env names VERIFIED against open-webui 0.11.0
      # backend config.py (HD-101 live-verify root cause, 2026-08-25: the previous
      # ENABLE_OIDC/OIDC_* names are NOT read by the app — the SSO button never rendered).
      # The provider registers only when OPENID_PROVIDER_URL + client id/secret are set.
      OAUTH_CLIENT_ID: "{{ lookup('community.general.onepassword', 'openwebui_api', field='username', vault=op_vault) }}"
      OAUTH_CLIENT_SECRET: "{{ lookup('community.general.onepassword', 'openwebui_api', field='credential', vault=op_vault) }}"
      OPENID_PROVIDER_URL: "https://sso.kogler.si/application/o/openwebui/.well-known/openid-configuration"
      OPENID_REDIRECT_URI: "https://ai.kogler.si/oauth2/callback"   # must match ks-oidc.yml redirect_uris
      OAUTH_PROVIDER_NAME: "Authentik"       # SSO button label on the login page
      OAUTH_SCOPES: "openid email profile"   # upstream default; explicit for clarity
      # Family self-service per the identity model (services-ai.md §6): an Authentik
      # identity without a local account creates one (DEFAULT_USER_ROLE=pending default
      # -> admin approves). Local form stays visible for the break-glass admin account;
      # PUBLIC local sign-up is closed (upstream default was open).
      ENABLE_OAUTH_SIGNUP: "true"
      OAUTH_MERGE_ACCOUNTS_BY_EMAIL: "true"  # links an existing local account to its SSO identity (same email)
      ENABLE_SIGNUP: "false"
      # RAG store (PGVector on db-internal) — connector configured in UI/settings at deploy;
      # Docling (services-internal) used as the OCR pipeline.
    volumes:
      - /srv/docker/open-webui:/app/backend/data   # users, chat history, settings (stateful; include in Kopia scope)
    labels:
      traefik.enable: "true"
      traefik.http.routers.open-webui.rule: "Host(`ai.kogler.si`)"
      traefik.http.routers.open-webui.entrypoints: websecure
      {{ 'traefik.http.routers.open-webui.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.open-webui.middlewares: crowdsec-only@file   # + Authentik OIDC (app-level; native OIDC, no Forward-Auth per HD-101)
      traefik.http.services.open-webui.loadbalancer.server.port: "8080"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
  db-internal:
    external: true

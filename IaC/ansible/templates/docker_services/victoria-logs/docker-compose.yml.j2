# victoria-logs docker-compose.yml — VictoriaLogs single-node log store (90d, db-internal)
#   Log store behind the host Alloy agents (roles/monitoring templates/alloy.river.j2), which
#   push to the Loki-compatible ingest endpoint POST /insert/loki/api/v1/push. Grafana queries
#   VL over db-internal (VictoriaLogs datasource, uid `loki`).
#   Retention 90d. The volume is Kopia-backed (docs/backup.md).
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#     victoria-logs_api — Basic Auth (plaintext -httpAuth.username/-httpAuth.password) for the
#       ingest + query endpoints. Consumed by Alloy (push) and Grafana (query). Fail-loud, no
#       default().
#   See docs/observability.md.
#   See docs/observability.md.
services:
  victoria-logs:
    image: victoriametrics/victoria-logs:{{ victoria_logs_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: victoria-logs
    restart: unless-stopped
    command:
      - "-retentionPeriod={{ victoria_logs_retention_days }}d"
      - "-httpAuth.username={{ vault['victoria-logs_api'].username | replace('$','$$') }}"
      - "-httpAuth.password={{ vault['victoria-logs_api'].password | replace('$','$$') }}"
      - "-storageDataPath=/victoria-logs-data"
    networks:
      - db-internal
    ports:
      # A non-secret `default('')` (CONVENTIONS §3): the WG peer-key gate — the loopback
      # fallback is structural wiring, not a 1Password secret. The victoria-logs_api lookup
      # above carries no default (fail-loud).
      # WG bind: oldsrv Alloy log push + future MCP reach VL over wg-s2s.
      - "{{ wg_s2s_vps.ip if (wg_s2s_vps.peer_public_key | default('') | length > 0) else '127.0.0.1' }}:9428:9428"
      # Loopback bind: the VPS host-APT Alloy self-scrape + any localhost consumer.
      - "127.0.0.1:9428:9428"
    volumes:
    # Host bind-mount (stateful = bind-mount convention): VL data, Kopia-backed. Retention is
    # backed up, so it lives on a host bind under /srv/docker for the VPS kopia client to
    # snapshot — not in a named volume (docs/backup.md).
      - /srv/docker/victoria-logs/data:/victoria-logs-data
    # NO container healthcheck: the victoriametrics/victoria-logs image is tool-less (ships
    # ONLY /victoria-logs-prod — no sh/wget/curl/nc), so a CMD healthcheck fails to exec and
    # Docker flags the container `unhealthy` while it serves fine. Liveness is covered by the
    # Grafana VictoriaLogs datasource health-check in the monitoring role and by the
    # `up{job="victoria-logs"}` alert rule (Alloy self-scrape of /metrics).
networks:
  db-internal:
    external: true

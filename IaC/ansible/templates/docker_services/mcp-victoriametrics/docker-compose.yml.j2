# mcp-victoriametrics docker-compose.yml — VictoriaMetrics MCP AI-debugging server (HD-344)
#   MCP server (ghcr.io/victoriametrics-community/mcp-victoriametrics) giving AI tools
#   (pi, Open WebUI, OpenClaw) read-only query access to the VPS VictoriaMetrics backend.
#   Runs on OLDSRV (≈600–700 MB RAM — the VPS/Pi don't host it, HD-341 decision).
#   Connects to the VictoriaMetrics backend over wg-s2s (`victoria_backend_host`,
#   wg-s2s-now/tailnet-later — see group_vars/all/main.yml HD-344 block). Logs + metrics
#   STAY on the VPS; oldsrv only fronts queries.
#
#   Exposure: NOT public, NOT WAN. Published ONLY on oldsrv's Home-VLAN address
#   (`oldsrv_home_ip`, actual-budget :5006 / immich-ml :3003 precedent) so LAN/tailnet
#   AI clients can reach it; the future s2s-wg→tailnet redo adds a Pattern-A sidecar.
#   The MCP server in `http` mode has NO native auth — the data gate is the bearer
#   token this container sends to VictoriaMetrics (`VM_INSTANCE_HEADERS`, Basic auth) +
#   the Home-VLAN-only bind, and (future) the tailnet ACL. Do NOT add traefik-public labels.
#
# Secrets via the HD-258 bulk vault pre-pass (`vault['victoria-metrics_api']`, the
#   1Password basic-auth item for the VictoriaMetrics backend — username/password).
services:
  mcp-victoriametrics:
    image: ghcr.io/victoriametrics-community/mcp-victoriametrics:{{ mcp_victoriametrics_version }}
    container_name: mcp-victoriametrics
    restart: unless-stopped
    cap_drop:
      - ALL
    # read_only absent: the upstream image is Alpine-root (no USER); it does not write
    # outside /tmp at runtime, but keep the standard read_only+tmpfs pair OFF unless the
    # image is verified to boot under it (HD-318 live lessons: cap_drop ALL is the safe
    # floor; read_only has broken linuxserver-style entrypoints before).
    tmpfs:
      - /tmp
    networks:
      - services-internal
    ports:
      # MCP Streamable HTTP endpoint — bound to oldsrv's Home IP (SSOT-derived), not
      # 0.0.0.0. Reach is scoped by the LAN + (future) tailnet ACL; never WAN/public.
      - "{{ oldsrv_home_ip }}:{{ mcp_metrics_port }}:{{ mcp_metrics_port }}"
    environment:
      # VictoriaMetrics backend URL (root / of the single-node instance).
      VM_INSTANCE_ENTRYPOINT: "http://{{ victoria_backend_host }}:8428"
      VM_INSTANCE_TYPE: "single"
      # Basic-auth to the VM backend (vault item username:password). The MCP server
      # sends these as the Authorization header on every query (HD-344).
      VM_INSTANCE_HEADERS: "Authorization=Basic {{ (vault['victoria-metrics_api'].username ~ ':' ~ vault['victoria-metrics_api'].password) | b64encode }}"
      # Streamable HTTP mode (upstream: MCP_SERVER_MODE=http enables it).
      MCP_SERVER_MODE: "http"
      MCP_LISTEN_ADDR: ":{{ mcp_metrics_port }}"
    # No healthcheck baked into the upstream image; a TCP probe on the listen port is
    # the honest liveness signal. Compose healthcheck optional — the image is Alpine,
    # so `wget` is absent; skip a shell healthcheck (HD-318: avoid entrypoint surprises).
networks:
  services-internal:
    external: true

# seerr docker-compose.yml — Request portal (seerr.kogler.si)
#   seerr.dev image. OWN LOGIN (no Authentik Forward-Auth — family non-admin users
#   submit requests directly). Internal-only.
#   SQLite (`seerr.db`) lives in /app/config → host path /srv/docker/seerr/config.
#   KOPS-059 / HD-130: this config+DB IS in backup scope (docs/backup.md "Service state"
#   → tank/data/services via nightly push + Kopia). Single-file SQLite — reconfig ~15 min;
#   isolated per-service under /srv/docker/seerr so its failure domain is the service only.
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}
#   — none needed
#   — none needed
services:
  seerr:
    image: seerr/seerr:{{ seerr_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: seerr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/seerr/config:/app/config
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.seerr.rule: "Host(`seerr.kogler.si`)"
      traefik.http.routers.seerr.entrypoints: websecure
      traefik.http.routers.seerr.middlewares: crowdsec-only@file   # CrowdSec block-list; own login, no Forward-Auth (KOPS-047 / HD-119)
      traefik.http.routers.seerr.tls.certresolver: letsencrypt
      # NOTE: no authentik-forward-auth — Seerr has its own login
      traefik.http.services.seerr.loadbalancer.server.port: "5055"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
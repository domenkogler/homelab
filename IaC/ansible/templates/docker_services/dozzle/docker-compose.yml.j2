# dozzle docker-compose.yml — Live container log viewer (logs.kogler.si)
#   Read-only docker.sock, viewer only (never a log store — Loki stays the backend).
#   Forward-Auth. Shows ALL containers in real time.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  dozzle:
    image: amir20/dozzle:{{ dozzle_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: dozzle
    restart: unless-stopped
    networks:
      - traefik-public
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      DOZZLE_LEVEL: info
    labels:
      traefik.enable: "true"
      traefik.http.routers.dozzle.rule: "Host(`logs.kogler.si`)"
      traefik.http.routers.dozzle.entrypoints: websecure
      {{ '' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.dozzle.middlewares: authentik-forward-auth@file
      traefik.http.services.dozzle.loadbalancer.server.port: "8080"
networks:
  traefik-public:
    external: true

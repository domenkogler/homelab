# slskd docker-compose.yml — Soulseek P2P daemon (HD-362, oldsrv)
#   Downloads the rarest FLAC (Soulseek P2P) — daemon with a web UI.
#   Routes through the SAME gluetun WireGuard sidecar pattern as qBittorrent
#   (HD-362 V4 decision): ALL P2P egress via PrivadoVPN, NOT the plain LAN.
#   NO inbound port (CGNAT-range + fixed-endpoint WG ⇒ peer is NOT reachable
#   inbound) → slskd is a **fetch-only** peer (search + download, no upload credit).
#   https://github.com/slskd/slskd · docs: services-media.md §Music Pillar,
#   services-downloads.md §VPN & Ingress (rate-limit + open-port notes).
#
#   AUTH = Soulseek network login (slskd_login -> SLSKD_SLSK_*) + the slskd web-UI
#   password (soulseek_api -> SLSKD_PASSWORD). slskd 0.26 has NO token option (HD-362).
#   Fail-closed lookups, | replace('$','$$') compose-escape (HD-270).
#   VERSION PIN: {{ slskd_version }} — registry-verified 2026-09-14.
services:
  gluetun-slskd:
    # VPN sidecar (exactly the qbittorrent gluetun shape, HD-318c). slskd runs
    # `network_mode: service:gluetun-slskd` so ALL its traffic egresses via VPN.
    image: qmcgaw/gluetun:{{ gluetun_version }}
    container_name: gluetun-slskd
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      - traefik-public
      - services-internal
    environment:
      VPN_SERVICE_PROVIDER: custom        # gluetun dropped `privado` → explicit endpoint (HD-318c)
      VPN_TYPE: wireguard
      WIREGUARD_ENDPOINT_IP: "{{ privado_vpn_endpoint_ip }}"
      WIREGUARD_ENDPOINT_PORT: "{{ privado_vpn_endpoint_port }}"
      WIREGUARD_PUBLIC_KEY: "{{ privado_vpn_public_key }}"
      WIREGUARD_PRIVATE_KEY: "{{ vault['privado-vpn_api'].credential | replace('$','$$') }}"
      WIREGUARD_ADDRESSES: "{{ privado_vpn_address }}/{{ privado_vpn_cidr }}"
    ports:
      # slskd web UI — internal-only narrow-bind on oldsrv Home-IP (homelable/actual-budget
      # precedent); reachable at http://<oldsrv-home-ip>:5030 through the sidecar namespace.
      - "{{ oldsrv_home_ip }}:5030:5030"

  slskd:
    image: slskd/slskd:{{ slskd_version }}
    restart: unless-stopped
    network_mode: "service:gluetun-slskd"   # shares the sidecar namespace — egress via VPN
    depends_on:
      - gluetun-slskd
    container_name: slskd
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    environment:
      # Soulseek network credentials (username + password from 1P).
      # ⚠ slskd reads ONLY `SLSKD_`-prefixed env vars — `slskd --envars` (152 of them) is the
      # authority, not the old upstream README. The previous SOULSEEK_USERNAME/PASSWORD pair
      # was therefore inert: the daemon held EMPTY credentials and logged
      # "Not connecting to the Soulseek server; username and/or password invalid" without ever
      # dialling vps.slsknet.org:2271 — that line is the pre-flight skip branch, NOT a server
      # rejection, which is why it read as a vault problem for three weeks (HD-362, settled
      # 2026-10-07 by measuring --envars + /api/v0/options: the vault was right all along).
      SLSKD_SLSK_USERNAME: "{{ vault['slskd_login'].username | replace('$','$$') }}"
      SLSKD_SLSK_PASSWORD: "{{ vault['slskd_login'].credential | replace('$','$$') }}"
      # Web-UI login. slskd 0.26 removed the shared token (`SLSKD_TOKEN` is gone from
      # --envars); the UI now authenticates username+password → JWT. Unset, the daemon serves
      # the STOCK DEFAULT slskd/slskd — which is exactly what answered on slskd.kogler.si.
      SLSKD_USERNAME: "slskd"
      SLSKD_PASSWORD: "{{ vault['soulseek_api'].credential | replace('$','$$') }}"
      # Downloads land on the NAS, where the arr can see them: /downloads == the same
      # /mnt/nas/media/downloads bind qBittorrent uses (TRaSH complete/<cat> layout).
      # Unset, slskd writes to <appDir>/downloads == /srv/docker/slskd/data/downloads —
      # a path Lidarr has no mount for, so every Soulseek find would be invisible forever
      # (measured live: GET /api/v0/options -> directories.downloads == /app/downloads).
      # ⚠ BOTH directories must already EXIST: slskd validates them at startup, does not create
      # them, and exits 0 when one is missing — a silent `Restarting (0)` crash loop with no
      # error code to catch. The incomplete leg is provisioned by roles/storage/tasks/nas.yml.
      SLSKD_DOWNLOADS_DIR: "/downloads/complete/music"
      SLSKD_INCOMPLETE_DIR: "/downloads/incomplete/music"
      # Rate-limit at the container (mirrors the ruled 10 MB/s P2P cap, HD-362) — KiB/s.
      # The previous SLSKD_{DOWNLOAD,UPLOAD}_BANDWIDTH_LIMIT names are not in --envars
      # either, so this cap had never actually been applied at the container until now.
      SLSKD_DOWNLOAD_SPEED_LIMIT: "10240"
      SLSKD_UPLOAD_SPEED_LIMIT: "10240"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /srv/docker/slskd/data:/app          # slskd app state (database, transfers queue)
      - /mnt/nas/media/downloads:/downloads:rw   # TRaSH layout: complete/music + incomplete/music
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
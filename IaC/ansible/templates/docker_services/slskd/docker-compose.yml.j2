# slskd docker-compose.yml — Soulseek P2P daemon (HD-362, oldsrv)
#   Downloads the rarest FLAC (Soulseek P2P) — daemon with a web UI.
#   Routes through the SAME gluetun WireGuard sidecar pattern as qBittorrent
#   (HD-362 V4 decision): ALL P2P egress via PrivadoVPN, NOT the plain LAN.
#   NO inbound port (CGNAT-range + fixed-endpoint WG ⇒ peer is NOT reachable
#   inbound) → slskd is a **fetch-only** peer (search + download, no upload credit).
#   https://github.com/slskd/slskd · docs: services-media.md §Music Pillar,
#   services-downloads.md §VPN & Ingress (rate-limit + open-port notes).
#
#   AUTH = Soulseek network login (slskd_login) + slskd web-UI token (soulseek_api).
#   Fail-closed lookups, | replace('$','$$') compose-escape (HD-270).
#   VERSION PIN: {{ slskd_version }} — registry-verified 2026-09-14.
services:
  gluetun-slskd:
    # VPN sidecar (exactly the qbittorrent gluetun shape, HD-318c). slskd runs
    # `network_mode: service:gluetun-slskd` so ALL its traffic egresses via VPN.
    image: qmcgaw/gluetun:{{ gluetun_version }}
    container_name: gluetun-slskd
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      - traefik-public
      - services-internal
    environment:
      VPN_SERVICE_PROVIDER: custom        # gluetun dropped `privado` → explicit endpoint (HD-318c)
      VPN_TYPE: wireguard
      WIREGUARD_ENDPOINT_IP: "{{ privado_vpn_endpoint_ip }}"
      WIREGUARD_ENDPOINT_PORT: "{{ privado_vpn_endpoint_port }}"
      WIREGUARD_PUBLIC_KEY: "{{ privado_vpn_public_key }}"
      WIREGUARD_PRIVATE_KEY: "{{ vault['privado-vpn_api'].credential | replace('$','$$') }}"
      WIREGUARD_ADDRESSES: "{{ privado_vpn_address }}/{{ privado_vpn_cidr }}"
    ports:
      # slskd web UI — internal-only narrow-bind on oldsrv Home-IP (homelable/actual-budget
      # precedent); reachable at http://<oldsrv-home-ip>:5030 through the sidecar namespace.
      - "{{ oldsrv_home_ip }}:5030:5030"

  slskd:
    image: slskd/slskd:{{ slskd_version }}
    restart: unless-stopped
    network_mode: "service:gluetun-slskd"   # shares the sidecar namespace — egress via VPN
    depends_on:
      - gluetun-slskd
    container_name: slskd
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    environment:
      # Soulseek network credentials (username + password from 1P).
      SOULSEEK_USERNAME: "{{ vault['slskd_login'].username | replace('$','$$') }}"
      SOULSEEK_PASSWORD: "{{ vault['slskd_login'].credential | replace('$','$$') }}"
      # Web-UI + API token.
      SLSKD_TOKEN: "{{ vault['soulseek_api'].credential | replace('$','$$') }}"
      # Rate-limit at the container (mirrors the router 10 MB/s cap, HD-362) — KB/s.
      SLSKD_DOWNLOAD_BANDWIDTH_LIMIT: "10240"
      SLSKD_UPLOAD_BANDWIDTH_LIMIT: "10240"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    volumes:
      - /srv/docker/slskd/data:/app          # slskd app state (database, downloads queue)
      - /mnt/nas/media/downloads/complete/music:/downloads:rw   # TRaSH-style music save path
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
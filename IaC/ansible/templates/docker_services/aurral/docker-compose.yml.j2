# aurral docker-compose.yml — Music discovery companion for Lidarr (HD-362, oldsrv)
#   Delivers the "discovery" leg of the Music Pillar: personalized recommendations,
#   Last.fm / ListenBrainz listening history, trending pools, and one-click "add to
#   Lidarr" requests. FREE (Last.fm + ListenBrainz accounts only — owner-created).
#   Upstream: ghcr.io/lklynet/aurral (docs.aurral.org) — GHCR, NOT Docker Hub.
#   docs: docs/services-media.md §Music Pillar.
#
#   PLACEMENT: OLDSRV, INTERNAL-ONLY. Homelable precedent: reached at
#   http://<oldsrv-home-ip>:3001 by direct IP (no home-host Traefik edge — HD-331/332
#   posture; the VPS edge cannot reach the home LAN either). No docker labels, no
#   routes.yml entry needed unless a subdomain is wanted later.
#
#   AUTH = Aurral's OWN UI login (home-edge pattern). SERVICE CONNECTIONS (Lidarr API,
#   Last.fm, ListenBrainz) are configured IN THE WEB UI (first-run setup), matching
#   upstream — the image's compose carries NO env vars for them. So NO 1Password
#   lookups are needed in this compose (vault items exist for the owner's reference):
#     lastfm_login / metabrainz_login — owner-created 2026-09-14, entered in the UI.
#
#   STATE: SQLite + config in /config (kopia-agent snapshot scope).
#   VERSION PIN: {{ aurral_version }} — ghcr.io/lklynet/aurral (registry-verified 2026-09-14).
services:
  aurral:
    image: ghcr.io/lklynet/aurral:{{ aurral_version }}
    restart: unless-stopped
    container_name: aurral
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    networks:
      - services-internal
    ports:
      # internal-only: bind ONLY oldsrv's Home-VLAN IP (narrow-bind law HD-62/HD-184;
      # actual-budget/homelable precedent) — NEVER 0.0.0.0.
      - "{{ oldsrv_home_ip }}:3001:3001"
    volumes:
      - /srv/docker/aurral/config:/config    # SQLite + app config (kopia-agent scope)
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  services-internal:
    external: true
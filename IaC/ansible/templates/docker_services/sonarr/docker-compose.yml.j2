# sonarr docker-compose.yml — TV series (sonarr.kogler.si)
#   TRaSH hardlink import: /mnt/nas/media/downloads/complete/tv → /mnt/nas/media/media/tv.
#   Forward-Auth. linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  sonarr:
    image: linuxserver/sonarr:{{ sonarr_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: sonarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/sonarr/config:/config
      - /mnt/nas/media/media:/media              # rw — creates tv/ folder, hardlink import
      - /mnt/nas/media/downloads:/downloads       # rw — downloads/complete/tv
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.sonarr.rule: "Host(`sonarr.kogler.si`)"
      traefik.http.routers.sonarr.entrypoints: websecure
      {{ 'traefik.http.routers.sonarr.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.sonarr.middlewares: authentik-forward-auth@file
      traefik.http.services.sonarr.loadbalancer.server.port: "8989"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

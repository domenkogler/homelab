# profilarr docker-compose.yml — Quality profile manager (profilarr.kogler.si)
#   Configuration management for Radarr/Sonarr quality profiles (Dictionarry-Hub).
#   Two containers: web UI (6868) + parser sidecar (5000). Forward-Auth.
#   Image source: ghcr.io/dictionarry-hub/profilarr — v2 Deno-based.
#   `latest` is a DOCUMENTED FLUID-TAG EXCEPTION — upstream publishes no
#   versioned tags (only develop/buildcache/sha256).
#   MUST pin to a verified tag if upstream ever starts publishing semver.
#   See docs/services.md + docs/deployment-compose.md.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  profilarr:
    image: ghcr.io/dictionarry-hub/profilarr:{{ profilarr_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN   # cap_drop ALL strips CHOWN; init chown on /config fails otherwise
      - SETGID
      - SETUID   # the init ends in `su-exec <uid>` to drop privileges; without SETUID/SETGID it dies "su-exec: setgroups: Operation not permitted"
    # read_only intentionally ABSENT: the profilarr init runs chown on
    # /config as root before dropping privileges; read_only root made the chown fail
    # ("Operation not permitted"). Dir ownership via bind_owner_uid on the entry.
    tmpfs:
      - /tmp
    container_name: profilarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    ports:
      # Loopback publish so the host-net home edge can reach the backend.
      - "{{ profilarr_bind }}:{{ profilarr_host_port }}:6868"
    volumes:
      - /srv/docker/profilarr/config:/config
    environment:
      PORT: "6868"
      HOST: "0.0.0.0"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.profilarr.rule: "Host(`profilarr.kogler.si`)"
      traefik.http.routers.profilarr.entrypoints: websecure
      {{ 'traefik.http.routers.profilarr.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair' }}
      traefik.http.routers.profilarr.middlewares: authentik-forward-auth@file
      traefik.http.services.profilarr.loadbalancer.server.port: "6868"
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:6868/api/v1/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  profilarr-parser:
    image: ghcr.io/dictionarry-hub/profilarr-parser:{{ profilarr_parser_version }}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN   # same chown-under-cap_drop-ALL rule as profilarr
      - SETGID
      - SETUID   # same su-exec privilege-drop path as profilarr
    # read_only intentionally ABSENT: same rationale as profilarr — the
    # Deno runtime needs a writable /run + config scratch at startup.
    tmpfs:
      - /tmp
      - /run
    container_name: profilarr-parser
    restart: unless-stopped
    networks:
      - services-internal
    environment:
      PARSER_PORT: "5000"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"

networks:
  traefik-public:
    external: true
  services-internal:
    external: true

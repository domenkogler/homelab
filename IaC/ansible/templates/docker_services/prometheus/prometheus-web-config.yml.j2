# prometheus web-config.yml — Basic Auth for the Prometheus HTTP endpoint (HD-59)
# Vault-escape note: this file is consumed by Prometheus itself (NOT `docker compose`
# interpolation), so `vault['<item>']` values pass through unchanged. Compose's
# `$`-substitution only applies to compose files (HD-270/HD-233 lesson). url/urlencode
# refs already escape; raw `vault['x'].credential` here is safe — no `| replace('$','$$')`.
#   Prometheus `--web.config.file` requires bcrypt-hashed passwords in `basic_auth_users`.
#   Rendered by the docker_services role; hash seeded from 1Password `Homelab-ansible`
#   `prometheus-internal_api` (username = user, password = the PLAINTEXT password the
#   secret stores; this template must therefore hold the BCRYPT hash — see
#   `scripts/gen-htpasswd.py`, which emits `username:bcrypt`).
#
#   DEPLOY-TIME NOTE: the value below must be the bcrypt hash of the prometheus-internal_api
#   password, generated via `python scripts/gen-htpasswd.py <user>` and pasted here (or
#   rendered from the 1Password field). The repo's fail-loud rule applies: if the field is
#   absent the render aborts rather than shipping an open scrape endpoint.
basic_auth_users:
  {{ vault['prometheus-internal_api'].username }}: >-
    {{ vault['prometheus-internal_api'].bcrypt_hash }}
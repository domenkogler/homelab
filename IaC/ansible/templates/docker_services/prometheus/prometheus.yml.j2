global:
  scrape_interval: 15s
  evaluation_interval: 30s
scrape_configs:
  # blackbox-exporter (services-internal, :9115, /probe)
  - job_name: blackbox-exporter
    static_configs:
      - targets:
          - "blackbox-exporter:9115"
    metrics_path: /probe
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [__param_module]
        target_label: __param_module
    params:
      module: [http_2xx]
  # HTTP probes for web services
  - job_name: blackbox_http_probes
    static_configs:
      - targets: ["https://kogler.si", "https://sso.kogler.si", "https://foto.kogler.si", "https://file.kogler.si", "https://git.kogler.si", "https://ha.kogler.si"]
    metrics_path: /probe
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [__param_module]
        target_label: __param_module
    params:
      module: [http_2xx]
  # ICMP probes (router + switch on Mgmt VLAN; nas/oldsrv/pi on Home VLAN — IPs from SSOT network_static_hosts)
  - job_name: blackbox_icmp
    static_configs:
      - targets:
{% for hostname in ['router', 'switch'] %}
          - "{{ (network_static_hosts | selectattr('name', 'equalto', hostname) | selectattr('vlan', 'equalto', 99) | first).ip }}"
{% endfor %}
{% for hostname in ['nas', 'oldsrv', 'pi'] %}
          - "{{ (network_static_hosts | selectattr('name', 'equalto', hostname) | selectattr('vlan', 'equalto', 10) | first).ip }}"
{% endfor %}
    metrics_path: /probe
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [__param_module]
        target_label: __param_module
    params:
      module: [icmp]
  # wg-s2s tunnel-liveness (HD-159): single ICMP probe to the home router's
  # WireGuard-side peer IP (10.255.40.1, SSOT wg_s2s_vps.router_ip). Succeeds only
  # when the home<VPS tunnel is up — the first-class tunnel-down signal. Kept as a
  # separate scrape job so job-level up{job="wg_icmp"}/execErr backstop is distinct
  # from the host-down blackbox_icmp job.
  - job_name: wg_icmp
    static_configs:
      - targets:
          - "{{ wg_s2s_vps.router_ip }}"
    metrics_path: /probe
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [__param_module]
        target_label: __param_module
    params:
      module: [icmp]

  - job_name: nut_exporter
    # DRuggeri/nut_exporter v3: emits ONLY on /ups_metrics?ups=<name> (plain /metrics is
    # empty) — README-blessed path. Metric names are network_ups_tools_* (2026-09-04 fix:
    # the old nut_* names + bitmask status never matched this exporter).
    metrics_path: /ups_metrics
    params:
      ups: ["{{ nut_ups_name | default('powerwalker') }}"]
    static_configs:
      - targets: ["{{ nut_exporter_host }}:{{ nut_exporter_port }}"]
  # zfs_exporter (single SSOT ZFS exporter — host binary on nas, storage role)
  - job_name: zfs_exporter
    static_configs:
      - targets: ["{{ zfs_exporter_host }}:{{ zfs_exporter_port }}"]
  # HA exporter (edge HA's /api/prometheus). GATED OFF until Phase 4 (prometheus_ha_exporter,
  # Wave-2 triage 2026-08-22): pre-cutover there is no HA behind ha_vip and no token file -
  # flip the var at HD-04 together with the HA long-lived-token vault item + compose mount.
{% if prometheus_ha_exporter | default(false) %}
  - job_name: ha_exporter
    metrics_path: /api/prometheus
    bearer_token_file: /etc/prometheus/ha_token
    static_configs:
      - targets:
          - "{{ ha_vip }}:8123"
{% endif %}
  # Service self-metrics: traefik
  - job_name: traefik
    static_configs:
      - targets: ["traefik:8082"]
  # Service self-metrics: crowdsec
  - job_name: crowdsec
    static_configs:
      - targets: ["crowdsec:6060"]
  # (Doco-CD scrape job removed — Doco-CD dropped, HD-150.)
  # Self-monitoring: the observability stack itself must alert when it dies
  # (docs/observability.md — Grafana rules key off up{job=...}, noData/execErr as backstop).
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
  - job_name: n8n
    static_configs:
      - targets: ["n8n:5678"]
  # Prometheus Alertmanager is NOT in Phase 1 — Grafana Alerting covers it (observability.md),
  # so there is no alertmanager:9093 target and no alerting block to point at.
  # (KOPS-052 — remove the obsolete scrape job; kept here as a comment for the Phase-2 re-add.)
remote_write: []
rule_files: []
# NOTE (Wave-3 round-2 triage 2026-08-22): a trailing `storage: tsdb:` block was removed -
# Prometheus has no such top-level config key; tsdb path/retention are CLI flags only
# (already set via --storage.tsdb.* in docker-compose.yml.j2).
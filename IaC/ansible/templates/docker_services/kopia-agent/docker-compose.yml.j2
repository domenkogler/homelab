# kopia-agent docker-compose.yml — oldsrv off-site backup CLIENT
#   Containerized Kopia agent on oldsrv: snapshots oldsrv-LOCAL state to the
#   kopia-server repository (VPS) over the WireGuard S2S tunnel — parity with the
#   VPS-side agent. The repo backend is the Hetzner Storage Box **backup** (SFTP) behind
#   kopia-server; the agent never touches storage itself.
#
#   The sources below are oldsrv-local paths (mounted READ-ONLY) plus ONE ruled NAS-resident
#   source: the music master. Never mounted: model weights (/srv/models — regenerable), Docker
#   layers and TSDB.
#
#   NAS-independence, stated exactly (docs/backup.md §Layer 2): every oldsrv-local source keeps
#   working while the NAS is fully down, because the music master is snapshotted by its OWN line,
#   behind its own mount guard. A NAS outage therefore fails one loud line in the log instead of
#   taking the whole agent with it — which is the invariant's actual purpose (off-site coverage for
#   local state must not ride on the NAS). The music master cannot be NAS-independent: it IS the
#   NAS's data, and the ruling that put it in backup scope says so.
#
#   Transport: kopia-server :51515 is published ONLY on the VPS WG tunnel address
#   (wg_s2s_vps.ip — see the kopia-server template); home-initiated connect is
#   allowed by the S2S scoping.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     kopia-server-internal_api (API Credential) — the SAME item kopia-server auths
#       with: `username` = the user@host identity the agent presents via
#       HTTP Basic Auth, `credential` = its password. No new 1Password item.
#   Config vars: none new — server address derives from `wg_s2s_vps.ip` (all.yml SSOT).
services:
  kopia-agent:
    image: kopia/kopia:{{ kopia_version }}   # same pin as kopia-server (one pin per image)
    cap_drop:
      - ALL
    # read_only is intentionally ABSENT: the kopia image's entrypoint writes /app/logs
    # (cli-logs/content-logs cache markers) and /app/cache markers before the command runs, so a
    # read-only root makes those mkdirs fail. /app/config + /app/cache are the bind dirs below;
    # /app/logs must stay writable on the layer.
    tmpfs:
      - /tmp
      - /app/logs   # image sets KOPIA_LOG_DIR=/app/logs - EROFS under read_only without it (kopia-server precedent)
    # The image ENTRYPOINT is /bin/kopia: without clearing it the command below resolves to
    # `kopia sh -c ...` and exits instantly ("expected command but got sh"). entrypoint: []
    # makes the sh -c bootstrap script PID 1 argv.
    entrypoint: []
    container_name: kopia-agent
    restart: unless-stopped
    # No overlay network: the agent egresses via the host's default bridge to the
    # WG S2S tunnel (wg-s2s on the router → VPS). It talks to NO local container.
    command:
      - sh
      - -c
      - |
        set -e
        # Fail loud: server auth identity is REQUIRED — never run an
        # agent that would silently skip auth (the server would reject it anyway).
        : "$${KOPIA_SERVER_USER:? kopia-server-internal_api.username missing — aborting}"
        : "$${KOPIA_SERVER_PASSWORD:? kopia-server-internal_api.credential missing — aborting}"
        if [ ! -f /app/config/repository.config ]; then
          echo "Connecting to kopia-server over the WG S2S tunnel..."
          # kopia 0.23.1 dropped --server-username/--server-password: HTTP Basic auth
          # is carried in the URL userinfo, and the repo master password on -p.
          # The server password may contain URL-hostile chars ((){}@ etc.) — percent-
          # encode it or the URL parser rejects it ("invalid character } in host
          # name"). Pure-bash encoder (no perl URI::Escape in the
          # kopia image, and Jinja chokes on the open-brace-hash sequence).
          # NOTE: docker compose interpolates $$NAME in the command block — every
          # bash var stays a simple name (compose warns "variable is not set" and
          # blanks it, which is harmless at compose-parse time; the bash runtime
          # re-reads $$NAME from the environment at exec). The ONLY hard error is the
          # $${var:offset} substring form (invalid interpolation format) — avoided.
          # fold is present in the kopia image. All $$NAME
          # forms are simple names: docker compose interpolates unknown $$NAMEs to a
          # harmless blank at parse time (the bash runtime re-reads them from env at
          # exec), and we avoid $${var:...} substring syntax entirely (that is the
          # only form that hard-errors compose: "invalid interpolation format").
          _urlenc() {
            printf '%s' "$$1" | fold -w1 | while IFS= read -r c; do
              case "$$c" in
                [A-Za-z0-9._~-]) printf '%s' "$$c" ;;
                *) printf '%%%02X' "'$$c" ;;
              esac
            done
          }
          _enc_user=$$(_urlenc "$$KOPIA_AGENT_USER")
          _enc_pass=$$(_urlenc "$$KOPIA_SERVER_PASSWORD")
          kopia repository connect server \
            --url="https://$${_enc_user}:$${_enc_pass}@$${KOPIA_SERVER_ADDR}" \
            --password="$${KOPIA_PASSWORD}" \
            --server-cert-fingerprint="$${KOPIA_SERVER_FINGERPRINT}" \
            --override-hostname=oldsrv.kogler.si \
            --override-username=oldsrv-agent
        fi
        # Scheduled worker (no UI): snapshot loop, first pass at start-up. Interval
        # is env-tunable; exact window + server-side policy tuning = deploy-gated.
        while :; do
          echo "[kopia-agent] snapshot create $$(date -u +%FT%TZ)"
          kopia snapshot create /mnt/src/opt /mnt/src/dumps /mnt/src/immich-upload || echo "[kopia-agent] snapshot create FAILED — retrying next interval"
          kopia snapshot create /mnt/src/signal-cli-data || echo "[kopia-agent] signal state snapshot FAILED — retrying next interval"
          # --- The music master (NAS `bulk/media/media/music`) — its own line, its own guard ---
          # WHY a guard at all: kopia reports an EMPTY tree as a SUCCESSFUL snapshot, and the next
          # prune would then retire the last snapshot that actually held the FLACs. A dead NFS
          # automount IS an empty directory from in here. So refuse to snapshot rather than let
          # retention eat the only good copy — the same duty `--max-delete` carries on the serving
          # push leg (docs/storage.md §Service ↔ Storage Placement).
          # (1) source witness — a bind carries the superblock with it, so either mountinfo names
          #     the NAS export or statfs reports nfs. Either witness is enough for THIS half.
          # (2) content witness — a mount that is bound but dead passes (1) and reads empty, so
          #     the emptiness test is what catches it. Both halves are required; neither alone is.
          _music_live() {
            # An empty pattern would make the grep match EVERY line, so a missing value must fail
            # the guard rather than wave everything through. (An undefined var kills the RENDER
            # first — this is the belt on the braces.)
            [ -n "$${KOPIA_MUSIC_EXPECTED_SOURCE}" ] || return 1
            grep -q "$${KOPIA_MUSIC_EXPECTED_SOURCE}" /proc/self/mountinfo 2>/dev/null \
              || [ "$$(stat -f -c %T /mnt/src/music 2>/dev/null)" = nfs ] \
              || return 1
            [ "$$(find /mnt/src/music -type f 2>/dev/null | wc -l)" -ge 1 ] || return 1
            return 0
          }
          if _music_live; then
            echo "[kopia-agent] music snapshot $$(date -u +%FT%TZ)"
            kopia snapshot create /mnt/src/music || echo "[kopia-agent] MUSIC snapshot FAILED — retrying next interval"
          else
            echo "[kopia-agent] music master is NOT mounted from $${KOPIA_MUSIC_EXPECTED_SOURCE} (or reads empty) — SKIPPING the music snapshot, a snapshot of an empty tree would prune the last good one"
          fi
          sleep "$${KOPIA_SNAPSHOT_INTERVAL_SECONDS:-86400}"
        done
    volumes:
      # --- Sources (READ-ONLY, oldsrv-local only — backup.md §Layer 2 policy) ---
      - /opt:/mnt/src/opt:ro                       # compose configs + technitium state + ha-standby config (/opt/*)
      - /srv/dumps:/mnt/src/dumps:ro               # dump scratch (created by push jobs; may be empty at first)
      - /srv/docker/immich/upload:/mnt/src/immich-upload:ro   # immich-ml thumbs/upload dir (face thumbnails — the one regenerable-adjacent exception backup.md keeps)
      # Signal gateway identity/state (named volume owned by the signal-cli-rest-api
      # project — `name:` pins the projected volume name; renaming that service's
      # project breaks this mount, caught at deploy). Read-only.
      - signal-cli-data:/mnt/src/signal-cli-data:ro
      # The music master (docs/storage.md §Service ↔ Storage Placement): the FLAC master on the
      # NAS, read through the /bulk/media NFS export the storage role mounts here. Read-only —
      # nothing in this container may write the master. Its snapshot line is guarded (see above).
      - "{{ music_master_mount }}:/mnt/src/music:ro"
      - /srv/docker/kopia-agent/config:/app/config
      - /srv/docker/kopia-agent/cache:/app/cache
    environment:
      # VPS peer address on the wg-s2s /30 (SSOT: group_vars/all/ wg_s2s_vps.ip).
      KOPIA_SERVER_ADDR: "{{ wg_s2s_vps.ip }}:51515"
      # kopia 0.23.x only connects to https:// servers, so the self-signed kopia-server cert is
      # pinned here by its stable SHA-256 fingerprint (lowercase hex). A fingerprint is a trust
      # anchor, so it lives in 1Password (`kopia-server_fingerprint`, NOT_AUTO_ROTATABLE):
      # replacing the cert requires re-seeding the item and re-rendering.
      KOPIA_SERVER_FINGERPRINT: "{{ vault['kopia-server_fingerprint'].password | replace('$','$$') }}"
      KOPIA_SERVER_USER: "{{ vault['kopia-server-internal_api'].username | replace('$','$$') }}"
      KOPIA_SERVER_PASSWORD: "{{ vault['kopia-server-internal_api'].credential | replace('$','$$') }}"
      # The URL userinfo identity must be the SAME user@host the session presents
      # (--override-username/--override-hostname), i.e. the kopia-server htpasswd entry —
      # otherwise the server rejects the session ('access denied' for <user@host>).
      # kopia_agent_user is the group_vars SSOT (all.yml).
      KOPIA_AGENT_USER: "{{ kopia_agent_user | replace('$','$$') }}"
      KOPIA_PASSWORD: "{{ vault['kopia_password'].password | replace('$','$$') }}"   # repo master password (kopia-server precedent)
      # Source witness for the music-master guard — the NFS source string that must appear in
      # /proc/self/mountinfo. SSOT: `music_master_expected_source` (group_vars/all/).
      KOPIA_MUSIC_EXPECTED_SOURCE: "{{ music_master_expected_source }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
volumes:
  signal-cli-data:
    external: true
    name: signal-cli-rest-api_signal-cli-data   # exact projected name of the signal-cli-rest-api project volume

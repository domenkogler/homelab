# kopia-agent docker-compose.yml — Per-host backup agent
#   Connects to the same S3 repository as kopia-server and runs backup
#   snapshots of /mnt/nas and local paths. Configured via kopia CLI or
#   the kopia-server web UI.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     kopia_password  (Password: repository master password)
#     kopia-s3_api    (API Credential: username=<access key>, credential=<secret key>)
services:
  kopia-agent:
    image: kopia/kopia:{{ kopia_version | default('latest') }}
    container_name: kopia-agent
    restart: unless-stopped
    command:
      - server
      - start
      - --address=0.0.0.0:51516
      - --insecure
    networks:
      - services-internal
    volumes:
      - /srv/docker/kopia-agent/config:/app/config
      - /mnt/nas:/mnt/nas:ro
    environment:
      KOPIA_PASSWORD: "{{ lookup('community.general.onepassword', 'kopia_password', field='password', vault=op_vault) }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  services-internal:
    external: true
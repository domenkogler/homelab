# renovate docker-compose.yml — upstream version tracking (3-day stability hold)
#   Renovate container scanning the homelab repo on Forgejo — no web UI, no Traefik labels.
#   Secret: forgejo_api (1Password « Homelab-ansible).
#   See docs/deployment-renovate.md. Secrets via
#   1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#
#   Upstream `ghcr.io/renovatebot/renovate` is designed to EXIT after a scan (per upstream
#   "Self-Hosting Renovate" — the open-source build needs external scheduling: "you must make
#   sure that some form of cron-like capability exists to schedule when Renovate runs. We
#   recommend that you run Renovate hourly"). With `restart: unless-stopped` a clean exit
#   auto-restarts and the container churns per minute (observed RestartCount in the thousands).
#   The rules in this template:
#     • `restart: on-failure:5` — clean exits must NOT trigger a restart; only crashes
#       do (Docker compose v2 `on-failure:<max-retries>` form, validator-aware). The `:5` caps
#       consecutive restart attempts so a genuinely broken image stops looping and
#       surfaces for owner investigation instead of burning the restart budget.
#     • `RENOVATE_SCHEDULE` — bounds Renovate's action window to low-traffic hours
#       (22:00–04:00 UTC, every day) per Renovate docs ("If Renovate isn't expected
#       to run more frequently, we recommend a time window of at least 3–4 hours").
#       `RENOVATE_SCHEDULE` is the documented env var for the `schedule` config option.
#     • NOT WIRED: this container still needs an EXTERNAL re-launch mechanism — a host
#       systemd timer (`/etc/systemd/system/renovate.timer` + `renovate.service` running
#       `docker compose up -d --no-deps --force-recreate renovate` hourly) on the VPS,
#       OR an Ansible cron job in deploy-service.yml. Until that lands the container exits
#       cleanly after each scan and restarts ONLY on crash — it does NOT run hourly.
#
#   DEFERRED (final step): when `domen/homelab` lands on Forgejo AND the
#   end-to-end PR flow is verified, flip RENOVATE_REPOSITORIES back
#   to `domen/homelab`. Currently `domen/test` (the sandbox).
services:
  renovate:
    image: ghcr.io/renovatebot/renovate:{{ renovate_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: renovate
    restart: on-failure:5
    environment:
      # The pinned image (35.x) predates the native `forgejo`
      # platform; Renovate validates the platform at startup and FATAL-exits on unknown
      # values. Forgejo is a Gitea soft-fork with API-compatible endpoints -> use gitea.
      # Revisit when renovate_version bumps to >=37 (native forgejo support).
      RENOVATE_PLATFORM: gitea
      # INTERNAL endpoint — git.kogler.si sits behind authentik-forward-auth,
      # which intercepts m2m API calls (renovate gets the SSO redirect, not a token check).
      # Both containers share services-internal; the container DNS name resolves directly.
      # The same pattern applies to the Forgejo Actions runner. Revisit ONLY if
      # renovate ever moves off this host.
      RENOVATE_ENDPOINT: http://forgejo:3000
      RENOVATE_TOKEN: "{{ vault['forgejo_api'].credential | replace('$','$$') }}"
      RENOVATE_REPOSITORIES: "domen/test"   # TEMPORARY: domen/homelab is not migrated to Forgejo yet; switch back to domen/homelab when it lands
      # PREREQUISITE: the repo MUST exist on Forgejo as
      # `domen/homelab` — with no repo there renovate 404s every API call ->
      # "Repository has unknown error" crash-loop; service DISABLED in group_vars
      # until the repo lands.
      RENOVATE_ONBOARDING: "false"
      # Bound the action window to low-traffic hours. Per upstream
      # docs ("RENOVATE_SCHEDULE" env var for the `schedule` config option; cron
      # syntax — minutes MUST be `*`). Every day 22:00–04:00 UTC = 6h window,
      # 3h minimum recommended.
      RENOVATE_SCHEDULE: "* 22-23,0-4 * * *"
      RENOVATE_DEPENDENCY_DASHBOARD: "true"
      RENOVATE_DEPENDENCY_DASHBOARD_TITLE: "Homelab Dependency Dashboard"
      RENOVATE_STABILITY_DAYS: "3"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    networks:
      - services-internal
    volumes:
      - /opt/renovate/config:/config
networks:
  services-internal:
    external: true
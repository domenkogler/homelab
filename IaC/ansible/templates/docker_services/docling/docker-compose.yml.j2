# docling docker-compose.yml — AI-stack OCR / document understanding (docling-serve)
#   Converts scans + PDFs (layout, tables, reading order) -> markdown for RAG ingestion.
#   Runs on CPU (spares the dGPU for Ollama/immich-ML). Consumed by Open WebUI / OpenClaw
#   over the v1 API on services-internal. docs/services-ai.md.
#
#   Image: quay.io/docling-project/docling-serve-cpu (CPU-only torch build) pinned via
#   docling_version (pin-semver convention). Serves the v1 API on port 5001.
#   Internal backend only: NO Traefik labels, NO host port binds — reached over
#   the services-internal overlay by the consuming AI services.
#
#   Model weights: BAKED INTO THE IMAGE at /opt/app-root/src/.cache/docling/models (871 MB,
#   reached via DOCLING_SERVE_ARTIFACTS_PATH), so the served pipeline never downloads at
#   start-up. The /models bind below is EMPTY and root-owned while the container runs as
#   uid 1001, so it cannot receive a runtime download either (`PermissionError: /models/hub`
#   from the CLI, which uses HF_HOME=/models). Consequence: a recreate is safe (nothing to
#   re-pull), but any model/engine not baked into the pin is unreachable until this bind is
#   chowned (registry `bind_owner_uid: "1001"` + `bind_dirs`, both supported by the
#   `docker_services` role) or HF_HOME is repointed — the hard prerequisite in front of the
#   engine bench. docs/services-ai.md §Where the model weights actually live.
#
#   `/tmp` stays noexec ON PURPOSE. The layout stage compiles torch-inductor kernels and
#   dlopen()s `torchinductor_*/….main.so`; kernels landing on the tmpfs make EVERY real
#   conversion fail the layout stage with `failed to map segment from shared object` while the
#   HTTP code stays 200. `TORCHINDUCTOR_CACHE_DIR` (+ `TORCH_EXTENSIONS_DIR`, same failure class)
#   therefore lives on a 1001-owned bind: a bind under /srv/docker is dlopen-able (the host root
#   fs is `ext4 rw` with no noexec), which keeps the noexec tmpfs the security posture wants.
#   `/tmp:exec` is the rejected alternative — a writable-exec-anywhere tmpfs in a read_only
#   container. /models stays as above (decorative for weights).
services:
  docling:
    image: quay.io/docling-project/docling-serve-cpu:{{ docling_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp          # noexec by Docker default, intentionally; the exec need lives on /cache
    container_name: docling
    restart: unless-stopped
    networks:
      - services-internal
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      DOCLING_SERVE_LOG_LEVEL: INFO
      DOCLING_SERVE_LOG_FORMAT: json          # structured logs for Loki (observability)
      DOCLING_SERVE_ENABLE_UI: "false"        # API backend only; UI is a demonstrator
      DOCLING_SERVE_ENABLE_MANAGEMENT_ENDPOINTS: "true"   # /v1/memory for observability
      HF_HOME: /models                        # persist downloaded model weights across restarts
      # Keep the compiled kernels on an exec-capable bind, off the noexec tmpfs.
      TORCHINDUCTOR_CACHE_DIR: /cache/torchinductor
      TORCH_EXTENSIONS_DIR: /cache/torch_extensions
    volumes:
      - /srv/docker/docling/models:/models     # ⚠ decorative today — empty + not writable by uid 1001; see the header
      - /srv/docker/docling/cache:/cache       # 1001-owned via the registry's bind_owner_uid/bind_dirs
    deploy:
      resources:
        limits:
          # Quoted/templated string — compose's schema wants limits.memory as a string.
          # The ceiling is also a floor: the rapidocr path needs ~3.3 GiB (docs/services-ai.md
          # §Operational facts) and the host is 16 GB with no swap, so an uncapped converter is
          # the one shape that takes the VPS down with it. Keep ~1.8× the peak.
          memory: "{{ docling_memory_limit }}"
networks:
  services-internal:
    external: true
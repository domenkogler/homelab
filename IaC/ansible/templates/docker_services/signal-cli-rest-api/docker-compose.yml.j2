# signal-cli-rest-api docker-compose.yml — Signal delivery for alerts (Observability)
#   service-internal (needs internet). Linked to Domen's personal number (no second SIM),
#   sends to the dedicated "Homelab Alerts" group.
#   CRITICAL: persist the identity volume — re-linking the number on every restart is
#   NOT acceptable (docs/observability.md). Secrets (signal_api) via
#   1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
services:
  signal-cli-rest-api:
    image: bbernhard/signal-cli-rest-api:{{ signal_cli_rest_api_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: signal-cli-rest-api
    restart: unless-stopped
    environment:
      SIGNAL_CLI_PHONE_NUMBER: "{{ vault['signal_api'].username }}"
      # INTENTIONAL default('', true) (HD-202): the Signal captcha token is an OPTIONAL
      # anti-bot value — signal-cli starts and receives fine without it; a missing 1Password
      # field must not abort the whole render (fail-loud law applies to REQUIRED secrets only).
      SIGNAL_CLI_CAPTCHA: "{{ vault['signal_api'].credential | default('', true) }}"
      MODE: json-rpc
      # API token auth (KOPS-002 / HD-125): require an X-Api-Key header so no container on
      # services-internal can send Signal messages as Domen's number without the token.
      # n8n sends the token in its webhook call. Token from `signal-internal_api` (SSOT).
      SIGNAL_CLI_API_TOKEN: "{{ vault['signal-internal_api'].credential }}"
    networks:
      - services-internal
    volumes:
      - signal-cli-data:/home/.local/share/signal-cli      # identity persists across restarts
    # No host ports: n8n reaches this on services-internal via signal-cli-rest-api:8080
    # over the Docker overlay — a host binding would expose the unauthenticated REST API
    # on the host net (KOPS-002 / HD-62).
volumes:
  signal-cli-data:
networks:
  services-internal:
    external: true
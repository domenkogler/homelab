# element-web docker-compose.yml — Matrix web client (chat.kogler.si)
#   Talks to the homeserver via Matrix-native SSO -> Authentik OIDC. NO Traefik
#   Forward-Auth here (avoids a double login: Authentik then Matrix — docs/services-matrix.md).
#   config.json points clients at the homeserver matrix.kogler.si. No secrets needed.
#   Static frontend — served by Traefik on port 80.
services:
  chat:
    # vectorim/element-web moved to element-hq (old org DENIED, probe 2026-08-21)
    image: ghcr.io/element-hq/element-web:{{ element_web_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
      # Wave-2 triage 2026-08-22: the nginx entrypoint envsubsts
      # /etc/nginx/templates/default.conf.template -> /etc/nginx/conf.d/default.conf at EVERY
      # start; with only /tmp tmpfs it died EROFS before nginx launched. /var/cache/nginx +
      # /var/run are the standard read-only-nginx pair (request-body temp + pid).
      - /etc/nginx/conf.d
      - /var/cache/nginx
      - /var/run
    container_name: chat
    restart: unless-stopped
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    networks:
      - traefik-public
    volumes:
      - ./config.json:/app/config.json:ro
    labels:
      traefik.enable: "true"
      traefik.http.routers.chat.rule: "Host(`chat.kogler.si`)"
      traefik.http.routers.chat.entrypoints: websecure
      traefik.http.routers.chat.middlewares: crowdsec-only@file   # CrowdSec block-list; Matrix-native SSO, no Forward-Auth (KOPS-025/054 / HD-120)
      {{ 'traefik.http.routers.chat.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # Intentional: NO authentik-forward-auth — Matrix-native SSO (docs/services-matrix.md).
      traefik.http.services.chat.loadbalancer.server.port: "80"
networks:
  traefik-public:
    external: true

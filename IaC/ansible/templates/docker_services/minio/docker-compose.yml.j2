# minio docker-compose.yml — S3-compatible object store (HD-131 D1)
#   Backs Immich originals (S3 object storage). Local MinIO = the S3-from-day-one path:
#   later move to Hetzner Storage Box / cloud S3 is an endpoint + credential change.
#   Runs on oldsrv (compute host); data lands on NAS-backed storage.
#
#   Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#     minio_login   (Login: username=<minio root user>, password=<minio root password>)
services:
  minio:
    image: minio/minio:{{ minio_version | default('latest') }}
    container_name: minio
    restart: unless-stopped
    # Overlay-network access only (services-internal): Immich reaches http://minio:9000 by
    # Docker DNS name — no host ports (CONVENTIONS §3 / HD-62 host-port hygiene). The S3 API
    # + console :9001 are reached via SSH/cockpit or an admin tunnel if needed.
    command: server /data --console-address ":9001"
    cap_drop: [ALL]
    networks:
      - services-internal
    volumes:
      - /srv/docker/minio/data:/data            # S3 objects; on oldsrv (NAS-backed or local NVMe)
    environment:
      MINIO_ROOT_USER: "{{ lookup('community.general.onepassword', 'minio_login', field='username', vault=op_vault) }}"
      MINIO_ROOT_PASSWORD: "{{ lookup('community.general.onepassword', 'minio_login', field='password', vault=op_vault) }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    # No Traefik labels: MinIO is an internal S3 store, reached by Immich over the
    # services-internal overlay — not exposed on the public Traefik edge (HD-131 D1).

networks:
  services-internal:
    external: true
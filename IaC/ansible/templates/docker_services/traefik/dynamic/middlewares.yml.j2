# traefik — file-provider middlewares (deployed as /opt/traefik/dynamic/middlewares.yml)
#
# Middleware chain for public services:
#   1. CrowdSec bouncer plugin — queries CrowdSec LAPI, blocks malicious IPs
#   2. Authentik Forward-Auth — delegates auth to the SSO provider
#
# Services that can use Forward-Auth reference the chain:
#   traefik.http.routers.<svc>.middlewares: authentik-forward-auth@file
#
# Self-auth'd services (own login / Matrix-native SSO / Companion flow that breaks
# with Forward-Auth) instead use the CrowdSec-only middleware, so they still get
# IP-level blocklist protection without the auth-proxy (KOPS-004/018/025/047/054,
# HD-60/118/119/120):
#   traefik.http.routers.<svc>.middlewares: crowdsec-only@file
#   (ha, jellyfin, matrix, seerr, chat, ha-standby, sso (HD-194), cockpit routes
#   (HD-188) — docs/services-traefik.md §Middleware)
# See services-traefik.md §Middleware Chain.

http:
  middlewares:
    # Chain: CrowdSec → Authentik. Services reference this by name.
    # No service template changes needed — the middleware name stayed the same.
    authentik-forward-auth:
      chain:
        middlewares:
          - crowdsec-bouncer
          - authentik-forward-auth-inner

    # CrowdSec-only: for routes that must NOT use Forward-Auth (own login / Matrix SSO /
    # Companion flow) but still need CrowdSec blocklist protection (HD-60/118/119/120).
    crowdsec-only:
      chain:
        middlewares:
          - crowdsec-bouncer

    # ONLYOFFICE CSP upgrade (HD-166 layer-6): DS builds browser-facing cache URLs
    # (Editor.bin etc.) with an http:// scheme behind our TLS edge (upstream issue
    # ONLYOFFICE/DocumentServer#2186 class) -> mixed content -> browser blocks the
    # fetch -> "Download failed" + empty document. This response header tells the
    # BROWSER to upgrade every http:// request from the office.kogler.si pages to
    # https:// transparently - no DS-internals patch needed.
    onlyoffice-csp:
      headers:
        contentSecurityPolicy: "upgrade-insecure-requests"

    # CrowdSec bouncer plugin — checks the client IP against CrowdSec's
    # blocklist (LAPI). Registered in traefik's static config via
    # --experimental.plugins.crowdsec-bouncer.* (v1.7.1 requires the LAPI key - Wave-3 R5).
    crowdsec-bouncer:
      plugin:
        crowdsec-bouncer:
          lapi_url: http://crowdsec:8080
          crowdsecLapiKey: >-
            {{ vault['crowdsec-bouncer_api'].credential }}
          update_interval: 10s

    # Authentik Forward-Auth — validates the user session, redirects to
    # sso.kogler.si if not authenticated. Passes user info as headers.
    # HD-240 (2026-08-25): authResponseHeaders MUST be the LIST of header names
    # (Traefik schema). The previous map form ("X-authentik-email: email") decoded to
    # NOTHING — traefik silently dropped the field, so identity headers never reached
    # header-consuming backends (grafana [auth.proxy] saw anonymous requests → bare
    # /login for every SSO user). Wire/decode-proven via a throwaway traefik config dump.
    authentik-forward-auth-inner:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
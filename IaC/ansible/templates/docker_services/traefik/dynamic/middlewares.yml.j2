# traefik — file-provider middlewares (deployed as /opt/traefik/dynamic/middlewares.yml)
#
# Vault-escape note: this file is consumed by Traefik's file-provider, NOT by `docker compose`
# interpolation, so `vault['<item>']` values pass through unchanged — compose's `$`-substitution
# applies only to compose YAML. Raw `vault['crowdsec-bouncer_api'].credential` here is safe and
# needs no `| replace('$','$$')`. Literal braces must stay out of these comments: an opening
# Jinja brace pair would render (or crash) even inside a `#` comment.
# Middleware chain for public services:
#   1. CrowdSec bouncer plugin — queries CrowdSec LAPI, blocks malicious IPs
#   2. Authentik Forward-Auth — delegates auth to the SSO provider
#
# Services that can use Forward-Auth reference the chain:
#   traefik.http.routers.<svc>.middlewares: authentik-forward-auth@file
#
# Self-auth'd services (own login / Matrix-native SSO / a Companion flow that breaks with
# Forward-Auth) instead use the CrowdSec-only middleware: IP-level blocklist protection
# without the auth-proxy:
#   traefik.http.routers.<svc>.middlewares: crowdsec-only@file
#   (ha, jellyfin, matrix, seerr, chat, ha-standby, sso, cockpit routes —
#   docs/services-traefik.md §Middleware Chain)
# See services-traefik.md §Middleware Chain.

http:
  middlewares:
    # Chain: CrowdSec -> Authentik. Services reference this by name.
    authentik-forward-auth:
      chain:
        middlewares:
          - crowdsec-bouncer
          - authentik-forward-auth-inner

    # CrowdSec-only: for routes that must NOT use Forward-Auth (own login / Matrix SSO /
    # Companion flow) but still need CrowdSec blocklist protection.
    crowdsec-only:
      chain:
        middlewares:
          - crowdsec-bouncer

    # The :80 -> :443 redirect middleware is declared HERE because the router that uses it
    # lives in routes.yml.j2: naming a middleware this edge never declared makes Traefik log
    # `middleware "redirect-to-https@file" does not exist` and serve nothing, silently. That
    # router uses the v3-valid `HostRegexp(`.+`)` rule — the v2 `{host:.+}` template form
    # parses, reports itself enabled, and matches nothing.
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true

    # ONLYOFFICE CSP upgrade: DS builds browser-facing cache URLs (Editor.bin etc., upstream
    # ONLYOFFICE/DocumentServer#2186 class) with an http:// scheme behind our TLS edge -> mixed
    # content -> the browser blocks the fetch -> "Download failed" + an empty document. This
    # response header tells the BROWSER to upgrade every http:// request from the
    # office.kogler.si pages to https:// — no patch inside DS is needed.
    onlyoffice-csp:
      headers:
        contentSecurityPolicy: "upgrade-insecure-requests"

    # CrowdSec bouncer plugin — checks the client IP against CrowdSec's blocklist (LAPI).
    # Registered in traefik's static config via --experimental.plugins.crowdsec-bouncer.*;
    # plugin v1.7.1 requires the LAPI key.
    crowdsec-bouncer:
      plugin:
        crowdsec-bouncer:
          lapi_url: http://crowdsec:8080
          crowdsecLapiKey: >-
            {{ vault['crowdsec-bouncer_api'].credential }}
          update_interval: 10s

    # Authentik Forward-Auth — validates the user session, redirects to
    # sso.kogler.si if not authenticated. Passes user info as headers.
    # Authentik Forward-Auth — validates the user session, redirects to sso.kogler.si if not
    # authenticated, and passes user info as headers. authResponseHeaders MUST be the LIST of
    # header names (Traefik's schema): the map form decodes to NOTHING, Traefik drops the field
    # silently, and header-consuming backends see anonymous requests (Grafana [auth.proxy] then
    # sends every SSO user to a bare /login).
    authentik-forward-auth-inner:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
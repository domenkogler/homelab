# opencloud csp.yaml — Content-Security-Policy for the OpenCloud web UI
#
# Consumed via env PROXY_CSP_CONFIG_FILE_LOCATION — the plain CSP_CONFIG_FILE name is
# unknown to this build, so the proxy silently serves the STOCK CSP and blocks the
# oidc-client-ts discovery fetches to sso.kogler.si in the browser.
#
# SCHEMA: the parser expects ALL directives nested under a top-level
# `directives:` key — a flat map parses but is silently ignored.
#
# BASELINE = stock OpenCloud directives, read from the served stock header,
# EXTENDED with: sso.kogler.si (OIDC discovery/userinfo/token fetches from the browser +
# hosted login iframe) and office.kogler.si (ONLYOFFICE editor iframe + WOPI).
# When bumping OpenCloud versions, re-diff against the freshly served stock header.
#
# 'self' = https://file.kogler.si
directives:
  default-src:
    - "'none'"                               # stock: strict deny-all, everything explicit below
  child-src:
    - "'self'"
  connect-src:
    - "'self'"
    - "blob:"
    - "https://raw.githubusercontent.com/opencloud-eu/awesome-apps/"
    - "https://update.opencloud.eu/"
    - "https://sso.kogler.si"                # OIDC discovery/userinfo/token from browser JS
    - "https://office.kogler.si"             # WOPI/API calls to ONLYOFFICE
    - "wss:"
  font-src:
    - "'self'"
    - "data:"
  frame-ancestors:
    - "'self'"
  frame-src:
    - "'self'"
    - "blob:"
    - "https://embed.diagrams.net/"
    - "https://sso.kogler.si"                # Authentik hosted login (if shown in an iframe)
    - "https://office.kogler.si"             # ONLYOFFICE editor iframe
  img-src:
    - "'self'"
    - "data:"
    - "blob:"
    - "https://raw.githubusercontent.com/opencloud-eu/awesome-apps/"
    - "https://sso.kogler.si"
  manifest-src:
    - "'self'"
  media-src:
    - "'self'"
  object-src:
    - "'self'"
    - "blob:"
  script-src:
    - "'self'"
    - "'unsafe-inline'"
  style-src:
    - "'self'"
    - "'unsafe-inline'"

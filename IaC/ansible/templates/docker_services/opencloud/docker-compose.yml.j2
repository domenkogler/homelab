# opencloud docker-compose.yml — File sync & share (file.kogler.si)
#   Go-based, lighter than Nextcloud. Embedded database (no external Postgres).
#   Files stored in /srv/docker/opencloud/data.
#
#   On first start: opencloud init generates config + admin user; admin logs in
#   via INITIAL_ADMIN_PASSWORD at https://file.kogler.si.
#   OIDC via Authentik (HD-52/HD-144): native OIDC for BOTH web UI AND the desktop
#   client. Provider declared in the Authentik Blueprint (ks-oidc.yml, HD-142); client sets
#   seeded into `opencloud_oidc` by the secret-egress glue (HD-143). csp.yaml (this dir)
#   adds https://sso.kogler.si to connect-src/frame-src. Native OIDC replaces Traefik
#   Forward-Auth on this route so the desktop client's OAuth/WebDAV isn't blocked.
#
#   Config files (csp.yaml, apps.yaml, banned-password-list.txt) sourced from
#   https://github.com/opencloud-eu/opencloud-compose — override by placing
#   custom files in /srv/docker/opencloud/config/.
#
#   Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault):
#     opencloud_login   (Login: password=<admin password>)
#     opencloud_db      (Database — reserved for future Postgres migration)
services:
  opencloud:
    image: opencloudeu/opencloud-rolling:{{ opencloud_version | default('7.4.0') }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: opencloud
    restart: unless-stopped
    user: "{{ storage_uid }}:{{ storage_gid }}"
    networks:
      - traefik-public
    entrypoint: ["/bin/sh"]
    command: ["-c", "opencloud init || true; exec opencloud server"]
    volumes:
      - /srv/docker/opencloud/data:/var/lib/opencloud
      - /srv/docker/opencloud/config:/etc/opencloud:ro
    environment:
      # Domain
      OC_DOMAIN: file.kogler.si
      OC_URL: "https://file.kogler.si"
      # Edge-terminated TLS (HD-126 / KOPS-006): Traefik terminates TLS at the edge, so
      # OpenCloud serves plain HTTP on traefik-public port 9200 for the proxy. `OC_INSECURE:
      # true` is CORRECT here — forcing OC_INSECURE:false would make OpenCloud serve its own
      # HTTPS and break the Traefik backend (which expects HTTP on 9200). The plaintext is
      # confined to the isolated traefik-public Docker network (no Home/Mgmt VLAN exposure);
      # CrowdSec reduces the blast radius. Internal mTLS deliberately NOT adopted (no real
      # gain vs edge TLS + network isolation for a single trusted host) — see deployment-compose.md.
      OC_INSECURE: "true"
      PROXY_HTTP_ADDR: 0.0.0.0:9200
      PROXY_TLS: "false"
      # Admin
      IDM_ADMIN_PASSWORD: "{{ lookup('community.general.onepassword', 'opencloud_login', field='password', vault=op_vault) }}"
      IDM_CREATE_DEMO_USERS: "false"
      # Logging
      OC_LOG_LEVEL: "{{ opencloud_log_level | default('info') }}"
      OC_LOG_COLOR: "false"
      OC_LOG_PRETTY: "false"
      # Sharing
      OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD: "true"
      OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD: "false"
      # Language
      OC_DEFAULT_LANGUAGE: sl
      OC_PASSWORD_POLICY_DISABLED: "true"
      FRONTEND_CHECK_FOR_UPDATES: "false"
      # === OIDC via Authentik (HD-52/HD-144) — native OIDC for web + desktop AppImage ===
      # + mobile. Provider declared in the Authentik Blueprint (ks-oidc.yml, HD-142); client
      # creds seeded into `opencloud_oidc` by the secret-egress glue (HD-143). Keeping this
      # behind Forward-Auth blocks the desktop client's OAuth/WebDAV, so native OIDC is used.
      OC_EXCLUDE_RUN_SERVICES: "idm"
      OC_OIDC_ISSUER: "https://sso.kogler.si/application/o/opencloud/"
      PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD: "jwt"
      PROXY_OIDC_REWRITE_WELLKNOWN: "true"
      PROXY_USER_OIDC_CLAIM: preferred_username
      PROXY_USER_CS3_CLAIM: username
      # === ONLYOFFICE / WOPI collaboration (HD-166) — in-browser doc editor ===
      # OpenCloud's native `collaboration` service speaks WOPI to ONLYOFFICE Docs at
      # office.kogler.si. ONLYOFFICE is NOT an auth surface: it never sees family logins.
      # OpenCloud <-> ONLYOFFICE trust via a shared JWT secret (COLLABORATION_JWT_SECRET,
      # aliased from OC_JWT_SECRET) — 1Password lookup, never a literal (HD-65).
      # Real OpenCloud 4.0 vars (verified against docs.opencloud.eu 4.0 dev collaboration
      # env-vars page, 2026-08-19): COLLABORATION_APP_NAME/PRODUCT/ADDR/WOPI_SRC/JWT_SECRET.
      # NO `WOPI_ENABLED` / `COLLABORATION_ENABLED` booleans exist — the service is
      # registered via OC_ADD_RUN_SERVICES=collaboration (mirrors OC_EXCLUDE_RUN_SERVICES
      # pattern already used below) and activates on APP_* config.
      OC_ADD_RUN_SERVICES: "collaboration"
      COLLABORATION_APP_NAME: "OnlyOffice"
      COLLABORATION_APP_PRODUCT: "OnlyOffice"
      COLLABORATION_APP_ADDR: "https://office.kogler.si"
      COLLABORATION_APP_INSECURE: "false"
      COLLABORATION_APP_PROOF_DISABLE: "false"       # verify OnlyOffice proof keys
      COLLABORATION_JWT_SECRET: "{{ lookup('community.general.onepassword', 'opencloud-collab_password', field='password', vault=op_vault) }}"
      # WOPI callback + live-typing sync store (default nats-js-kv; node addr via
      # OC_CACHE_STORE_NODES per docs — not COLLABORATION_STORE_NODES)
      COLLABORATION_WOPI_SRC: "https://file.kogler.si"
      COLLABORATION_STORE: "nats-js-kv"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.opencloud.rule: "Host(`file.kogler.si`)"
      traefik.http.routers.opencloud.entrypoints: websecure
      {{ 'traefik.http.routers.opencloud.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      # HD-52/HD-144: native OIDC enabled (desktop client needs it). NOT behind Forward-Auth —
      # replacing `authentik-forward-auth@file` with `crowdsec-only@file` so the desktop/mobile
      # OAuth/WebDAV isn't blocked by a browser-redirect SSO layer, while keeping WAF protection.
      traefik.http.routers.opencloud.middlewares: crowdsec-only@file
      traefik.http.services.opencloud.loadbalancer.server.port: "9200"
networks:
  traefik-public:
    external: true

# immich-ml docker-compose.yml — Face recognition & smart search (Immich ML)
#   GPU-accelerated (shares AMD RX 7600 VRAM with ollama). Connects to
#   immich-server on services-internal. No web UI — no Traefik labels.
#   Model weights in /srv/models/immich-ml (local NVMe, no backup).
#   HD-184: :3003 is ALSO published bound to oldsrv's Home IP so immich-app (VPS)
#   can reach it cross-host over the WG S2S tunnel — firewall-scoped by the WG
#   AllowedIPs + RouterOS forward ACL (HD-155), never 0.0.0.0.
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   immich-ml-internal_api (api -> credential) — ML API-key auth (HD-160): immich-app sends
#   this key as the ML-auth header so only the immich server can drive ML inference.
services:
  immich-ml:
    image: ghcr.io/immich-app/immich-machine-learning:{{ immich_version }}
    container_name: immich-ml
    restart: unless-stopped
    networks:
      - services-internal
    ports:
      # Cross-host ML for immich-app on the VPS (HD-184): bound to oldsrv's Home
      # IP (SSOT-derived `immich_ml_bind`), not 0.0.0.0 — reach is scoped by the
      # WG AllowedIPs + RouterOS ACL; inside the overlay it stays immich-ml:3003.
      - "{{ immich_ml_bind }}:3003:3003"
    devices:
      - /dev/dri:/dev/dri
      - /dev/kfd:/dev/kfd
    group_add:
      - "{{ gpu_render_gid }}"
      - "{{ gpu_video_gid }}"
    volumes:
      - /srv/models/immich-ml:/cache               # model weights (regenerable, not backed up)
      - /srv/docker/immich/upload:/data:ro                # read thumbs for ML processing
    environment:
      IMMICH_PORT: "3003"
      IMMICH_HOST: "0.0.0.0"
      # HD-160: require the shared ML API key from immich-app (fail-loud lookup).
      IMMICH_API_KEY: "{{ vault['immich-ml-internal_api'].credential | replace('$','$$') }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
networks:
  services-internal:
    external: true
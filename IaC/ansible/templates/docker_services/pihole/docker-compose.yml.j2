# pihole docker-compose.yml — DNS ad-blocker (ad.kogler.si)
#   Forward-Auth. Runs alongside Technitium — pihole uses it as upstream DNS.
#   Ad lists block tracking/ads at the DNS level. Web UI on port 80.
#   NOTE: Port 53 may conflict with Technitium on the same host; adjust
#   PIHOLE_DNS_ to point at technitium:53 on services-internal.
#
# Secrets via {{ lookup('community.general.onepassword', '<name>', vault=op_vault) }}:
#   pihole_password (Password: WEBPASSWORD for admin UI)
services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    # Port 5353 instead of 53 — Technitium uses 53 on this host.
    # Pi-hole upstream points at technitium:53 on services-internal.
    ports:
      - "5353:53/udp"
      - "5353:53/tcp"
    volumes:
      - /srv/docker/pihole/etc:/etc/pihole
      - /srv/docker/pihole/dnsmasq:/etc/dnsmasq.d
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      WEBPASSWORD: "{{ lookup('community.general.onepassword', 'pihole_password', field='password', vault=op_vault) | default('') }}"
      PIHOLE_DNS_: "technitium:53"
      DNSSEC: "true"
      CONDITIONAL_FORWARDING: "true"
      CONDITIONAL_FORWARDING_IP: "{{ ha_vip }}"
      CONDITIONAL_FORWARDING_DOMAIN: "kogler.si"
      REV_SERVER: "true"
      REV_SERVER_CIDR: "10.10.0.0/16"
    labels:
      traefik.enable: "true"
      traefik.http.routers.pihole.rule: "Host(`ad.kogler.si`)"
      traefik.http.routers.pihole.entrypoints: websecure
      traefik.http.routers.pihole.tls.certresolver: letsencrypt
      traefik.http.routers.pihole.middlewares: authentik-forward-auth@file
      traefik.http.services.pihole.loadbalancer.server.port: "80"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true
# lidarr docker-compose.yml — Music (lidarr.kogler.si)
#   TRaSH hardlink import: /mnt/nas/media/downloads/complete/music → /mnt/nas/media/media/music.
#   Forward-Auth. linuxserver image, PUID/PGID={{ storage_uid }}:{{ storage_gid }} (shared `media` owner).
#
# Secrets via 1Password lookup at render: onepassword('<name>', field=..., vault=op_vault)
#   — none needed
services:
  lidarr:
    image: linuxserver/lidarr:{{ lidarr_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    container_name: lidarr
    restart: unless-stopped
    networks:
      - traefik-public
      - services-internal
    volumes:
      - /srv/docker/lidarr/config:/config
      - /mnt/nas/media/media:/media              # rw — creates music/ folder, hardlink import
      - /mnt/nas/media/downloads:/downloads       # rw — downloads/complete/music
    environment:
      PUID: "{{ storage_uid }}"
      PGID: "{{ storage_gid }}"
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.lidarr.rule: "Host(`lidarr.kogler.si`)"
      traefik.http.routers.lidarr.entrypoints: websecure
      {{ 'traefik.http.routers.lidarr.tls.certresolver: letsencrypt' if (traefik_acme_issuer | default(false)) else '# consumer mode: TLS from the synced cert pair (HD-181/HD-204)' }}
      traefik.http.routers.lidarr.middlewares: authentik-forward-auth@file
      traefik.http.services.lidarr.loadbalancer.server.port: "8686"
networks:
  traefik-public:
    external: true
  services-internal:
    external: true

# dsh docker-compose.yml — DeepSeek Harness (DSH) — the "DSH" half of the dual AI
#   harness (HD-268c). DevOps/IaC coding cascade in a container; the other half is
#   pi-dev (pi coding agent). docs/services-ai.md §2/§3, docs/services.md.
#   Decided 2026-08-27 (HD-268c + HD-250): use `runzhliu/deepseek-harness`,
#   the community Docker-Hub image published from the runzhliu/deepseek-harness-docker
#   source repo, packaging the official `@deepseek/dsh` (no source mod, non-root,
#   version-tagged — deliberately NOT `latest`). research live-verified 2026-08-26,
#   repo verified 2026-08-27 (Docker Hub `runzhliu/deepseek-harness` tags: 0.1.1-rc.2).
#
#   ⚠️ SECURITY (HD-250 + the received DSH caveats): DSH is an UNSANDBOXED,
#   bare-filesystem agent framework in minimal mode. It can "escape" the intended
#   project dir and read/modify adjacent host files if given too much access. Therefore:
#     • mount ONLY the dedicated /srv/docker/dsh/workspace sandbox — NEVER /home, /root,
#       or any host source tree;
#     • set the DSH permission tier to Workspace or Read-Only in the UI during first
#       setup; avoid "Full Access" until the agent is fully trusted.
#
#   UI exposure (HD-355, 2026-09-10): dsh MOVED to oldsrv (dev-AI tier); the
#   tailscale sidecar is REMOVED (decided 2026-09-10 — tailnet = mobile-only via the
#   VPS edge, never direct LAN reach; docs/services-ai.md §2). DSH's Web UI binds
#   127.0.0.1 ONLY (DeepSeek.app rejects `--host 0.0.0.0`), so the clean-vs-host-publish
#   choice is: bind the UI to 0.0.0.0 INSIDE the container (DeepSeek ships the flag;
#   the 2026-08-27 research doc for the sidecar pre-dates a working containerized
#   0.0.0.0-bind) and publish `{{ oldsrv_home_ip }}:3080:3080` on the HOST (the
#   media-bridge pattern — precedent: immich-ml `{{ oldsrv_home_ip }}:3003`, verified
#   2026-09-08). The VPS `traefik-tailnet` edge then reaches it over the WG S2S
#   (wg_s2s_vps allowed_ips already carries oldsrv /32) and serves the clean URLs
#   `dsh.kogler.si`/`dsh.ts.kogler.si` (still Authentik Forward-Auth on the edge, not
#   public). HD-250 remains: no public Traefik label route on this compose; the app's
#   `services-internal` membership is for LiteLLM + Forgejo app-to-app legs only.
#
#   Secrets (fail-closed, HD-65 — all via 1Password vault refs, never literals):
#     dsh_api (api -> credential) — scoped LiteLLM virtual key for DSH's model backend
#       (HD-247; minted by the litellm bootstrap glue). NOT the LiteLLM master key.
#       DSH supports any OpenAI-compatible provider — it points at LiteLLM :4000/v1.
#     dsh_forgejo_api (api -> credential) — Forgejo service-account token, PR-ONLY,
#       NO merge rights, on the homelab repo only. Proposals via PR; never push/merge.
#   Image: runzhliu/deepseek-harness, tag pinned via dsh_version.
#     TODO(deploy): verify this exact tag + capture the image DIGEST at first live
#     converge (no docker here) and replace `dsh_version` with the digest pin.
services:
  dsh:
    image: runzhliu/deepseek-harness:{{ dsh_version }}
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    # Chromium (browser-desktop plugin) needs /dev/shm for renderer processes —
    # mirrors the runtime setting from the upstream runzhliu/deepseek-harness
    # compose (docker-antigravity-derived); without it Chromium segfaults in the
    # noVNC desktop. Real working directory is /workspace (HOME=/workspace).
    shm_size: 1gb
    container_name: dsh
    restart: unless-stopped
    # DSH Web UI: bind 0.0.0.0 INSIDE the container + publish on the HOST's Home-VLAN
    # IP (HD-355, media-bridge pattern; reachable from the VPS edge over WG S2S).
    ports:
      - "{{ oldsrv_home_ip }}:3080:3080"        # HD-355 — oldsrv Home-IP publish (never 0.0.0.0/127.0.0.1)
    networks:
      - services-internal       # LiteLLM (models) + Forgejo (PR proposals)
    environment:
      TZ: "{{ timezone | default('Europe/Ljubljana') }}"
      # Model backend = LiteLLM (the spine). DSH connects as an OpenAI-compatible
      # provider to LiteLLM; credential = scoped virtual key from the HD-247 glue.
      # Folded scalar (HD-233): 1P-sourced values can carry YAML-hostile chars.
      OPENAI_BASE_URL: "http://litellm:4000/v1"
      OPENAI_API_KEY: >-
        {{ vault['dsh_api'].credential | replace('$','$$') }}
      # Bind the Web UI inside the container (HD-355); the HOST publish is
      # {{ oldsrv_home_ip }}:3080 only — never 0.0.0.0 on the host.
      DSH_WEB_HOST: "0.0.0.0"
      DSH_WEB_PORT: "3080"
      # Forgejo PR-only git identity (HD-268c). No literals.
      FORGEJO_PR_TOKEN: >-
        {{ vault['dsh_forgejo_api'].credential | replace('$','$$') }}
    volumes:
      # Isolated DSH sandbox ONLY — never host dirs (DSH escape warning; HD-268c).
      - /srv/docker/dsh/workspace:/workspace
      # DSH profile home (DSH_HOME=/home/node/.dsh). read_only:true root means this
      # MUST be a writable mount or DSH crash-loops (ENOENT mkdir /home/node/.dsh/profiles).
      # Named volume (rebuildable-cache class, Kopia scope) — matches upstream compose.
      # chrome-profile (browser-desktop) + node_modules live here too.
      - dsh-home:/home/node/.dsh

networks:
  services-internal:
    external: true

volumes:
  dsh-home:
# homelable nginx.conf — frontend reverse proxy for the host-net backend (HD-45)
#   Rendered into /opt/homelable/nginx.conf by the docker_services extra-template step
#   (bind-mounted into the homelable-frontend container at /etc/nginx/conf.d/default.conf).
#   This is the upstream docker/nginx.conf translation for a host-net backend
#   (INSTALLATION.md "Your own reverse proxy") with the Home-VLAN narrow-bind applied:
#     - listen on OLDSRV's Home-VLAN IP :3000 ONLY (never 0.0.0.0)
#     - proxy /api (incl. the v1 status WebSocket) to the loopback backend :8000
#   The SPA is served from the image's /usr/share/nginx/html at the root.
server {
    listen {{ oldsrv_home_ip }}:3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20M;

    # WebSocket — must come before /api/ to take priority (upstream ordering)
    location /api/v1/status/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Legacy /ws/ path
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

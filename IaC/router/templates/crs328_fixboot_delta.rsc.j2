{#- CRS328 switch fixboot delta — boot resilience (fixboot) without a full
    converge: the switch converge's bridge/user adds are not idempotent, so a
    re-import aborts before the syslog/SNMP blocks land. Adds the centralsyslog
    action (RB4011/switch/AP -> VictoriaLogs), the single fixboot startup
    script+scheduler re-asserting syslog + SNMP after boot, and removes
    fixsyslog/fixsnmp if present. Idempotent — safe to re-import.
    Render: render-converge.yml; apply: routeros-apply-delta.sh 10.10.99.2
    crs328_fixboot_delta.rsc. -#}
# =============================================================================
# CRS328 — Kogler Homelab — fixboot consolidation delta
# Source template: Iac/router/templates/crs328_fixboot_delta.rsc.j2
# =============================================================================

# ---- Remote syslog to the VPS: centralsyslog action (config) ----
:if ([/system logging action find where name=centralsyslog] = "") do={
    /system logging action add name=centralsyslog target=remote remote={{ wireguard_s2s_vps.remote_ip.split('/')[0] }} remote-port=514
} else={
    /system logging action set [find where name=centralsyslog] target=remote remote={{ wireguard_s2s_vps.remote_ip.split('/')[0] }} remote-port=514
}

# ---- Logging rules: ship error/firewall/critical/warning to the VPS (mirror router) ----
/system logging remove [find where action=centralsyslog]
/system logging add topics=error action=centralsyslog
/system logging add topics=firewall action=centralsyslog
/system logging add topics=critical action=centralsyslog
/system logging add topics=warning action=centralsyslog

# ---- Boot resilience (fixboot): re-assert syslog + SNMP after boot ----
:if ([/system script find where name=fixboot] = "") do={
    /system script add name=fixboot source=":delay 10s; /system logging action set [find where name=centralsyslog] remote=0.0.0.0; :delay 1s; /system logging action set [find where name=centralsyslog] remote={{ wireguard_s2s_vps.remote_ip.split('/')[0] }}; /snmp set enabled=yes; /snmp community set [find where name={{ snmp_ro_community }}] addresses={{ mgmt.subnet }} read-access=yes write-access=no;"
}
:if ([/system scheduler find where name=fixboot] = "") do={
    /system scheduler add name=fixboot on-event=fixboot start-time=startup interval=0 policy=read,write,test
}

# ---- Cleanup: fixsyslog/fixsnmp split (folded into fixboot) ----
:if ([/system script find where name=fixsyslog] != "") do={
    /system script remove [find where name=fixsyslog]
}
:if ([/system scheduler find where name=fixsyslog] != "") do={
    /system scheduler remove [find where name=fixsyslog]
}
:if ([/system script find where name=fixsnmp] != "") do={
    /system script remove [find where name=fixsnmp]
}
:if ([/system scheduler find where name=fixsnmp] != "") do={
    /system scheduler remove [find where name=fixsnmp]
}

# =============================================================================
# Verify: /system script print, /system scheduler print, /system logging action print
# =============================================================================
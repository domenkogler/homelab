{#- Universal AP bootstrap template — rendered by render-routeros.yml.
    ONE script for all APs: they DHCP off the router and get their static-reserved
    Management IP (10.10.99.x) from a router static DHCP lease (added by the
    Ansible `router` role). Secrets from 1Password at render time. -#}
# =============================================================================
# hAP / wAP — Kogler Homelab — Bootstrap (RENDERED — do not edit, regenerate)
# Source template: IaC/router/templates/ap_initial.rsc.j2   (UNIVERSAL — all APs)
# =============================================================================
# Purpose: Universal bootstrap for every hAP/wAP AP. The AP is placed on a
#          Management (VLAN {{ mgmt.id }}) access port on the CRS328 and gets its
#          static-reserved IP via DHCP from the router — no static IP here.
# How:     Upload this + flash/admin.pub + flash/ansible.pub to the AP Files
#          (the .pub files MUST live in the `flash/` folder — files in the device
#          ROOT are wiped on reboot on the APs; the router boots off flash and is
#          immune), then:
#            /system reset-configuration no-defaults=yes run-after-reset=ap_initial.rsc
# NOTE:    NO secrets in the repo — credentials injected from 1Password.
# =============================================================================

# Static DHCP reservations the Ansible `router` role adds (AP MAC -> Management IP),
# sourced from group_vars/all.yml (SSOT):
{% for ap in network_static_hosts if ap.name.startswith('ap-') and ap.vlan == mgmt.id %}
#   {{ ap.name }}  {{ ap.mac | default('TBD') }}  -> {{ ap.ip }}
{% endfor %}

# ---- System ----

/system identity set name={{ ap_identity }}
/system clock set time-zone-name={{ timezone }}

# ---- Users (bootstrap auth) ----
# admin = password + SSH key. ansible = key-only (automation).

/user set [find name=admin] password={{ mikrotik_admin_password }} comment="human admin"
/user ssh-keys import public-key-file=flash/admin.pub user=admin

# RouterOS 7: /user add REQUIRES password= (see rb4011_initial.rsc.j2 for full rationale).
/user add name=ansible group=full disabled=no password="" comment="Ansible automation (SSH-key auth, key-only)"
/user ssh-keys import public-key-file=flash/ansible.pub user=ansible

# ---- Bridge (all ports) ----

/interface bridge add name=bridge protocol-mode=none
/interface bridge port add bridge=bridge interface=ether1
/interface bridge port add bridge=bridge interface=ether2
/interface bridge port add bridge=bridge interface=ether3
/interface bridge port add bridge=bridge interface=ether4
/interface bridge port add bridge=bridge interface=ether5
/interface bridge port add bridge=bridge interface=wifi1
/interface bridge port add bridge=bridge interface=wifi2

# ---- Management IP via DHCP (static reservation from the router) ----

/ip dhcp-client add interface=bridge disabled=no comment="Mgmt IP via router DHCP (static reservation: VLAN {{ mgmt.id }})"

# ---- CAP Mode (SSIDs provisioned by the router CAPsMAN — MODERN wifi-qcom-ac, HD-232/task 8) ----

# TODO validate-live (cutover-prep, HD-229): confirm the wifi-qcom-ac cap field set on the live
# AP against the manager (legacy `wireless cap` is gone). The AP radio interfaces on
# RouterOS 7 are named `wifi1`/`wifi2` (modern wifi-qcom-ac package) — the bridge ports
# above use those names; verify /interface/wifi cap print after import for the
# discovery-interfaces only (no radio list needed — CAP discovery covers them).
/interface wifi cap set \
    enabled=yes \
    discovery-interfaces=bridge

# ---- Services ----
# HD-193 + HD-301: scope every management service to the mgmt subnet from FIRST BOOT
# (B4 binding floor). RouterOS 7 syntax: `available-from=` (NOT `interface=` —
# rejected with "bad parameter interface" on ROS7, live-validated 2026-08-31).
# AP is L2-only (no WAN egress, HD-165) so the surface is small, but we still
# disable the dangerous services defensively.

/ip service set telnet disabled=yes port=23 available-from={{ mgmt.subnet }}
/ip service set ftp disabled=yes port=21 available-from={{ mgmt.subnet }}
/ip service set www disabled=yes port=80 available-from={{ mgmt.subnet }}
/ip service set api-ssl disabled=yes port=8729 available-from={{ mgmt.subnet }} certificate=none
/ip service set reverse-proxy disabled=yes port=443 available-from={{ mgmt.subnet }} certificate=none
/ip service set api disabled=no port=8728 available-from={{ mgmt.subnet }}
/ip service set www-ssl disabled=no port=443 available-from={{ mgmt.subnet }} certificate=none
/ip service set ssh disabled=no port=22 available-from={{ mgmt.subnet }}
/ip service set winbox disabled=no port=8291 available-from={{ mgmt.subnet }}

# ---- End ----
# After import, verify on the router: /ip dhcp-server lease print
# (AP should show its static-reserved 10.10.99.x). CAP registration + SSIDs
# happen once the Ansible `router` role configures CAPsMAN.

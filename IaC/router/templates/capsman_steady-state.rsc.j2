    Manager = RB4011 (wifi-qcom-ac package; radios NOT required). APs join as CAPs via
    /interface wifi cap (ap_initial.rsc.j2). SSIDs/VLANs/passphrase items come from
    group_vars/router.yml routeros_capsman_ssids (SSOT); secrets from 1Password at
    render time. NEVER commit rendered/ or secret literals. -#}
# =============================================================================
# CAPsMAN — Kogler Homelab — Steady-State WiFi (MODERN wifi-qcom-ac)
# This template: IaC/router/templates/capsman_steady-state.rsc.j2
# =============================================================================
# Purpose: Per-SSID WiFi provisioning on the RB4011 CAPsMAN manager — delivered as a
#          rendered .rsc, NOT as ansible api_modify.
#          → docs/network-ops.md §CAPsMAN steady-state contract (`wifi-qcom-ac`)
#
# How:     Upload to the RB4011 Files, then run:
#            /import capsman_steady-state.rsc
#          AFTER the router bootstrap (rb4011_initial.rsc) + the router role have
#          established bridge/VLANs/DHCP/firewall. NOT a reset script.
#
# NOTE:    NO secrets in the repo — passphrases injected from 1Password at render.
#          Fail-loud: a missing wifi-kogler* item aborts the render.
#
# wifi-qcom-ac has no `datapath.vlan-mode=` (import rejects it), and a CAP cannot
#   honor a datapath vlan-id: the CAP logs 'vlan-id configured, but interface does not
#   support assigning vlans' and clients loop-disconnect.
#   So: a NAMED datapath (DP_AC, bridge-lan, NO vlan-id) here, and per-SSID VLAN
#   tagging on the CAP's own bridge (pvid per slave + tagged uplink —
#   ap_initial.rsc.j2). The manager is enabled below; with it off nothing provisions.
# =============================================================================

# ---- Enable the CAPsMAN manager ----
# interfaces defaults to 'all' (listens on the bridge the CAPs discover on).
/interface wifi capsman set enabled=yes

# ---- Datapath (bridge-lan, NO vlan-id — wifi-qcom-ac CAP VLAN via CAP bridge) ----
/interface wifi datapath add name=DP_AC bridge=bridge-lan comment="CAP datapath (no vlan-id; per-SSID VLAN via CAP bridge pvid)"

# ---- Security profiles (WPA2-PSK, one per SSID) ----

{% for ssid in routeros_capsman_ssids %}
/interface wifi security add \
    name=sec-{{ ssid.cfg | replace('cfg-', '') }} \
    authentication-types=wpa2-psk \
    passphrase={{ lookup('community.general.onepassword', ssid.item, field='password', vault=op_vault) }} \
    comment="{{ ssid.ssid }} WPA2-PSK ({{ ssid.item }})"
{% endfor %}

# ---- Wifi config objects (datapath = DP_AC, NO vlan-id) ----

{% for ssid in routeros_capsman_ssids %}
/interface wifi configuration add \
    name={{ ssid.cfg }} \
    ssid="{{ ssid.ssid | replace('\\"', '\\\\"') }}" \
    security=sec-{{ ssid.cfg | replace('cfg-', '') }} \
    mode=ap \
    datapath=DP_AC \
    comment="VLAN {{ ssid.vlan }} ({{ ssid.item }})"
{% endfor %}

# ---- Per-band Kogler master configs (non-DFS 5GHz + band split) ----
# A client can fail to associate on CAPsMAN's auto-selected DFS 5GHz channels
# (5500/5580), so the 5GHz master pins non-DFS channel 36 (5180).
# The master config is split per band so the 5GHz pin never reaches the 2.4GHz
# provisioning — a shared cfg-kogler with channel.frequency confuses 2.4GHz slaves.
/interface wifi configuration add \
    name=cfg-kogler-24 \
    ssid="Kogler" \
    security=sec-kogler \
    mode=ap \
    datapath=DP_AC \
    comment="Kogler 2.4GHz master (no channel pin)"
/interface wifi configuration add \
    name=cfg-kogler-5 \
    ssid="Kogler" \
    security=sec-kogler \
    mode=ap \
    datapath=DP_AC \
    channel.band=5ghz-ac \
    channel.frequency=5180 \
    comment="Kogler 5GHz master (ch36 non-DFS)"

# ---- Provisioning rules (manager -> APs) ----
# Band split: 2.4GHz master = cfg-kogler-24 + the 2.4GHz slaves; 5GHz master =
# cfg-kogler-5 + the 5GHz-only slaves. A slave is routed to 5GHz by `band: 5` in
# routeros_capsman_ssids (SSOT), else it stays 2.4GHz.
{% set slaves24 = routeros_capsman_ssids | rejectattr('cfg', 'equalto', 'cfg-kogler') | rejectattr('band', 'equalto', 5) | map(attribute='cfg') | list %}
{% set slaves5  = routeros_capsman_ssids | rejectattr('cfg', 'equalto', 'cfg-kogler') | selectattr('band', 'equalto', 5) | map(attribute='cfg') | list %}
# 2.4GHz: master + enabled slave SSIDs
/interface wifi provisioning add \
    action=create-dynamic-enabled \
    master-configuration=cfg-kogler-24 \
{% if slaves24 %}
    slave-configurations={{ slaves24 | join(',') }} \
{% endif %}
    supported-bands=2ghz-n \
    comment="2.4GHz: Kogler{% if slaves24 %} + {{ slaves24 | join(',') }}{% endif %}"
# 5GHz: Kogler master + 5GHz-only slaves (guest)
/interface wifi provisioning add \
    action=create-dynamic-enabled \
    master-configuration=cfg-kogler-5 \
{% if slaves5 %}
    slave-configurations={{ slaves5 | join(',') }} \
{% endif %}
    supported-bands=5ghz-ac \
    comment="5GHz: Kogler{% if slaves5 %} + {{ slaves5 | join(',') }}{% endif %}"

# ---- End ----
# After import, verify on the router:
#   1. /interface wifi configuration print        -> 1 config per enabled SSID (cfg-kogler*)
#   2. /interface wifi security print             -> sec-kogler* profiles
#   3. /interface wifi registration-table print   -> clients appear per SSID
#   4. /interface wifi provisioning print         -> dynamic CAP entries created
# Enabled SSIDs land on their VLAN (Kogler -> 10, Kogler IOT -> 20; re-enable more
# from routeros_capsman_ssids in group_vars/router.yml to broadcast them again).

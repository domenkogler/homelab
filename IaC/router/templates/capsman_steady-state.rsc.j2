{#- CAPsMAN steady-state WiFi — MODERN wifi-qcom-ac — rendered by render-routeros.yml.
    Manager = RB4011 (HD-232: wifi-qcom-ac package, radios NOT required). APs join
    as CAPs via /interface wifi cap (ap_initial.rsc.j2). SSIDs/VLANs/passphrase
    items from group_vars/router.yml routeros_capsman_ssids (SSOT). Secrets from
    1Password at render time. NEVER commit rendered/ or secret literals. -#}
# =============================================================================
# CAPsMAN — Kogler Homelab — Steady-State WiFi (MODERN wifi-qcom-ac)
# Source template: IaC/router/templates/capsman_steady-state.rsc.j2
# =============================================================================
# Purpose: Per-SSID WiFi provisioning on the RB4011 CAPsMAN manager. Delivered as
#          a rendered .rsc and uploaded at the Phase 1.5 cutover (owner decision:
#          NOT ansible api_modify). HD-232 = modern wifi-qcom-ac; datapath VLAN
#          tagging lives in the wifi config objects, not the legacy access-list.
#
# How:     Upload to the RB4011 Files, then run:
#            /import capsman_steady-state.rsc
#          AFTER the router bootstrap (rb4011_initial.rsc) + Ansible router role
#          have established bridge/VLANs/DHCP/firewall. NOT a reset script.
#
# NOTE:    NO secrets in the repo — passphrases injected from 1Password at render.
#          Fail-loud: a missing wifi-kogler* item aborts the render.
#
# VALIDATED-LIVE (2026-09-02, RouterOS 7.24.1 + wifi-qcom-ac):
#   datapath.bridge= + datapath.vlan-id= are the live-accepted fields; the
#   datapath.vlan-mode= property does NOT exist on 7.24.1's wifi-qcom-ac
#   ("bad parameter datapath.vlan-mode" at import — live-probed). Tagging is
#   driven by vlan-id alone under datapath.bridge.
# FIX (2026-09-02 live-apply): wifi-qcom-ac CAPs CANNOT honor datapath vlan-id —
#   the CAP logs 'vlan-id configured, but interface does not support assigning
#   vlans' and clients loop-disconnect. Per-SSID VLAN tagging must ride the CAP's
#   BRIDGE (pvid per slave interface + tagged uplink), NOT the manager datapath.
#   So: configs use a NAMED datapath (DP_AC, bridge-lan, NO vlan-id), and the
#   manager is enabled here (was missing — the #1 'APs not working' cause).
# =============================================================================

# ---- Enable the CAPsMAN manager (was missing — APs never provisioned) ----
# interfaces defaults to 'all' (listens on the bridge the CAPs discover on).
/interface wifi capsman set enabled=yes

# ---- Datapath (bridge-lan, NO vlan-id — wifi-qcom-ac CAP VLAN via CAP bridge) ----
/interface wifi datapath add name=DP_AC bridge=bridge-lan comment="CAP datapath (no vlan-id; per-SSID VLAN via CAP bridge pvid)"

# ---- Security profiles (WPA2-PSK, one per SSID) ----

{% for ssid in routeros_capsman_ssids %}
/interface wifi security add \
    name=sec-{{ ssid.cfg | replace('cfg-', '') }} \
    authentication-types=wpa2-psk \
    passphrase={{ lookup('community.general.onepassword', ssid.item, field='password', vault=op_vault) }} \
    comment="{{ ssid.ssid }} WPA2-PSK ({{ ssid.item }})"
{% endfor %}

# ---- Wifi config objects (datapath = DP_AC, NO vlan-id — HD-232 + 2026-09-02 fix) ----

{% for ssid in routeros_capsman_ssids %}
/interface wifi configuration add \
    name={{ ssid.cfg }} \
    ssid="{{ ssid.ssid | replace('\\"', '\\\\"') }}" \
    security=sec-{{ ssid.cfg | replace('cfg-', '') }} \
    mode=ap \
    datapath=DP_AC \
    comment="VLAN {{ ssid.vlan }} ({{ ssid.item }})"
{% endfor %}

# ---- Per-band Kogler master configs (2026-09-03: non-DFS 5GHz + band split) ----
# A phone (Samsung) could not associate with the CAPsMAN auto-selected DFS 5GHz
# channels (5500/5580) — pinned to non-DFS channel 36 (5180). The master config is
# split per band so the 5GHz channel pin never touches the 2.4GHz provisioning
# (a shared cfg-kogler with channel.frequency confused the 2.4GHz IOT slaves -
# live-probed). IOT is 2.4GHz-only (owner decision).
/interface wifi configuration add \
    name=cfg-kogler-24 \
    ssid="Kogler" \
    security=sec-kogler \
    mode=ap \
    datapath=DP_AC \
    comment="Kogler 2.4GHz master (no channel pin)"
/interface wifi configuration add \
    name=cfg-kogler-5 \
    ssid="Kogler" \
    security=sec-kogler \
    mode=ap \
    datapath=DP_AC \
    channel.band=5ghz-ac \
    channel.frequency=5180 \
    comment="Kogler 5GHz master (ch36 non-DFS)"

# ---- Provisioning rules (manager -> APs) ----
# 2.4GHz master = cfg-kogler-24 + IOT slaves; 5GHz master = cfg-kogler-5 (Kogler
# only). Slave list is data-driven from routeros_capsman_ssids (all except master).
{% set slaves = routeros_capsman_ssids | rejectattr('cfg', 'equalto', 'cfg-kogler') | map(attribute='cfg') | list %}
# 2.4GHz: master + enabled slave SSIDs
/interface wifi provisioning add \
    action=create-dynamic-enabled \
    master-configuration=cfg-kogler-24 \
{% if slaves %}
    slave-configurations={{ slaves | join(',') }} \
{% endif %}
    supported-bands=2ghz-n \
    comment="2.4GHz: Kogler{% if slaves %} + {{ slaves | join(',') }}{% endif %}"
# 5GHz: Kogler master only (no IOT on 5GHz)
/interface wifi provisioning add \
    action=create-dynamic-enabled \
    master-configuration=cfg-kogler-5 \
    supported-bands=5ghz-ac \
    comment="5GHz: Kogler only (no IOT on 5GHz)"

# ---- End ----
# After import, verify on the router:
#   1. /interface wifi configuration print        -> 1 config per enabled SSID (cfg-kogler*)
#   2. /interface wifi security print             -> sec-kogler* profiles
#   3. /interface wifi registration-table print   -> clients appear per SSID
#   4. /interface wifi provisioning print         -> dynamic CAP entries created
# Enabled SSIDs land on their VLAN (Kogler -> 10, Kogler IOT -> 20; re-enable more
# from routeros_capsman_ssids in group_vars/router.yml to broadcast them again).

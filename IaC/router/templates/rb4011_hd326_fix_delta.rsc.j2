{#- RB4011 — per-MAC kids controls + cloud-IoT WAN egress live-apply DELTA.
    Purpose: converge the live router's firewall to SSOT for the per-MAC kids
    controls and the cloud-IoT WAN egress, without a full converge import.

    The failure this fixes: rules appended at the END of the forward chain sit
    BELOW the Home->WAN accept and the Default deny, so first-match-wins makes the
    per-MAC machinery INERT — cloud-IoT WAN stays blocked, kids bedtime/DoT drops
    never fire. Double imports also stack duplicate rows, and a NAT row rendered
    for only part of the kids set leaves one device unfiltered.

    This delta (idempotent, comment-driven, safe to re-import):
      A) REMOVE every kids filter rule + every iot-wan-allow accept + the IoT DoT
         drops (all re-added below at the correct position).
      B) ADD the cloud-IoT iot-wan-allow accepts ABOVE the IoT->WAN drop, in SSOT
         order (cursor-based move — each rule placed before the previous one).
      C) ADD the kids DoT + bedtime drops ABOVE the Home->WAN accept, in SSOT order
         per device (DoT then bedtime).
      D) ADD the IoT DoT drops (one tcp + one udp) above the Default deny.
      E) NAT: ensure per-MAC kids filtered DNS (udp+tcp) for EVERY row with
         `kids: true`.

    Apply: /import rb4011_hd326_fix_delta.rsc  (via scripts/routeros-apply-delta.sh)
    Fold-back: the SSOT converge template rb4011_converge.rsc.j2 carries the full set
    + order; this delta is TRANSIENT and is deleted once the converge import is the
    live state (network-ops.md 3-tier).
-#}
# =============================================================================
# RB4011 — kids controls + cloud-IoT WAN live-apply DELTA
# =============================================================================
:log warning "rb4011_hd326_fix_delta.rsc: start"

# ---- A. REMOVE all kids + iot-wan-allow + IoT-DoT tail rules (re-add below) ----
# A double import leaves these at the END of the forward chain (BELOW the Default
# deny) — remove every copy, then the fresh set is re-created at the correct
# positions in B/C/D. The NAT rows are handled idempotently in E. Comment-driven,
# so a re-import is safe.
/ip firewall filter remove [find where comment~"HD-326 kids DoT-bypass drop"]
/ip firewall filter remove [find where comment~"HD-326 kids bedtime WAN drop"]
/ip firewall filter remove [find where comment~"IoT cloud device -> WAN allowed via iot-wan-allow"]
/ip firewall filter remove [find where comment~"IoT -> DoT bypass drop" and chain=forward]

# ---- B. cloud-IoT WAN egress (iot-wan-allow) ABOVE the IoT->WAN drop ----
:local iotDrop [/ip firewall filter find where chain=forward and comment="IoT -> WAN drop (disable for firmware)"]
:if ($iotDrop = "") do={ :error "delta: IoT->WAN drop rule not found — aborting" }
:local prev $iotDrop
{% for h in network_static_hosts %}{% if h.mac is defined and h.vlan == 20 and h.wan_allow is defined and h.wan_allow %}
/ip firewall filter add chain=forward src-address=10.10.20.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom action=accept comment="IoT cloud device -> WAN allowed via iot-wan-allow (HD-312/325): {{ h.name }}"
/ip firewall filter move [find where comment="IoT cloud device -> WAN allowed via iot-wan-allow (HD-312/325): {{ h.name }}"] destination=$prev
:set prev [/ip firewall filter find where comment="IoT cloud device -> WAN allowed via iot-wan-allow (HD-312/325): {{ h.name }}"]
{% endif %}{% endfor %}
# NOTE: each rule is placed immediately BEFORE $prev (starting from the IoT-drop),
# advancing $prev to the just-placed rule — so the SSOT order is preserved with
# the FIRST wan_allow device highest and the IoT->WAN drop immediately after the LAST.

# ---- C. Kids controls ABOVE the Home->WAN accept ----
:local homeWan [/ip firewall filter find where chain=forward and comment="Home -> WAN allowed (HD-309 row 73)"]
:if ($homeWan = "") do={ :error "delta: Home->WAN accept rule not found — aborting" }
:local prev $homeWan
{% for h in network_static_hosts %}{% if h.mac is defined and h.kids is defined and h.kids %}
/ip firewall filter add chain=forward src-address=10.10.1.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom protocol=tcp dst-port=853 action=drop comment="HD-326 kids DoT-bypass drop (853): {{ h.name }}"
/ip firewall filter move [find where comment="HD-326 kids DoT-bypass drop (853): {{ h.name }}"] destination=$prev
:set prev [/ip firewall filter find where comment="HD-326 kids DoT-bypass drop (853): {{ h.name }}"]
/ip firewall filter add chain=forward src-address=10.10.1.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom time=22:00:00-07:00:00,mon,tue,wed,thu,fri,sat,sun action=drop comment="HD-326 kids bedtime WAN drop (22:00-07:00): {{ h.name }}"
/ip firewall filter move [find where comment="HD-326 kids bedtime WAN drop (22:00-07:00): {{ h.name }}"] destination=$prev
:set prev [/ip firewall filter find where comment="HD-326 kids bedtime WAN drop (22:00-07:00): {{ h.name }}"]
{% endif %}{% endfor %}
# Order: for each kids device DoT-drop then bedtime-drop, placed above the
# Home->WAN accept in SSOT device order (the first kids device's DoT is highest).

# ---- D. IoT DoT drops ABOVE the Default deny ----
:local defDeny [/ip firewall filter find where chain=forward and comment="Default deny inter-VLAN"]
:local prev $defDeny
:if ([/ip firewall filter find where chain=forward and comment="IoT -> DoT bypass drop tcp (HD-342)"] = "") do={
  /ip firewall filter add chain=forward src-address=10.10.20.0/24 protocol=tcp dst-port=853 action=drop comment="IoT -> DoT bypass drop tcp (HD-342)"
}
:if ([/ip firewall filter find where chain=forward and comment="IoT -> DoT bypass drop udp (HD-342)"] = "") do={
  /ip firewall filter add chain=forward src-address=10.10.20.0/24 protocol=udp dst-port=853 action=drop comment="IoT -> DoT bypass drop udp (HD-342)"
}
:local t [/ip firewall filter find where chain=forward and comment="IoT -> DoT bypass drop tcp (HD-342)"]
:if ($t != "") do={ /ip firewall filter move $t destination=$prev }
:set prev [/ip firewall filter find where chain=forward and comment="IoT -> DoT bypass drop tcp (HD-342)"]
:local u [/ip firewall filter find where chain=forward and comment="IoT -> DoT bypass drop udp (HD-342)"]
:if ($u != "") do={ /ip firewall filter move $u destination=$prev }

# ---- E. NAT: ensure per-MAC kids filtered DNS for EVERY kids device ----
# One dstnat pair (udp+tcp) per SSOT row with `kids: true`; add whichever the device
# is missing and re-assert the rest (idempotent).
:local vip {{ dns_primary_ip }}
{% for h in network_static_hosts %}{% if h.mac is defined and h.kids is defined and h.kids %}
:if ([/ip firewall nat find where chain=dstnat and src-address=10.10.1.0/24 and src-mac-address={{ h.mac }} and protocol=udp and dst-port=53] = "") do={
  /ip firewall nat add chain=dstnat src-address=10.10.1.0/24 src-mac-address={{ h.mac }} protocol=udp dst-port=53 action=dst-nat to-addresses=$vip to-ports=53 comment="kids filtered DNS - UDP 53 -> Technitium: {{ h.name }}"
}
:if ([/ip firewall nat find where chain=dstnat and src-address=10.10.1.0/24 and src-mac-address={{ h.mac }} and protocol=tcp and dst-port=53] = "") do={
  /ip firewall nat add chain=dstnat src-address=10.10.1.0/24 src-mac-address={{ h.mac }} protocol=tcp dst-port=53 action=dst-nat to-addresses=$vip to-ports=53 comment="kids filtered DNS - TCP 53 -> Technitium: {{ h.name }}"
}
{% endif %}{% endfor %}

:log warning "rb4011_hd326_fix_delta.rsc: done"
# =============================================================================
# Verify:
#   /ip firewall filter print where chain=forward sequence=... (kids + iot-wan ABOVE
#     the Home->WAN accept / IoT->WAN drop; DEFAULT deny LAST)
#   /ip firewall nat print -> 4 dstnat rows (2 kids devices x udp+tcp)
# =============================================================================
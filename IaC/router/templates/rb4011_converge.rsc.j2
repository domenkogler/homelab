# =============================================================================
# RB4011 — Kogler Homelab — CONVERGED STEADY-STATE (RENDERED — do not edit)
# Source template: IaC/router/templates/rb4011_converge.rsc.j2
# =============================================================================
# Purpose: Full final router state — import on a device that already ran
#          rb4011_initial.rsc (or after reset). Idempotent-ish: `/set` safe,
#          `/add` errors on duplicates (re-import = "already have" messages OK).
#          Encodes the untagged-vlan99 fix + full firewall from the router role.
# How:     Upload + /import router-converge.rsc in a WinBox terminal
#          (or via SSH: scp to deviceFiles then /import).
# =============================================================================

# ---- System ----
/system identity set name=router.kogler.si
/system clock set time-zone-name=Europe/Ljubljana
/system ntp client set enabled=yes
# Add NTP servers idempotently — `/add` on an existing address is a hard failure
# that aborts the whole import (live 2026-09-01: duplicate address stopped the
# converge import at line 17 BEFORE reaching bridge/vlan/lease changes).
:if ([/system ntp client servers find where address="0.si.pool.ntp.org"] = "") do={
    /system ntp client servers add address=0.si.pool.ntp.org
}
:if ([/system ntp client servers find where address="1.si.pool.ntp.org"] = "") do={
    /system ntp client servers add address=1.si.pool.ntp.org
}

# ---- WAN (internet for laptop + 1Password) — bootstrap has it; needed for standalone reset ----
# IDEMPOTENT GUARD (live 2026-09-03): a re-import aborts here with 'already have interface
# with name pppoe-telekom' if the bootstrap already created it — which BLOCKS the rest of
# the script (DNS/DHCP changes downstream never land). Set the existing interface's creds
# instead of re-adding.
:if ([/interface pppoe-client find where name=pppoe-telekom] = "") do={
    /interface pppoe-client add name=pppoe-telekom interface=ether1 \
        user="{{ pppoe_login_user }}" password="{{ pppoe_login_password }}" \
        add-default-route=yes use-peer-dns=no disabled=no
} else={
    /interface pppoe-client set [find where name=pppoe-telekom] \
        user="{{ pppoe_login_user }}" password="{{ pppoe_login_password }}" \
        add-default-route=yes use-peer-dns=no disabled=no
}

# ---- Users (auth) ----
/user set [find name=admin] password="{{ mikrotik_admin_password }}" comment="human admin"
# IDEMPOTENT GUARD (HD-322): a re-import aborts with 'user with the same name already
# exists' on the bare /user add — the first hard stop of the old converge. Set the
# existing user instead of re-adding.
:if ([/user find where name=ansible] = "") do={
    /user add name=ansible group=full disabled=no password="" comment="Ansible automation (SSH-key auth)"
} else={
    /user set [find name=ansible] group=full disabled=no comment="Ansible automation (SSH-key auth)"
}
# SSH-key imports are bootstrap-only: admin.pub/ansible.pub exist on a fresh flash
# (uploaded by rb4011_initial.rsc) but are cleaned up in steady state — a re-import
# here aborts with 'input does not match any value of public-key-file' (HD-322 live
# lesson). Guard on the file existing; skip silently when it does not (steady-state
# already has the keys from bootstrap).
:if ([/file find where name=admin.pub] != "") do={
    /user ssh-keys import public-key-file=admin.pub user=admin
}
:if ([/file find where name=ansible.pub] != "") do={
    /user ssh-keys import public-key-file=ansible.pub user=ansible
}

# ---- Bridge + trunk (port model 2026-09-01: untagged=primary/access, tagged=secondary/Mgmt) ----
# ADMIN/PC/PI ports: untagged Home (10) primary + tagged Mgmt (99) — dual-home.
# A single untagged port carries ONE VLAN (untagged frames map to pvid); the secondary
# admin plane rides TAGGED 99 on the same port. nas iLO4 + HMIP-HAP stay Mgmt-only.
# IDEMPOTENT (HD-322): /interface bridge add on an existing bridge errors — guard it.
:if ([/interface bridge find where name=bridge-lan] = "") do={
    /interface bridge add name=bridge-lan vlan-filtering=yes protocol-mode=none
}
# Bridge ports — guard each (HD-322): re-import aborts on 'interface already added'.
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether2] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether2  pvid=10 comment="PC (oldsrv) — untagged Home + tagged Mgmt"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether3] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether3  pvid=10 comment="Laptop (mgmt via Pi hop — Home untagged only)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether7] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether7  pvid=99 comment="nas iLO4 (Mgmt access)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether9] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether9  pvid=99 comment="HMIP-HAP (Mgmt access)"
}
# Raspberry Pi (ether10) — DUAL-HOMED: untagged Home (10) + tagged Mgmt (99).
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether10] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether10 pvid=10 comment="Raspberry Pi (Dual: Home10 + MGMT99)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=sfp-sfpplus1] = "") do={
    /interface bridge port add bridge=bridge-lan interface=sfp-sfpplus1 comment="trunk -> switch"
}
# Home (10): untagged on the dual-homed ports (ether2/3/10 — the access/primary plane).
# IDEMPOTENT (HD-322): guard against duplicate bridge-vlan on re-import (dynamic entries
# are excluded — a static add is the SSOT row).
:if ([/interface bridge vlan find where bridge=bridge-lan and vlan-ids=10 and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids=10 tagged=bridge-lan,sfp-sfpplus1 untagged=ether2,ether3,ether10 comment="Home VLAN (access primary)"
} else={
    /interface bridge vlan set [find where bridge=bridge-lan and vlan-ids=10 and dynamic=no] tagged=bridge-lan,sfp-sfpplus1 untagged=ether2,ether3,ether10 comment="Home VLAN (access primary)"
}
# Management (99): TAGGED on the dual-homed ports + trunk + self; UNTAGGED on the Mgmt-only access ports.
:if ([/interface bridge vlan find where bridge=bridge-lan and vlan-ids=99 and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids=99 tagged=bridge-lan,sfp-sfpplus1,ether2,ether10 untagged=ether7,ether9 comment="Management VLAN on trunk + tagged admin"
} else={
    /interface bridge vlan set [find where bridge=bridge-lan and vlan-ids=99 and dynamic=no] tagged=bridge-lan,sfp-sfpplus1,ether2,ether10 untagged=ether7,ether9 comment="Management VLAN on trunk + tagged admin"
}
# All gateways' VLANs must be trunked to the switch (tagged on sfp-sfpplus1) so the
# switch can reach each per-VLAN gateway — mirror of crs328_converge.rsc.j2 (which
# trunktags every VLAN). Missing 20/21/30/40/50 previously dropped those VLANs at
# the trunk (HD-308: Shield on Media(50) had no WAN — empty ARP, waiting lease).
# Other VLANs (20/21/30/40/50): tagged on trunk+self only.
{% for v in network_vlans %}
{% if v.id != 99 and v.id != 10 %}
:if ([/interface bridge vlan find where vlan-ids={{ v.id }} and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids={{ v.id }} tagged=bridge-lan,sfp-sfpplus1 comment="{{ v.name }} VLAN on trunk"
} else={
    /interface bridge vlan set [find where vlan-ids={{ v.id }} and dynamic=no] tagged=bridge-lan,sfp-sfpplus1 comment="{{ v.name }} VLAN on trunk"
}
{% endif %}
{% endfor %}
:if ([/interface vlan find where name=vlan99-mgmt] = "") do={
    /interface vlan add name=vlan99-mgmt vlan-id=99 interface=bridge-lan
}

# ---- Per-VLAN interfaces + gateways (SSOT network_vlans) ----
# NOTE: vlan 99 (mgmt) is created ABOVE as `vlan99-mgmt` (bootstrap-compatible
# name); the loop skips it to avoid a duplicate `vlan99-management`.
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/interface vlan find where name=vlan{{ v.id }}-{{ v.name|lower }}] = "") do={
    /interface vlan add name=vlan{{ v.id }}-{{ v.name|lower }} vlan-id={{ v.id }} interface=bridge-lan
}
{% endif %}
{% endfor %}
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/ip address find where interface=vlan{{ v.id }}-{{ v.name|lower }}] = "") do={
    /ip address add address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} interface=vlan{{ v.id }}-{{ v.name|lower }} comment="{{ v.name }} gateway"
} else={
    /ip address set [find where interface=vlan{{ v.id }}-{{ v.name|lower }}] address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} comment="{{ v.name }} gateway"
}
{% else %}
:if ([/ip address find where interface=vlan99-mgmt] = "") do={
    /ip address add address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} interface=vlan99-mgmt comment="Management gateway"
} else={
    /ip address set [find where interface=vlan99-mgmt] address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} comment="Management gateway"
}
{% endif %}
{% endfor %}

# ---- DHCP: pools + servers + networks (mgmt server = dhcp-mgmt, named in bootstrap) ----
# RouterOS caps dhcp-server network at 3 dns-servers; router /ip dns upstream is the
# 4th/final fallback (HD-317). Guarded (HD-322) — re-import never duplicate-aborts.
# mgmt pool/server (bootstrap) — keep; add the rest
:if ([/ip pool find where name=pool-mgmt] = "") do={
    /ip pool add name=pool-mgmt ranges={{ mgmt.pool }}
} else={
    /ip pool set [find where name=pool-mgmt] ranges={{ mgmt.pool }}
}
:if ([/ip dhcp-server find where name=dhcp-mgmt] = "") do={
    /ip dhcp-server add name=dhcp-mgmt interface=vlan99-mgmt address-pool=pool-mgmt disabled=no
} else={
    /ip dhcp-server set [find where name=dhcp-mgmt] interface=vlan99-mgmt address-pool=pool-mgmt disabled=no
}
:if ([/ip dhcp-server network find where gateway=10.10.99.1] = "") do={
    /ip dhcp-server network add address={{ mgmt.subnet }} gateway=10.10.99.1 dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
} else={
    /ip dhcp-server network set [find where gateway=10.10.99.1] gateway=10.10.99.1 dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
}
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/ip pool find where name=pool-vlan{{ v.id }}] = "") do={
    /ip pool add name=pool-vlan{{ v.id }} ranges={{ v.pool }}
} else={
    /ip pool set [find where name=pool-vlan{{ v.id }}] ranges={{ v.pool }}
}
:if ([/ip dhcp-server find where name=dhcp-{{ v.id }}] = "") do={
    /ip dhcp-server add name=dhcp-{{ v.id }} interface=vlan{{ v.id }}-{{ v.name|lower }} address-pool=pool-vlan{{ v.id }} disabled=no
} else={
    /ip dhcp-server set [find where name=dhcp-{{ v.id }}] interface=vlan{{ v.id }}-{{ v.name|lower }} address-pool=pool-vlan{{ v.id }} disabled=no
}
:if ([/ip dhcp-server network find where gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}] = "") do={
    /ip dhcp-server network add address={{ v.subnet }} gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }} dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
} else={
    /ip dhcp-server network set [find where gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}] gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }} dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
}
{% endif %}
{% endfor %}

# ---- DHCP static reservations (APs on vlan99 -> dhcp-mgmt; other reserved devices -> their VLAN server) ----
{% for h in network_static_hosts %}
{% if h.mac is defined and h.name.startswith('ap-') %}
:if ([/ip dhcp-server lease find where server=dhcp-mgmt and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-mgmt address={{ h.ip }} mac-address={{ h.mac }} comment="AP {{ h.name }}"
}
{% elif h.mac is defined and h.vlan == 99 and h.name not in ['router', 'switch'] and 'ap-' not in h.name %}
:if ([/ip dhcp-server lease find where server=dhcp-mgmt and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-mgmt address={{ h.ip }} mac-address={{ h.mac }} comment="{{ h.name }} mgmt reservation"
}
{% elif h.mac is defined and h.vlan != 99 and h.name not in ['router'] and 'ap-' not in h.name %}
:if ([/ip dhcp-server lease find where server=dhcp-{{ h.vlan }} and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-{{ h.vlan }} address={{ h.ip }} mac-address={{ h.mac }} comment="{{ h.name }} reservation"
}
{% endif %}
{% endfor %}

# ---- WireGuard S2S (HD-91/HD-155) ----
:if ([/interface wireguard find where name=wg-s2s] = "") do={
    /interface wireguard add name=wg-s2s listen-port=51820
} else={
    /interface wireguard set [find where name=wg-s2s] listen-port=51820
}
:if ([/ip address find where interface=wg-s2s] = "") do={
    /ip address add address={{ wireguard_s2s_vps.local_ip }} interface=wg-s2s
}
:if ([/interface wireguard peers find where interface=wg-s2s] = "") do={
    /interface wireguard peers add interface=wg-s2s public-key="{{ wireguard_s2s_vps.vps_public_key }}" allowed-address="{{ wireguard_s2s_vps.remote_ip }}" comment="VPS S2S peer"
} else={
    /interface wireguard peers set [find where interface=wg-s2s] public-key="{{ wireguard_s2s_vps.vps_public_key }}" allowed-address="{{ wireguard_s2s_vps.remote_ip }}" comment="VPS S2S peer"
}
# NOTE (live 2026-08-31): quote EVERY non-literal value sent to the script parser — the WG
# public-key contains +/= (and the admin/pppoe passwords may contain ! or $), which RouterOS
# mangles unquoted (user hit: wg-s2s peer add failed until public-key was quoted).
:if ([/ip route find where dst-address=10.255.40.0/30 and gateway=wg-s2s] = "") do={
    /ip route add dst-address=10.255.40.0/30 gateway=wg-s2s
}
# Address-list for the VPS peer (HD-155 least-access)
:if ([/ip firewall address-list find where list=vps_s2s_peer] = "") do={
    /ip firewall address-list add address={{ wireguard_s2s_vps.remote_ip.split('/')[0] }} list=vps_s2s_peer comment="VPS S2S peer"
}
# Scoped home targets the VPS may reach (HD-155)
{% for h in network_static_hosts %}
{% if h.name in ['nas','ha-vip','oldsrv','pi','router','switch'] %}
:if ([/ip firewall address-list find where list=vps_scoped_home and address={{ h.ip }}] = "") do={
    /ip firewall address-list add address={{ h.ip }} list=vps_scoped_home comment="HD-155: {{ h.name }}"
}
{% endif %}
{% endfor %}

# ---- Comtrend modem mgmt (HD-302) ----
# The RB4011 holds the modem-LAN address (now /24 so a connected route to the
# modem subnet exists). Live fix 2026-09-02: was /32 -> modem unreachable via
# forward (no route) even though the modem itself answered; /24 restores it.
:if ([/ip address find where interface=ether1] = "") do={
    /ip address add address={{ comtrend_modem.router_on_modem }} interface=ether1 comment="Comtrend modem mgmt /24 (HD-302)"
}

# ---- Firewall: NAT (masquerade + Kids forced DNS) ----
# Reset both NAT chains first (re-import safety + dedup against the reconciling
# router role, which also owns these rows). Without the reset, converge's
# unguarded /add would re-stack duplicates on top of the role's rows (live
# duplex NAT bug, 2026-09-01: converge + role both added masquerade + Kids DNS).
/ip firewall nat remove [find chain=srcnat]
/ip firewall nat remove [find chain=dstnat]
/ip firewall nat
add chain=srcnat out-interface=pppoe-telekom action=masquerade comment="Masquerade -> WAN"
# HD-302: the Comtrend (consumer ONT) only answers its web UI to its directly-
# connected peer on the modem link (the RB4011). Forwarded HTTP/HTTPS from lan
# hosts is silently ignored (conn tracker syn-sent, 0 repl). Masquerade trusted-
# admin traffic out ether1 as the router's own modem-LAN address so the modem
# answers. Live-verified 2026-09-02 (laptop -> modem UI returns 401 auth page).
add chain=srcnat out-interface={{ comtrend_modem.iface }} protocol=tcp dst-address={{ comtrend_modem.modem_mgmt_ip }} dst-port=80,443 action=masquerade comment="HD-302: modem UI via router SNAT (trusted-admin)"
add chain=dstnat src-address=10.10.40.0/24 protocol=udp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="Kids forced filtered DNS - UDP 53 -> Technitium"
add chain=dstnat src-address=10.10.40.0/24 protocol=tcp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="Kids forced filtered DNS - TCP 53 -> Technitium"

# ---- Firewall: address lists ----
# Reset first (HD-322): a re-import without the reset STACKS duplicate rows for
# trusted-admin/trusted-ha/internal_lan on top of the previous import (the role's
# api_modify handles absents, but the converge must own the same single set).
/ip firewall address-list remove [find list=trusted-admin]
/ip firewall address-list remove [find list=trusted-ha]
/ip firewall address-list remove [find list=internal_lan]
/ip firewall address-list
{% for h in network_static_hosts %}
{% if h.name in ['oldsrv','nas','ha-vip','laptop-domen'] %}
add address={{ h.ip }} list=trusted-admin comment="Trusted admin host: {{ h.name }}"
{% endif %}
{% if h.name in ['oldsrv','ha-vip'] %}
add address={{ h.ip }} list=trusted-ha comment="Trusted HA host: {{ h.name }}"
{% endif %}
{% endfor %}
add address=10.10.1.0/24 list=internal_lan comment="Home VLAN"
add address=10.10.20.0/24 list=internal_lan comment="IoT VLAN"
add address=10.10.30.0/24 list=internal_lan comment="Guest VLAN"
add address=10.10.40.0/24 list=internal_lan comment="Kids VLAN"
add address=10.10.50.0/24 list=internal_lan comment="Media VLAN"
add address=10.10.99.0/24 list=internal_lan comment="Mgmt VLAN"

# ---- Firewall: FORWARD chain (inter-VLAN, ordered, per router role) ----
# Reset chain (re-import safety) — comment-driven; a real reset clears it.
/ip firewall filter remove [find chain=forward]
/ip firewall filter
add chain=forward action=accept connection-state=established,related comment="Allow established/related return"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address-list=trusted-ha protocol=udp dst-port=5683 comment="IoT Shelly CoAP push -> HA"
add chain=forward action=accept src-address-list=trusted-admin dst-address=10.10.20.0/24 comment="Trusted admin -> IoT (new)"
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=tcp connection-state=established,related comment="Home -> IoT (est/rel)"
# KNXnet/IP tunneling (HA on the Pi -> GIRA IP router on IoT): the Pi is NOT
# in trusted-admin (node, not admin host -- HD-310 Mgmt-strict posture), so
# HA's KNX tunnel needs its own narrow new-UDP exception. Same pattern as the
# CoAP 5683 reverse exception above. dst = knx-ip 10.10.20.11 (SSOT, VLAN 20).
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.11 protocol=udp dst-port=3671 comment="Home -> KNX router (KNXnet/IP tunnel, HA) - new UDP"
# Shelly Gen1 RGBW2 REST (HA on the Pi -> Shelly fleet on IoT): same reason
# as the KNX exception above -- the Pi is a node, NOT in trusted-admin
# (HD-310 Mgmt-strict posture), so HA's outbound new-TCP to the Shelly HTTP
# API needs its own narrow exception. dst-port 80 only (Gen1 REST; the CoAP
# 5683 push path is the reverse direction, already covered by trusted-ha
# above). Same pattern as the KNX narrow exception (HD-319).
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=tcp dst-port=80 comment="Home Pi (HA) -> Shelly RGBW2 REST (new TCP)"
# Shelly Gen1 CoIoT/CoAP client (HA -> Shelly fleet on IoT) (HD-323): the
# Gen1 Shelly integration's config flow + runtime BlockDevice open a CoAP
# client session TOWARD each device on udp/5683 (requests/management), in
# ADDITION to the reverse push the device sends to HA (covered by
# trusted-ha above). Without this forward new-UDP the config flow's
# validate_input (BlockDevice.initialize -> CoAP GET to the device) fails
# with "cannot_connect" and the device can't be added in the UI. Narrow:
# Home(10) only, dst-port 5683 only.
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=udp dst-port=5683 comment="Home Pi (HA) -> Shelly CoIoT/CoAP client (new UDP)"
add chain=forward action=accept src-address-list=trusted-admin dst-port=80,443 protocol=tcp dst-address-list=ups_management comment="Trusted admin -> UPS web UI"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.30 protocol=udp dst-port=53,853 comment="LAN -> DNS resolver udp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.30 protocol=tcp dst-port=53,853 comment="LAN -> DNS resolver tcp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.20 protocol=udp dst-port=53,853 comment="LAN -> DNS secondary Pi udp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.20 protocol=tcp dst-port=53,853 comment="LAN -> DNS secondary Pi tcp"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address=10.10.1.30 protocol=udp dst-port=53,853 comment="IoT -> DNS resolver udp"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address=10.10.1.30 protocol=tcp dst-port=53,853 comment="IoT -> DNS resolver tcp"
# WAN egress per network-vlans.md row 73 ("All (except IoT) -> WAN Allowed (masqueraded)"), HD-309
add chain=forward action=accept src-address=10.10.1.0/24  out-interface=pppoe-telekom comment="Home -> WAN allowed (HD-309 row 73)"
add chain=forward action=accept src-address=10.10.50.0/24 out-interface=pppoe-telekom comment="Media -> WAN allowed (HD-309)"
add chain=forward action=accept src-address=10.10.30.0/24 out-interface=pppoe-telekom comment="Guest -> WAN allowed (HD-309 row 73)"
add chain=forward action=accept src-address=10.10.99.0/24 out-interface=pppoe-telekom comment="Mgmt -> WAN allowed (HD-309 row 73)"
add chain=forward action=drop src-address=10.10.20.0/24 out-interface=pppoe-telekom comment="IoT -> WAN drop (disable for firmware)"
add chain=forward action=accept src-address-list=vps_s2s_peer dst-address-list=vps_scoped_home comment="VPS S2S -> scoped home (HD-155)"
add chain=forward action=drop src-address-list=vps_s2s_peer comment="VPS S2S -> anything else DROP (HD-155)"
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.50.0/24 comment="Home -> Media"
add chain=forward action=accept src-address=10.10.50.0/24 dst-address=10.10.1.0/24 comment="Media -> Home"
add chain=forward action=accept src-address=10.10.99.0/24 dst-address=10.10.1.0/24 comment="Mgmt -> Home (laptop/Pi discovery, HD-307)"
add chain=forward action=drop src-address=10.10.30.0/24 dst-address-list=internal_lan comment="Guest -> LAN drop"
add chain=forward action=drop src-address=10.10.40.0/24 protocol=tcp dst-port=853 comment="Kids -> DoT bypass drop tcp"
add chain=forward action=drop src-address=10.10.40.0/24 protocol=udp dst-port=853 comment="Kids -> DoT bypass drop udp"
add chain=forward action=drop src-address=10.10.40.0/24 dst-address=10.10.1.0/24 comment="Kids -> Home drop"
add chain=forward action=drop src-address=10.10.40.0/24 out-interface=pppoe-telekom time=22:00:00-07:00:00,mon,tue,wed,thu,fri,sat,sun comment="Kids bedtime WAN block 22:00-07:00"
add chain=forward action=accept src-address=10.10.40.0/24 out-interface=pppoe-telekom comment="Kids -> WAN allowed out-of-window (HD-309 row 73)"
add chain=forward action=drop src-address-list=internal_lan dst-address-list=internal_lan comment="Default deny inter-VLAN"
# HD-302: Comtrend modem mgmt (trusted-admin only)
add chain=forward action=accept src-address-list=trusted-admin dst-address=192.168.1.1 protocol=tcp dst-port=80,443 comment="Trusted admin -> Comtrend modem"
add chain=forward action=drop dst-address=192.168.1.0/24 comment="Drop all other -> Comtrend modem subnet"

# ---- Firewall: INPUT chain (mgmt services lockdown HD-78/KOPS-003) ----
/ip firewall filter remove [find chain=input]
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="Allow established/related input"
add chain=input action=accept protocol=udp dst-port={{ wg_s2s_vps.listen_port }} comment="Allow WireGuard S2S handshake/input (HD-285)"
add chain=input action=accept src-address-list=internal_lan protocol=udp dst-port=67,68 comment="Allow DHCP input from LAN"
add chain=input action=accept in-interface=pppoe-telekom protocol=udp dst-port=67,68 comment="Accept PPPoE DHCP-renewal input (WAN)"
add chain=input action=drop in-interface=pppoe-telekom comment="Drop all other new-from-WAN (brute-force floor)"
add chain=input action=accept src-address=10.10.99.0/24 protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Allow mgmt services from Mgmt VLAN"
add chain=input action=accept src-address-list=trusted-admin protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Allow mgmt services from trusted-admin"
add chain=input action=drop protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Drop mgmt services from non-mgmt sources"
add chain=input action=accept src-address=10.10.99.0/24 protocol=udp dst-port=161 comment="Allow SNMP from Mgmt VLAN"
add chain=input action=drop protocol=udp dst-port=161 comment="Drop SNMP from non-mgmt"
add chain=input action=accept src-address-list=internal_lan protocol=tcp dst-port=53 comment="Allow DNS input from LAN tcp"
add chain=input action=accept src-address-list=internal_lan protocol=udp dst-port=53 comment="Allow DNS input from LAN udp"

# ---- Services (mgmt-scoped, dangerous disabled — HD-301) ----
/ip service set telnet disabled=yes port=23 available-from={{ router_services_available_from }}
/ip service set ftp disabled=yes port=21 available-from={{ router_services_available_from }}
/ip service set www disabled=yes port=80 available-from={{ router_services_available_from }}
/ip service set api-ssl disabled=yes port=8729 available-from={{ router_services_available_from }} certificate=none
/ip service set reverse-proxy disabled=yes port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set api disabled=no port=8728 available-from={{ router_services_available_from }}
/ip service set www-ssl disabled=no port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set ssh disabled=no port=22 available-from={{ router_services_available_from }}
/ip service set winbox disabled=no port=8291 available-from={{ router_services_available_from }}

# ---- DNS (router resolver as tertiary) ----
# Upstream = the same Technitium chain the DHCP hands out (VPS->oldsrv->Pi), so
# the router forwards to them first and only falls back to raw Cloudflare when
# all are unreachable (RouterOS queries listed servers concurrently + takes the
# first reply). The router's WAN egress IP is exactly what the VPS nftables
# dns-allow-home set permits (HD-317). Final fallback stays unfiltered (accepted
# tradeoff, network-dns.md).
/ip dns set allow-remote-requests=yes servers={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }},1.1.1.1,1.0.0.1


# =============================================================================
# RB4011 — Kogler Homelab — CONVERGED STEADY-STATE (Jinja SOURCE TEMPLATE — rendered to the gitignored rendered/*.rsc)
# This template: IaC/router/templates/rb4011_converge.rsc.j2
# =============================================================================
# Purpose: Full final router state — import on a device that already ran
#          rb4011_initial.rsc (or after reset). Idempotent-ish: `/set` safe,
#          `/add` errors on duplicates (re-import = "already have" messages OK).
#          Encodes the same bridge/VLAN/trunk + firewall state as the router role.
# How:     Upload + /import router-converge.rsc in a WinBox terminal
#          (or via SSH: scp to deviceFiles then /import).
# =============================================================================

# ---- System ----
/system identity set name=router.kogler.si
/system clock set time-zone-name=Europe/Ljubljana
/system ntp client set enabled=yes
# Add NTP servers idempotently — `/add` on an existing address is a hard failure
# that aborts the whole import BEFORE the bridge/vlan/lease changes below.
:if ([/system ntp client servers find where address="0.si.pool.ntp.org"] = "") do={
    /system ntp client servers add address=0.si.pool.ntp.org
}
:if ([/system ntp client servers find where address="1.si.pool.ntp.org"] = "") do={
    /system ntp client servers add address=1.si.pool.ntp.org
}

# ---- WAN (internet for laptop + 1Password) — bootstrap has it; needed for standalone reset ----
# Guard it: a re-import aborts here with 'already have interface with name
# pppoe-telekom' when the bootstrap already created it, which BLOCKS everything below
# (DNS/DHCP changes never land). Set the existing interface's creds instead of re-adding.
:if ([/interface pppoe-client find where name=pppoe-telekom] = "") do={
    /interface pppoe-client add name=pppoe-telekom interface=ether1 \
        user="{{ pppoe_login_user }}" password="{{ pppoe_login_password }}" \
        add-default-route=yes use-peer-dns=no disabled=no
} else={
    /interface pppoe-client set [find where name=pppoe-telekom] \
        user="{{ pppoe_login_user }}" password="{{ pppoe_login_password }}" \
        add-default-route=yes use-peer-dns=no disabled=no
}

# ---- Users (auth) ----
/user set [find name=admin] password="{{ mikrotik_admin_password }}" comment="human admin"
# Guard it: a bare /user add aborts the re-import with 'user with the same name already
# exists'. Set the existing user instead of re-adding.
:if ([/user find where name=ansible] = "") do={
    /user add name=ansible group=full disabled=no password="" comment="Ansible automation (SSH-key auth)"
} else={
    /user set [find name=ansible] group=full disabled=no comment="Ansible automation (SSH-key auth)"
}
# Scoped read-only API user for the n8n firmware automation — `group=read` means
# read-only on every config path, no write. The password is injected from 1Password at
# render (mikrotik-n8n_api, see render-routeros.yml).
# GATED on that vault item EXISTING: a bare lookup would abort the render, so when it is
# absent emit a loud DEFERRED comment instead of a blank password (fail-loud, no default).
{% if mikrotik_n8n_present | default(false) %}
:if ([/user find where name=n8n] = "") do={
    /user add name=n8n group=read disabled=no password="{{ mikrotik_n8n_password }}" comment="read-only API for n8n firmware automation"
} else={
    /user set [find name=n8n] group=read disabled=no password="{{ mikrotik_n8n_password }}" comment="read-only API for n8n firmware automation"
}
{% else %}
# n8n user DEFERRED — mikrotik-n8n_api 1P item missing (create it, then re-render + re-converge)
{% endif %}
# SSH-key imports are bootstrap-only: admin.pub/ansible.pub exist on a fresh flash
# (uploaded by rb4011_initial.rsc) but are cleaned up in steady state. Guard on the file
# existing — unguarded, a re-import aborts with 'input does not match any value of
# public-key-file'. Steady state already has the keys, so skipping is correct.
:if ([/file find where name=admin.pub] != "") do={
    /user ssh-keys import public-key-file=admin.pub user=admin
}
:if ([/file find where name=ansible.pub] != "") do={
    /user ssh-keys import public-key-file=ansible.pub user=ansible
}

# ---- Bridge + trunk (port model: untagged=primary/access, tagged=secondary/Mgmt) ----
# ADMIN/PC/PI ports: untagged Home (10) primary + tagged Mgmt (99) — dual-home.
# A single untagged port carries ONE VLAN (untagged frames map to pvid); the secondary
# admin plane rides TAGGED 99 on the same port. nas iLO4 + HMIP-HAP stay Mgmt-only.
# Guard the bridge add: /interface bridge add on an existing bridge errors.
:if ([/interface bridge find where name=bridge-lan] = "") do={
    /interface bridge add name=bridge-lan vlan-filtering=yes protocol-mode=none
}
# Bridge ports — guard each: a re-import aborts on 'interface already added'.
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether2] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether2  pvid=10 comment="PC (oldsrv) — untagged Home + tagged Mgmt"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether3] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether3  pvid=10 comment="Laptop (untagged Home + tagged Mgmt for WSL Debian)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether7] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether7  pvid=99 comment="nas iLO4 (Mgmt access)"
}
# spark (Lenovo ThinkStation PGX / NVIDIA GB10) — DUAL-HOMED like oldsrv/Pi on its single
# NIC (enP7s7): untagged Home (10) + tagged Mgmt (99), on ether8.
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether8] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether8 pvid=10 comment="spark (Dual: Home10 + MGMT99)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether9] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether9  pvid=20 comment="HMIP-HAP (IoT VLAN 20 + WAN via flag)"
}
# Raspberry Pi (ether10) — DUAL-HOMED: untagged Home (10) + tagged Mgmt (99).
:if ([/interface bridge port find where bridge=bridge-lan and interface=ether10] = "") do={
    /interface bridge port add bridge=bridge-lan interface=ether10 pvid=10 comment="Raspberry Pi (Dual: Home10 + MGMT99)"
}
:if ([/interface bridge port find where bridge=bridge-lan and interface=sfp-sfpplus1] = "") do={
    /interface bridge port add bridge=bridge-lan interface=sfp-sfpplus1 comment="trunk -> switch"
}
# Home (10): untagged on the dual-homed ports (ether2/3/10 — the access/primary plane).
# Guard against a duplicate bridge-vlan on re-import and match STATIC rows only — a
# dynamic entry cannot be `set`.
:if ([/interface bridge vlan find where bridge=bridge-lan and vlan-ids=10 and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids=10 tagged=bridge-lan,sfp-sfpplus1 untagged=ether2,ether3,ether8,ether10 comment="Home VLAN (access primary)"
} else={
    /interface bridge vlan set [find where bridge=bridge-lan and vlan-ids=10 and dynamic=no] tagged=bridge-lan,sfp-sfpplus1 untagged=ether2,ether3,ether8,ether10 comment="Home VLAN (access primary)"
}
# Management (99): TAGGED on the dual-homed ports + trunk + self; UNTAGGED on the
# Mgmt-only access ports (ether7 iLO only — ether9 is an IoT-20 access port).
:if ([/interface bridge vlan find where bridge=bridge-lan and vlan-ids=99 and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids=99 tagged=bridge-lan,sfp-sfpplus1,ether2,ether3,ether8,ether10 untagged=ether7 comment="Management VLAN on trunk + tagged admin"
} else={
    /interface bridge vlan set [find where bridge=bridge-lan and vlan-ids=99 and dynamic=no] tagged=bridge-lan,sfp-sfpplus1,ether2,ether3,ether8,ether10 untagged=ether7 comment="Management VLAN on trunk + tagged admin"
}
# Every gateway VLAN is tagged on the trunk (sfp-sfpplus1) so the switch reaches each
# per-VLAN gateway — mirror of crs328_converge.rsc.j2, which trunk-tags every VLAN. A
# VLAN missing at the trunk shows as empty ARP + no WAN on that VLAN's devices.
# Other VLANs (20/30/40/50): tagged on trunk+self only. VLAN 20 (IoT) also
# carries UNTAGGED ether9 (HMIP-HAP access).
# NOTE: `untagged` must render via a Jinja conditional, not a bare list append.
{% for v in network_vlans %}
{% if v.id != 99 and v.id != 10 %}
:if ([/interface bridge vlan find where vlan-ids={{ v.id }} and dynamic=no] = "") do={
    /interface bridge vlan add bridge=bridge-lan vlan-ids={{ v.id }} tagged=bridge-lan,sfp-sfpplus1{% if v.id == 20 %} untagged=ether9{% endif %} comment="{{ v.name }} VLAN on trunk"
} else={
    /interface bridge vlan set [find where vlan-ids={{ v.id }} and dynamic=no] tagged=bridge-lan,sfp-sfpplus1{% if v.id == 20 %} untagged=ether9{% endif %} comment="{{ v.name }} VLAN on trunk"
}
{% endif %}
{% endfor %}
:if ([/interface vlan find where name=vlan99-mgmt] = "") do={
    /interface vlan add name=vlan99-mgmt vlan-id=99 interface=bridge-lan
}

# ---- Per-VLAN interfaces + gateways (SSOT network_vlans) ----
# NOTE: vlan 99 (mgmt) is created ABOVE as `vlan99-mgmt` (bootstrap-compatible
# name); the loop skips it to avoid a duplicate `vlan99-management`.
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/interface vlan find where name=vlan{{ v.id }}-{{ v.name|lower }}] = "") do={
    /interface vlan add name=vlan{{ v.id }}-{{ v.name|lower }} vlan-id={{ v.id }} interface=bridge-lan
}
{% endif %}
{% endfor %}
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/ip address find where interface=vlan{{ v.id }}-{{ v.name|lower }}] = "") do={
    /ip address add address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} interface=vlan{{ v.id }}-{{ v.name|lower }} comment="{{ v.name }} gateway"
} else={
    /ip address set [find where interface=vlan{{ v.id }}-{{ v.name|lower }}] address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} comment="{{ v.name }} gateway"
}
{% else %}
:if ([/ip address find where interface=vlan99-mgmt] = "") do={
    /ip address add address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} interface=vlan99-mgmt comment="Management gateway"
} else={
    /ip address set [find where interface=vlan99-mgmt] address={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}/{{ v.subnet.split('/')[1] }} comment="Management gateway"
}
{% endif %}
{% endfor %}

# ---- DHCP: pools + servers + networks (mgmt server = dhcp-mgmt, named in bootstrap) ----
# RouterOS caps a dhcp-server network at 3 dns-servers — a 4th is silently dropped, so
# the router's own /ip dns is the implicit final fallback. Guard every add: a re-import
# must never duplicate-abort.
#
# DHCP option 15 (the search suffix, {{ domain_local }}) rides the `dhcp-domain` option
# row below, attached to every server — RouterOS 7 has no `domain=` property (`set …
# domain=` → `Script Error: bad parameter domain`). It is what makes a single-label name
# (`nas`, for `\\nas\media`) reach DNS instead of LLMNR/NetBIOS broadcast — which a wired
# port answers and Wi-Fi does not. → docs/network-vlans.md §DHCP
#
# Resolver ORDER per VLAN comes from `lan_first_dns` on the `network_vlans` row (SSOT),
# identical to roles/router/tasks/main.yml — which instance a VLAN queries first decides
# which split-horizon ANSWER it gets. → docs/network-dns.md §DNS Flow
# mgmt pool/server (bootstrap) — keep; add the rest
:if ([/ip pool find where name=pool-mgmt] = "") do={
    /ip pool add name=pool-mgmt ranges={{ mgmt.pool }}
} else={
    /ip pool set [find where name=pool-mgmt] ranges={{ mgmt.pool }}
}
:if ([/ip dhcp-server find where name=dhcp-mgmt] = "") do={
    /ip dhcp-server add name=dhcp-mgmt interface=vlan99-mgmt address-pool=pool-mgmt disabled=no
} else={
    /ip dhcp-server set [find where name=dhcp-mgmt] interface=vlan99-mgmt address-pool=pool-mgmt disabled=no
}
:if ([/ip dhcp-server network find where gateway=10.10.99.1] = "") do={
    /ip dhcp-server network add address={{ mgmt.subnet }} gateway=10.10.99.1 dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
} else={
    /ip dhcp-server network set [find where gateway=10.10.99.1] gateway=10.10.99.1 dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
}
{% for v in network_vlans %}
{% if v.id != 99 %}
:if ([/ip pool find where name=pool-vlan{{ v.id }}] = "") do={
    /ip pool add name=pool-vlan{{ v.id }} ranges={{ v.pool }}
} else={
    /ip pool set [find where name=pool-vlan{{ v.id }}] ranges={{ v.pool }}
}
:if ([/ip dhcp-server find where name=dhcp-{{ v.id }}] = "") do={
    /ip dhcp-server add name=dhcp-{{ v.id }} interface=vlan{{ v.id }}-{{ v.name|lower }} address-pool=pool-vlan{{ v.id }} disabled=no
} else={
    /ip dhcp-server set [find where name=dhcp-{{ v.id }}] interface=vlan{{ v.id }}-{{ v.name|lower }} address-pool=pool-vlan{{ v.id }} disabled=no
}
:if ([/ip dhcp-server network find where gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}] = "") do={
    /ip dhcp-server network add address={{ v.subnet }} gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }} dns-server={{ ([dns_tertiary_ip, dns_primary_ip, dns_secondary_ip] if (v.lan_first_dns | default(false)) else [dns_primary_ip, dns_secondary_ip, dns_tertiary_ip]) | join(',') }}
} else={
    /ip dhcp-server network set [find where gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }}] gateway={{ (network_static_hosts | selectattr('vlan','==',v.id) | selectattr('name','==','router') | first).ip }} dns-server={{ ([dns_tertiary_ip, dns_primary_ip, dns_secondary_ip] if (v.lan_first_dns | default(false)) else [dns_primary_ip, dns_secondary_ip, dns_tertiary_ip]) | join(',') }}
}
{% endif %}
{% endfor %}

# ---- DHCP option 15 (Domain Name) attached to EVERY server, dhcp-mgmt included ----
# Mechanism: an `/ip dhcp-server option` row with code 15, referenced by each server's
# `dhcp-option`. RouterOS 7 has no `domain=` property (`set … domain=` →
# `Script Error: bad parameter domain`).
#
# Use FULL paths inside `[find]`: a bare `[find]` resolves against the CURRENT menu, so
# inside a `do={}` block it searches the wrong table and attaches NOTHING, silently.
# roles/router does not manage this reference — one owner, not two.
#
# The value is hex with a 0x prefix: a literal or `x6b…` form dies with
# `failure: Unknown data type!`. Read it back with `print detail` — `raw-value` is the
# payload.
:if ([/ip dhcp-server option find where name=dhcp-domain] = "") do={
    /ip dhcp-server option add name=dhcp-domain code=15 value=0x{{ (domain_local | string).encode().hex() }}
} else={
    /ip dhcp-server option set [/ip dhcp-server option find where name=dhcp-domain] code=15 value=0x{{ (domain_local | string).encode().hex() }}
}
:foreach s in=[/ip dhcp-server find] do={
    /ip dhcp-server set $s dhcp-option=[/ip dhcp-server option find where name=dhcp-domain]
}

# ---- Stale phantom VLAN 21 cleanup ----
# A `vlan21-iot-internet` interface + dhcp-21 server/pool/network can survive on a device
# that was never re-converged after VLAN 21 left the SSOT. Unreachable dead state, but it
# must not persist.
# Cleanup is idempotent — each remove is guarded on existence. Order matters:
# remove dependent objects (lease/pool/network/server) before the interface.
:if ([/ip dhcp-server lease find where server=dhcp-21] != "") do={ /ip dhcp-server lease remove [find where server=dhcp-21] }
:if ([/ip dhcp-server network find where gateway=10.10.21.1] != "") do={ /ip dhcp-server network remove [find where gateway=10.10.21.1] }
:if ([/ip dhcp-server find where name=dhcp-21] != "") do={ /ip dhcp-server remove [find where name=dhcp-21] }
:if ([/ip pool find where name=pool-vlan21] != "") do={ /ip pool remove [find where name=pool-vlan21] }
:if ([/ip address find where interface=vlan21-iot-internet] != "") do={ /ip address remove [find where interface=vlan21-iot-internet] }
:if ([/interface vlan find where name=vlan21-iot-internet] != "") do={ /interface vlan remove [find where name=vlan21-iot-internet] }

# ---- DHCP static reservations (APs on vlan99 -> dhcp-mgmt; other reserved devices -> their VLAN server) ----
{% for h in network_static_hosts %}
{% if h.mac is defined and h.name.startswith('ap-') %}
:if ([/ip dhcp-server lease find where server=dhcp-mgmt and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-mgmt address={{ h.ip }} mac-address={{ h.mac }} comment="AP {{ h.name }}"
}
{% elif h.mac is defined and h.vlan == 99 and h.name not in ['router', 'switch'] and 'ap-' not in h.name %}
:if ([/ip dhcp-server lease find where server=dhcp-mgmt and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-mgmt address={{ h.ip }} mac-address={{ h.mac }} comment="{{ h.name }} mgmt reservation"
}
{% elif h.mac is defined and h.vlan != 99 and h.name not in ['router'] and 'ap-' not in h.name %}
:if ([/ip dhcp-server lease find where server=dhcp-{{ h.vlan }} and mac-address={{ h.mac }} and dynamic=no] = "") do={
    /ip dhcp-server lease add server=dhcp-{{ h.vlan }} address={{ h.ip }} mac-address={{ h.mac }} comment="{{ h.name }} reservation"
}
{% endif %}
{% endfor %}

# ---- WireGuard S2S ----
:if ([/interface wireguard find where name=wg-s2s] = "") do={
    /interface wireguard add name=wg-s2s listen-port=51820
} else={
    /interface wireguard set [find where name=wg-s2s] listen-port=51820
}
:if ([/ip address find where interface=wg-s2s] = "") do={
    /ip address add address={{ wireguard_s2s_vps.local_ip }} interface=wg-s2s
}
:if ([/interface wireguard peers find where interface=wg-s2s] = "") do={
    /interface wireguard peers add interface=wg-s2s public-key="{{ wireguard_s2s_vps.vps_public_key }}" allowed-address="{{ wireguard_s2s_vps.remote_ip }}" comment="VPS S2S peer"
} else={
    /interface wireguard peers set [find where interface=wg-s2s] public-key="{{ wireguard_s2s_vps.vps_public_key }}" allowed-address="{{ wireguard_s2s_vps.remote_ip }}" comment="VPS S2S peer"
}
# Quote EVERY non-literal value sent to the script parser: the WG public key contains
# +/= (and the admin/pppoe passwords may contain ! or $), which RouterOS mangles
# unquoted — the add then fails with no useful error.
:if ([/ip route find where dst-address=10.255.40.0/30 and gateway=wg-s2s] = "") do={
    /ip route add dst-address=10.255.40.0/30 gateway=wg-s2s
}
# Address-list for the VPS S2S peer (least-access source)
:if ([/ip firewall address-list find where list=vps_s2s_peer] = "") do={
    /ip firewall address-list add address={{ wireguard_s2s_vps.remote_ip.split('/')[0] }} list=vps_s2s_peer comment="VPS S2S peer"
}
# Scoped home targets the VPS may reach
{% for h in network_static_hosts %}
{% if h.name in ['nas','ha-vip','oldsrv','pi','router','switch','spark'] %}
:if ([/ip firewall address-list find where list=vps_scoped_home and address={{ h.ip }}] = "") do={
    /ip firewall address-list add address={{ h.ip }} list=vps_scoped_home comment="{{ h.name }}"
}
{% endif %}
{% endfor %}

# ---- Comtrend modem mgmt ----
# → docs/network.md §Comtrend modem management path
# The RB4011 holds a /24 on the modem LAN so a connected route to the modem subnet
# exists; a /32 leaves the modem unreachable via forward (no route) even though the
# modem itself answers.
:if ([/ip address find where interface=ether1] = "") do={
    /ip address add address={{ comtrend_modem.router_on_modem }} interface=ether1 comment="Comtrend modem mgmt /24"
}

# ---- Firewall: NAT (masquerade + forced DNS) ----
# Reset both NAT chains first: the reconciling router role owns the same rows, and
# without the reset an unguarded /add stacks a second masquerade + a second forced-DNS
# pair on top of the role's — two writers, four rows.
/ip firewall nat remove [find chain=srcnat]
/ip firewall nat remove [find chain=dstnat]
/ip firewall nat
add chain=srcnat out-interface=pppoe-telekom action=masquerade comment="Masquerade -> WAN"
# The Comtrend (consumer ONT) answers its web UI only to its directly-connected peer on
# the modem link (the RB4011); forwarded HTTP/HTTPS from LAN hosts is silently ignored
# (conn-tracker syn-sent, 0 replies). Masquerade trusted-admin traffic out ether1 as the
# router's own modem-LAN address so the modem answers.
add chain=srcnat out-interface={{ comtrend_modem.iface }} protocol=tcp dst-address={{ comtrend_modem.modem_mgmt_ip }} dst-port=80,443 action=masquerade comment="modem UI via router SNAT (trusted-admin)"
add chain=dstnat src-address=10.10.40.0/24 protocol=udp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="Kids forced filtered DNS - UDP 53 -> Technitium"
add chain=dstnat src-address=10.10.40.0/24 protocol=tcp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="Kids forced filtered DNS - TCP 53 -> Technitium"
# Per-MAC kids filtered DNS on Home VLAN 10 (the kids join the Kogler SSID, so the
# VLAN-40 hijack above does NOT cover them): redirect each kids tablet's DNS (53) to the
# Technitium primary, which enforces the Kids-Group policy (Cloudflare Families).
# Mirrors roles/router/tasks/main.yml — both own these rows.
{% for h in network_static_hosts %}{% if h.mac is defined and h.kids is defined and h.kids %}
add chain=dstnat src-address=10.10.1.0/24 src-mac-address={{ h.mac }} protocol=udp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="kids filtered DNS - UDP 53 -> Technitium: {{ h.name }}"
add chain=dstnat src-address=10.10.1.0/24 src-mac-address={{ h.mac }} protocol=tcp dst-port=53 action=dst-nat to-addresses={{ dns_primary_ip }} to-ports=53 comment="kids filtered DNS - TCP 53 -> Technitium: {{ h.name }}"
{% endif %}{% endfor %}
# IoT VLAN 20 per-device DNS visibility: hijack plain :53 from IoT to the Pi tertiary
# (dns_tertiary_ip, read via dns-pi.kogler.si) so each device's queries land per-source-IP
# in the Pi query log instead of collapsing at the VPS primary / WAN egress.
# Mirrors roles/router/tasks/main.yml — both own these rows.
add chain=dstnat src-address=10.10.20.0/24 protocol=udp dst-port=53 action=dst-nat to-addresses={{ dns_tertiary_ip }} to-ports=53 comment="IoT forced DNS - UDP 53 -> Pi"
add chain=dstnat src-address=10.10.20.0/24 protocol=tcp dst-port=53 action=dst-nat to-addresses={{ dns_tertiary_ip }} to-ports=53 comment="IoT forced DNS - TCP 53 -> Pi"

# ---- Firewall: address lists ----
# trusted-ha = DERIVED from inventory, not hand-enumerated: the hosts that RUN HA —
# the raspberry_pi group (HA primary) + the home_servers group (HA standby), trimmed to
# short names, plus the VIP. A hand-list silently drops a new HA node.
# The list MUST include the HA PRIMARY, not just the VIP: HA tunnels KNX from the host's
# own address (`local_ip` is null in the config entry, so xknx picks eth0), never from the
# VIP — a Pi missing here means HA's KNX to VLAN 20 hits the default drop while wall
# switches keep driving the bus and nothing looks broken.
# Reset the lists first: a re-import without the reset STACKS duplicate rows for
# trusted-admin/trusted-ha/internal_lan. The role's api_modify handles absents, but the
# converge must own the same single set.
/ip firewall address-list remove [find list=trusted-admin]
/ip firewall address-list remove [find list=trusted-ha]
/ip firewall address-list remove [find list=internal_lan]
/ip firewall address-list
{% set ha_names = (groups['raspberry_pi'] + groups['home_servers']) | map('regex_replace', '\\..*$', '') | list + ['ha-vip'] %}
{% for h in network_static_hosts %}
{% if h.name in ['oldsrv','nas','ha-vip','laptop-domen'] %}
add address={{ h.ip }} list=trusted-admin comment="Trusted admin host: {{ h.name }}"
{% endif %}
{% if h.name in ha_names %}
add address={{ h.ip }} list=trusted-ha comment="Trusted HA host: {{ h.name }}"
{% endif %}
{% endfor %}
add address=10.10.1.0/24 list=internal_lan comment="Home VLAN"
add address=10.10.20.0/24 list=internal_lan comment="IoT VLAN"
add address=10.10.30.0/24 list=internal_lan comment="Guest VLAN"
add address=10.10.40.0/24 list=internal_lan comment="Kids VLAN"
add address=10.10.50.0/24 list=internal_lan comment="Media VLAN"
add address=10.10.99.0/24 list=internal_lan comment="Mgmt VLAN"

# ---- Firewall: FORWARD chain (inter-VLAN, ordered, per router role) ----
# Reset chain (re-import safety) — comment-driven; a real reset clears it.
/ip firewall filter remove [find chain=forward]
/ip firewall filter
add chain=forward action=accept connection-state=established,related comment="Allow established/related return"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address-list=trusted-ha protocol=udp dst-port=5683 comment="IoT Shelly CoAP push -> HA"
add chain=forward action=accept src-address-list=trusted-ha dst-address=10.10.20.0/24 comment="Trusted HA hosts (oldsrv/ha-vip) -> IoT (new)"
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=tcp connection-state=established,related comment="Home -> IoT (est/rel)"
# KNXnet/IP tunneling (HA on the Pi -> GIRA IP router on IoT): the Pi is NOT in
# trusted-admin (a node, not an admin host), so HA's KNX tunnel needs its own narrow
# new-UDP exception. Same pattern as the CoAP 5683 reverse exception above.
# dst = knx-ip 10.10.20.11 (SSOT, VLAN 20).
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.11 protocol=udp dst-port=3671 comment="Home -> KNX router (KNXnet/IP tunnel, HA) - new UDP"
# KNXnet/IP REPLY path — mirrors the CoAP 5683 reverse exception above. Match the KNX
# ROUTER'S SOURCE PORT, not dst-port: HA's replies arrive from knx-ip:3671 to xknx's
# EPHEMERAL tunnel port, so a `dst-port=3671` rule reads correctly and matches nothing.
# Without it an idle UDP tunnel goes half-open: HA keeps sending (the bus still works)
# while every L_DATA.con and state read is dropped and xknx cannot see it.
# → docs/network-vlans.md §Inter-VLAN Firewall Rules
add chain=forward action=accept src-address=10.10.20.11 protocol=udp src-port=3671 dst-address-list=trusted-ha comment="KNX router -> HA (tunnel replies; match src-port 3671, replies go to xknx ephemeral port)"
# Shelly Gen1 RGBW2 REST (HA on the Pi -> the Shelly fleet on IoT): the Pi is a node, not
# an admin host, so HA's outbound new-TCP to the Shelly HTTP API needs its own narrow
# exception. dst-port 80 only (Gen1 REST); the CoAP 5683 push path is the reverse
# direction and is already covered by trusted-ha above.
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=tcp dst-port=80 comment="Home Pi (HA) -> Shelly RGBW2 REST (new TCP)"
# Shelly Gen1 CoIoT/CoAP CLIENT (HA -> each device, udp/5683): the reverse of the push
# above. Without this new-UDP the integration's config flow (BlockDevice.initialize ->
# CoAP GET) fails "cannot_connect" and the device cannot be added in the UI.
# Narrow: Home(10) only, dst-port 5683 only.
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.20.0/24 protocol=udp dst-port=5683 comment="Home Pi (HA) -> Shelly CoIoT/CoAP client (new UDP)"

add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.30 protocol=udp dst-port=53,853 comment="LAN -> DNS resolver udp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.30 protocol=tcp dst-port=53,853 comment="LAN -> DNS resolver tcp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.20 protocol=udp dst-port=53,853 comment="LAN -> DNS secondary Pi udp"
add chain=forward action=accept src-address-list=internal_lan dst-address=10.10.1.20 protocol=tcp dst-port=53,853 comment="LAN -> DNS secondary Pi tcp"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address=10.10.1.30 protocol=udp dst-port=53,853 comment="IoT -> DNS resolver udp"
add chain=forward action=accept src-address=10.10.20.0/24 dst-address=10.10.1.30 protocol=tcp dst-port=53,853 comment="IoT -> DNS resolver tcp"
# Cloud-IoT per-MAC WAN egress (iot-wan-allow): the LG/Bosch/HAP cloud devices ride
# VLAN 20, where the IoT->WAN drop below cuts their WAN; these src-mac-address accepts
# restore internet for exactly the SSOT rows with wan_allow: true.
# MUST sit ABOVE the IoT->WAN drop.
{% for h in network_static_hosts %}{% if h.mac is defined and h.vlan == 20 and h.wan_allow is defined and h.wan_allow %}
add chain=forward action=accept src-address=10.10.20.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom comment="IoT cloud device -> WAN allowed via iot-wan-allow (HD-312/325): {{ h.name }}"
{% endif %}{% endfor %}
# Per-MAC kids controls on Home VLAN 10: the kids tablets' bedtime WAN hard-block
# (22:00-07:00) + DoT(853) bypass drop, rendered per SSOT row with kids: true.
# MUST sit ABOVE the Home->WAN accept below — a drop placed below it is shadowed
# (first-match-wins).
{% for h in network_static_hosts %}{% if h.mac is defined and h.kids is defined and h.kids %}
add chain=forward action=drop src-address=10.10.1.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom protocol=tcp dst-port=853 comment="HD-326 kids DoT-bypass drop (853): {{ h.name }}"
add chain=forward action=drop src-address=10.10.1.0/24 src-mac-address={{ h.mac }} out-interface=pppoe-telekom time=22:00:00-07:00:00,mon,tue,wed,thu,fri,sat,sun comment="HD-326 kids bedtime WAN drop (22:00-07:00): {{ h.name }}"
{% endif %}{% endfor %}
# WAN egress for every VLAN except IoT, masqueraded — docs/network-vlans.md
# §Inter-VLAN Firewall Rules
add chain=forward action=accept src-address=10.10.1.0/24  out-interface=pppoe-telekom comment="Home -> WAN allowed (HD-309 row 73)"
add chain=forward action=accept src-address=10.10.50.0/24 out-interface=pppoe-telekom comment="Media -> WAN allowed"
add chain=forward action=accept src-address=10.10.30.0/24 out-interface=pppoe-telekom comment="Guest -> WAN allowed"
add chain=forward action=accept src-address=10.10.99.0/24 out-interface=pppoe-telekom comment="Mgmt -> WAN allowed"
add chain=forward action=drop src-address=10.10.20.0/24 out-interface=pppoe-telekom comment="IoT -> WAN drop (disable for firmware)"
add chain=forward action=accept src-address-list=vps_s2s_peer dst-address-list=vps_scoped_home comment="VPS S2S -> scoped home"
add chain=forward action=drop src-address-list=vps_s2s_peer comment="VPS S2S -> anything else DROP"
add chain=forward action=accept src-address=10.10.1.0/24 dst-address=10.10.50.0/24 comment="Home -> Media"
add chain=forward action=accept src-address=10.10.50.0/24 dst-address=10.10.1.0/24 comment="Media -> Home"
add chain=forward action=accept src-address=10.10.99.0/24 dst-address=10.10.1.0/24 comment="Mgmt -> Home (laptop/Pi discovery, HD-307)"
add chain=forward action=drop src-address=10.10.30.0/24 dst-address-list=internal_lan comment="Guest -> LAN drop"
add chain=forward action=drop src-address=10.10.40.0/24 protocol=tcp dst-port=853 comment="Kids -> DoT bypass drop tcp"
add chain=forward action=drop src-address=10.10.40.0/24 protocol=udp dst-port=853 comment="Kids -> DoT bypass drop udp"
# IoT VLAN 20 DoT(853) bypass drop — mirror of the Kids drop, so encrypted DNS cannot
# bypass the forced-DNS path (plain :53 -> Pi above). DoH/443 stays accepted: HTTPS
# cannot be filtered without TLS interception.
add chain=forward action=drop src-address=10.10.20.0/24 protocol=tcp dst-port=853 comment="IoT -> DoT bypass drop tcp (HD-342)"
add chain=forward action=drop src-address=10.10.20.0/24 protocol=udp dst-port=853 comment="IoT -> DoT bypass drop udp (HD-342)"
add chain=forward action=drop src-address=10.10.40.0/24 dst-address=10.10.1.0/24 comment="Kids -> Home drop"
add chain=forward action=drop src-address=10.10.40.0/24 out-interface=pppoe-telekom time=22:00:00-07:00:00,mon,tue,wed,thu,fri,sat,sun comment="Kids bedtime WAN block 22:00-07:00"
add chain=forward action=accept src-address=10.10.40.0/24 out-interface=pppoe-telekom comment="Kids -> WAN allowed out-of-window"
add chain=forward action=drop src-address-list=internal_lan dst-address-list=internal_lan comment="Default deny inter-VLAN"
# Comtrend modem mgmt (trusted-admin only)
add chain=forward action=accept src-address-list=trusted-admin dst-address=192.168.1.1 protocol=tcp dst-port=80,443 comment="Trusted admin -> Comtrend modem"
add chain=forward action=drop dst-address=192.168.1.0/24 comment="Drop all other -> Comtrend modem subnet"

# ---- Firewall: INPUT chain (mgmt services lockdown) ----
/ip firewall filter remove [find chain=input]
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="Allow established/related input"
add chain=input action=accept protocol=udp dst-port={{ wg_s2s_vps.listen_port }} comment="Allow WireGuard S2S handshake/input"
add chain=input action=accept src-address-list=internal_lan protocol=udp dst-port=67,68 comment="Allow DHCP input from LAN"
add chain=input action=accept in-interface=pppoe-telekom protocol=udp dst-port=67,68 comment="Accept PPPoE DHCP-renewal input (WAN)"
add chain=input action=drop in-interface=pppoe-telekom comment="Drop all other new-from-WAN (brute-force floor)"
add chain=input action=accept src-address=10.10.99.0/24 protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Allow mgmt services from Mgmt VLAN"
add chain=input action=accept src-address-list=trusted-admin protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Allow mgmt services from trusted-admin"
add chain=input action=drop protocol=tcp dst-port=22,8728,8729,8291,80,443 comment="Drop mgmt services from non-mgmt sources"
add chain=input action=accept src-address=10.10.99.0/24 protocol=udp dst-port=161 comment="Allow SNMP from Mgmt VLAN"
add chain=input action=drop protocol=udp dst-port=161 comment="Drop SNMP from non-mgmt"
add chain=input action=accept src-address-list=internal_lan protocol=tcp dst-port=53 comment="Allow DNS input from LAN tcp"
add chain=input action=accept src-address-list=internal_lan protocol=udp dst-port=53 comment="Allow DNS input from LAN udp"

# ---- IPv6: scoped dual-stack — the FILTER lands before any prefix does ----
# IPv4 inbound safety is an accident of NAT; IPv6 has no NAT, so an unsolicited packet
# from the internet reaches a Home device unless WE drop it.
# → docs/network-vlans.md §IPv6 — scoped dual-stack (Home VLAN only)
#
# The invariant: no VLAN loses its IPv4-only protection without an explicit filter
# decision, and that decision must be in place BEFORE the prefix is live — so the
# section is ordered delegation → filter → addressing/RA, never reordered by a later edit.
#
# DHCPv6-PD delegates the prefix over pppoe-telekom, so it is NEVER written into a row
# below: the Home address is `<prefix from the pool>::1/64` and `advertise=yes` puts THAT
# /64 in the RA, which is what makes a re-delegation heal itself.
#
# Deliberately absent — no inbound `udp 41641 -> oldsrv` accept: it needs one predictable
# destination address and oldsrv has none (`addr_gen_mode=1`/RFC 7217 + `use_tempaddr=2`
# give it hashed + rotating temporary addresses). Pinning it is a host-side decision
# (roles/network); a Tailscale punch still works because those packets are replies, which
# rule 1 (`established,related`) admits. No MLD (130-132) accept: nothing here sends
# IPv6 multicast to the ISP.
# The filter is FIRST-MATCH-WINS, so every exception sits ABOVE its drop — the same idiom
# as the WireGuard listen-port rule in the IPv4 input chain above.
# Syntax on this device differs from the older property names: `protocol=icmpv6` (not
# ipv6-icmp), `icmp-options=<single int>` (no lists, no ranges), no `name=` on
# /ipv6 dhcp-client (it is keyed by interface), and no `from-pool` on /ipv6 nd prefix
# (`advertise` on the address is the SLAAC mechanism).

# (1) The delegation itself. No default route and no ISP DNS from here: the v6 default
#     route already arrives with the ISP's own RA, and DNS stays on the Technitium
#     chain the DHCP path hands out (docs/network-dns.md).
/ipv6 dhcp-client remove [find where interface=pppoe-telekom]
/ipv6 dhcp-client add interface=pppoe-telekom request=prefix pool-name={{ network_ipv6.pool }} \
    pool-prefix-length=64 prefix-hint={{ network_ipv6.prefix_hint }} \
    add-default-route=no use-peer-dns=no comment="DHCPv6-PD (the delegated prefix lands in the pool)"
# The pool only exists once the client has bound — give the Solicit/Advertise exchange
# a moment so the address row below resolves on the first import.
:delay 3s

# (2) The filter. Whole-chain rebuild, the way the IPv4 chains above are owned.
/ipv6 firewall filter remove [find chain=input]
/ipv6 firewall filter remove [find chain=forward]
/ipv6 firewall filter
add chain=input action=accept connection-state=established,related comment="v6 established/related (also what admits a tailscale hole-punch reply)"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=1 comment="v6 icmp dest-unreach (RFC 4890 errors)"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=2 comment="v6 icmp packet-too-big — PMTUD; black-holing this is the classic silent-v6 breakage"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=3 comment="v6 icmp time-exceeded"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=4 comment="v6 icmp parameter-problem"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=133 comment="v6 router-solicitation (ND on the WAN link)"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=134 comment="v6 router-advertisement — the ISP's RA carries the ::/0 route"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=135 comment="v6 neighbor-solicitation"
add chain=input action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=136 comment="v6 neighbor-advertisement"
add chain=input action=accept in-interface=pppoe-telekom protocol=udp dst-port=546 comment="DHCPv6-PD replies the server starts (a Renew/Reconfigure it pushes is new, not related)"
add chain=input action=drop in-interface=pppoe-telekom comment="drop all other new-from-WAN — IPv6 has no NAT, so this rule IS the inbound protection"
add chain=forward action=accept connection-state=established,related comment="v6 established/related"
add chain=forward action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=1 comment="forwarded v6 icmp dest-unreach"
add chain=forward action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=2 comment="forwarded PMTUD — Home hosts must see packet-too-big or their connections stall silently"
add chain=forward action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=3 comment="forwarded v6 icmp time-exceeded"
add chain=forward action=accept in-interface=pppoe-telekom protocol=icmpv6 icmp-options=4 comment="forwarded v6 icmp parameter-problem"
add chain=forward action=drop in-interface=pppoe-telekom comment="no unsolicited v6 into any VLAN (any future exception goes ABOVE this line)"
# The no-v6 VLANs keep it that way even if someone later advertises a prefix at them:
# egress from them is refused, which is what IPv4 routing already gives them.
{% for v in network_vlans if v.id not in network_ipv6.slaac_vlan_ids and v.id != 99 %}
add chain=forward action=drop in-interface=vlan{{ v.id }}-{{ v.name|lower }} comment="no v6 egress from {{ v.name }} ({{ v.id }}) — this VLAN stays IPv4-routed"
{% endfor %}
add chain=forward action=drop in-interface=vlan99-mgmt comment="no v6 origin from Mgmt — mirrors the v4 drop-mgmt-origin"

# (3) Addressing + RA, LAST. One advertised address device-wide = the invariant "RA on
#     the Home VLAN only"; a `disabled=yes` /ipv6 nd row would NOT express it — the
#     `interface=all` default row advertises again.
/ipv6 address remove [find where comment~"^HD-414"]
{% for v in network_vlans if v.id in network_ipv6.slaac_vlan_ids %}
/ipv6 address add address={{ network_ipv6.router_address_suffix }} interface=vlan{{ v.id }}-{{ v.name|lower }} from-pool={{ network_ipv6.pool }} advertise=yes comment="HD-414 {{ v.name }} GWA (fixed suffix, prefix taken from the pool)"
{% endfor %}
{% for v in network_vlans if v.id in network_ipv6.slaac_vlan_ids %}
/ipv6 nd remove [find where interface=vlan{{ v.id }}-{{ v.name|lower }}]
/ipv6 nd add interface=vlan{{ v.id }}-{{ v.name|lower }} disabled=no ra-preference=medium hop-limit=64 \
    advertise-dns=no managed-address-configuration=no other-configuration=no \
    comment="SLAAC on {{ v.name }} ({{ v.id }}) only — DNS stays on the DHCP path"
{% endfor %}
:if ([/ipv6 pool find where name={{ network_ipv6.pool }}] = "") do={
    :log warning "pool {{ network_ipv6.pool }} is not bound yet — the Home v6 address and its RA prefix stay invalid until the DHCPv6-PD delegation lands"
}

# ---- Services (mgmt-scoped, dangerous disabled) ----
/ip service set telnet disabled=yes port=23 available-from={{ router_services_available_from }}
/ip service set ftp disabled=yes port=21 available-from={{ router_services_available_from }}
/ip service set www disabled=yes port=80 available-from={{ router_services_available_from }}
/ip service set api-ssl disabled=yes port=8729 available-from={{ router_services_available_from }} certificate=none
/ip service set reverse-proxy disabled=yes port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set api disabled=no port=8728 available-from={{ router_services_available_from }}
/ip service set www-ssl disabled=no port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set ssh disabled=no port=22 available-from={{ router_services_available_from }}
/ip service set winbox disabled=no port=8291 available-from={{ router_services_available_from }}

# ---- SNMP: RO, Mgmt-scoped — config so it survives steady-state converges ----
# The RO community (network-snmp_api) renders as snmp_ro_community; the community `name=`
# IS the shared secret (it must match the Alloy snmp.yml auth community), scoped to the
# Mgmt subnet and read-only. Idempotent: set enabled, then set the named community if
# present else add it. The INPUT chain above allows udp/161 from Mgmt, drops the rest.
/snmp set enabled=yes
:if ([/snmp community find where name={{ snmp_ro_community }}] = "") do={
    /snmp community add name={{ snmp_ro_community }} addresses={{ mgmt.subnet }} read-access=yes write-access=no comment="Homelab RO poller"
} else={
    /snmp community set [find where name={{ snmp_ro_community }}] addresses={{ mgmt.subnet }} read-access=yes write-access=no
}

# ---- Boot resilience (fixboot): re-assert syslog + SNMP after boot ----
# ONE startup script+scheduler for both concerns. RouterOS settings are config, not
# runtime state, but a stray change or a boot edge can leave the syslog remote target
# or SNMP off; a startup scheduler re-asserts both ~10s post-boot (after bring-up):
#   * centralsyslog -> the VPS rsyslog target (target = wireguard_s2s_vps.remote_ip)
#   * /snmp enabled + RO community scoped to Mgmt
# Script/scheduler names are letters+numbers only -> `fixboot`. A single-line quoted
# source keeps the /import parser happy.
:if ([/system script find where name=fixboot] = "") do={
    /system script add name=fixboot source=":delay 10s; /system logging action set [find where name=centralsyslog] remote=0.0.0.0; :delay 1s; /system logging action set [find where name=centralsyslog] remote={{ wireguard_s2s_vps.remote_ip.split('/')[0] }}; /snmp set enabled=yes; /snmp community set [find where name={{ snmp_ro_community }}] addresses={{ mgmt.subnet }} read-access=yes write-access=no;"
}
:if ([/system scheduler find where name=fixboot] = "") do={
    /system scheduler add name=fixboot on-event=fixboot start-time=startup interval=0 policy=read,write,test
}
# Cleanup: the fixsyslog + fixsnmp split (folded into fixboot) — remove if present.
:if ([/system script find where name=fixsyslog] != "") do={
    /system script remove [find where name=fixsyslog]
}
:if ([/system scheduler find where name=fixsyslog] != "") do={
    /system scheduler remove [find where name=fixsyslog]
}
:if ([/system script find where name=fixsnmp] != "") do={
    /system script remove [find where name=fixsnmp]
}
:if ([/system scheduler find where name=fixsnmp] != "") do={
    /system scheduler remove [find where name=fixsnmp]
}

# ---- End ----
# Upstream = the same Technitium chain the DHCP hands out (VPS->oldsrv->Pi), so
# the router forwards to them first and only falls back to raw Cloudflare when
# all are unreachable (RouterOS queries listed servers concurrently + takes the
# first reply). The router's WAN egress IP is exactly what the VPS nftables
# dns-allow-home set permits. Final fallback stays unfiltered (accepted
# tradeoff, network-dns.md).
/ip dns set allow-remote-requests=yes servers={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }},1.1.1.1,1.0.0.1

# ---- End ----

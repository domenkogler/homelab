# =====================================================================
# rb4011_dns_resolver_delta — HD-317: TECHNETIUM DNS-PRIMARY ON ROUTER (DHCP + /ip dns)
# ---------------------------------------------------------------------
# Transient delta (network-ops.md 3-tier): sets the DHCP dns-server chain to
# PRIMARY(VPS) -> SECONDARY(oldsrv) -> TERTIARY(Pi) — RouterOS /ip dhcp-server
# network accepts AT MOST 3 dns-server values (a 4th is silently dropped; the
# earlier 4-entry rendition dropped Pi), so the router /ip dns is NOT part of
# the DHCP list. The router's own /ip dns upstream (below) is the implicit
# final fallback: clients that can't reach any of the 3 resolvers still have the
# router-resolver as their gateway.
# Final state is ALSO folded into rb4011_converge.rsc.j2 (its idempotency is
# partial by design — /add dupes abort re-imports before the DNS section).
# Render: playbooks/render-converge.yml; apply: scripts/routeros-apply-delta.sh.
# =====================================================================
# DHCP — every VLAN network: dns-server = VPS,oldsrv,Pi  (3 max)
/ip dhcp-server network set [find where address=10.10.1.0/24]    dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.20.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.21.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.30.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.40.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.50.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
/ip dhcp-server network set [find where address=10.10.99.0/24]   dns-server={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }}
# Router resolver upstream — VPS,oldsrv,Pi + Cloudflare last (final unfiltered resort)
/ip dns set allow-remote-requests=yes servers={{ dns_primary_ip }},{{ dns_secondary_ip }},{{ dns_tertiary_ip }},1.1.1.1,1.0.0.1
# =====================================================================
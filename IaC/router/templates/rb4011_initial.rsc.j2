{#- RB4011 bootstrap template — rendered by render-routeros.yml (never commit rendered/).
    IPs/VLANs from group_vars/all/; secrets from 1Password at render time. -#}
# =============================================================================
# RB4011 — Kogler Homelab — Bootstrap (RENDERED — do not edit, regenerate)
# Source template: IaC/router/templates/rb4011_initial.rsc.j2
# =============================================================================
# Purpose: Minimal bootstrap that establishes the Management (VLAN {{ mgmt.id }})
#          plane with a static gateway IP + DHCP for temporary hosts, so the
#          Ansible `router` role can connect (user=ansible, SSH-key auth) and
#          take over the full VLAN/firewall/CAPsMAN/WireGuard config.
# How:     Upload this + admin.pub + ansible.pub to the router Files, then EITHER:
#            (a) /system reset-configuration no-defaults=yes run-after-reset=rb4011_initial.rsc
#                (works on a clean device, but the run-after-reset pipeline aborts the
#                whole script at the first error and leaves the device half-configured)
#          OR (b) the recommended path on a device with state already on it: /import
#                rb4011_initial.rsc  in a WinBox terminal. Idempotent for `set`, errors
#                on duplicate `add` — after an aborted import the NTP server and the
#                service rows are the two places that need manual recovery.
# NOTE:    NO secrets in the repo — credentials injected from 1Password.
#
# Security baseline:
#   * Telnet/FTP/www/api-ssl/reverse-proxy are DISABLED from the first line of device
#     uptime, AND scoped to the mgmt subnet via `available-from=` (RouterOS 7 syntax —
#     `interface=` is the RouterOS 6 form and is rejected with "bad parameter
#     interface" on a ROS7 device). Defense in depth: even if a later change re-enables
#     a disabled service, it still won't listen on WAN.
#   * The minimal INPUT chain below drops everything from WAN except established/related
#     and ICMP. The full firewall comes from the `router` Ansible role and the converge
#     template; this chain is only the bootstrap-window floor.
# =============================================================================

# ---- System ----

/system identity set name=router.kogler.si
/system clock set time-zone-name={{ timezone }}
# RouterOS 7: the parameter is 'address=' — the NTP client schema knows no v6 'server=',
# so `server=` dies with 'bad parameter server'. Do not regress.
/system ntp client set enabled=yes
{% for h in ntp_servers %}
/system ntp client servers add address={{ h }}
{% endfor %}

# ---- Users (bootstrap auth) ----
# admin = password + SSH key. ansible = key-only (automation).

/user set [find name=admin] password="{{ mikrotik_admin_password }}" comment="human admin"
/user ssh-keys import public-key-file=admin.pub user=admin

# RouterOS 7: /user add REQUIRES a `password=` field, even an empty one — the two-line
# form (add without password, then set) dies with 'missing value(s) of argument(s)
# password'. Passing `password=""` on the add also keeps a zero-password ansible user
# off the wire between the add and the set.
/user add name=ansible group=full disabled=no password="" comment="Ansible automation (SSH-key auth, key-only)"
/user ssh-keys import public-key-file=ansible.pub user=ansible

# ---- Management (VLAN {{ mgmt.id }} — {{ mgmt.name }}) ----
# router→switch = sfp-sfpplus1 (trunk, mgmt tagged); direct host ports = access mgmt.
/interface bridge add name=bridge-lan vlan-filtering=yes protocol-mode=none
/interface bridge port add bridge=bridge-lan interface=ether2  pvid={{ mgmt.id }} comment="PC (oldsrv), B7"
/interface bridge port add bridge=bridge-lan interface=ether3  pvid={{ mgmt.id }} comment="Laptop, B8"
/interface bridge port add bridge=bridge-lan interface=ether7  pvid={{ mgmt.id }} comment="nas iLO4"
/interface bridge port add bridge=bridge-lan interface=ether9  pvid={{ mgmt.id }} comment="HMIP-HAP"
# Raspberry Pi (ether10) — DUAL-HOMED: VLAN-10 access (Home node + HA VIP) +
# mgmt (99) tagged (Ansible mgmt plane). pvid=10 untagged; vlan99 arrives tagged.
/interface bridge port add bridge=bridge-lan interface=ether10 pvid=10 comment="Raspberry Pi (Dual: VLAN10 + MGMT)"
/interface bridge port add bridge=bridge-lan interface=sfp-sfpplus1
/interface bridge vlan add bridge=bridge-lan vlan-ids={{ mgmt.id }} tagged=bridge-lan,sfp-sfpplus1
/interface bridge vlan add bridge=bridge-lan vlan-ids=10 tagged=bridge-lan,sfp-sfpplus1 untagged=ether10 comment="Home VLAN access (Pi)"
/interface vlan add name=vlan{{ mgmt.id }}-mgmt vlan-id={{ mgmt.id }} interface=bridge-lan

/ip address add address={{ router99.ip }}/{{ mgmt.subnet.split('/')[1] }} interface=vlan{{ mgmt.id }}-mgmt \
    comment="{{ mgmt.name }} gateway"
/ip pool add name=pool-mgmt ranges={{ mgmt.pool }}
/ip dhcp-server add name=dhcp-mgmt interface=vlan{{ mgmt.id }}-mgmt address-pool=pool-mgmt disabled=no
/ip dhcp-server network add address={{ mgmt.subnet }} gateway={{ router99.ip }} dns-server={{ bootstrap_dns_servers }}

# ---- WAN (internet for laptop + 1Password) ----

/interface pppoe-client add name=pppoe-telekom interface=ether1 \
    user="{{ pppoe_login_user }}" password="{{ pppoe_login_password }}" \
    add-default-route=yes use-peer-dns=no disabled=no
/ip firewall nat add chain=srcnat out-interface=pppoe-telekom action=masquerade comment="Masquerade → WAN"

# ---- Minimal INPUT firewall (bootstrap-window floor) ----
# Bootstrap only — the real inter-VLAN + per-zone rules come from the `router`
# Ansible role. This block: drop WAN-side new connections (telnet / SSH / API /
# winbox brute-force surface from the public PPPoE IP), accept everything from the
# mgmt subnet, accept ICMP, accept established/related.
# Do NOT lock the laptop out of the router here — the laptop is on 10.10.99.0/24
# via the bootstrap access ports, and the Ansible role needs to reach the API.
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="HD-301: accept established/related"
add chain=input action=drop connection-state=invalid comment="HD-301: drop invalid"
add chain=input action=accept protocol=icmp comment="HD-301: accept ICMP (path MTU + ping)"
add chain=input action=accept in-interface=vlan{{ mgmt.id }}-mgmt comment="HD-301: accept all from mgmt VLAN"
add chain=input action=accept in-interface=pppoe-telekom protocol=udp dst-port=67,68 comment="HD-301: accept PPPoE DHCP-renewal input"
add chain=input action=drop in-interface=pppoe-telekom comment="HD-301: drop all other new-from-WAN (brute-force floor)"
add chain=input action=accept comment="HD-301: accept all from other (LAN) interfaces — replaced by the `router` Ansible role in §1.5.3"

# ---- Services (Ansible REST/API/SSH door) ----
# Scope every management service to the mgmt subnet (10.10.99.0/24). RouterOS 7
# syntax: `available-from=` (`interface=` is the RouterOS 6 form, rejected with
# "bad parameter interface" on ROS7). Belt-and-braces: every service is also bound
# to its well-known port, and the dangerous-on-WAN services (telnet, ftp, www,
# api-ssl, reverse-proxy) are disabled explicitly.
/ip service set telnet disabled=yes port=23 available-from={{ router_services_available_from }}
/ip service set ftp disabled=yes port=21 available-from={{ router_services_available_from }}
/ip service set www disabled=yes port=80 available-from={{ router_services_available_from }}
/ip service set api-ssl disabled=yes port=8729 available-from={{ router_services_available_from }} certificate=none
/ip service set reverse-proxy disabled=yes port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set api disabled=no port=8728 available-from={{ router_services_available_from }}
/ip service set www-ssl disabled=no port=443 available-from={{ router_services_available_from }} certificate=none
/ip service set ssh disabled=no port=22 available-from={{ router_services_available_from }}
/ip service set winbox disabled=no port=8291 available-from={{ router_services_available_from }}

# ---- SNMP: RO, Mgmt-scoped — survives factory reset via run-after-reset ----
# The RO community (network-snmp_api) is injected at render as snmp_ro_community; the
# community `name=` IS the shared secret string (must match the Alloy snmp.yml auth
# community) and is scoped to the Mgmt subnet only, read-only.
/snmp set enabled=yes
:if ([/snmp community find where name={{ snmp_ro_community }}] = "") do={
    /snmp community add name={{ snmp_ro_community }} addresses={{ mgmt.subnet }} read-access=yes write-access=no comment="Homelab RO poller (HD-53)"
} else={
    /snmp community set [find where name={{ snmp_ro_community }}] addresses={{ mgmt.subnet }} read-access=yes write-access=no
}

# ---- End ----
# After import, verify:
#   1. PPPoE connects          → /interface pppoe-client monitor pppoe-telekom
#   2. Laptop gets 10.10.99.x  → /ip dhcp-server lease print
#   3. Services are locked     → /ip service print  (api+www-ssl+ssh+winbox ON,
#                                               AVAILABLE-FROM=10.10.99.0/24;
#                                               telnet+ftp+www+api-ssl+reverse-proxy
#                                               X = disabled; the DYNAMIC rows
#                                               3/4/6/9/10 are normal)
#   4. INPUT chain is set      → /ip firewall filter print  (bootstrap floor visible)
#   5. SNMP enabled + RO community scoped to Mgmt → /snmp print, /snmp community print
#   6. SSH from the laptop     → ssh -i ~/.ssh/id_ed25519 ansible@10.10.99.1
#   6. Ansible `router` role then applies the real VLAN/firewall/CAPsMAN config.

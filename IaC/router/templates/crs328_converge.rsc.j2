# =============================================================================
# CRS328-24P-4S+ — Kogler Homelab — CONVERGED STEADY-STATE (RENDERED — do not edit)
# Source template: IaC/router/templates/crs328_converge.rsc.j2
# =============================================================================
# Purpose: Full final state for the switch — import on a device that already ran
#          crs328_initial.rsc (or run after a reset). Idempotent-ish: `/set` safe,
#          `/add` errors on duplicates (re-import = "already have" messages OK).
#          Authored from the SSOT (group_vars/all.yml + router.yml).
# How:     Upload + /import switch-converge.rsc in a WinBox terminal
#          (or via SSH: scp to deviceFiles then /import).
# =============================================================================

# ---- Users (auth — mirror bootstrap; .pub keys in flash/ per HD-304) ----
# admin = password + SSH key. ansible = key-only (automation).
# .pub files MUST live in flash/ (root files wiped on reboot on switch/APs).
/user set [find name=admin] password="{{ mikrotik_admin_password }}" comment="human admin"
/user add name=ansible group=full disabled=no password="" comment="Ansible automation (SSH-key auth, key-only)"
/user ssh-keys import public-key-file=flash/admin.pub user=admin
/user ssh-keys import public-key-file=flash/ansible.pub user=ansible

# ---- Identity / clock ----
/system identity set name=switch.kogler.si
/system clock set time-zone-name=Europe/Ljubljana

# ---- Bridge + ports (bootstrap already created; re-set idempotently) ----
# Bridge name = "bridge" (SSOT with crs328_initial.rsc.j2 — do NOT rename).
# Remove a prior phantom `bridge-lan` if a partial run created one, then ensure `bridge`.
# SAFETY ORDER (live 2026-08-31, recurring re-lock): do NOT enable vlan-filtering
# here — it severs the switch's own mgmt path the instant it comes on if the trunk
# + mgmt IP aren't carrying vlan99 yet (switch vanishes from the router's L2 view).
# Filtering is enabled by the LAST command of this script (mirror of the role).
/interface bridge remove [find name=bridge-lan]
/interface bridge add name=bridge vlan-filtering=no protocol-mode=none
# Ensure every port is a member of the bridge (idempotent: set-if-exists via /set, add-if-absent)
{% for n in range(1, 25) %}
/interface bridge port add bridge=bridge interface=ether{{ n }} pvid=99
{% endfor %}
{% for n in range(2, 5) %}
/interface bridge port add bridge=bridge interface=sfp-sfpplus{{ n }} pvid=99
{% endfor %}
# uplink first (must exist before VLANs carry it as tagged)
/interface bridge port add bridge=bridge interface=sfp-sfpplus1 comment="uplink -> router"

# ---- VLANs on the bridge (tagged trunk + per-VLAN) ----
# HD-328: every access port from switch_port_map must ALSO be an untagged member of
# its role VLAN on the bridge — a CRS328 with ingress-filtering on the bridge DROPS
# traffic from an access port whose VLAN has no untagged membership (pvid alone does
# NOT make the port forward: Shield/console on VLAN 50 had empty ARP + no WAN — the
# HD-308 signature — because VLAN 50 had no untagged member at all).
{% for v in network_vlans %}
# VLAN {{ v.id }} ({{ v.name }})
{% set access = switch_port_map.items() | selectattr('1.vlan', 'equalto', v.id) | map(attribute='1.port') | list %}
/interface bridge vlan add bridge=bridge vlan-ids={{ v.id }} tagged=bridge,sfp-sfpplus1{% if v.ssid is defined and v.ssid and wifi_ports is defined %},{{ wifi_ports | join(',') }}{% endif %}{% if access | length > 0 %},untagged={{ access | join(',') }}{% endif %} comment="{{ v.name }} VLAN on trunk{% if v.ssid is defined and v.ssid %} (+ wifi AP ports tagged for {{ v.ssid|default('') }}){% endif %}{% if access | length > 0 %} (+ access ports {{ access | join(',') }} untagged){% endif %}"
{% endfor %}

# ---- Stale phantom VLAN 21 bridge-vlan cleanup (HD-325 / HD-328) ----
# VLAN 21 (IoT-Internet) was deleted in HD-325; a stale bridge-vlan entry can
# survive a pre-HD-325 converge (live-found 2026-09-04: `21 bridge,sfp-sfpplus1`
# on the switch). Harmless (no client can frame it), but keep the L2 table
# matching the SSOT. Idempotent: remove only if present.
:if ([/interface bridge vlan find where bridge=bridge and vlan-ids=21 and dynamic=no] != "") do={ /interface bridge vlan remove [find where bridge=bridge and vlan-ids=21 and dynamic=no] }

# ---- VLAN interfaces (per-VLAN L3 gateways NOT on switch — switch is L2; keep only mgmt) ----
# mgmt VLAN interface for the management IP
/interface vlan add name=vlan99-mgmt vlan-id=99 interface=bridge

# ---- Management IP + route + DNS (SSOT) ----
/ip address add address={{ switch99.ip }}/24 interface=vlan99-mgmt comment="Management mgmt (SSOT)"
/ip route add dst-address=0.0.0.0/0 gateway=10.10.99.1 comment="Default via router"
/ip dns set servers=10.10.99.1

# ---- Access port reassignment to their real VLANs (SSOT switch_port_map) ----
# (bootstrap puts ALL ports on pvid 99; steady-state moves them to their role VLAN)
# PoE: left at the device default (auto-on, per WinBox) — forcing poe-out=on broke
# the script at import (RouterOS parser: syntax error col 41 on poe-out=on; the
# CRS328 rejects the forced value). APs power fine under auto-on.
{% for k, v in switch_port_map.items() %}
# {{ k }} ({{ v.vlan }}): {{ v.port }}
/interface bridge port set [find where interface={{ v.port }}] pvid={{ v.vlan }} comment="{{ k }} -> VLAN {{ v.vlan }}"
{% endfor %}

# ---- PoE everywhere else default = auto-on (APs explicitly on; others stay auto) ----

# ---- INPUT firewall mgmt lockdown (HD-301 parity; steady-state) ----
# Allow established/related, mgmt-VLAN services, trusted-admin; drop the rest
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="Allow established/related input (switch)"
add chain=input action=accept in-interface=vlan99-mgmt comment="Allow mgmt VLAN input (switch)"
add chain=input action=drop comment="Drop all other input (switch lockdown)"

# ---- Services (mgmt-scoped, dangerous disabled — HD-301) ----
/ip service set telnet disabled=yes port=23 available-from=10.10.99.0/24
/ip service set ftp disabled=yes port=21 available-from=10.10.99.0/24
/ip service set www disabled=yes port=80 available-from=10.10.99.0/24
/ip service set api-ssl disabled=yes port=8729 available-from=10.10.99.0/24 certificate=none
/ip service set reverse-proxy disabled=yes port=443 available-from=10.10.99.0/24 certificate=none
/ip service set api disabled=no port=8728 available-from=10.10.99.0/24
/ip service set www-ssl disabled=no port=443 available-from=10.10.99.0/24 certificate=none
/ip service set ssh disabled=no port=22 available-from=10.10.99.0/24
/ip service set winbox disabled=no port=8291 available-from=10.10.99.0/24

# ---- LAST: enable VLAN filtering (safety order — see bridge add at top) ----
# With the trunk + access ports + mgmt IP + vlan99 all in place ABOVE, enabling
# filtering now keeps the switch reachable. If this step errors, the switch stays
# reachable (filtering off) for recovery.
/interface bridge set bridge vlan-filtering=yes

# ---- End ----
# Verify: /interface bridge print, /interface bridge port print, /ip address print,
#         /ip firewall filter print, /ip service print